        { "hebraico": "חָרֵֽב׃", "transliteral": "ḥā-rêḇ", "traducao_palavra": "[está] em ruínas?" }
      ]
    },
    "5": {
      "traducao_completa": "Ora, pois, assim diz YHWH dos Exércitos: Considerai os vossos caminhos.",
      "palavras": [
        { "hebraico": "וְעַתָּ֕ה", "transliteral": "wə-ʿat-tā", "traducao_palavra": "e agora" },
        { "hebraico": "כֹּ֥ה", "transliteral": "kōh", "traducao_palavra": "assim" },
        { "hebraico": "אָמַ֛ר", "transliteral": "ʾā-mar", "traducao_palavra": "diz" },
