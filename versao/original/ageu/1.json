        { "hebraico": "לֵאמֹֽר׃", "transliteral": "lê-mōr", "traducao_palavra": "dizendo:" }
      ]
    },
    "4": {
      "traducao_completa": "Acaso é tempo de vós mesmos habitardes em vossas casas apaineladas, enquanto esta casa fica em ruínas?",
      "palavras": [
        { "hebraico": "הַעֵ֤ת", "transliteral": "ha-ʿêṯ", "traducao_palavra": "acaso é tempo" },
        { "hebraico": "לָכֶם֙", "transliteral": "lā-ḵem", "traducao_palavra": "para vós" },
        { "hebraico": "אַתֶּ֔ם", "transliteral": "ʾat-tem", "traducao_palavra": "vós mesmos" },
        { "hebraico": "לָשֶׁ֖בֶת", "transliteral": "lā-še-ḇeṯ", "traducao_palavra": "habitardes" },
