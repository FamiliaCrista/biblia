      ]
    },
    "6": {
      "traducao_completa": "Semeastes muito, e recolhestes pouco; comeis, mas não vos fartais; bebeis, mas não vos saciais; vestis-vos, mas ninguém se aquece; e o que recebe salário, recebe-o num saquitel furado.",
      "palavras": [
        { "hebraico": "זְרַעְתֶּ֨ם", "transliteral": "zə-raʿ-tem", "traducao_palavra": "semeastes" },
        { "hebraico": "הַרְבֵּ֜ה", "transliteral": "har-bêh", "traducao_palavra": "muito" },
        { "hebraico": "וְהָבֵ֣א", "transliteral": "wə-hā-ḇê", "traducao_palavra": "e recolhestes" },
        { "hebraico": "מְעָט֮", "transliteral": "mə-ʿāṭ", "traducao_palavra": "pouco;" },
