        { "hebraico": "כָּלְאָ֥ה", "transliteral": "kā-lə-ʾā", "traducao_palavra": "reteve" },
        { "hebraico": "יְבוּלָֽהּ׃", "transliteral": "yə-ḇū-lāh", "traducao_palavra": "o seu fruto." }
      ]
    },
    "11": {
      "traducao_completa": "E chamei a seca sobre a terra, e sobre os montes, e sobre o trigo, e sobre o mosto, e sobre o azeite, e sobre o que a terra produz; como também sobre os homens, e sobre os animais, e sobre todo o trabalho das mãos.",
      "palavras": [
        { "hebraico": "וָאֶקְרָ֨א", "transliteral": "wā-ʾeq-rā", "traducao_palavra": "e chamei" },
        { "hebraico": "חֹ֜רֶב", "transliteral": "ḥō-reḇ", "traducao_palavra": "a seca" },
        { "hebraico": "עַל־הָאָ֣רֶץ", "transliteral": "ʿal-hā-ʾā-reṣ", "traducao_palavra": "sobre a terra" },
        { "hebraico": "וְעַל־הֶהָרִ֗ים", "transliteral": "wə-ʿal-he-hā-rîm", "traducao_palavra": "e sobre os montes" },
        { "hebraico": "וְעַל־הַדָּגָן֙", "transliteral": "wə-ʿal-had-dā-ḡān", "traducao_palavra": "e sobre o trigo" },
