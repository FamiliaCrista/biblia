        { "hebraico": "וַהֲבֵאתֶ֥ם", "transliteral": "wa-hă-ḇê-ṯem", "traducao_palavra": "e trazei" },
        { "hebraico": "עֵ֖ץ", "transliteral": "ʿêṣ", "traducao_palavra": "madeira" },
