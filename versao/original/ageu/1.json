        { "hebraico": "לֹ֑ו", "transliteral": "lô", "traducao_palavra": "para ninguém;" },
        { "hebraico": "וְהַ֨מִּשְׂתַּכֵּ֔ר", "transliteral": "wə-ham-miś-tak-kêr", "traducao_palavra": "e o que recebe salário" },
        { "hebraico": "מִשְׂתַּכֵּ֖ר", "transliteral": "miś-tak-kêr", "traducao_palavra": "recebe salário" },
