    "2": {
      "traducao_completa": "Assim fala YHWH dos Exércitos, dizendo: Este povo diz: Não veio ainda o tempo, o tempo em que a casa de YHWH deve ser edificada.",
      "palavras": [
        { "hebraico": "כֹּ֥ה", "transliteral": "kōh", "traducao_palavra": "assim" },
        { "hebraico": "אָמַ֛ר", "transliteral": "ʾā-mar", "traducao_palavra": "fala" },
