        { "hebraico": "בֶּן־שְׁאַלְתִּיאֵל֙", "transliteral": "ben-šə-ʾal-tî-ʾêl", "traducao_palavra": "filho de Salatiel" },
        { "hebraico": "פַּחַ֣ת", "transliteral": "pa-ḥaṯ", "traducao_palavra": "governador de" },
        { "hebraico": "יְהוּדָ֔ה", "transliteral": "yə-hū-ḏā", "traducao_palavra": "Judá" },
        { "hebraico": "וְאֶל־יְהֹושֻׁ֧עַ", "transliteral": "wə-ʾel-yə-hô-šu-aʿ", "traducao_palavra": "e a Josué" },
        { "hebraico": "בֶּן־יְהֹוצָדָ֛ק", "transliteral": "ben-yə-hô-ṣā-ḏāq", "traducao_palavra": "filho de Jeozadaque" },
        { "hebraico": "הַכֹּהֵ֥ן", "transliteral": "hak-kō-hên", "traducao_palavra": "o sacerdote" },
        { "hebraico": "הַגָּדֹ֖ול", "transliteral": "hag-gā-ḏôl", "traducao_palavra": "o grande [sumo sacerdote]" },
        { "hebraico": "לֵאמֹֽר׃", "transliteral": "lê-mōr", "traducao_palavra": "dizendo:" }
      ]
