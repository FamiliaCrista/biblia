        { "hebraico": "הַבָּ֑יִת", "transliteral": "hab-bā-yiṯ", "traducao_palavra": "a casa;" },
        { "hebraico": "וְאֶרְצֶה־בֹּ֥ו", "transliteral": "wə-ʾer-ṣeh-bô", "traducao_palavra": "e dela me agradarei" },
        { "hebraico": "וְאֶכָּבְדָ֖ה", "transliteral": "wə-ʾek-kā-ḇə-ḏā", "traducao_palavra": "e serei glorificado" },
        { "hebraico": "אָמַ֥ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH." }
      ]
    },
    "9": {
      "traducao_completa": "Olhastes para muito, mas eis que veio a ser pouco; e quando o trouxestes para casa, eu assoprei sobre ele. Por que causa? diz YHWH dos Exércitos. Por causa da minha casa, que está em ruínas, enquanto correis cada um de vós à sua própria casa.",
      "palavras": [
        { "hebraico": "פָּנֹ֤ה", "transliteral": "pā-nōh", "traducao_palavra": "olhastes" },
        { "hebraico": "אֶל־הַרְבֵּה֙", "transliteral": "ʾel-har-bêh", "traducao_palavra": "para muito" },
        { "hebraico": "וְהִנֵּ֣ה", "transliteral": "wə-hin-nêh", "traducao_palavra": "e eis que veio" },
        { "hebraico": "לִמְעָ֔ט", "transliteral": "lim-ʿāṭ", "traducao_palavra": "a ser pouco;" },
        { "hebraico": "וַהֲבֵאתֶ֥ם", "transliteral": "wa-hă-ḇê-ṯem", "traducao_palavra": "e quando o trouxestes para" },
        { "hebraico": "הַבַּ֖יִת", "transliteral": "hab-ba-yiṯ", "traducao_palavra": "casa" },
        { "hebraico": "וְנָפַ֣חְתִּי", "transliteral": "wə-nā-p̄aḥ-tî", "traducao_palavra": "eu assoprei" },
        { "hebraico": "בֹ֑ו", "transliteral": "ḇô", "traducao_palavra": "nele." },
        { "hebraico": "יַ֣עַן", "transliteral": "ya-ʿan", "traducao_palavra": "Por causa de" },
        { "hebraico": "מֶ֗ה", "transliteral": "meh", "traducao_palavra": "quê?" },
        { "hebraico": "נְאֻם֙", "transliteral": "nə-ʾum", "traducao_palavra": "declaração de" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹ֔ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "dos Exércitos:" },
        { "hebraico": "יַ֣עַן", "transliteral": "ya-ʿan", "traducao_palavra": "Por causa de" },
        { "hebraico": "בֵּיתִ֞י", "transliteral": "bê-ṯî", "traducao_palavra": "minha casa" },
        { "hebraico": "אֲשֶׁר־ה֣וּא", "transliteral": "ʾă-šer-hû", "traducao_palavra": "que ela está" },
        { "hebraico": "חָרֵ֔ב", "transliteral": "ḥā-rêḇ", "traducao_palavra": "em ruínas" },
        { "hebraico": "וְאַתֶּ֥ם", "transliteral": "wə-ʾat-tem", "traducao_palavra": "enquanto vós" },
        { "hebraico": "רָצִ֖ים", "transliteral": "rā-ṣîm", "traducao_palavra": "correis" },
        { "hebraico": "אִ֥ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada um" },
        { "hebraico": "לְבֵיתֹֽו׃", "transliteral": "lə-ḇê-ṯô", "traducao_palavra": "à sua própria casa." }
      ]
    },
    "10": {
      "traducao_completa": "Por isso os céus retiveram o seu orvalho de cima de vós, e a terra reteve os seus frutos.",
      "palavras": [
        { "hebraico": "עַל־כֵּ֣ן", "transliteral": "ʿal-kên", "traducao_palavra": "por isso" },
        { "hebraico": "עֲלֵיכֶ֔ם", "transliteral": "ʿă-lê-ḵem", "traducao_palavra": "sobre vós/por vossa causa" },
        { "hebraico": "כָּלְא֥וּ", "transliteral": "kā-lə-ʾû", "traducao_palavra": "reteram" },
        { "hebraico": "שָׁמַ֖יִם", "transliteral": "šā-ma-yim", "traducao_palavra": "os céus" },
