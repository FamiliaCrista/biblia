        { "hebraico": "בְּיֹ֥ום", "transliteral": "bə-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "אֶחָ֖ד", "transliteral": "ʾe-ḥāḏ", "traducao_palavra": "primeiro" },
        { "hebraico": "לַחֹ֑דֶשׁ", "transliteral": "la-ḥō-ḏeš", "traducao_palavra": "do mês" },
        { "hebraico": "הָיָ֨ה", "transliteral": "hā-yā", "traducao_palavra": "veio" },
        { "hebraico": "דְבַר־יְהוָ֜ה", "transliteral": "də-ḇar-YHWH", "traducao_palavra": "a palavra de YHWH" },
        { "hebraico": "בְּיַד־חַגַּ֣י", "transliteral": "bə-yaḏ-ḥag-gay", "traducao_palavra": "por intermédio de Ageu" },
        { "hebraico": "הַנָּבִ֗יא", "transliteral": "han-nā-ḇî", "traducao_palavra": "o profeta" },
