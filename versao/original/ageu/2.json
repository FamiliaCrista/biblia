        { "hebraico": "לְפָנַי֙", "transliteral": "lə-p̄ā-nay", "traducao_palavra": "diante de mim" },
        { "hebraico": "נְאֻם־יְהוָ֔ה", "transliteral": "nə-ʾum-YHWH", "traducao_palavra": "declaração de YHWH;" },
