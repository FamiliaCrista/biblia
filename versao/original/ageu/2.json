        { "hebraico": "בַּשְּׁבִיעִ֕י", "transliteral": "baš-šə-ḇî-ʿî", "traducao_palavra": "no sétimo [mês]" },
        { "hebraico": "בְּעֶשְׂרִ֥ים", "transliteral": "bə-ʿeś-rîm", "traducao_palavra": "no vigésimo" },
        { "hebraico": "וְאֶחָ֖ד", "transliteral": "wə-ʾe-ḥāḏ", "traducao_palavra": "e primeiro [dia]" },
        { "hebraico": "לַחֹ֑דֶשׁ", "transliteral": "la-ḥō-ḏeš", "traducao_palavra": "do mês" },
        { "hebraico": "הָיָה֙", "transliteral": "hā-yā", "traducao_palavra": "veio" },
