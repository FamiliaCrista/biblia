        { "hebraico": "יִשָּׂא־אִ֣ישׁ", "transliteral": "yiś-śā-ʾîš", "traducao_palavra": "levar alguém" },
        { "hebraico": "בְּשַׂר־קֹדֶשׁ֮", "transliteral": "bə-śar-qō-ḏeš", "traducao_palavra": "carne santa" },
