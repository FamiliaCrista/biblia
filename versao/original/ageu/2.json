        { "hebraico": "וְאֶל־שְׁאֵרִ֥ית", "transliteral": "wə-ʾel-šə-ʾê-rîṯ", "traducao_palavra": "e ao restante de" },
        { "hebraico": "הָעָ֖ם", "transliteral": "hā-ʿām", "traducao_palavra": "o povo" },
        { "hebraico": "לֵאמֹֽר׃", "transliteral": "lê-mōr", "traducao_palavra": "dizendo:" }
