        { "hebraico": "לֵאמֹֽר׃", "transliteral": "lê-mōr", "traducao_palavra": "dizendo:" }
      ]
    },
    "2": {
      "traducao_completa": "Fala agora a Zorobabel, filho de Salatiel, governador de Judá, e a Josué, filho de Jeozadaque, o sumo sacerdote, e ao restante do povo, dizendo:",
