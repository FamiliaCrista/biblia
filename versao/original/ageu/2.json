        { "hebraico": "כָּל־מַעֲשֵׂ֣ה", "transliteral": "kāl-ma-ʿă-śêh", "traducao_palavra": "toda a obra de" },
        { "hebraico": "יְדֵיהֶ֑ם", "transliteral": "yə-ḏê-hem", "traducao_palavra": "suas mãos;" },
        { "hebraico": "וַאֲשֶׁ֥ר", "transliteral": "wa-ʾă-šer", "traducao_palavra": "e o que" },
