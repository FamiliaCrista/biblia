        { "hebraico": "וְאֶל־הַיַּ֧יִן", "transliteral": "wə-ʾel-hay-ya-yin", "traducao_palavra": "ou no vinho" },
        { "hebraico": "וְאֶל־שֶׁ֛מֶן", "transliteral": "wə-ʾel-še-men", "traducao_palavra": "ou no azeite" },
        { "hebraico": "וְאֶל־כָּל־מַאֲכָ֖ל", "transliteral": "wə-ʾel-kāl-ma-ʾă-ḵāl", "traducao_palavra": "ou em qualquer mantimento" },
        { "hebraico": "הֲיִקְדָּ֑שׁ", "transliteral": "hă-yiq-dāš", "traducao_palavra": "acaso ficará santificado?" },
        { "hebraico": "וַיַּעֲנ֧וּ", "transliteral": "way-ya-ʿă-nû", "traducao_palavra": "e responderam" },
