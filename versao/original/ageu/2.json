    "3": {
      "traducao_completa": "Quem há entre vós que, tendo ficado, viu esta casa na sua primeira glória? E como a vedes agora? Não é esta como nada em vossos olhos, comparada com aquela?",
      "palavras": [
        { "hebraico": "מִ֤י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "בָכֶם֙", "transliteral": "ḇā-ḵem", "traducao_palavra": "há entre vós" },
        { "hebraico": "הַנִּשְׁאָ֔ר", "transliteral": "han-niš-ʾār", "traducao_palavra": "que restou" },
        { "hebraico": "אֲשֶׁ֤ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "רָאָה֙", "transliteral": "rā-ʾā", "traducao_palavra": "viu" },
        { "hebraico": "אֶת־הַבַּ֣יִת", "transliteral": "ʾeṯ-hab-ba-yiṯ", "traducao_palavra": "a casa" },
        { "hebraico": "הַזֶּ֔ה", "transliteral": "haz-zeh", "traducao_palavra": "esta" },
        { "hebraico": "בִּכְבֹודֹ֖ו", "transliteral": "biḵ-ḇô-ḏô", "traducao_palavra": "na sua glória" },
        { "hebraico": "הָרִאשֹׁ֑ון", "transliteral": "hā-ri-šôn", "traducao_palavra": "primeira?" },
        { "hebraico": "וּמָ֨ה", "transliteral": "ū-māh", "traducao_palavra": "e como" },
        { "hebraico": "אַתֶּ֤ם", "transliteral": "ʾat-tem", "traducao_palavra": "vós" },
        { "hebraico": "רֹאִים֙", "transliteral": "rō-ʾîm", "traducao_palavra": "vedes" },
        { "hebraico": "אֹתֹ֣ו", "transliteral": "ʾō-ṯô", "traducao_palavra": "a ela" },
        { "hebraico": "עַ֔תָּה", "transliteral": "ʿat-tā", "traducao_palavra": "agora?" },
        { "hebraico": "הֲלֹ֥וא", "transliteral": "hă-lô", "traducao_palavra": "porventura não [é]" },
        { "hebraico": "כָמֹ֛הוּ", "transliteral": "ḵā-mō-hū", "traducao_palavra": "como ela" },
        { "hebraico": "כְּאַ֖יִן", "transliteral": "kə-ʾa-yin", "traducao_palavra": "como nada" },
        { "hebraico": "בְּעֵינֵיכֶֽם׃", "transliteral": "bə-ʿê-nê-ḵem", "traducao_palavra": "aos vossos olhos?" }
      ]
    },
