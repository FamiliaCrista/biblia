        { "hebraico": "וַחֲזַ֨ק", "transliteral": "wa-ḥă-zaq", "traducao_palavra": "e sede fortes" },
        { "hebraico": "כָּל־עַ֥ם", "transliteral": "kāl-ʿam", "traducao_palavra": "todo o povo de" },
