        { "hebraico": "הַכֹּהֲנִ֛ים", "transliteral": "hak-kō-hă-nîm", "traducao_palavra": "os sacerdotes" },
        { "hebraico": "וַיֹּאמְר֖וּ", "transliteral": "way-yō-mə-rû", "traducao_palavra": "e disseram:" },
        { "hebraico": "יִטְמָֽא׃", "transliteral": "yiṭ-mā", "traducao_palavra": "Ficará imundo." }
      ]
