        { "hebraico": "וְאֶל־יְהֹושֻׁ֥עַ", "transliteral": "wə-ʾel-yə-hô-šu-aʿ", "traducao_palavra": "e a Josué" },
        { "hebraico": "בֶּן־יְהֹוצָדָ֖ק", "transliteral": "ben-yə-hô-ṣā-ḏāq", "traducao_palavra": "filho de Jeozadaque" },
