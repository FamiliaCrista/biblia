        { "hebraico": "עָרֹ֛ות", "transliteral": "ʿā-rôṯ", "traducao_palavra": "desnudando" },
        { "hebraico": "יְסֹ֥וד", "transliteral": "yə-sôḏ", "traducao_palavra": "o alicerce" },
