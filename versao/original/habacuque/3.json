    "19": {
      "traducao_completa": "YHWH, o Senhor, é a minha força, e fará os meus pés como os das corças, e me fará andar sobre os meus lugares altos. (Para o cantor-mor sobre os meus instrumentos de corda).",
      "palavras": [
        { "hebraico": "יְהוִ֤ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֲדֹנָי֙", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor é" },
        { "hebraico": "חֵילִ֔י", "transliteral": "ḥê-lî", "traducao_palavra": "a minha força," },
        { "hebraico": "וַיָּ֤שֶׂם", "transliteral": "way-yā-śem", "traducao_palavra": "e fará" },
        { "hebraico": "רַגְלַי֙", "transliteral": "raḡ-lay", "traducao_palavra": "os meus pés" },
        { "hebraico": "כָּֽאַיָּלֹ֔ות", "transliteral": "kā-ʾay-yā-lôṯ", "traducao_palavra": "como os das corças," },
        { "hebraico": "וְעַ֥ל", "transliteral": "wə-ʿal", "traducao_palavra": "e sobre" },
        { "hebraico": "בָּמֹותַ֖י", "transliteral": "bā-mô-ṯay", "traducao_palavra": "os meus lugares altos" },
        { "hebraico": "יַדְרִכֵ֑נִי", "transliteral": "yaḏ-rî-ḵê-nî", "traducao_palavra": "me fará andar." },
        { "hebraico": "לַמְנַצֵּ֖חַ", "transliteral": "lam-naṣ-ṣê-aḥ", "traducao_palavra": "Ao mestre de canto," },
        { "hebraico": "בִּנְגִינֹותָֽי׃", "transliteral": "bin-ḡî-nô-ṯāy", "traducao_palavra": "sobre os meus instrumentos de corda." }
      ]
    }
