    "14": {
      "traducao_completa": "Traspassaste com as suas próprias lanças a cabeça dos seus guerreiros, que vinham como turbilhão para me dispersarem; o seu regozijo era como o de devorar o pobre em segredo.",
      "palavras": [
        { "hebraico": "נָקַ֤בְתָּ", "transliteral": "nā-qaḇ-tā", "traducao_palavra": "traspassaste" },
        { "hebraico": "בְמַטָּיו֙", "transliteral": "ḇə-maṭ-ṭāyw", "traducao_palavra": "com as suas próprias lanças" },
        { "hebraico": "רֹ֣אשׁ", "transliteral": "rōš", "traducao_palavra": "a cabeça dos" },
        { "hebraico": "פְּרָזָ֔יו", "transliteral": "pə-rā-zāyw", "traducao_palavra": "seus chefes/guerreiros," },
        { "hebraico": "יִסְעֲר֖וּ", "transliteral": "yis-ʿă-rû", "traducao_palavra": "que vinham como turbilhão" },
        { "hebraico": "לַהֲפִיצֵ֑נִי", "transliteral": "la-hă-p̄î-ṣê-nî", "traducao_palavra": "para me dispersarem;" },
        { "hebraico": "עֲלִ֣יצֻתָ֔ם", "transliteral": "ʿă-lî-ṣu-ṯām", "traducao_palavra": "o seu júbilo era" },
        { "hebraico": "כְּמֹו־לֶאֱכֹ֥ל", "transliteral": "kə-mô-le-ʾĕ-ḵōl", "traducao_palavra": "como o de devorar" },
        { "hebraico": "עָנִ֖י", "transliteral": "ʿā-nî", "traducao_palavra": "o aflito/pobre" },
        { "hebraico": "בַּמִּסְתָּֽר׃", "transliteral": "bam-mis-tār", "traducao_palavra": "em oculto/segredo." }
      ]
    },
    "15": {
      "traducao_completa": "Marchaste pelo mar com os teus cavalos, pela massa de grandes águas.",
      "palavras": [
        { "hebraico": "דָּרַ֥כְתָּ", "transliteral": "dā-raḵ-tā", "traducao_palavra": "marchaste" },
        { "hebraico": "בַיָּ֖ם", "transliteral": "ḇay-yām", "traducao_palavra": "pelo mar com" },
        { "hebraico": "סוּסֶ֑יךָ", "transliteral": "sū-se-ḵā", "traducao_palavra": "os teus cavalos," },
        { "hebraico": "חֹ֖מֶר", "transliteral": "ḥō-mer", "traducao_palavra": "pelo montão/massa de" },
        { "hebraico": "מַ֥יִם", "transliteral": "ma-yim", "traducao_palavra": "águas" },
        { "hebraico": "רַבִּֽים׃", "transliteral": "rab-bîm", "traducao_palavra": "muitas." }
      ]
    },
    "16": {
      "traducao_completa": "Ouvi, e o meu ventre se comoveu; à sua voz tremeram os meus lábios; entrou a podridão nos meus ossos, e estremeci dentro de mim; descansarei no dia da angústia, quando subir contra o povo aquele que o invadirá.",
      "palavras": [
        { "hebraico": "שָׁמַ֣עְתִּי", "transliteral": "šā-maʿ-tî", "traducao_palavra": "ouvi," },
        { "hebraico": "וַתִּרְגַּ֣ז", "transliteral": "wat-tir-gaz", "traducao_palavra": "e estremeceu" },
        { "hebraico": "בִּטְנִ֗י", "transliteral": "biṭ-nî", "traducao_palavra": "o meu ventre;" },
        { "hebraico": "לְקֹול֙", "transliteral": "lə-qôl", "traducao_palavra": "ao som," },
        { "hebraico": "צָלֲל֣וּ", "transliteral": "ṣā-lă-lû", "traducao_palavra": "tremeram" },
        { "hebraico": "שְׂפָתַ֔י", "transliteral": "śə-p̄ā-ṯay", "traducao_palavra": "os meus lábios;" },
        { "hebraico": "יָבֹ֥וא", "transliteral": "yā-ḇô", "traducao_palavra": "entrou" },
        { "hebraico": "רָקָ֛ב", "transliteral": "rā-qāḇ", "traducao_palavra": "podridão" },
        { "hebraico": "בַּעֲצָמַ֖י", "transliteral": "ba-ʿă-ṣā-may", "traducao_palavra": "nos meus ossos," },
        { "hebraico": "וְתַחְתַּ֣י", "transliteral": "wə-ṯaḥ-tay", "traducao_palavra": "e debaixo de mim mesmo" },
        { "hebraico": "אֶרְגָּ֑ז", "transliteral": "ʾer-gāz", "traducao_palavra": "estremeci;" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "contudo" },
        { "hebraico": "אָנ֣וּחַ", "transliteral": "ʾā-nū-aḥ", "traducao_palavra": "descansarei" },
        { "hebraico": "לְיֹ֣ום", "transliteral": "lə-yôm", "traducao_palavra": "no dia da" },
        { "hebraico": "צָרָ֗ה", "transliteral": "ṣā-rā", "traducao_palavra": "angústia," },
        { "hebraico": "לַעֲלֹ֥ות", "transliteral": "la-ʿă-lôṯ", "traducao_palavra": "quando subir" },
        { "hebraico": "לְעַ֖ם", "transliteral": "lə-ʿam", "traducao_palavra": "contra o povo aquele que" },
        { "hebraico": "יְגוּדֶֽנּוּ׃", "transliteral": "yə-ḡū-ḏen-nū", "traducao_palavra": "o acometerá com tropas." }
      ]
    },
    "17": {
      "traducao_completa": "Porque, ainda que a figueira não floresça, nem haja fruto nas videiras; ainda que o produto da oliveira minta, e os campos não produzam mantimento; as ovelhas da malhada sejam arrebatadas, e nos currais não haja gado;",
      "palavras": [
        { "hebraico": "כִּֽי־תְאֵנָ֣ה", "transliteral": "kî-ṯə-ʾê-nā", "traducao_palavra": "porque ainda que a figueira" },
        { "hebraico": "לֹֽא־תִפְרָ֗ח", "transliteral": "lō-ṯip̄-rāḥ", "traducao_palavra": "não floresça," },
        { "hebraico": "וְאֵ֤ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não haja" },
        { "hebraico": "יְבוּל֙", "transliteral": "yə-ḇūl", "traducao_palavra": "fruto" },
        { "hebraico": "בַּגְּפָנִ֔ים", "transliteral": "bag-gə-p̄ā-nîm", "traducao_palavra": "nas videiras;" },
        { "hebraico": "כִּחֵשׁ֙", "transliteral": "ki-ḥêš", "traducao_palavra": "falhe" },
        { "hebraico": "מַעֲשֵׂה־זַ֔יִת", "transliteral": "ma-ʿă-śêh-za-yiṯ", "traducao_palavra": "o produto da oliveira," },
        { "hebraico": "וּשְׁדֵמֹ֖ות", "transliteral": "ū-šə-ḏê-môṯ", "traducao_palavra": "e os campos" },
        { "hebraico": "לֹא־עָ֣שׂוּ", "transliteral": "lō-ʿā-śû", "traducao_palavra": "não produzam" },
        { "hebraico": "אֹ֑כֶל", "transliteral": "ʾō-ḵel", "traducao_palavra": "mantimento;" },
        { "hebraico": "גָּזַ֤ר", "transliteral": "gā-zar", "traducao_palavra": "sejam arrebatadas" },
        { "hebraico": "מִמִּכְלָה֙", "transliteral": "mim-miḵ-lā", "traducao_palavra": "do aprisco" },
        { "hebraico": "צֹ֔אן", "transliteral": "ṣōn", "traducao_palavra": "as ovelhas," },
        { "hebraico": "וְאֵ֥ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não haja" },
        { "hebraico": "בָּקָ֖ר", "transliteral": "bā-qār", "traducao_palavra": "gado" },
        { "hebraico": "בָּרְפָתִֽים׃", "transliteral": "bā-rə-p̄ā-ṯîm", "traducao_palavra": "nos currais;" }
      ]
    },
