        { "hebraico": "תָּפ֛וּשׂ", "transliteral": "tā-p̄ūś", "traducao_palavra": "está coberta de" },
        { "hebraico": "זָהָ֥ב", "transliteral": "zā-hāḇ", "traducao_palavra": "ouro" },
