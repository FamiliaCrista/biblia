    "10": {
      "traducao_completa": "Mas eu te oferecerei sacrifício com a voz do agradecimento; o que votei pagarei; de YHWH vem a salvação.",
      "palavras": [
        { "hebraico": "וַאֲנִ֗י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "mas eu" },
        { "hebraico": "בְּקֹ֤ול", "transliteral": "bə-qôl", "traducao_palavra": "com a voz de" },
        { "hebraico": "תֹּודָה֙", "transliteral": "tô-ḏā", "traducao_palavra": "ação de graças" },
        { "hebraico": "אֶזְבְּחָה־לָּ֔ךְ", "transliteral": "ʾez-bə-ḥā-llāḵ", "traducao_palavra": "sacrificarei a ti" },
