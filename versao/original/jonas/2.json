        { "hebraico": "נָדַ֖רְתִּי", "transliteral": "nā-ḏar-tî", "traducao_palavra": "fiz em voto" },
        { "hebraico": "אֲשַׁלֵּ֑מָה", "transliteral": "ʾă-šal-lê-mā", "traducao_palavra": "cumprirei" },
        { "hebraico": "יְשׁוּעָ֥תָה", "transliteral": "yə-šū-ʿā-ṯā", "traducao_palavra": "a salvação pertence" },
        { "hebraico": "לַיהוָֽה׃", "transliteral": "la-YHWH", "traducao_palavra": "a YHWH" }
      ]
    },
    "11": {
      "traducao_completa": "Falou, pois, YHWH ao peixe, e ele vomitou a Jonas na terra seca.",
      "palavras": [
        { "hebraico": "וַיֹּ֥אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e ordenou/falou" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "לַדָּ֑ג", "transliteral": "lad-dāḡ", "traducao_palavra": "ao peixe" },
        { "hebraico": "וַיָּקֵ֥א", "transliteral": "way-yā-qê", "traducao_palavra": "e ele vomitou" },
