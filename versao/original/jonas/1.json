        { "hebraico": "וְאַל־תִּתֵּ֥ן", "transliteral": "wə-ʾal-tit-tên", "traducao_palavra": "e não ponhas" },
        { "hebraico": "עָלֵ֖ינוּ", "transliteral": "ʿā-lê-nû", "traducao_palavra": "sobre nós" },
        { "hebraico": "דָּ֣ם", "transliteral": "dām", "traducao_palavra": "sangue" },
