        { "hebraico": "אָ֔נִי", "transliteral": "ʾā-nî", "traducao_palavra": "eu" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "בְשֶׁלִּ֔י", "transliteral": "ḇə-šel-lî", "traducao_palavra": "por minha causa" },
