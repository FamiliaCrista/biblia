    "10": {
      "traducao_completa": "Então os homens se encheram de grande temor e disseram-lhe: Que é isto que fizeste? Pois sabiam os homens que ele fugia de diante de YHWH, porque ele lho havia declarado.",
      "palavras": [
        { "hebraico": "וַיִּֽירְא֤וּ", "transliteral": "way-yî-rə-ʾû", "traducao_palavra": "e temeram" },
