    "8": {
      "traducao_completa": "Então lhe disseram: Declara-nos agora, por causa de quem nos sobreveio este mal? Que ocupação é a tua? Donde vens? Qual é a tua terra? E de que povo és tu?",
      "palavras": [
        { "hebraico": "וַיֹּאמְר֣וּ", "transliteral": "way-yō-mə-rû", "traducao_palavra": "então disseram" },
