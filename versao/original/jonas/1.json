        { "hebraico": "הַגִּידָה־נָּ֣א", "transliteral": "hag-gî-ḏā-nnā", "traducao_palavra": "declara-nos, pedimos-te" },
        { "hebraico": "לָ֔נוּ", "transliteral": "lā-nû", "traducao_palavra": "a nós" },
        { "hebraico": "בַּאֲשֶׁ֛ר", "transliteral": "ba-ʾă-šer", "traducao_palavra": "por causa de" },
        { "hebraico": "לְמִי־הָרָעָ֥ה", "transliteral": "lə-mî-hā-rā-ʿā", "traducao_palavra": "quem [veio] este mal" },
        { "hebraico": "הַזֹּ֖את", "transliteral": "haz-zōṯ", "traducao_palavra": "este" },
        { "hebraico": "לָ֑נוּ", "transliteral": "lā-nû", "traducao_palavra": "a nós?" },
        { "hebraico": "מַה־מְּלַאכְתְּךָ֙", "transliteral": "mah-mə-laḵ-tə-ḵā", "traducao_palavra": "qual é a tua ocupação?" },
