        { "hebraico": "תָּבֹ֔וא", "transliteral": "tā-ḇô", "traducao_palavra": "vens?" },
        { "hebraico": "מָ֣ה", "transliteral": "māh", "traducao_palavra": "qual é" },
        { "hebraico": "אַרְצֶ֔ךָ", "transliteral": "ʾar-ṣe-ḵā", "traducao_palavra": "a tua terra?" },
