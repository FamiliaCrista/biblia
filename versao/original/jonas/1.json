        { "hebraico": "גְדֹולָ֔ה", "transliteral": "gə-ḏô-lā", "traducao_palavra": "grande" },
        { "hebraico": "וַיֹּאמְר֥וּ", "transliteral": "way-yō-mə-rû", "traducao_palavra": "e disseram" },
        { "hebraico": "אֵלָ֖יו", "transliteral": "ʾê-lāyw", "traducao_palavra": "a ele:" },
