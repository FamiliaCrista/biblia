        { "hebraico": "הַיָּם֙", "transliteral": "hay-yām", "traducao_palavra": "o mar" },
        { "hebraico": "מֵֽעָלֵ֔ינוּ", "transliteral": "mê-ʿā-lê-nû", "traducao_palavra": "de sobre nós?" },
