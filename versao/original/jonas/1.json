        { "hebraico": "וַיַּפִּ֙לוּ֙", "transliteral": "way-yap-pî-lû", "traducao_palavra": "e lançaram" },
        { "hebraico": "גֹּֽורָלֹ֔ות", "transliteral": "gô-rā-lôṯ", "traducao_palavra": "sortes" },
        { "hebraico": "וַיִּפֹּ֥ל", "transliteral": "way-yip-pōl", "traducao_palavra": "e caiu" },
