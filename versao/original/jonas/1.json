        { "hebraico": "עָשִׂ֑יתָ", "transliteral": "ʿā-śî-ṯā", "traducao_palavra": "fizeste?" },
        { "hebraico": "כִּֽי־יָדְע֣וּ", "transliteral": "kî-yā-ḏə-ʿû", "traducao_palavra": "porque sabiam" },
        { "hebraico": "הָאֲנָשִׁ֗ים", "transliteral": "hā-ʾă-nā-šîm", "traducao_palavra": "os homens" },
        { "hebraico": "כִּֽי־מִלִּפְנֵ֤י", "transliteral": "kî-mil-lip̄-nê", "traducao_palavra": "que de diante de" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "ה֣וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "בֹרֵ֔חַ", "transliteral": "ḇō-rê-aḥ", "traducao_palavra": "estava fugindo" },
