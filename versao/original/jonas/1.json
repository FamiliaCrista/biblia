        { "hebraico": "אָֽתָּה׃", "transliteral": "ʾāt-tā", "traducao_palavra": "és tu?" }
      ]
    },
    "9": {
      "traducao_completa": "E ele lhes respondeu: Eu sou hebreu, e temo a YHWH, o Deus do céu, que fez o mar e a terra seca.",
