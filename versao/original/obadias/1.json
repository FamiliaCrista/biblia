        { "hebraico": "אַנְשֵׁ֖י", "transliteral": "ʾan-šê", "traducao_palavra": "os homens de" },
        { "hebraico": "שְׁלֹמֶ֑ךָ", "transliteral": "šə-lō-me-ḵā", "traducao_palavra": "tua paz" },
        { "hebraico": "לַחְמְךָ֗", "transliteral": "laḥ-mə-ḵā", "traducao_palavra": "[os que comem] o teu pão" },
        { "hebraico": "יָשִׂ֤ימוּ", "transliteral": "yā-śî-mū", "traducao_palavra": "puseram" },
