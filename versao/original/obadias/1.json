        { "hebraico": "שִׁבְתֹּ֑ו", "transliteral": "šiḇ-tô", "traducao_palavra": "sua morada" },
        { "hebraico": "אֹמֵ֣ר", "transliteral": "ʾō-mêr", "traducao_palavra": "que dizes" },
        { "hebraico": "בְּלִבֹּ֔ו", "transliteral": "bə-lib-bô", "traducao_palavra": "no seu coração:" },
        { "hebraico": "מִ֥י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "יֹורִדֵ֖נִי", "transliteral": "yô-ri-ḏê-nî", "traducao_palavra": "me fará descer/derrubará" },
        { "hebraico": "אָֽרֶץ׃", "transliteral": "ʾā-reṣ", "traducao_palavra": "em terra?" }
      ]
    },
    "4": {
      "traducao_completa": "Se te elevares como a águia, e se puseres o teu ninho entre as estrelas, dali te derrubarei, diz YHWH.",
      "palavras": [
        { "hebraico": "אִם־תַּגְבִּ֣יהַּ", "transliteral": "ʾim-taḡ-bî-ah", "traducao_palavra": "se te remontares tão alto" },
        { "hebraico": "כַּנֶּ֔שֶׁר", "transliteral": "kan-ne-šer", "traducao_palavra": "como a águia" },
