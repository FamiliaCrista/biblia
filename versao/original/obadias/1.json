  "versiculos": {
    "1": {
      "traducao_completa": "Visão de Obadias. Assim diz o Senhor YHWH a respeito de Edom: Temos ouvido uma mensagem de YHWH, e um embaixador foi enviado entre as nações, dizendo: Levantai-vos, e levantemo-nos contra ela para a guerra.",
      "palavras": [
        { "hebraico": "חֲזֹ֖ון", "transliteral": "ḥă-zôn", "traducao_palavra": "a visão de" },
        { "hebraico": "עֹבַדְיָ֑ה", "transliteral": "ʿō-ḇaḏ-yā", "traducao_palavra": "Obadias" },
        { "hebraico": "כֹּֽה־אָמַ֩ר", "transliteral": "kōh-ʾā-mar", "traducao_palavra": "assim diz" },
        { "hebraico": "אֲדֹנָ֨י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִ֜ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "לֶאֱדֹ֗ום", "transliteral": "le-ʾĕ-ḏôm", "traducao_palavra": "a respeito de Edom:" },
        { "hebraico": "שְׁמוּעָ֨ה", "transliteral": "šə-mū-ʿā", "traducao_palavra": "uma mensagem/notícia" },
        { "hebraico": "שָׁמַ֜עְנוּ", "transliteral": "šā-maʿ-nû", "traducao_palavra": "ouvimos" },
        { "hebraico": "מֵאֵ֤ת", "transliteral": "mê-ʾêṯ", "traducao_palavra": "de parte de" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וְצִיר֙", "transliteral": "wə-ṣîr", "traducao_palavra": "e um embaixador/mensageiro" },
        { "hebraico": "בַּגֹּויִ֣ם", "transliteral": "bag-gô-yim", "traducao_palavra": "entre as nações" },
        { "hebraico": "שֻׁלָּ֔ח", "transliteral": "šul-lāḥ", "traducao_palavra": "foi enviado:" },
        { "hebraico": "ק֛וּמוּ", "transliteral": "qū-mû", "traducao_palavra": "levantai-vos" },
        { "hebraico": "וְנָק֥וּמָה", "transliteral": "wə-nā-qū-mā", "traducao_palavra": "e levantemo-nos" },
        { "hebraico": "עָלֶ֖יהָ", "transliteral": "ʿā-le-hā", "traducao_palavra": "contra ela" },
        { "hebraico": "לַמִּלְחָמָֽה׃", "transliteral": "lam-mil-ḥā-mā", "traducao_palavra": "para a guerra" }
      ]
    },
    "2": {
      "traducao_completa": "Eis que te fiz pequeno entre as nações; tu és muito desprezado.",
      "palavras": [
        { "hebraico": "הִנֵּ֥ה", "transliteral": "hin-nêh", "traducao_palavra": "eis que" },
        { "hebraico": "קָטֹ֛ן", "transliteral": "qā-ṭōn", "traducao_palavra": "pequeno" },
        { "hebraico": "נְתַתִּ֖יךָ", "transliteral": "nə-ṯat-tî-ḵā", "traducao_palavra": "te pus/fiz" },
        { "hebraico": "בַּגֹּויִ֑ם", "transliteral": "bag-gô-yim", "traducao_palavra": "entre as nações" },
        { "hebraico": "בָּז֥וּי", "transliteral": "bā-zūy", "traducao_palavra": "desprezado" },
        { "hebraico": "אַתָּ֖ה", "transliteral": "ʾat-tā", "traducao_palavra": "és tu" },
        { "hebraico": "מְאֹֽד׃", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" }
      ]
