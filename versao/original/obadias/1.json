    "3": {
      "traducao_completa": "A soberba do teu coração te enganou, ó tu que habitas nas fendas das rochas, na tua alta morada, que dizes no teu coração: Quem me derrubará em terra?",
      "palavras": [
        { "hebraico": "זְדֹ֤ון", "transliteral": "zə-ḏôn", "traducao_palavra": "a presunção/soberba de" },
        { "hebraico": "לִבְּךָ֙", "transliteral": "lib-bə-ḵā", "traducao_palavra": "teu coração" },
        { "hebraico": "הִשִּׁיאֶ֔ךָ", "transliteral": "hiš-šî-ʾe-ḵā", "traducao_palavra": "te enganou" },
        { "hebraico": "שֹׁכְנִ֥י", "transliteral": "šō-ḵə-nî", "traducao_palavra": "ó tu que habitas" },
        { "hebraico": "בְחַגְוֵי־סֶּ֖לַע", "transliteral": "bə-ḥaḡ-wê-se-laʿ", "traducao_palavra": "nas fendas dos penhascos" },
