        { "hebraico": "קִנֶּ֑ךָ", "transliteral": "qin-ne-ḵā", "traducao_palavra": "o teu ninho" },
        { "hebraico": "מִשָּׁ֥ם", "transliteral": "miš-šām", "traducao_palavra": "dali" },
        { "hebraico": "אֹורִֽידְךָ֖", "transliteral": "ʾô-rî-ḏə-ḵā", "traducao_palavra": "te derrubarei" },
        { "hebraico": "נְאֻם־יְהוָֽה׃", "transliteral": "nə-ʾum-YHWH", "traducao_palavra": "declaração de YHWH" }
      ]
    },
    "5": {
      "traducao_completa": "Se viessem a ti ladrões, ou salteadores de noite (como estás destruído!), não furtariam o que lhes bastasse? Se a ti viessem os vindimadores, não deixariam alguns cachos?",
      "palavras": [
        { "hebraico": "אִם־גַּנָּבִ֤ים", "transliteral": "ʾim-gan-nā-ḇîm", "traducao_palavra": "se ladrões" },
        { "hebraico": "בָּאֽוּ־לְךָ֙", "transliteral": "bā-ʾū-lə-ḵā", "traducao_palavra": "viessem a ti" },
        { "hebraico": "אִם־שֹׁ֣ודְדֵי", "transliteral": "ʾim-šô-ḏə-ḏê", "traducao_palavra": "ou salteadores de" },
        { "hebraico": "לַ֔יְלָה", "transliteral": "lay-lā", "traducao_palavra": "noite" },
        { "hebraico": "אֵ֣יךְ", "transliteral": "ʾêḵ", "traducao_palavra": "como" },
        { "hebraico": "נִדְמֵ֔יתָה", "transliteral": "nid-mê-ṯā", "traducao_palavra": "foste desolado/destruído!" },
        { "hebraico": "הֲלֹ֥וא", "transliteral": "hă-lô", "traducao_palavra": "porventura não" },
        { "hebraico": "יִגְנְב֖וּ", "transliteral": "yiḡ-nə-ḇû", "traducao_palavra": "furtariam" },
        { "hebraico": "דַּיָּ֑ם", "transliteral": "day-yām", "traducao_palavra": "o que lhes bastava?" },
        { "hebraico": "אִם־בֹּֽצְרִים֙", "transliteral": "ʾim-bō-ṣə-rîm", "traducao_palavra": "se vindimadores" },
        { "hebraico": "בָּ֣אוּ", "transliteral": "bā-ʾû", "traducao_palavra": "viessem" },
        { "hebraico": "לָ֔ךְ", "transliteral": "lāḵ", "traducao_palavra": "a ti" },
        { "hebraico": "הֲלֹ֖וא", "transliteral": "hă-lô", "traducao_palavra": "porventura não" },
        { "hebraico": "יַשְׁאִ֥ירוּ", "transliteral": "yaš-ʾî-rû", "traducao_palavra": "deixariam" },
        { "hebraico": "עֹלֵלֹֽות׃", "transliteral": "ʿō-lê-lôṯ", "traducao_palavra": "rebuscos/restos de uvas?" }
