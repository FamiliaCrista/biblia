      ]
    },
    "9": {
      "traducao_completa": "E os teus valentes, ó Temã, ficarão atemorizados, para que todo homem do monte de Esaú seja exterminado pela matança.",
      "palavras": [
        { "hebraico": "וְחַתּ֥וּ", "transliteral": "wə-ḥat-tû", "traducao_palavra": "e ficarão aterrorizados/abatidos" },
