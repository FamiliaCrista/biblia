{
  "livro": "Oséias - הוֹשֵׁעַ - Hôšēaʿ",
  "capítulo": 12,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Efraim me cercou de mentiras, e a casa de Israel, de engano; mas Judá ainda domina com Deus e com o Santo é fiel.",
      "palavras": [
        { "hebraico": "סְבָבֻ֤נִי", "transliteral": "sə-ḇā-ḇu-nî", "traducao_palavra": "cercou-me" },
        { "hebraico": "בְכַ֙חַשׁ֙", "transliteral": "ḇə-ḵa-ḥaš", "traducao_palavra": "com mentira" },
        { "hebraico": "אֶפְרַ֔יִם", "transliteral": "ʾep̄-ra-yim", "traducao_palavra": "Efraim" },
        { "hebraico": "וּבְמִרְמָ֖ה", "transliteral": "ū-ḇə-mir-mā", "traducao_palavra": "e com engano" },
        { "hebraico": "בֵּ֣ית", "transliteral": "bêṯ", "traducao_palavra": "a casa de" },
        { "hebraico": "יִשְׂרָאֵ֑ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "וִיהוּדָ֗ה", "transliteral": "wî-hū-ḏā", "traducao_palavra": "mas Judá" },
        { "hebraico": "עֹ֥ד", "transliteral": "ʿōḏ", "traducao_palavra": "ainda" },
        { "hebraico": "רָ֤ד", "transliteral": "rāḏ", "traducao_palavra": "anda/domina" },
        { "hebraico": "עִם־אֵל֙", "transliteral": "ʿim-ʾêl", "traducao_palavra": "com Deus" },
        { "hebraico": "וְעִם־קְדֹושִׁ֖ים", "transliteral": "wə-ʿim-qə-ḏô-šîm", "traducao_palavra": "e com o Santo" },
        { "hebraico": "נֶאֱמָֽן׃", "transliteral": "ne-ʾĕ-mān", "traducao_palavra": "é fiel" }
      ]
    },
    "2": {
      "traducao_completa": "Efraim apascenta o vento e persegue o vento oriental; todo o dia multiplica a mentira e a destruição; e fazem aliança com a Assíria, e o azeite se leva ao Egito.",
      "palavras": [
        { "hebraico": "אֶפְרַ֜יִם", "transliteral": "ʾep̄-ra-yim", "traducao_palavra": "Efraim" },
        { "hebraico": "רֹעֶ֥ה", "transliteral": "rō-ʿeh", "traducao_palavra": "apascenta" },
        { "hebraico": "ר֙וּחַ֙", "transliteral": "rū-aḥ", "traducao_palavra": "o vento" },
        { "hebraico": "וְרֹדֵ֣ף", "transliteral": "wə-rō-ḏêp̄", "traducao_palavra": "e persegue" },
        { "hebraico": "קָדִ֔ים", "transliteral": "qā-ḏîm", "traducao_palavra": "o vento oriental" },
        { "hebraico": "כָּל־הַיֹּ֕ום", "transliteral": "kāl-hay-yôm", "traducao_palavra": "todo o dia" },
        { "hebraico": "כָּזָ֥ב", "transliteral": "kā-zāḇ", "traducao_palavra": "mentira" },
        { "hebraico": "וָשֹׁ֖ד", "transliteral": "wā-šōḏ", "traducao_palavra": "e destruição" },
        { "hebraico": "יַרְבֶּ֑ה", "transliteral": "yar-beh", "traducao_palavra": "multiplica" },
        { "hebraico": "וּבְרִית֙", "transliteral": "ū-ḇə-rîṯ", "traducao_palavra": "e aliança" },
        { "hebraico": "עִם־אַשּׁ֣וּר", "transliteral": "ʿim-ʾaš-šūr", "traducao_palavra": "com a Assíria" },
        { "hebraico": "יִכְרֹ֔תוּ", "transliteral": "yiḵ-rō-ṯû", "traducao_palavra": "fazem" },
        { "hebraico": "וְשֶׁ֖מֶן", "transliteral": "wə-še-men", "traducao_palavra": "e azeite" },
