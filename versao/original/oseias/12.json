        { "hebraico": "יוּבָֽל׃", "transliteral": "yū-ḇāl", "traducao_palavra": "é levado" }
      ]
    },
    "3": {
      "traducao_completa": "YHWH também tem contenda com Judá, e castigará a Jacó segundo os seus caminhos; segundo as suas obras lhe retribuirá.",
      "palavras": [
        { "hebraico": "וְרִ֥יב", "transliteral": "wə-rîḇ", "traducao_palavra": "e contenda [tem]" },
        { "hebraico": "לַיהוָ֖ה", "transliteral": "la-YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "עִם־יְהוּדָ֑ה", "transliteral": "ʿim-yə-hū-ḏā", "traducao_palavra": "com Judá" },
        { "hebraico": "וְלִפְקֹ֤ד", "transliteral": "wə-lip̄-qōḏ", "traducao_palavra": "e para castigar" },
        { "hebraico": "עַֽל־יַעֲקֹב֙", "transliteral": "ʿal-ya-ʿă-qōḇ", "traducao_palavra": "a Jacó" },
