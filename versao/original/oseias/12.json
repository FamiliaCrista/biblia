        { "hebraico": "כְּנַ֗עַן", "transliteral": "kə-na-ʿan", "traducao_palavra": "[como] mercador/Canaã" },
        { "hebraico": "בְּיָדֹו֙", "transliteral": "bə-yā-ḏô", "traducao_palavra": "na sua mão [estão]" },
        { "hebraico": "מֹאזְנֵ֣י", "transliteral": "mō-zə-nê", "traducao_palavra": "balanças de" },
        { "hebraico": "מִרְמָ֔ה", "transliteral": "mir-mā", "traducao_palavra": "engano" },
        { "hebraico": "לַעֲשֹׁ֖ק", "transliteral": "la-ʿă-šōq", "traducao_palavra": "oprimir" },
        { "hebraico": "אָהֵֽב׃", "transliteral": "ʾā-hêḇ", "traducao_palavra": "ele ama" }
      ]
    },
    "9": {
      "traducao_completa": "E diz Efraim: Contudo me tenho enriquecido, e tenho adquirido para mim grandes bens; em todos os meus trabalhos não acharão em mim iniquidade alguma que seja pecado.",
      "palavras": [
        { "hebraico": "וַיֹּ֣אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e diz" },
        { "hebraico": "אֶפְרַ֔יִם", "transliteral": "ʾep̄-ra-yim", "traducao_palavra": "Efraim" },
        { "hebraico": "אַ֣ךְ", "transliteral": "ʾaḵ", "traducao_palavra": "certamente" },
        { "hebraico": "עָשַׁ֔רְתִּי", "transliteral": "ʿā-šar-tî", "traducao_palavra": "enriqueci-me" },
        { "hebraico": "מָצָ֥אתִי", "transliteral": "mā-ṣā-ṯî", "traducao_palavra": "achei/adquiri" },
        { "hebraico": "אֹ֖ון", "transliteral": "ʾôn", "traducao_palavra": "riqueza/bens" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "כָּל־יְגִיעַ֕י", "transliteral": "kāl-yə-ḡî-ʿay", "traducao_palavra": "em todos os meus trabalhos" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִמְצְאוּ־לִ֖י", "transliteral": "yim-ṣə-ʾū-lî", "traducao_palavra": "acharão em mim" },
        { "hebraico": "עָוֹ֥ן", "transliteral": "ʿā-wōn", "traducao_palavra": "iniquidade" },
        { "hebraico": "אֲשֶׁר־חֵֽטְא׃", "transliteral": "ʾă-šer-ḥêṭ", "traducao_palavra": "que seja pecado" }
      ]
    },
    "10": {
      "traducao_completa": "Mas eu sou YHWH, teu Deus, desde a terra do Egito; ainda te farei habitar em tendas, como nos dias da festa solene.",
      "palavras": [
        { "hebraico": "וְאָנֹכִ֛י", "transliteral": "wə-ʾā-nō-ḵî", "traducao_palavra": "mas eu sou" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהֶ֖יךָ", "transliteral": "ʾĕ-lō-he-ḵā", "traducao_palavra": "teu Deus" },
        { "hebraico": "מֵאֶ֣רֶץ", "transliteral": "mê-ʾe-reṣ", "traducao_palavra": "desde a terra de" },
        { "hebraico": "מִצְרָ֑יִם", "transliteral": "miṣ-rā-yim", "traducao_palavra": "Egito" },
        { "hebraico": "עֹ֛ד", "transliteral": "ʿōḏ", "traducao_palavra": "ainda" },
        { "hebraico": "אֹושִֽׁיבְךָ֥", "transliteral": "ʾô-šî-ḇə-ḵā", "traducao_palavra": "te farei habitar" },
        { "hebraico": "בָאֳהָלִ֖ים", "transliteral": "ḇā-ʾo-hā-lîm", "traducao_palavra": "em tendas" },
        { "hebraico": "כִּימֵ֥י", "transliteral": "kî-mê", "traducao_palavra": "como nos dias de" },
        { "hebraico": "מֹועֵֽד׃", "transliteral": "mô-ʿêḏ", "traducao_palavra": "assembleia/festa solene" }
      ]
    },
    "11": {
      "traducao_completa": "Falei aos profetas, e multipliquei as visões; e pelo ministério dos profetas usei de símiles.",
      "palavras": [
        { "hebraico": "וְדִבַּרְתִּי֙", "transliteral": "wə-ḏib-bar-tî", "traducao_palavra": "e falei" },
        { "hebraico": "עַל־הַנְּבִיאִ֔ים", "transliteral": "ʿal-han-nə-ḇî-ʾîm", "traducao_palavra": "aos profetas" },
        { "hebraico": "וְאָנֹכִ֖י", "transliteral": "wə-ʾā-nō-ḵî", "traducao_palavra": "e eu" },
        { "hebraico": "חָזֹ֣ון", "transliteral": "ḥā-zôn", "traducao_palavra": "visões" },
        { "hebraico": "הִרְבֵּ֑יתִי", "transliteral": "hir-bê-ṯî", "traducao_palavra": "multipliquei" },
        { "hebraico": "וּבְיַ֥ד", "transliteral": "ū-ḇə-yaḏ", "traducao_palavra": "e pela mão de" },
        { "hebraico": "הַנְּבִיאִ֖ים", "transliteral": "han-nə-ḇî-ʾîm", "traducao_palavra": "os profetas" },
        { "hebraico": "אֲדַמֶּֽה׃", "transliteral": "ʾă-ḏam-meh", "traducao_palavra": "usei de parábolas/símiles" }
      ]
    },
    "12": {
      "traducao_completa": "Não é Gileade iniquidade? Pura vaidade são eles; em Gilgal sacrificam bois; sim, os seus altares são como montões de pedras nos sulcos dos campos.",
      "palavras": [
        { "hebraico": "אִם־גִּלְעָ֥ד", "transliteral": "ʾim-gil-ʿāḏ", "traducao_palavra": "se Gileade é" },
        { "hebraico": "אָ֙וֶן֙", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" },
        { "hebraico": "אַךְ־שָׁ֣וְא", "transliteral": "ʾaḵ-šāwə", "traducao_palavra": "certamente vaidade" },
        { "hebraico": "הָי֔וּ", "transliteral": "hā-yû", "traducao_palavra": "são eles" },
        { "hebraico": "בַּגִּלְגָּ֖ל", "transliteral": "bag-gil-gāl", "traducao_palavra": "em Gilgal" },
        { "hebraico": "שְׁוָרִ֣ים", "transliteral": "šə-wā-rîm", "traducao_palavra": "bois" },
        { "hebraico": "זִבֵּ֑חוּ", "transliteral": "zib-bê-ḥû", "traducao_palavra": "sacrificam" },
        { "hebraico": "גַּ֤ם", "transliteral": "gam", "traducao_palavra": "também" },
        { "hebraico": "מִזְבְּחֹותָם֙", "transliteral": "miz-bə-ḥô-ṯām", "traducao_palavra": "os seus altares" },
        { "hebraico": "כְּגַלִּ֔ים", "transliteral": "kə-ḡal-lîm", "traducao_palavra": "[são] como montões de pedras" },
        { "hebraico": "עַ֖ל", "transliteral": "ʿal", "traducao_palavra": "sobre" },
        { "hebraico": "תַּלְמֵ֥י", "transliteral": "tal-mê", "traducao_palavra": "os sulcos de" },
        { "hebraico": "שָׂדָֽי׃", "transliteral": "śā-ḏāy", "traducao_palavra": "o campo" }
      ]
    },
    "13": {
      "traducao_completa": "Jacó fugiu para a terra da Síria, e Israel serviu por uma mulher, e por uma mulher guardou o gado.",
      "palavras": [
        { "hebraico": "וַיִּבְרַ֥ח", "transliteral": "way-yiḇ-raḥ", "traducao_palavra": "e fugiu" },
        { "hebraico": "יַעֲקֹ֖ב", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" },
        { "hebraico": "שְׂדֵ֣ה", "transliteral": "śə-ḏêh", "traducao_palavra": "ao campo de" },
        { "hebraico": "אֲרָ֑ם", "transliteral": "ʾă-rām", "traducao_palavra": "Arã/Síria" },
        { "hebraico": "וַיַּעֲבֹ֤ד", "transliteral": "way-ya-ʿă-ḇōḏ", "traducao_palavra": "e serviu" },
        { "hebraico": "יִשְׂרָאֵל֙", "transliteral": "yiś-rā-ʾêl", "traducao_palavra": "Israel" },
        { "hebraico": "בְּאִשָּׁ֔ה", "transliteral": "bə-ʾiš-šā", "traducao_palavra": "por uma mulher" },
        { "hebraico": "וּבְאִשָּׁ֖ה", "transliteral": "ū-ḇə-ʾiš-šā", "traducao_palavra": "e por uma mulher" },
        { "hebraico": "שָׁמָֽר׃", "transliteral": "šā-mār", "traducao_palavra": "guardou ovelhas/rebanho" }
