        { "hebraico": "כְּמַעֲלָלָ֖יו", "transliteral": "kə-ma-ʿă-lā-lāyw", "traducao_palavra": "segundo as suas obras" },
        { "hebraico": "יָשִׁ֥יב", "transliteral": "yā-šîḇ", "traducao_palavra": "retribuirá" },
        { "hebraico": "לֹֽו׃", "transliteral": "lô", "traducao_palavra": "a ele" }
      ]
    },
    "4": {
      "traducao_completa": "No ventre pegou do calcanhar de seu irmão, e no seu vigor lutou com Deus.",
      "palavras": [
        { "hebraico": "בַּבֶּ֖טֶן", "transliteral": "bab-be-ṭen", "traducao_palavra": "no ventre" },
        { "hebraico": "עָקַ֣ב", "transliteral": "ʿā-qaḇ", "traducao_palavra": "pegou pelo calcanhar" },
        { "hebraico": "אֶת־אָחִ֑יו", "transliteral": "ʾeṯ-ʾā-ḥîw", "traducao_palavra": "a seu irmão" },
        { "hebraico": "וּבְאֹונֹ֖ו", "transliteral": "ū-ḇə-ʾô-nô", "traducao_palavra": "e no seu vigor" },
        { "hebraico": "שָׂרָ֥ה", "transliteral": "śā-rā", "traducao_palavra": "lutou/prevaleceu com" },
        { "hebraico": "אֶת־אֱלֹהִֽים׃", "transliteral": "ʾeṯ-ʾĕ-lō-hîm", "traducao_palavra": "Deus" }
      ]
    },
    "5": {
      "traducao_completa": "Lutou com o anjo e prevaleceu; chorou e lhe suplicou; em Bete-El o achou, e ali falou ele conosco,",
      "palavras": [
        { "hebraico": "וַיָּ֤שַׂר", "transliteral": "way-yā-śar", "traducao_palavra": "e lutou" },
        { "hebraico": "אֶל־מַלְאָךְ֙", "transliteral": "ʾel-mal-ʾāḵ", "traducao_palavra": "com o anjo" },
        { "hebraico": "וַיֻּכָ֔ל", "transliteral": "way-yu-ḵāl", "traducao_palavra": "e prevaleceu" },
        { "hebraico": "בָּכָ֖ה", "transliteral": "bā-ḵā", "traducao_palavra": "chorou" },
        { "hebraico": "וַיִּתְחַנֶּן־לֹ֑ו", "transliteral": "way-yiṯ-ḥan-nen-lô", "traducao_palavra": "e suplicou-lhe" },
        { "hebraico": "בֵּֽית־אֵל֙", "transliteral": "bêṯ-ʾêl", "traducao_palavra": "em Bete-El" },
        { "hebraico": "יִמְצָאֶ֔נּוּ", "transliteral": "yim-ṣā-ʾen-nû", "traducao_palavra": "o achou" },
        { "hebraico": "וְשָׁ֖ם", "transliteral": "wə-šām", "traducao_palavra": "e ali" },
        { "hebraico": "יְדַבֵּ֥ר", "transliteral": "yə-ḏab-bêr", "traducao_palavra": "falou" },
        { "hebraico": "עִמָּֽנוּ׃", "transliteral": "ʿim-mā-nû", "traducao_palavra": "conosco" }
      ]
    },
    "6": {
      "traducao_completa": "sim, YHWH, o Deus dos Exércitos; YHWH é o seu memorial.",
      "palavras": [
        { "hebraico": "וַֽיהוָ֖ה", "transliteral": "wa-YHWH", "traducao_palavra": "sim YHWH" },
        { "hebraico": "אֱלֹהֵ֣י", "transliteral": "ʾĕ-lō-hê", "traducao_palavra": "o Deus de" },
        { "hebraico": "הַצְּבָאֹ֑ות", "transliteral": "haṣ-ṣə-ḇā-ʾôṯ", "traducao_palavra": "os Exércitos" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH [é]" },
        { "hebraico": "זִכְרֹֽו׃", "transliteral": "ziḵ-rô", "traducao_palavra": "o seu memorial" }
      ]
    },
    "7": {
      "traducao_completa": "Tu, pois, converte-te a teu Deus; guarda a misericórdia e o juízo, e no teu Deus espera sempre.",
      "palavras": [
        { "hebraico": "וְאַתָּ֖ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "tu pois" },
        { "hebraico": "בֵּאלֹהֶ֣יךָ", "transliteral": "bê-lō-he-ḵā", "traducao_palavra": "a teu Deus" },
        { "hebraico": "תָשׁ֑וּב", "transliteral": "tā-šūḇ", "traducao_palavra": "converte-te/volta" },
        { "hebraico": "חֶ֤סֶד", "transliteral": "ḥe-seḏ", "traducao_palavra": "a misericórdia" },
        { "hebraico": "וּמִשְׁפָּט֙", "transliteral": "ū-miš-pāṭ", "traducao_palavra": "e o juízo/justiça" },
        { "hebraico": "שְׁמֹ֔ר", "transliteral": "šə-mōr", "traducao_palavra": "guarda" },
        { "hebraico": "וְקַוֵּ֥ה", "transliteral": "wə-qaw-wêh", "traducao_palavra": "e espera" },
        { "hebraico": "אֶל־אֱלֹהֶ֖יךָ", "transliteral": "ʾel-ʾĕ-lō-he-ḵā", "traducao_palavra": "no teu Deus" },
        { "hebraico": "תָּמִֽיד׃", "transliteral": "tā-mîḏ", "traducao_palavra": "continuamente" }
      ]
    },
    "8": {
      "traducao_completa": "Canaã tem na mão balança enganosa; ama a opressão.",
