{
  "livro": "Oséias - הוֹשֵׁעַ - Hôšēaʿ",
  "capítulo": 2,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Todavia, o número dos filhos de Israel será como a areia do mar, que não se pode medir nem contar; e acontecerá que, no lugar onde se lhes dizia: Vós não sois meu povo, se lhes dirá: Vós sois filhos do Deus vivo.",
      "palavras": [
        { "hebraico": "וְֽ֠הָיָה", "transliteral": "wə-hā-yā", "traducao_palavra": "e acontecerá/será" },
        { "hebraico": "מִסְפַּ֤ר", "transliteral": "mis-par", "traducao_palavra": "o número de" },
        { "hebraico": "בְּנֵֽי־יִשְׂרָאֵל֙", "transliteral": "bə-nê-yiś-rā-ʾēl", "traducao_palavra": "os filhos de Israel" },
        { "hebraico": "כְּחֹ֣ול", "transliteral": "kə-ḥôl", "traducao_palavra": "como a areia de" },
        { "hebraico": "הַיָּ֔ם", "transliteral": "hay-yām", "traducao_palavra": "o mar" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "לֹֽא־יִמַּ֖ד", "transliteral": "lō-yim-maḏ", "traducao_palavra": "não se pode medir" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יִסָּפֵ֑ר", "transliteral": "yis-sā-p̄êr", "traducao_palavra": "se pode contar" },
        { "hebraico": "וְֽ֠הָיָה", "transliteral": "wə-hā-yā", "traducao_palavra": "e acontecerá [que]" },
        { "hebraico": "בִּמְקֹ֞ום", "transliteral": "bim-qôm", "traducao_palavra": "no lugar" },
        { "hebraico": "אֲשֶׁר־יֵאָמֵ֤ר", "transliteral": "ʾă-šer-yê-ʾā-mêr", "traducao_palavra": "onde se dizia" },
        { "hebraico": "לָהֶם֙", "transliteral": "lā-hem", "traducao_palavra": "a eles" },
        { "hebraico": "לֹא־עַמִּ֣י", "transliteral": "lō-ʿam-mî", "traducao_palavra": "não-meu-povo" },
        { "hebraico": "אַתֶּ֔ם", "transliteral": "ʾat-tem", "traducao_palavra": "sois vós" },
        { "hebraico": "יֵאָמֵ֥ר", "transliteral": "yê-ʾā-mêr", "traducao_palavra": "será dito" },
        { "hebraico": "לָהֶ֖ם", "transliteral": "lā-hem", "traducao_palavra": "a eles" },
        { "hebraico": "בְּנֵ֥י", "transliteral": "bə-nê", "traducao_palavra": "filhos de" },
        { "hebraico": "אֵֽל־חָֽי׃", "transliteral": "ʾêl-ḥāy", "traducao_palavra": "o Deus vivo" }
      ]
    },
    "2": {
      "traducao_completa": "E os filhos de Judá e os filhos de Israel se congregarão num só corpo, e constituirão sobre si uma só cabeça, e subirão da terra; porque grande será o dia de Jezreel.",
      "palavras": [
        { "hebraico": "וְ֠נִקְבְּצוּ", "transliteral": "wə-niq-bə-ṣû", "traducao_palavra": "e se congregarão" },
        { "hebraico": "בְּנֵֽי־יְהוּדָ֤ה", "transliteral": "bə-nê-yə-hū-ḏā", "traducao_palavra": "os filhos de Judá" },
        { "hebraico": "וּבְנֵֽי־יִשְׂרָאֵל֙", "transliteral": "ū-ḇə-nê-yiś-rā-ʾêl", "traducao_palavra": "e os filhos de Israel" },
        { "hebraico": "יַחְדָּ֔ו", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente" },
        { "hebraico": "וְשָׂמ֥וּ", "transliteral": "wə-śā-mû", "traducao_palavra": "e constituirão" },
        { "hebraico": "לָהֶ֛ם", "transliteral": "lā-hem", "traducao_palavra": "para si" },
        { "hebraico": "רֹ֥אשׁ", "transliteral": "rōš", "traducao_palavra": "uma cabeça/líder" },
        { "hebraico": "אֶחָ֖ד", "transliteral": "ʾe-ḥāḏ", "traducao_palavra": "único" },
        { "hebraico": "וְעָל֣וּ", "transliteral": "wə-ʿā-lû", "traducao_palavra": "e subirão" },
        { "hebraico": "מִן־הָאָ֑רֶץ", "transliteral": "min-hā-ʾā-reṣ", "traducao_palavra": "da terra" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "גָדֹ֖ול", "transliteral": "gā-ḏôl", "traducao_palavra": "grande [será]" },
        { "hebraico": "יֹ֥ום", "transliteral": "yôm", "traducao_palavra": "o dia de" },
        { "hebraico": "יִזְרְעֶֽאל׃", "transliteral": "yiz-rə-ʿel", "traducao_palavra": "Jezreel" }
      ]
    },
    "3": {
      "traducao_completa": "Dizei a vossos irmãos: Ami; e a vossas irmãs: Ruama.",
      "palavras": [
        { "hebraico": "אִמְר֥וּ", "transliteral": "ʾim-rû", "traducao_palavra": "dizei" },
        { "hebraico": "לַאֲחֵיכֶ֖ם", "transliteral": "la-ʾă-ḥê-ḵem", "traducao_palavra": "a vossos irmãos" },
        { "hebraico": "עַמִּ֑י", "transliteral": "ʿam-mî", "traducao_palavra": "Meu-Povo [Ami]" },
        { "hebraico": "וְלַאֲחֹותֵיכֶ֖ם", "transliteral": "wə-la-ʾă-ḥô-ṯê-ḵem", "traducao_palavra": "e a vossas irmãs" },
        { "hebraico": "רֻחָֽמָה׃", "transliteral": "ru-ḥā-mā", "traducao_palavra": "Favorecida/Compadecida [Ruama]" }
      ]
    },
    "4": {
      "traducao_completa": "Contendei com vossa mãe, contendei, porque ela não é minha mulher, e eu não sou seu marido; e desvie ela as suas prostituições de diante da sua face e os seus adultérios de entre os seus seios;",
      "palavras": [
        { "hebraico": "רִ֤יבוּ", "transliteral": "rî-ḇû", "traducao_palavra": "pleiteai/contendei" },
        { "hebraico": "בְאִמְּכֶם֙", "transliteral": "ḇə-ʾim-mə-ḵem", "traducao_palavra": "com vossa mãe" },
        { "hebraico": "רִ֔יבוּ", "transliteral": "rî-ḇû", "traducao_palavra": "contendei" },
        { "hebraico": "כִּֽי־הִיא֙", "transliteral": "kî-hî", "traducao_palavra": "porque ela" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não [é]" },
        { "hebraico": "אִשְׁתִּ֔י", "transliteral": "ʾiš-tî", "traducao_palavra": "minha mulher" },
        { "hebraico": "וְאָנֹכִ֖י", "transliteral": "wə-ʾā-nō-ḵî", "traducao_palavra": "e eu" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não [sou]" },
        { "hebraico": "אִישָׁ֑הּ", "transliteral": "ʾî-šāh", "traducao_palavra": "seu marido" },
        { "hebraico": "וְתָסֵ֤ר", "transliteral": "wə-ṯā-sêr", "traducao_palavra": "e remova ela" },
        { "hebraico": "זְנוּנֶ֙יהָ֙", "transliteral": "zə-nū-ne-hā", "traducao_palavra": "suas prostituições" },
        { "hebraico": "מִפָּנֶ֔יהָ", "transliteral": "mip-pā-ne-hā", "traducao_palavra": "de sua face" },
        { "hebraico": "וְנַאֲפוּפֶ֖יהָ", "transliteral": "wə-na-ʾă-p̄ū-p̄e-hā", "traducao_palavra": "e seus adultérios" },
        { "hebraico": "מִבֵּ֥ין", "transliteral": "mib-bên", "traducao_palavra": "de entre" },
        { "hebraico": "שָׁדֶֽיהָ׃", "transliteral": "šā-ḏe-hā", "traducao_palavra": "os seus seios" }
      ]
    },
    "5": {
      "traducao_completa": "para que eu não a despoje, deixando-a nua, e a ponha como no dia em que nasceu, e a torne como um deserto, e a ponha como uma terra seca, e a mate de sede.",
      "palavras": [
        { "hebraico": "פֶּן־אַפְשִׁיטֶ֣נָּה", "transliteral": "pen-ʾap̄-šî-ṭen-nā", "traducao_palavra": "para que não a despoje" },
        { "hebraico": "עֲרֻמָּ֔ה", "transliteral": "ʿă-rum-mā", "traducao_palavra": "nua" },
        { "hebraico": "וְהִצַּגְתִּ֖יהָ", "transliteral": "wə-hiṣ-ṣaḡ-tî-hā", "traducao_palavra": "e a ponha/exponha" },
        { "hebraico": "כְּיֹ֣ום", "transliteral": "kə-yôm", "traducao_palavra": "como no dia de" },
        { "hebraico": "הִוָּֽלְדָ֑הּ", "transliteral": "hiw-wā-lə-ḏāh", "traducao_palavra": "seu nascimento" },
        { "hebraico": "וְשַׂמְתִּ֣יהָ", "transliteral": "wə-śam-tî-hā", "traducao_palavra": "e a torne" },
        { "hebraico": "כַמִּדְבָּ֗ר", "transliteral": "ḵam-miḏ-bār", "traducao_palavra": "como o deserto" },
        { "hebraico": "וְשַׁתִּ֙הָ֙", "transliteral": "wə-šat-tî-hā", "traducao_palavra": "e a ponha" },
        { "hebraico": "כְּאֶ֣רֶץ", "transliteral": "kə-ʾe-reṣ", "traducao_palavra": "como terra" },
        { "hebraico": "צִיָּ֔ה", "transliteral": "ṣî-yā", "traducao_palavra": "árida/seca" },
        { "hebraico": "וַהֲמִתִּ֖יהָ", "transliteral": "wa-hă-mit-tî-hā", "traducao_palavra": "e a mate" },
        { "hebraico": "בַּצָּמָֽא׃", "transliteral": "baṣ-ṣā-mā", "traducao_palavra": "de sede" }
      ]
    },
    "6": {
      "traducao_completa": "E de seus filhos não me compadecerei, porque são filhos de prostituições.",
      "palavras": [
        { "hebraico": "וְאֶת־בָּנֶ֖יהָ", "transliteral": "wə-ʾeṯ-bā-ne-hā", "traducao_palavra": "e de seus filhos" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֲרַחֵ֑ם", "transliteral": "ʾă-ra-ḥêm", "traducao_palavra": "me compadecerei" },
        { "hebraico": "כִּֽי־בְנֵ֥י", "transliteral": "kî-ḇə-nê", "traducao_palavra": "porque filhos de" },
        { "hebraico": "זְנוּנִ֖ים", "transliteral": "zə-nū-nîm", "traducao_palavra": "prostituições" },
        { "hebraico": "הֵֽמָּה׃", "transliteral": "hêm-mā", "traducao_palavra": "são eles" }
      ]
    },
    "7": {
      "traducao_completa": "Porque sua mãe se prostituiu; aquela que os concebeu cobriu-se de vergonha, porque disse: Irei após os meus amantes, que me dão o meu pão e a minha água, a minha lã e o meu linho, o meu óleo e as minhas bebidas.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "זָֽנְתָה֙", "transliteral": "zā-nə-ṯā", "traducao_palavra": "se prostituiu" },
        { "hebraico": "אִמָּ֔ם", "transliteral": "ʾim-mām", "traducao_palavra": "a mãe deles" },
        { "hebraico": "הֹבִ֖ישָׁה", "transliteral": "hō-ḇî-šā", "traducao_palavra": "envergonhou-se" },
        { "hebraico": "הֹורָתָ֑ם", "transliteral": "hô-rā-ṯām", "traducao_palavra": "aquela que os concebeu" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אָמְרָ֗ה", "transliteral": "ʾā-mə-rā", "traducao_palavra": "ela disse" },
        { "hebraico": "אֵלְכָ֞ה", "transliteral": "ʾê-lə-ḵā", "traducao_palavra": "irei" },
        { "hebraico": "אַחֲרֵ֤י", "transliteral": "ʾa-ḥă-rê", "traducao_palavra": "atrás de" },
        { "hebraico": "מְאַהֲבַי֙", "transliteral": "mə-ʾa-hă-ḇay", "traducao_palavra": "meus amantes" },
        { "hebraico": "נֹתְנֵ֤י", "transliteral": "nō-ṯə-nê", "traducao_palavra": "que me dão" },
        { "hebraico": "לַחְמִי֙", "transliteral": "laḥ-mî", "traducao_palavra": "o meu pão" },
        { "hebraico": "וּמֵימַ֔י", "transliteral": "ū-mê-may", "traducao_palavra": "e a minha água" },
        { "hebraico": "צַמְרִ֣י", "transliteral": "ṣam-rî", "traducao_palavra": "a minha lã" },
        { "hebraico": "וּפִשְׁתִּ֔י", "transliteral": "ū-p̄iš-tî", "traducao_palavra": "e o meu linho" },
        { "hebraico": "שַׁמְנִ֖י", "transliteral": "šam-nî", "traducao_palavra": "o meu óleo" },
        { "hebraico": "וְשִׁקּוּיָֽי׃", "transliteral": "wə-šiq-qū-yāy", "traducao_palavra": "e as minhas bebidas" }
      ]
    },
    "8": {
      "traducao_completa": "Portanto, eis que cercarei o teu caminho com espinhos; e levantarei uma sebe contra ela, para que ela não ache as suas veredas.",
      "palavras": [
        { "hebraico": "לָכֵ֗ן", "transliteral": "lā-ḵên", "traducao_palavra": "portanto" },
        { "hebraico": "הִנְנִי־שָׂ֥ךְ", "transliteral": "hin-nî-śāḵ", "traducao_palavra": "eis que cercarei" },
        { "hebraico": "אֶת־דַּרְכֵּ֖ךְ", "transliteral": "ʾeṯ-dar-kêḵ", "traducao_palavra": "o teu caminho" },
        { "hebraico": "בַּסִּירִ֑ים", "transliteral": "bas-sî-rîm", "traducao_palavra": "com espinhos" },
        { "hebraico": "וְגָֽדַרְתִּי֙", "transliteral": "wə-ḡā-ḏar-tî", "traducao_palavra": "e construirei muro contra" },
        { "hebraico": "אֶת־גְּדֵרָ֔הּ", "transliteral": "ʾeṯ-gə-ḏê-rāh", "traducao_palavra": "o seu muro/sebe" },
        { "hebraico": "וּנְתִיבֹותֶ֖יהָ", "transliteral": "ū-nə-ṯî-ḇô-ṯe-hā", "traducao_palavra": "e as suas veredas" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תִמְצָֽא׃", "transliteral": "ṯim-ṣā", "traducao_palavra": "achará" }
      ]
    },
    "9": {
      "traducao_completa": "E irá após os seus amantes, mas não os alcançará; e buscá-los-á, mas não os achará; então dirá: Irei e voltarei a meu primeiro marido, porque melhor me ia então do que agora.",
      "palavras": [
        { "hebraico": "וְרִדְּפָ֤ה", "transliteral": "wə-rid-də-p̄ā", "traducao_palavra": "e perseguirá" },
        { "hebraico": "אֶת־מְאַהֲבֶ֙יהָ֙", "transliteral": "ʾeṯ-mə-ʾa-hă-ḇe-hā", "traducao_palavra": "os seus amantes" },
        { "hebraico": "וְלֹֽא־תַשִּׂ֣יג", "transliteral": "wə-lō-ṯaś-śîḡ", "traducao_palavra": "mas não alcançará" },
        { "hebraico": "אֹתָ֔ם", "transliteral": "ʾō-ṯām", "traducao_palavra": "a eles" },
        { "hebraico": "וּבִקְשָׁתַ֖ם", "transliteral": "ū-ḇiq-šā-ṯam", "traducao_palavra": "e buscá-los-á" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "mas não" },
        { "hebraico": "תִמְצָ֑א", "transliteral": "ṯim-ṣā", "traducao_palavra": "os achará" },
        { "hebraico": "וְאָמְרָ֗ה", "transliteral": "wə-ʾā-mə-rā", "traducao_palavra": "e dirá" },
        { "hebraico": "אֵלְכָה֙", "transliteral": "ʾê-lə-ḵā", "traducao_palavra": "irei" },
        { "hebraico": "וְאָשׁוּבָה֙", "transliteral": "wə-ʾā-šū-ḇā", "traducao_palavra": "e voltarei" },
        { "hebraico": "אֶל־אִישִׁ֣י", "transliteral": "ʾel-ʾî-šî", "traducao_palavra": "a meu marido" },
        { "hebraico": "הָרִאשֹׁ֔ון", "transliteral": "hā-ri-šôn", "traducao_palavra": "o primeiro" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "טֹ֥וב", "transliteral": "ṭôḇ", "traducao_palavra": "melhor [era]" },
        { "hebraico": "לִ֛י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "אָ֖ז", "transliteral": "ʾāz", "traducao_palavra": "então" },
        { "hebraico": "מֵעָֽתָּה׃", "transliteral": "mê-ʿat-tā", "traducao_palavra": "do que agora" }
      ]
    },
    "10": {
      "traducao_completa": "Pois ela não reconheceu que fui eu que lhe dei o grão, e o mosto, e o azeite, e lhe multipliquei a prata e o ouro, que eles usaram para Baal.",
      "palavras": [
        { "hebraico": "וְהִיא֙", "transliteral": "wə-hî", "traducao_palavra": "e ela" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יָֽדְעָ֔ה", "transliteral": "yā-ḏə-ʿā", "traducao_palavra": "soube/reconheceu" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "אָֽנֹכִי֙", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "eu" },
        { "hebraico": "נָתַ֣תִּי", "transliteral": "nā-ṯat-tî", "traducao_palavra": "dei" },
        { "hebraico": "לָ֔הּ", "transliteral": "lāh", "traducao_palavra": "a ela" },
        { "hebraico": "הַדָּגָ֖ן", "transliteral": "had-dā-ḡān", "traducao_palavra": "o cereal" },
        { "hebraico": "וְהַתִּירֹ֣ושׁ", "transliteral": "wə-hat-tî-rôš", "traducao_palavra": "e o vinho novo" },
        { "hebraico": "וְהַיִּצְהָ֑ר", "transliteral": "wə-hay-yiṣ-hār", "traducao_palavra": "e o azeite fresco" },
        { "hebraico": "וְכֶ֨סֶף", "transliteral": "wə-ḵe-sep̄", "traducao_palavra": "e prata" },
        { "hebraico": "הִרְבֵּ֥יתִי", "transliteral": "hir-bê-ṯî", "traducao_palavra": "multipliquei" },
        { "hebraico": "לָ֛הּ", "transliteral": "lāh", "traducao_palavra": "a ela" },
        { "hebraico": "וְזָהָ֖ב", "transliteral": "wə-zā-hāḇ", "traducao_palavra": "e ouro" },
        { "hebraico": "עָשׂ֥וּ", "transliteral": "ʿā-śû", "traducao_palavra": "que fizeram/usaram" },
        { "hebraico": "לַבָּֽעַל׃", "transliteral": "lab-bā-ʿal", "traducao_palavra": "para Baal" }
      ]
