    "11": {
      "traducao_completa": "Portanto, tornarei a tirar o meu grão a seu tempo e o meu mosto no seu tempo determinado; e arrebatarei a minha lã e o meu linho, com que cobriam a sua nudez.",
      "palavras": [
        { "hebraico": "לָכֵ֣ן", "transliteral": "lā-ḵên", "traducao_palavra": "portanto" },
        { "hebraico": "אָשׁ֔וּב", "transliteral": "ʾā-šūḇ", "traducao_palavra": "voltarei e" },
        { "hebraico": "וְלָקַחְתִּ֤י", "transliteral": "wə-lā-qaḥ-tî", "traducao_palavra": "tirarei" },
        { "hebraico": "דְגָנִי֙", "transliteral": "də-ḡā-nî", "traducao_palavra": "o meu cereal" },
        { "hebraico": "בְּעִתֹּ֔ו", "transliteral": "bə-ʿit-tô", "traducao_palavra": "no seu tempo" },
        { "hebraico": "וְתִירֹושִׁ֖י", "transliteral": "wə-ṯî-rô-šî", "traducao_palavra": "e o meu vinho novo" },
        { "hebraico": "בְּמֹֽועֲדֹ֑ו", "transliteral": "bə-mô-ʿă-ḏô", "traducao_palavra": "na sua estação própria" },
        { "hebraico": "וְהִצַּלְתִּי֙", "transliteral": "wə-hiṣ-ṣal-tî", "traducao_palavra": "e arrebatarei" },
        { "hebraico": "צַמְרִ֣י", "transliteral": "ṣam-rî", "traducao_palavra": "a minha lã" },
        { "hebraico": "וּפִשְׁתִּ֔י", "transliteral": "ū-p̄iš-tî", "traducao_palavra": "e o meu linho" },
        { "hebraico": "לְכַסֹּ֖ות", "transliteral": "lə-ḵas-sôṯ", "traducao_palavra": "dados para cobrir" },
        { "hebraico": "אֶת־עֶרְוָתָֽהּ׃", "transliteral": "ʾeṯ-ʿer-wā-ṯāh", "traducao_palavra": "a sua nudez" }
      ]
    },
    "12": {
      "traducao_completa": "E agora descobrirei a sua vileza diante dos olhos dos seus amantes, e ninguém a livrará da minha mão.",
      "palavras": [
        { "hebraico": "וְעַתָּ֛ה", "transliteral": "wə-ʿat-tā", "traducao_palavra": "e agora" },
        { "hebraico": "אֲגַלֶּ֥ה", "transliteral": "ʾă-ḡal-leh", "traducao_palavra": "descobrirei" },
        { "hebraico": "אֶת־נַבְלֻתָ֖הּ", "transliteral": "ʾeṯ-naḇ-lu-ṯāh", "traducao_palavra": "a sua vergonha/vileza" },
        { "hebraico": "לְעֵינֵ֣י", "transliteral": "lə-ʿê-nê", "traducao_palavra": "aos olhos de" },
        { "hebraico": "מְאַהֲבֶ֑יהָ", "transliteral": "mə-ʾa-hă-ḇe-hā", "traducao_palavra": "seus amantes" },
        { "hebraico": "וְאִ֖ישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "e ninguém" },
