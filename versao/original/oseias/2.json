        { "hebraico": "מִיָּדִֽי׃", "transliteral": "mî-yā-ḏî", "traducao_palavra": "da minha mão" }
      ]
    },
    "13": {
      "traducao_completa": "E farei cessar todo o seu regozijo, as suas festas, as suas luas novas, e os seus sábados, e todas as suas solenidades.",
      "palavras": [
        { "hebraico": "וְהִשְׁבַּתִּי֙", "transliteral": "wə-hiš-bat-tî", "traducao_palavra": "e farei cessar" },
        { "hebraico": "כָּל־מְשֹׂושָׂ֔הּ", "transliteral": "kāl-mə-śô-śāh", "traducao_palavra": "toda a sua alegria" },
        { "hebraico": "חַגָּ֖הּ", "transliteral": "ḥag-gāh", "traducao_palavra": "suas festas" },
        { "hebraico": "חָדְשָׁ֣הּ", "transliteral": "ḥāḏ-šāh", "traducao_palavra": "suas luas novas" },
        { "hebraico": "וְשַׁבַּתָּ֑הּ", "transliteral": "wə-šab-bat-tāh", "traducao_palavra": "e seus sábados" },
        { "hebraico": "וְכֹ֖ל", "transliteral": "wə-ḵōl", "traducao_palavra": "e todas" },
        { "hebraico": "מֹועֲדָֽהּ׃", "transliteral": "mô-ʿă-ḏāh", "traducao_palavra": "suas festas solenes" }
      ]
    },
    "14": {
      "traducao_completa": "E devastarei a sua vide e a sua figueira, das quais ela dizia: Esta é a paga que me deram os meus amantes; e eu as tornarei num bosque, e as feras do campo as devorarão.",
      "palavras": [
        { "hebraico": "וַהֲשִׁמֹּתִ֗י", "transliteral": "wa-hă-šim-mō-ṯî", "traducao_palavra": "e devastarei" },
        { "hebraico": "גַּפְנָהּ֙", "transliteral": "gap̄-nāh", "traducao_palavra": "a sua vide" },
        { "hebraico": "וּתְאֵ֣נָתָ֔הּ", "transliteral": "ū-ṯə-ʾê-nā-ṯāh", "traducao_palavra": "e a sua figueira" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "das quais" },
        { "hebraico": "אָמְרָ֗ה", "transliteral": "ʾā-mə-rā", "traducao_palavra": "ela dizia" },
        { "hebraico": "אֶתְנָ֥ה", "transliteral": "ʾeṯ-nā", "traducao_palavra": "meu pagamento/salário de prostituição" },
        { "hebraico": "הֵ֙מָּה֙", "transliteral": "hêm-mā", "traducao_palavra": "são estas" },
        { "hebraico": "לִ֔י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "נָֽתְנוּ־לִ֖י", "transliteral": "nā-ṯə-nū-lî", "traducao_palavra": "deram a mim" },
        { "hebraico": "מְאַֽהֲבָ֑י", "transliteral": "mə-ʾa-hă-ḇāy", "traducao_palavra": "os meus amantes" },
        { "hebraico": "וְשַׂמְתִּ֣ים", "transliteral": "wə-śam-tîm", "traducao_palavra": "e as tornarei" },
        { "hebraico": "לְיַ֔עַר", "transliteral": "lə-ya-ʿar", "traducao_palavra": "em bosque" },
        { "hebraico": "וַאֲכָלָ֖תַם", "transliteral": "wa-ʾă-ḵā-lā-ṯam", "traducao_palavra": "e as devorarão" },
        { "hebraico": "חַיַּ֥ת", "transliteral": "ḥay-yaṯ", "traducao_palavra": "as feras de" },
        { "hebraico": "הַשָּׂדֶֽה׃", "transliteral": "haś-śā-ḏeh", "traducao_palavra": "o campo" }
      ]
    },
    "15": {
      "traducao_completa": "E castigarei nela os dias dos baalins, nos quais lhes queimava incenso, e se adornava com as suas arrecadas e com as suas joias, e ia atrás dos seus amantes, mas de mim se esquecia, diz YHWH.",
      "palavras": [
        { "hebraico": "וּפָקַדְתִּ֣י", "transliteral": "ū-p̄ā-qaḏ-tî", "traducao_palavra": "e castigarei" },
        { "hebraico": "עָלֶ֗יהָ", "transliteral": "ʿā-le-hā", "traducao_palavra": "sobre ela" },
        { "hebraico": "אֶת־יְמֵ֤י", "transliteral": "ʾeṯ-yə-mê", "traducao_palavra": "os dias de" },
        { "hebraico": "הַבְּעָלִים֙", "transliteral": "hab-bə-ʿā-lîm", "traducao_palavra": "os baalins" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "em que" },
        { "hebraico": "תַּקְטִ֣יר", "transliteral": "taq-ṭîr", "traducao_palavra": "queimava incenso" },
        { "hebraico": "לָהֶ֔ם", "transliteral": "lā-hem", "traducao_palavra": "a eles" },
        { "hebraico": "וַתַּ֤עַד", "transliteral": "wat-ta-ʿaḏ", "traducao_palavra": "e se enfeitava com" },
        { "hebraico": "נִזְמָהּ֙", "transliteral": "niz-māh", "traducao_palavra": "o seu brinco" },
        { "hebraico": "וְחֶלְיָתָ֔הּ", "transliteral": "wə-ḥel-yā-ṯāh", "traducao_palavra": "e o seu colar/joia" },
        { "hebraico": "וַתֵּ֖לֶךְ", "transliteral": "wat-tê-leḵ", "traducao_palavra": "e ia" },
        { "hebraico": "אַחֲרֵ֣י", "transliteral": "ʾa-ḥă-rê", "traducao_palavra": "após" },
        { "hebraico": "מְאַהֲבֶ֑יהָ", "transliteral": "mə-ʾa-hă-ḇe-hā", "traducao_palavra": "os seus amantes" },
        { "hebraico": "וְאֹתִ֥י", "transliteral": "wə-ʾō-ṯî", "traducao_palavra": "mas de mim" },
        { "hebraico": "שָׁכְחָ֖ה", "transliteral": "šā-ḵə-ḥā", "traducao_palavra": "ela se esquecia" },
        { "hebraico": "נְאֻם־יְהוָֽה׃", "transliteral": "nə-ʾum-YHWH", "traducao_palavra": "declaração de YHWH" }
      ]
    },
    "16": {
      "traducao_completa": "Portanto, eis que eu a atrairei, e a levarei para o deserto, e lhe falarei ao coração.",
      "palavras": [
        { "hebraico": "לָכֵ֗ן", "transliteral": "lā-ḵên", "traducao_palavra": "portanto" },
        { "hebraico": "הִנֵּ֤ה", "transliteral": "hin-nêh", "traducao_palavra": "eis que" },
        { "hebraico": "אָֽנֹכִי֙", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "eu" },
        { "hebraico": "מְפַתֶּ֔יהָ", "transliteral": "mə-p̄at-te-hā", "traducao_palavra": "a atrairei/persuadirei" },
        { "hebraico": "וְהֹֽלַכְתִּ֖יהָ", "transliteral": "wə-hō-laḵ-tî-hā", "traducao_palavra": "e a levarei para" },
        { "hebraico": "הַמִּדְבָּ֑ר", "transliteral": "ham-miḏ-bār", "traducao_palavra": "o deserto" },
        { "hebraico": "וְדִבַּרְתִּ֖י", "transliteral": "wə-ḏib-bar-tî", "traducao_palavra": "e falarei" },
        { "hebraico": "עַל־לִבָּֽהּ׃", "transliteral": "ʿal-lib-bāh", "traducao_palavra": "ao seu coração" }
      ]
    },
    "17": {
      "traducao_completa": "E dar-lhe-ei dali as suas vinhas e o vale de Acor por porta de esperança; e ali responderá como nos dias da sua mocidade e como no dia em que subiu da terra do Egito.",
      "palavras": [
        { "hebraico": "וְנָתַ֨תִּי", "transliteral": "wə-nā-ṯat-tî", "traducao_palavra": "e darei" },
        { "hebraico": "לָ֤הּ", "transliteral": "lāh", "traducao_palavra": "a ela" },
        { "hebraico": "אֶת־כְּרָמֶ֙יהָ֙", "transliteral": "ʾeṯ-kə-rā-me-hā", "traducao_palavra": "as suas vinhas" },
        { "hebraico": "מִשָּׁ֔ם", "transliteral": "miš-šām", "traducao_palavra": "dali" },
        { "hebraico": "וְאֶת־עֵ֥מֶק", "transliteral": "wə-ʾeṯ-ʿê-meq", "traducao_palavra": "e o vale de" },
        { "hebraico": "עָכֹ֖ור", "transliteral": "ʿā-ḵôr", "traducao_palavra": "Acor" },
        { "hebraico": "לְפֶ֣תַח", "transliteral": "lə-p̄e-ṯaḥ", "traducao_palavra": "por porta de" },
        { "hebraico": "תִּקְוָ֑ה", "transliteral": "tiq-wā", "traducao_palavra": "esperança" },
        { "hebraico": "וְעָ֤נְתָה", "transliteral": "wə-ʿā-nə-ṯā", "traducao_palavra": "e ali cantará/responderá" },
        { "hebraico": "שָּׁ֙מָּה֙", "transliteral": "šām-mā", "traducao_palavra": "ali" },
        { "hebraico": "כִּימֵ֣י", "transliteral": "kî-mê", "traducao_palavra": "como nos dias de" },
        { "hebraico": "נְעוּרֶ֔יהָ", "transliteral": "nə-ʿū-re-hā", "traducao_palavra": "sua mocidade" },
        { "hebraico": "וּכְיֹ֥ום", "transliteral": "ū-ḵə-yôm", "traducao_palavra": "e como no dia de" },
        { "hebraico": "עֲלֹותָ֖הּ", "transliteral": "ʿă-lô-ṯāh", "traducao_palavra": "sua subida" },
        { "hebraico": "מֵאֶ֥רֶץ", "transliteral": "mê-ʾe-reṣ", "traducao_palavra": "da terra de" },
        { "hebraico": "מִצְרָֽיִם׃", "transliteral": "miṣ-rā-yim", "traducao_palavra": "Egito" }
      ]
    },
    "18": {
      "traducao_completa": "E acontecerá naquele dia, diz YHWH, que me chamarás: Meu marido; e não me chamarás mais: Meu senhor.",
      "palavras": [
        { "hebraico": "וְהָיָ֤ה", "transliteral": "wə-hā-yā", "traducao_palavra": "e acontecerá" },
        { "hebraico": "בַיֹּום־הַהוּא֙", "transliteral": "ḇay-yôm-ha-hû", "traducao_palavra": "naquele dia" },
        { "hebraico": "נְאֻם־יְהוָ֔ה", "transliteral": "nə-ʾum-YHWH", "traducao_palavra": "declaração de YHWH" },
        { "hebraico": "תִּקְרְאִ֖י", "transliteral": "tiq-rə-ʾî", "traducao_palavra": "chamar-me-ás" },
        { "hebraico": "אִישִׁ֑י", "transliteral": "ʾî-šî", "traducao_palavra": "Meu Marido [Ishi]" },
        { "hebraico": "וְלֹֽא־תִקְרְאִי־לִ֥י", "transliteral": "wə-lō-ṯiq-rə-ʾî-lî", "traducao_palavra": "e não me chamarás" },
        { "hebraico": "עֹ֖וד", "transliteral": "ʿôḏ", "traducao_palavra": "mais" },
        { "hebraico": "בַּעְלִֽי׃", "transliteral": "baʿ-lî", "traducao_palavra": "Meu Senhor/Baal [Baali]" }
      ]
    },
    "19": {
      "traducao_completa": "E da sua boca tirarei os nomes dos baalins, e não mais se fará menção dos seus nomes.",
      "palavras": [
        { "hebraico": "וַהֲסִרֹתִ֛י", "transliteral": "wa-hă-si-rō-ṯî", "traducao_palavra": "e removerei/tirarei" },
        { "hebraico": "אֶת־שְׁמֹ֥ות", "transliteral": "ʾeṯ-šə-môṯ", "traducao_palavra": "os nomes de" },
        { "hebraico": "הַבְּעָלִ֖ים", "transliteral": "hab-bə-ʿā-lîm", "traducao_palavra": "os baalins" },
        { "hebraico": "מִפִּ֑יהָ", "transliteral": "mip-pî-hā", "traducao_palavra": "da sua boca" },
        { "hebraico": "וְלֹֽא־יִזָּכְר֥וּ", "transliteral": "wə-lō-yiz-zā-ḵə-rû", "traducao_palavra": "e não serão lembrados" },
        { "hebraico": "עֹ֖וד", "transliteral": "ʿôḏ", "traducao_palavra": "mais" },
        { "hebraico": "בִּשְׁמָֽם׃", "transliteral": "biš-mām", "traducao_palavra": "pelos seus nomes" }
      ]
    },
    "20": {
      "traducao_completa": "E naquele dia farei por eles aliança com as feras do campo, e com as aves do céu, e com os répteis da terra; e da terra quebrarei o arco, e a espada, e a guerra, e os farei deitar em segurança.",
      "palavras": [
        { "hebraico": "וְכָרַתִּ֨י", "transliteral": "wə-ḵā-rat-tî", "traducao_palavra": "e farei/estabelecerei" },
        { "hebraico": "לָהֶ֤ם", "transliteral": "lā-hem", "traducao_palavra": "por eles" },
        { "hebraico": "בְּרִית֙", "transliteral": "bə-rîṯ", "traducao_palavra": "uma aliança" },
        { "hebraico": "בַּיֹּ֣ום", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "הַה֔וּא", "transliteral": "ha-hû", "traducao_palavra": "aquele" },
        { "hebraico": "עִם־חַיַּ֤ת", "transliteral": "ʿim-ḥay-yaṯ", "traducao_palavra": "com as feras de" },
        { "hebraico": "הַשָּׂדֶה֙", "transliteral": "haś-śā-ḏeh", "traducao_palavra": "o campo" },
        { "hebraico": "וְעִם־עֹ֣וף", "transliteral": "wə-ʿim-ʿôp̄", "traducao_palavra": "e com as aves de" },
        { "hebraico": "הַשָּׁמַ֔יִם", "transliteral": "haš-šā-ma-yim", "traducao_palavra": "o céu" },
        { "hebraico": "וְרֶ֖מֶשׂ", "transliteral": "wə-re-meś", "traducao_palavra": "e os répteis de" },
        { "hebraico": "הָֽאֲדָמָ֑ה", "transliteral": "hā-ʾă-ḏā-mā", "traducao_palavra": "o solo" },
        { "hebraico": "וְקֶ֨שֶׁת", "transliteral": "wə-qe-šeṯ", "traducao_palavra": "e o arco" },
        { "hebraico": "וְחֶ֤רֶב", "transliteral": "wə-ḥe-reḇ", "traducao_palavra": "e a espada" },
