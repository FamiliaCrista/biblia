      ]
    },
    "10": {
      "traducao_completa": "Todavia, ainda que eles contratem entre as nações, agora os congregarei; e começarão a definhar sob a opressão do rei dos príncipes.",
      "palavras": [
        { "hebraico": "גַּ֛ם", "transliteral": "gam", "traducao_palavra": "todavia/ainda que" },
        { "hebraico": "כִּֽי־יִתְנ֥וּ", "transliteral": "kî-yiṯ-nû", "traducao_palavra": "contratem eles" },
        { "hebraico": "בַגֹּויִ֖ם", "transliteral": "ḇag-gô-yim", "traducao_palavra": "entre as nações" },
        { "hebraico": "עַתָּ֣ה", "transliteral": "ʿat-tā", "traducao_palavra": "agora" },
        { "hebraico": "אֲקַבְּצֵ֑ם", "transliteral": "ʾă-qab-bə-ṣêm", "traducao_palavra": "os congregarei" },
        { "hebraico": "וַיָּחֵ֣לּוּ", "transliteral": "way-yā-ḥêl-lû", "traducao_palavra": "e definharão/serão diminuídos" },
        { "hebraico": "מְּעָ֔ט", "transliteral": "mə-ʿāṭ", "traducao_palavra": "um pouco" },
        { "hebraico": "מִמַּשָּׂ֖א", "transliteral": "mim-maś-śā", "traducao_palavra": "sob a carga de" },
        { "hebraico": "מֶ֥לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "o rei de" },
        { "hebraico": "שָׂרִֽים׃", "transliteral": "śā-rîm", "traducao_palavra": "príncipes" }
      ]
    },
    "11": {
      "traducao_completa": "Porquanto Efraim multiplicou os altares para pecar, estes altares se lhe tornaram em pecado.",
      "palavras": [
        { "hebraico": "כִּֽי־הִרְבָּ֥ה", "transliteral": "kî-hir-bā", "traducao_palavra": "porquanto multiplicou" },
        { "hebraico": "אֶפְרַ֛יִם", "transliteral": "ʾep̄-ra-yim", "traducao_palavra": "Efraim" },
        { "hebraico": "מִזְבְּחֹ֖ות", "transliteral": "miz-bə-ḥôṯ", "traducao_palavra": "altares" },
        { "hebraico": "לַחֲטֹ֑א", "transliteral": "la-ḥă-ṭō", "traducao_palavra": "para pecar" },
        { "hebraico": "הָיוּ־לֹ֥ו", "transliteral": "hā-yū-lô", "traducao_palavra": "foram para ele" },
        { "hebraico": "מִזְבְּחֹ֖ות", "transliteral": "miz-bə-ḥôṯ", "traducao_palavra": "altares" },
        { "hebraico": "לַחֲטֹֽא׃", "transliteral": "la-ḥă-ṭō", "traducao_palavra": "para pecar" }
      ]
    },
    "12": {
      "traducao_completa": "Escrevi-lhe as grandezas da minha lei, mas foram estimadas como coisa estranha.",
      "palavras": [
        { "hebraico": "אֶכְתָּב־לֹ֥ו", "transliteral": "ʾeḵ-tāḇ-lô", "traducao_palavra": "escrevi para ele" },
        { "hebraico": "רִבֹּ֣ו", "transliteral": "rib-bô", "traducao_palavra": "as multidões/grandezas de" },
        { "hebraico": "תֹּֽורָתִ֑י", "transliteral": "tô-rā-ṯî", "traducao_palavra": "minha lei" },
        { "hebraico": "כְּמֹו־זָ֖ר", "transliteral": "kə-mô-zār", "traducao_palavra": "como coisa estranha" },
        { "hebraico": "נֶחְשָֽׁבוּ׃", "transliteral": "neḥ-šā-ḇû", "traducao_palavra": "foram consideradas" }
      ]
    },
    "13": {
      "traducao_completa": "Quanto aos sacrifícios das minhas ofertas, sacrificam carne e a comem, mas YHWH não os aceita; agora se lembrará da sua iniquidade e castigará os seus pecados; eles voltarão para o Egito.",
      "palavras": [
        { "hebraico": "זִבְחֵ֣י", "transliteral": "ziḇ-ḥê", "traducao_palavra": "os sacrifícios de" },
        { "hebraico": "הַבְהָבַ֗י", "transliteral": "haḇ-hā-ḇay", "traducao_palavra": "minhas ofertas" },
        { "hebraico": "יִזְבְּח֤וּ", "transliteral": "yiz-bə-ḥû", "traducao_palavra": "sacrificam" },
        { "hebraico": "בָשָׂר֙", "transliteral": "ḇā-śār", "traducao_palavra": "carne" },
        { "hebraico": "וַיֹּאכֵ֔לוּ", "transliteral": "way-yō-ḵê-lû", "traducao_palavra": "e a comem" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "רָצָ֑ם", "transliteral": "rā-ṣām", "traducao_palavra": "se agrada deles" },
        { "hebraico": "עַתָּ֞ה", "transliteral": "ʿat-tā", "traducao_palavra": "agora" },
        { "hebraico": "יִזְכֹּ֤ר", "transliteral": "yiz-kōr", "traducao_palavra": "ele se lembrará de" },
        { "hebraico": "עֲוֹנָם֙", "transliteral": "ʿă-wō-nām", "traducao_palavra": "sua iniquidade" },
        { "hebraico": "וְיִפְקֹ֣ד", "transliteral": "wə-yip̄-qōḏ", "traducao_palavra": "e castigará" },
        { "hebraico": "חַטֹּאותָ֔ם", "transliteral": "ḥaṭ-ṭō-wō-ṯām", "traducao_palavra": "os seus pecados" },
