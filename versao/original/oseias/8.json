{
  "livro": "Oséias - הוֹשֵׁעַ - Hôšēaʿ",
  "capítulo": 8,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Põe a trombeta à tua boca! Como a águia vem o inimigo contra a casa de YHWH, porque transgrediram a minha aliança e se rebelaram contra a minha lei.",
      "palavras": [
        { "hebraico": "אֶל־חִכְּךָ֣", "transliteral": "ʾel-ḥik-kə-ḵā", "traducao_palavra": "ao teu palato/boca põe" },
        { "hebraico": "שֹׁפָ֔ר", "transliteral": "šō-p̄ār", "traducao_palavra": "a trombeta/shofar" },
        { "hebraico": "כַּנֶּ֖שֶׁר", "transliteral": "kan-ne-šer", "traducao_palavra": "como águia vem" },
        { "hebraico": "עַל־בֵּ֣ית", "transliteral": "ʿal-bêṯ", "traducao_palavra": "contra a casa de" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "יַ֚עַן", "transliteral": "ya-ʿan", "traducao_palavra": "porque" },
        { "hebraico": "עָבְר֣וּ", "transliteral": "ʿā-ḇə-rû", "traducao_palavra": "transgrediram" },
        { "hebraico": "בְרִיתִ֔י", "transliteral": "ḇə-rî-ṯî", "traducao_palavra": "a minha aliança" },
        { "hebraico": "וְעַל־תֹּורָתִ֖י", "transliteral": "wə-ʿal-tô-rā-ṯî", "traducao_palavra": "e contra a minha lei" },
        { "hebraico": "פָּשָֽׁעוּ׃", "transliteral": "pā-šā-ʿû", "traducao_palavra": "se rebelaram" }
      ]
    },
    "2": {
      "traducao_completa": "A mim clamarão: Deus meu, nós, Israel, te conhecemos!",
      "palavras": [
        { "hebraico": "לִ֖י", "transliteral": "lî", "traducao_palavra": "a mim" },
        { "hebraico": "יִזְעָ֑קוּ", "transliteral": "yiz-ʿā-qû", "traducao_palavra": "clamarão" },
        { "hebraico": "אֱלֹהַ֖י", "transliteral": "ʾĕ-lō-hay", "traducao_palavra": "meu Deus" },
        { "hebraico": "יְדַֽעֲנוּךָ֥", "transliteral": "yə-ḏa-ʿă-nū-ḵā", "traducao_palavra": "nós te conhecemos" },
        { "hebraico": "יִשְׂרָאֵֽל׃", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "[nós,] Israel" }
      ]
    },
    "3": {
      "traducao_completa": "Israel rejeitou o bem; o inimigo o perseguirá.",
      "palavras": [
        { "hebraico": "זָנַ֥ח", "transliteral": "zā-naḥ", "traducao_palavra": "rejeitou" },
        { "hebraico": "יִשְׂרָאֵ֖ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "טֹ֑וב", "transliteral": "ṭôḇ", "traducao_palavra": "o bem" },
        { "hebraico": "אֹויֵ֖ב", "transliteral": "ʾô-yêḇ", "traducao_palavra": "o inimigo" },
        { "hebraico": "יִרְדְּפֹֽו׃", "transliteral": "yir-də-p̄ô", "traducao_palavra": "o perseguirá" }
      ]
    },
    "4": {
      "traducao_completa": "Eles estabeleceram reis, mas não por mim; constituíram príncipes, mas eu não o soube; da sua prata e do seu ouro fizeram ídolos para si, para serem destruídos.",
      "palavras": [
        { "hebraico": "הֵ֤ם", "transliteral": "hêm", "traducao_palavra": "eles" },
        { "hebraico": "הִמְלִ֙יכוּ֙", "transliteral": "him-lî-ḵû", "traducao_palavra": "estabeleceram reis" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "mas não" },
        { "hebraico": "מִמֶּ֔נִּי", "transliteral": "mim-men-nî", "traducao_palavra": "por mim" },
        { "hebraico": "הֵשִׂ֖ירוּ", "transliteral": "hê-śî-rû", "traducao_palavra": "constituíram príncipes" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "mas não" },
        { "hebraico": "יָדָ֑עְתִּי", "transliteral": "yā-ḏā-ʿə-tî", "traducao_palavra": "eu aprovei/soube" },
        { "hebraico": "כַּסְפָּ֣ם", "transliteral": "kas-pām", "traducao_palavra": "da sua prata" },
        { "hebraico": "וּזְהָבָ֗ם", "transliteral": "ū-zə-hā-ḇām", "traducao_palavra": "e do seu ouro" },
        { "hebraico": "עָשׂׂ֤וּ", "transliteral": "ʿā-śû", "traducao_palavra": "fizeram" },
        { "hebraico": "לָהֶם֙", "transliteral": "lā-hem", "traducao_palavra": "para si" },
        { "hebraico": "עֲצַבִּ֔ים", "transliteral": "ʿă-ṣab-bîm", "traducao_palavra": "ídolos" },
        { "hebraico": "לְמַ֖עַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "para que" },
        { "hebraico": "יִכָּרֵֽת׃", "transliteral": "yik-kā-rêṯ", "traducao_palavra": "sejam destruídos" }
      ]
    },
    "5": {
      "traducao_completa": "O teu bezerro, ó Samaria, é rejeitado; a minha ira se acendeu contra eles; até quando serão eles incapazes de alcançar a inocência?",
      "palavras": [
        { "hebraico": "זָנַח֙", "transliteral": "zā-naḥ", "traducao_palavra": "rejeitou [o culto]/repelente é" },
        { "hebraico": "עֶגְלֵ֣ךְ", "transliteral": "ʿeḡ-lêḵ", "traducao_palavra": "o teu bezerro" },
        { "hebraico": "שֹֽׁמְרֹ֔ון", "transliteral": "šō-mə-rôn", "traducao_palavra": "ó Samaria" },
        { "hebraico": "חָרָ֥ה", "transliteral": "ḥā-rā", "traducao_palavra": "acendeu-se" },
        { "hebraico": "אַפִּ֖י", "transliteral": "ʾap-pî", "traducao_palavra": "a minha ira" },
        { "hebraico": "בָּהֶ֑ם", "transliteral": "bā-hem", "traducao_palavra": "contra eles" },
        { "hebraico": "עַד־מָתַ֕י", "transliteral": "ʿaḏ-mā-ṯay", "traducao_palavra": "até quando" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יוּכְל֖וּ", "transliteral": "yū-ḵə-lû", "traducao_palavra": "poderão alcançar" },
        { "hebraico": "נִקָּיֹֽן׃", "transliteral": "niq-qā-yôn", "traducao_palavra": "a pureza/inocência?" }
      ]
    },
    "6": {
      "traducao_completa": "Porque isso procede de Israel; um artífice o fez, e não é Deus; mas em pedaços será desfeito o bezerro de Samaria.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "מִיִּשְׂרָאֵל֙", "transliteral": "mî-yiś-rā-ʾêl", "traducao_palavra": "de Israel procede" },
        { "hebraico": "וְה֔וּא", "transliteral": "wə-hû", "traducao_palavra": "e ele [é]" },
        { "hebraico": "חָרָ֣שׁ", "transliteral": "ḥā-rāš", "traducao_palavra": "um artífice" },
        { "hebraico": "עָשָׂ֔הוּ", "transliteral": "ʿā-śā-hû", "traducao_palavra": "o fez" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "אֱלֹהִ֖ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "ה֑וּא", "transliteral": "hû", "traducao_palavra": "é ele" },
        { "hebraico": "כִּֽי־שְׁבָבִ֣ים", "transliteral": "kî-šə-ḇā-ḇîm", "traducao_palavra": "porque em estilhas/pedaços" },
        { "hebraico": "יִֽהְיֶ֔ה", "transliteral": "yih-yeh", "traducao_palavra": "será reduzido" },
        { "hebraico": "עֵ֖גֶל", "transliteral": "ʿê-ḡel", "traducao_palavra": "o bezerro de" },
        { "hebraico": "שֹׁמְרֹֽון׃", "transliteral": "šō-mə-rôn", "traducao_palavra": "Samaria" }
      ]
    },
    "7": {
      "traducao_completa": "Porque semeiam vento e ceifarão turbilhão; não haverá seara; o broto não dará farinha; se a der, os estrangeiros a devorarão.",
      "palavras": [
        { "hebraico": "כִּ֛י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "ר֥וּחַ", "transliteral": "rū-aḥ", "traducao_palavra": "vento" },
        { "hebraico": "יִזְרָ֖עוּ", "transliteral": "yiz-rā-ʿû", "traducao_palavra": "semeiam" },
        { "hebraico": "וְסוּפָ֣תָה", "transliteral": "wə-sū-p̄ā-ṯā", "traducao_palavra": "e turbilhão/tempestade" },
        { "hebraico": "יִקְצֹ֑רוּ", "transliteral": "yiq-ṣō-rû", "traducao_palavra": "ceifarão" },
        { "hebraico": "קָמָ֣ה", "transliteral": "qā-mā", "traducao_palavra": "seara espigada" },
        { "hebraico": "אֵֽין־לֹ֗ו", "transliteral": "ʾên-lô", "traducao_palavra": "não há nele" },
        { "hebraico": "צֶ֚מַח", "transliteral": "ṣe-maḥ", "traducao_palavra": "o broto/grão" },
        { "hebraico": "בְּלִ֣י", "transliteral": "bə-lî", "traducao_palavra": "não" },
        { "hebraico": "יַֽעֲשֶׂה־קֶּ֔מַח", "transliteral": "ya-ʿă-śeh-qe-maḥ", "traducao_palavra": "produzirá farinha" },
        { "hebraico": "אוּלַ֣י", "transliteral": "ʾū-lay", "traducao_palavra": "ainda que" },
        { "hebraico": "יַֽעֲשֶׂ֔ה", "transliteral": "ya-ʿă-śeh", "traducao_palavra": "a produza" },
        { "hebraico": "זָרִ֖ים", "transliteral": "zā-rîm", "traducao_palavra": "estrangeiros" },
        { "hebraico": "יִבְלָעֻֽהוּ׃", "transliteral": "yiḇ-lā-ʿu-hû", "traducao_palavra": "a devorarão" }
      ]
    },
    "8": {
      "traducao_completa": "Israel foi devorado; agora está entre as nações como um vaso em que ninguém tem prazer.",
      "palavras": [
        { "hebraico": "נִבְלַ֖ע", "transliteral": "niḇ-laʿ", "traducao_palavra": "devorado foi" },
        { "hebraico": "יִשְׂרָאֵ֑ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "עַתָּה֙", "transliteral": "ʿat-tā", "traducao_palavra": "agora" },
        { "hebraico": "הָי֣וּ", "transliteral": "hā-yû", "traducao_palavra": "eles estão/tornaram-se" },
        { "hebraico": "בַגֹּויִ֔ם", "transliteral": "ḇag-gô-yim", "traducao_palavra": "entre as nações" },
        { "hebraico": "כִּכְלִ֖י", "transliteral": "kik-lî", "traducao_palavra": "como um vaso" },
        { "hebraico": "אֵֽין־חֵ֥פֶץ", "transliteral": "ʾên-ḥê-p̄eṣ", "traducao_palavra": "sem prazer/inútil" },
        { "hebraico": "בֹּֽו׃", "transliteral": "bô", "traducao_palavra": "nele" }
      ]
    },
    "9": {
      "traducao_completa": "Porque subiram à Assíria, como jumento montês solitário; Efraim alugou amantes.",
      "palavras": [
        { "hebraico": "כִּֽי־הֵ֙מָּה֙", "transliteral": "kî-hêm-mā", "traducao_palavra": "porque eles" },
        { "hebraico": "עָל֣וּ", "transliteral": "ʿā-lû", "traducao_palavra": "subiram a" },
        { "hebraico": "אַשּׁ֔וּר", "transliteral": "ʾaš-šūr", "traducao_palavra": "a Assíria" },
        { "hebraico": "עַ֥יִר", "transliteral": "ʿa-yir", "traducao_palavra": "como jumento selvagem" },
        { "hebraico": "בֹּודֵ֖ד", "transliteral": "bô-ḏêḏ", "traducao_palavra": "solitário" },
        { "hebraico": "לֹ֑ו", "transliteral": "lô", "traducao_palavra": "por si mesmo" },
        { "hebraico": "אֶפְרַ֕יִם", "transliteral": "ʾep̄-ra-yim", "traducao_palavra": "Efraim" },
        { "hebraico": "הִתְנ֥וּ", "transliteral": "hiṯ-nû", "traducao_palavra": "contratou/alugou" },
