        { "hebraico": "הֵ֣מָּה", "transliteral": "hêm-mā", "traducao_palavra": "eles" },
        { "hebraico": "בָּ֜אוּ", "transliteral": "bā-ʾû", "traducao_palavra": "foram a" },
