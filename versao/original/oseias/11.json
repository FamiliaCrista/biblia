        { "hebraico": "אַשּׁ֑וּר", "transliteral": "ʾaš-šūr", "traducao_palavra": "Assíria" },
        { "hebraico": "וְהֹושַׁבְתִּ֥ים", "transliteral": "wə-hô-šaḇ-tîm", "traducao_palavra": "e os farei habitar" },
        { "hebraico": "עַל־בָּתֵּיהֶ֖ם", "transliteral": "ʿal-bāt-tê-hem", "traducao_palavra": "nas suas casas" },
        { "hebraico": "נְאֻם־יְהוָֽה׃", "transliteral": "nə-ʾum-YHWH", "traducao_palavra": "declaração de YHWH" }
