        { "hebraico": "הָיוּ֙", "transliteral": "hā-yû", "traducao_palavra": "são/tornaram-se" },
        { "hebraico": "שָׂרֵ֣י", "transliteral": "śā-rê", "traducao_palavra": "os príncipes de" },
        { "hebraico": "יְהוּדָ֔ה", "transliteral": "yə-hū-ḏā", "traducao_palavra": "Judá" },
        { "hebraico": "כְּמַסִּיגֵ֖י", "transliteral": "kə-mas-sî-ḡê", "traducao_palavra": "como os que removem" },
        { "hebraico": "גְּב֑וּל", "transliteral": "gə-ḇūl", "traducao_palavra": "marcos/limites" },
        { "hebraico": "עֲלֵיהֶ֗ם", "transliteral": "ʿă-lê-hem", "traducao_palavra": "sobre eles" },
