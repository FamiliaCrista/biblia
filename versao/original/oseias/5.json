        { "hebraico": "עִמָּֽם׃", "transliteral": "ʿim-mām", "traducao_palavra": "com eles" }
      ]
    },
    "6": {
      "traducao_completa": "Com os seus rebanhos e com o seu gado irão para buscar a YHWH, mas não o acharão; ele se retirou deles.",
