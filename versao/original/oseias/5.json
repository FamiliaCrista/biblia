        { "hebraico": "שִׁמְעוּ־זֹ֣את", "transliteral": "šim-ʿû-zōṯ", "traducao_palavra": "ouvi isto" },
        { "hebraico": "הַכֹּהֲנִ֗ים", "transliteral": "hak-kō-hă-nîm", "traducao_palavra": "ó sacerdotes" },
        { "hebraico": "וְהַקְשִׁ֙יבוּ֙", "transliteral": "wə-haq-šî-ḇû", "traducao_palavra": "e escutai" },
        { "hebraico": "בֵּ֣ית", "transliteral": "bêṯ", "traducao_palavra": "ó casa de" },
