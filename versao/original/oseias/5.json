        { "hebraico": "בָּרָמָ֑ה", "transliteral": "bā-rā-mā", "traducao_palavra": "em Ramá" },
        { "hebraico": "הָרִ֙יעוּ֙", "transliteral": "hā-rî-ʿû", "traducao_palavra": "dai alarme" },
        { "hebraico": "בֵּ֣ית", "transliteral": "bêṯ", "traducao_palavra": "em Bete-" },
