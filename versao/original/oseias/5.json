        { "hebraico": "פְּרוּשָׂ֥ה", "transliteral": "pə-rū-śā", "traducao_palavra": "estendida" },
        { "hebraico": "עַל־תָּבֹֽור׃", "transliteral": "ʿal-tā-ḇôr", "traducao_palavra": "sobre o Tabor" }
      ]
    },
    "2": {
      "traducao_completa": "E os revoltosos se aprofundaram na matança; eu, porém, castigarei a todos eles.",
      "palavras": [
        { "hebraico": "וְשַׁחֲטָ֥ה", "transliteral": "wə-ša-ḥă-ṭā", "traducao_palavra": "e na matança" },
        { "hebraico": "שֵׂטִ֖ים", "transliteral": "śê-ṭîm", "traducao_palavra": "os revoltosos/rebeldes" },
        { "hebraico": "הֶעְמִ֑יקוּ", "transliteral": "heʿ-mî-qû", "traducao_palavra": "aprofundaram-se" },
        { "hebraico": "וַאֲנִ֥י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "mas eu serei" },
