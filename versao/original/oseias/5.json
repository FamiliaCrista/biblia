    "12": {
      "traducao_completa": "Portanto, eu serei para Efraim como a traça, e para a casa de Judá como a podridão.",
      "palavras": [
        { "hebraico": "וַאֲנִ֥י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "portanto eu serei" },
        { "hebraico": "כָעָ֖שׁ", "transliteral": "ḵā-ʿāš", "traducao_palavra": "como a traça" },
