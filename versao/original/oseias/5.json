        { "hebraico": "יָדָֽעוּ׃", "transliteral": "yā-ḏā-ʿû", "traducao_palavra": "conhecem" }
      ]
    },
    "5": {
      "traducao_completa": "A soberba de Israel testifica contra ele na sua face; e Israel e Efraim tropeçarão na sua iniquidade; também Judá tropeçará com eles.",
      "palavras": [
        { "hebraico": "וְעָנָ֥ה", "transliteral": "wə-ʿā-nā", "traducao_palavra": "e testifica" },
        { "hebraico": "גְאֹֽון־יִשְׂרָאֵ֖ל", "transliteral": "gə-ʾôn-yiś-rā-ʾêl", "traducao_palavra": "a soberba de Israel" },
        { "hebraico": "בְּפָנָ֑יו", "transliteral": "bə-p̄ā-nāyw", "traducao_palavra": "na sua face" },
