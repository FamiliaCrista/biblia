    "8": {
      "traducao_completa": "Tocai a trombeta em Gibeá, a corneta em Ramá; clamai em Bete-Áven: Após ti, ó Benjamim!",
      "palavras": [
        { "hebraico": "תִּקְע֤וּ", "transliteral": "tiq-ʿû", "traducao_palavra": "tocai" },
        { "hebraico": "שֹׁופָר֙", "transliteral": "šô-p̄ār", "traducao_palavra": "o shofar/trombeta" },
