        { "hebraico": "כַּמַּ֖יִם", "transliteral": "kam-ma-yim", "traducao_palavra": "como água" },
        { "hebraico": "עֶבְרָתִֽי׃", "transliteral": "ʿeḇ-rā-ṯî", "traducao_palavra": "o meu furor" }
      ]
    },
    "11": {
      "traducao_completa": "Efraim está oprimido e quebrantado no juízo, porque quis andar após a vaidade.",
      "palavras": [
        { "hebraico": "עָשׁ֥וּק", "transliteral": "ʿā-šûq", "traducao_palavra": "oprimido [está]" },
        { "hebraico": "אֶפְרַ֖יִם", "transliteral": "ʾep̄-ra-yim", "traducao_palavra": "Efraim" },
