        { "hebraico": "אֶפְרַ֙יִם֙", "transliteral": "ʾep̄-ra-yim", "traducao_palavra": "Efraim" },
        { "hebraico": "לְשַׁמָּ֣ה", "transliteral": "lə-šam-mā", "traducao_palavra": "em desolação" },
        { "hebraico": "תִֽהְיֶ֔ה", "transliteral": "ṯih-yeh", "traducao_palavra": "se tornará" },
        { "hebraico": "בְּיֹ֖ום", "transliteral": "bə-yôm", "traducao_palavra": "no dia de" },
