        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לָכֶם֙", "transliteral": "lā-ḵem", "traducao_palavra": "a vós pertence" },
        { "hebraico": "הַמִּשְׁפָּ֔ט", "transliteral": "ham-miš-pāṭ", "traducao_palavra": "o julgamento/juízo" },
        { "hebraico": "כִּֽי־פַח֙", "transliteral": "kî-p̄aḥ", "traducao_palavra": "pois um laço" },
        { "hebraico": "הֱיִיתֶ֣ם", "transliteral": "hĕ-yî-ṯem", "traducao_palavra": "fostes" },
