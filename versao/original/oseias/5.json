        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִתְּנ֣וּ", "transliteral": "yit-tə-nû", "traducao_palavra": "permitem" },
        { "hebraico": "מַֽעַלְלֵיהֶ֗ם", "transliteral": "ma-ʿal-lê-hem", "traducao_palavra": "as suas ações/obras" },
        { "hebraico": "לָשׁוּב֙", "transliteral": "lā-šūḇ", "traducao_palavra": "o voltarem" },
        { "hebraico": "אֶל־אֱלֹ֣הֵיהֶ֔ם", "transliteral": "ʾel-ʾĕ-lō-hê-hem", "traducao_palavra": "para o seu Deus" },
