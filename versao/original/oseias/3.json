        { "hebraico": "אֶל־אֱלֹהִ֣ים", "transliteral": "ʾel-ʾĕ-lō-hîm", "traducao_palavra": "para deuses" },
        { "hebraico": "אֲחֵרִ֔ים", "transliteral": "ʾă-ḥê-rîm", "traducao_palavra": "outros" },
        { "hebraico": "וְאֹהֲבֵ֖י", "transliteral": "wə-ʾō-hă-ḇê", "traducao_palavra": "e amem" },
        { "hebraico": "אֲשִׁישֵׁ֥י", "transliteral": "ʾă-šî-šê", "traducao_palavra": "bolos de passas de" },
        { "hebraico": "עֲנָבִֽים׃", "transliteral": "ʿă-nā-ḇîm", "traducao_palavra": "uvas" }
      ]
    },
    "2": {
      "traducao_completa": "E comprei-a para mim por quinze moedas de prata, e um ômer de cevada, e meio ômer de cevada.",
      "palavras": [
        { "hebraico": "וָאֶכְּרֶ֥הָ", "transliteral": "wā-ʾek-kə-re-hā", "traducao_palavra": "e comprei-a" },
        { "hebraico": "לִּ֖י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "בַּחֲמִשָּׁ֣ה", "transliteral": "ba-ḥă-miš-šā", "traducao_palavra": "por cinco" },
        { "hebraico": "עָשָׂ֣ר", "transliteral": "ʿā-śār", "traducao_palavra": "dez [quinze]" },
        { "hebraico": "כָּ֑סֶף", "transliteral": "kā-sep̄", "traducao_palavra": "[moedas de] prata" },
