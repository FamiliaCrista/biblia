        { "hebraico": "מַלְכָּ֑ם", "transliteral": "mal-kām", "traducao_palavra": "seu rei" },
        { "hebraico": "וּפָחֲד֧וּ", "transliteral": "ū-p̄ā-ḥă-ḏû", "traducao_palavra": "e com temor tremendo virão" },
        { "hebraico": "אֶל־יְהוָ֛ה", "transliteral": "ʾel-YHWH", "traducao_palavra": "a YHWH" },
        { "hebraico": "וְאֶל־טוּבֹ֖ו", "transliteral": "wə-ʾel-ṭū-ḇô", "traducao_palavra": "e à sua bondade" },
        { "hebraico": "בְּאַחֲרִ֥ית", "transliteral": "bə-ʾa-ḥă-rîṯ", "traducao_palavra": "no fim de" },
