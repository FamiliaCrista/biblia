    },
    "5": {
      "traducao_completa": "Depois tornarão os filhos de Israel, e buscarão a YHWH, seu Deus, e a Davi, seu rei; e com temor se achegarão a YHWH e à sua bondade, no fim dos dias.",
      "palavras": [
        { "hebraico": "אַחַ֗ר", "transliteral": "ʾa-ḥar", "traducao_palavra": "depois" },
        { "hebraico": "יָשֻׁ֙בוּ֙", "transliteral": "yā-šu-ḇû", "traducao_palavra": "voltarão" },
        { "hebraico": "בְּנֵ֣י", "transliteral": "bə-nê", "traducao_palavra": "os filhos de" },
        { "hebraico": "יִשְׂרָאֵ֔ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "וּבִקְשׁוּ֙", "transliteral": "ū-ḇiq-šû", "traducao_palavra": "e buscarão" },
        { "hebraico": "אֶת־יְהוָ֣ה", "transliteral": "ʾeṯ-YHWH", "traducao_palavra": "a YHWH" },
        { "hebraico": "אֱלֹהֵיהֶ֔ם", "transliteral": "ʾĕ-lō-hê-hem", "traducao_palavra": "seu Deus" },
        { "hebraico": "וְאֵ֖ת", "transliteral": "wə-ʾêṯ", "traducao_palavra": "e a" },
