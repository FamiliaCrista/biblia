        { "hebraico": "אֵלֶ֗יהָ", "transliteral": "ʾê-le-hā", "traducao_palavra": "a ela" },
        { "hebraico": "יָמִ֤ים", "transliteral": "yā-mîm", "traducao_palavra": "dias" },
        { "hebraico": "רַבִּים֙", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
        { "hebraico": "תֵּ֣שְׁבִי", "transliteral": "tê-šə-ḇî", "traducao_palavra": "esperarás/habitarás" },
        { "hebraico": "לִ֔י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תִזְנִ֔י", "transliteral": "ṯiz-nî", "traducao_palavra": "te prostituirás" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "תִהְיִ֖י", "transliteral": "ṯih-yî", "traducao_palavra": "serás [mulher]" },
        { "hebraico": "לְאִ֑ישׁ", "transliteral": "lə-ʾîš", "traducao_palavra": "de outro homem" },
        { "hebraico": "וְגַם־אֲנִ֖י", "transliteral": "wə-ḡam-ʾă-nî", "traducao_palavra": "e também eu serei" },
        { "hebraico": "אֵלָֽיִךְ׃", "transliteral": "ʾê-lā-yiḵ", "traducao_palavra": "para contigo" }
      ]
    },
    "4": {
      "traducao_completa": "Porque os filhos de Israel ficarão por muitos dias sem rei, e sem príncipe, e sem sacrifício, e sem estátua, e sem éfode, e sem terafins.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "יָמִ֣ים", "transliteral": "yā-mîm", "traducao_palavra": "dias" },
        { "hebraico": "רַבִּ֗ים", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
        { "hebraico": "יֵשְׁבוּ֙", "transliteral": "yê-šə-ḇû", "traducao_palavra": "ficarão/habitarão" },
        { "hebraico": "בְּנֵ֣י", "transliteral": "bə-nê", "traducao_palavra": "os filhos de" },
        { "hebraico": "יִשְׂרָאֵ֔ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "אֵ֣ין", "transliteral": "ʾên", "traducao_palavra": "sem" },
        { "hebraico": "מֶ֤לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "rei" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e sem" },
        { "hebraico": "שָׂ֔ר", "transliteral": "śār", "traducao_palavra": "príncipe/líder" },
        { "hebraico": "וְאֵ֥ין", "transliteral": "wə-ʾên", "traducao_palavra": "e sem" },
        { "hebraico": "זֶ֖בַח", "transliteral": "ze-ḇaḥ", "traducao_palavra": "sacrifício" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e sem" },
        { "hebraico": "מַצֵּבָ֑ה", "transliteral": "maṣ-ṣê-ḇā", "traducao_palavra": "estátua/coluna sagrada" },
        { "hebraico": "וְאֵ֥ין", "transliteral": "wə-ʾên", "traducao_palavra": "e sem" },
        { "hebraico": "אֵפֹ֖וד", "transliteral": "ʾê-p̄ôḏ", "traducao_palavra": "éfode" },
        { "hebraico": "וּתְרָפִֽים׃", "transliteral": "ū-ṯə-rā-p̄îm", "traducao_palavra": "e terafins" }
