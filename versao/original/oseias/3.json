  "versiculos": {
    "1": {
      "traducao_completa": "E YHWH me disse: Vai outra vez, ama uma mulher amada de seu amigo e adúltera, como o amor de YHWH pelos filhos de Israel, embora eles olhem para outros deuses e amem os bolos de passas de uvas.",
      "palavras": [
        { "hebraico": "וַיֹּ֨אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "יְהוָ֜ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֵלַ֗י", "transliteral": "ʾê-lay", "traducao_palavra": "a mim" },
        { "hebraico": "עֹ֚וד", "transliteral": "ʿôḏ", "traducao_palavra": "outra vez" },
        { "hebraico": "לֵ֣ךְ", "transliteral": "lêḵ", "traducao_palavra": "vai" },
        { "hebraico": "אֱֽהַב־אִשָּׁ֔ה", "transliteral": "ʾĕ-haḇ-ʾiš-šā", "traducao_palavra": "ama uma mulher" },
        { "hebraico": "אֲהֻ֥בַת", "transliteral": "ʾă-hu-ḇaṯ", "traducao_palavra": "amada por um" },
        { "hebraico": "רֵ֖עַ", "transliteral": "rē-aʿ", "traducao_palavra": "amante/amigo" },
        { "hebraico": "וּמְנָאָ֑פַת", "transliteral": "ū-mə-nā-ʾā-p̄aṯ", "traducao_palavra": "e adúltera" },
        { "hebraico": "כְּאַהֲבַ֤ת", "transliteral": "kə-ʾa-hă-ḇaṯ", "traducao_palavra": "como o amor de" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֶת־בְּנֵ֣י", "transliteral": "ʾeṯ-bə-nê", "traducao_palavra": "para com os filhos de" },
        { "hebraico": "יִשְׂרָאֵ֔ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "וְהֵ֗ם", "transliteral": "wə-hêm", "traducao_palavra": "embora eles" },
