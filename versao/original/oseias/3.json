        { "hebraico": "שְׂעֹרִֽים׃", "transliteral": "śə-ʿō-rîm", "traducao_palavra": "cevada" }
      ]
    },
    "3": {
      "traducao_completa": "E eu lhe disse: Por muitos dias ficarás para mim; não te prostituirás, nem serás mulher de outro homem; e assim também eu serei para contigo.",
