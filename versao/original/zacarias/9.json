        { "hebraico": "יִתְקָ֔ע", "transliteral": "yiṯ-qāʿ", "traducao_palavra": "tocará" },
        { "hebraico": "וְהָלַ֖ךְ", "transliteral": "wə-hā-laḵ", "traducao_palavra": "e marchará" },
