        { "hebraico": "יְהוָ֧ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהֵיהֶ֛ם", "transliteral": "ʾĕ-lō-hê-hem", "traducao_palavra": "o Deus deles" },
        { "hebraico": "בַּיּ֥וֹם", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
