        { "hebraico": "אֲסִירֵ֖י", "transliteral": "ʾă-sî-rê", "traducao_palavra": "presos de" },
        { "hebraico": "הַתִּקְוָ֑ה", "transliteral": "hat-tiq-wā", "traducao_palavra": "a esperança" },
        { "hebraico": "גַּם־הַיּ֕וֹם", "transliteral": "gam-hay-yôm", "traducao_palavra": "ainda hoje" },
