        { "hebraico": "אֶל־הַשָּׂטָ֗ן", "transliteral": "ʾel-haś-śā-ṭān", "traducao_palavra": "ao Acusador [Satanás]" },
        { "hebraico": "יִגְעַ֨ר", "transliteral": "yiḡ-ʿar", "traducao_palavra": "repreenda" },
