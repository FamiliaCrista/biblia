        { "hebraico": "לִפְנֵ֖י", "transliteral": "lip̄-nê", "traducao_palavra": "diante de" },
        { "hebraico": "מַלְאַ֣ךְ", "transliteral": "mal-ʾaḵ", "traducao_palavra": "o anjo de" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וְהַשָּׂטָ֛ן", "transliteral": "wə-haś-śā-ṭān", "traducao_palavra": "e o Acusador [Satanás]" },
        { "hebraico": "עֹמֵ֥ד", "transliteral": "ʿō-mêḏ", "traducao_palavra": "estava em pé" },
        { "hebraico": "עַל־יְמִינֹ֖ו", "transliteral": "ʿal-yə-mî-nô", "traducao_palavra": "à sua direita" },
