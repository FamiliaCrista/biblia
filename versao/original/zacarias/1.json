        { "hebraico": "קָֽצֶף׃", "transliteral": "qā-ṣep̄", "traducao_palavra": "[com grande] indignação" }
      ]
    },
    "3": {
      "traducao_completa": "Portanto, dize-lhes: Assim diz YHWH dos Exércitos: Convertei-vos a mim, diz YHWH dos Exércitos, e eu me tornarei a vós, diz YHWH dos Exércitos.",
