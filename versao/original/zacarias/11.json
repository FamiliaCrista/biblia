        { "hebraico": "כִּֽי־נָ֤פַל", "transliteral": "kî-nā-p̄al", "traducao_palavra": "porque caiu" },
        { "hebraico": "אֶ֙רֶז֙", "transliteral": "ʾe-rez", "traducao_palavra": "o cedro" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "porque" },
        { "hebraico": "אַדִּרִ֖ים", "transliteral": "ʾad-di-rîm", "traducao_palavra": "os poderosos / magnos" },
        { "hebraico": "שֻׁדָּ֑דוּ", "transliteral": "šud-dā-ḏû", "traducao_palavra": "foram destruídos" },
        { "hebraico": "הֵילִ֙ילוּ֙", "transliteral": "hê-lî-lû", "traducao_palavra": "uivai" },
        { "hebraico": "אַלּוֹנֵ֣י", "transliteral": "ʾal-lô-nê", "traducao_palavra": "carvalhos de" },
        { "hebraico": "בָשָׁ֔ן", "transliteral": "ḇā-šān", "traducao_palavra": "Basã" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "יָרַ֖ד", "transliteral": "yā-raḏ", "traducao_palavra": "caiu / desceu" },
        { "hebraico": "יַ֥עַר", "transliteral": "ya-ʿar", "traducao_palavra": "o bosque / floresta" },
        { "hebraico": "הַבָּצִֽיר׃", "transliteral": "hab-bā-ṣîr", "traducao_palavra": "impenetrável / fortificada" }
      ]
    },
    "3": {
      "traducao_completa": "Voz de uivo dos pastores! Porque a sua glória foi destruída; voz de bramido de leõezinhos! Porque a soberba do Jordão foi assolada.",
      "palavras": [
        { "hebraico": "ק֚וֹל", "transliteral": "qôl", "traducao_palavra": "voz de" },
        { "hebraico": "יִֽלְלַ֣ת", "transliteral": "yil-laṯ", "traducao_palavra": "uivo de" },
        { "hebraico": "הָרֹעִ֔ים", "transliteral": "hā-rō-ʿîm", "traducao_palavra": "os pastores" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
