        { "hebraico": "לְבָנ֖וֹן", "transliteral": "lə-ḇā-nôn", "traducao_palavra": "ó Líbano" },
        { "hebraico": "דְּלָתֶ֑יךָ", "transliteral": "də-lā-ṯe-ḵā", "traducao_palavra": "as tuas portas" },
        { "hebraico": "וְתֹאכַ֥ל", "transliteral": "wə-ṯō-ḵal", "traducao_palavra": "para que consuma" },
        { "hebraico": "אֵ֖שׁ", "transliteral": "ʾēš", "traducao_palavra": "o fogo" },
        { "hebraico": "בַּאֲרָזֶֽיךָ׃", "transliteral": "ba-ʾă-rā-ze-ḵā", "traducao_palavra": "os teus cedros" }
      ]
    },
    "2": {
      "traducao_completa": "Uiva, cipreste, porque o cedro caiu, porque os mais nobres são destruídos; uivai, carvalhos de Basã, porque o bosque impenetrável foi derribado.",
      "palavras": [
