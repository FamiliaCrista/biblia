      ]
    },
    "5": {
      "traducao_completa": "cujos compradores as matam e não se consideram culpados; e os que as vendem dizem: Bendito seja YHWH, porque enriqueci; e os seus pastores não se compadecem delas.",
      "palavras": [
        { "hebraico": "אֲשֶׁ֨ר", "transliteral": "ʾă-šer", "traducao_palavra": "cujos" },
        { "hebraico": "קֹנֵיהֶ֣ן", "transliteral": "qō-nê-hen", "traducao_palavra": "compradores delas" },
        { "hebraico": "יַהַרְגֻן֮", "transliteral": "ya-har-ḡun", "traducao_palavra": "as matam" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יֶאְשָׁמוּ֒", "transliteral": "yeʾ-šā-mû", "traducao_palavra": "se têm por culpados" },
        { "hebraico": "וּמֹכְרֵיהֶ֣ן", "transliteral": "ū-mō-ḵə-rê-hen", "traducao_palavra": "e os vendedores delas" },
        { "hebraico": "יֹאמַ֗ר", "transliteral": "yō-mar", "traducao_palavra": "dizem" },
        { "hebraico": "בָּר֤וּךְ", "transliteral": "bā-rûḵ", "traducao_palavra": "bendito seja" },
