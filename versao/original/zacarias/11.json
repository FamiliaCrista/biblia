    },
    "4": {
      "traducao_completa": "Assim diz YHWH meu Deus: Apascenta as ovelhas da matança,",
      "palavras": [
        { "hebraico": "כֹּ֥ה", "transliteral": "kōh", "traducao_palavra": "assim" },
        { "hebraico": "אָמַ֖ר", "transliteral": "ʾā-mar", "traducao_palavra": "diz" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהָ֑י", "transliteral": "ʾĕ-lō-hāy", "traducao_palavra": "meu Deus" },
        { "hebraico": "רְעֵ֖ה", "transliteral": "rə-ʿēh", "traducao_palavra": "apascenta" },
