        { "hebraico": "וְרֹ֣עֵיהֶ֔ם", "transliteral": "wə-rō-ʿê-hem", "traducao_palavra": "e os pastores delas" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יַחְמ֖וֹל", "transliteral": "yaḥ-môl", "traducao_palavra": "se compadecem" },
        { "hebraico": "עֲלֵיהֶֽן׃", "transliteral": "ʿă-lê-hen", "traducao_palavra": "delas" }
      ]
    },
    "6": {
      "traducao_completa": "Porque não me compadecerei mais dos habitantes desta terra, diz YHWH; mas eis que entregarei os homens, cada um na mão do seu próximo e na mão do seu rei; eles ferirão a terra, e eu não os livrarei da sua mão.",
      "palavras": [
        { "hebraico": "כִּ֠י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֶחְמ֣וֹל", "transliteral": "ʾeḥ-môl", "traducao_palavra": "me compadecerei" },
        { "hebraico": "ע֗וֹד", "transliteral": "ʿôḏ", "traducao_palavra": "mais" },
        { "hebraico": "עַל־יֹשְׁבֵ֥י", "transliteral": "ʿal-yō-šə-ḇê", "traducao_palavra": "dos habitantes de" },
        { "hebraico": "הָאָ֛רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "נְאֻם־יְהוָ֑ה", "transliteral": "nə-ʾum-YHWH", "traducao_palavra": "declaração de YHWH" },
        { "hebraico": "וְהִנֵּ֨ה", "transliteral": "wə-hin-nēh", "traducao_palavra": "e eis que" },
        { "hebraico": "אָנֹכִ֜י", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "eu" },
        { "hebraico": "מַמְצִ֣יא", "transliteral": "mam-ṣî", "traducao_palavra": "entregarei / farei cair" },
        { "hebraico": "אֶת־הָאָדָ֗ם", "transliteral": "ʾeṯ-hā-ʾā-ḏām", "traducao_palavra": "o homem" },
        { "hebraico": "אִ֤ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada um" },
        { "hebraico": "בְּיַד־רֵעֵ֙הוּ֙", "transliteral": "bə-yaḏ-rê-ʿê-hû", "traducao_palavra": "na mão do seu próximo" },
        { "hebraico": "וּבְיַ֣ד", "transliteral": "ū-ḇə-yaḏ", "traducao_palavra": "e na mão de" },
        { "hebraico": "מַלְכּ֔וֹ", "transliteral": "mal-kô", "traducao_palavra": "seu rei" },
        { "hebraico": "וְכִתְּתוּ֙", "transliteral": "wə-ḵit-tə-ṯû", "traducao_palavra": "e esmagarão / ferirão" },
        { "hebraico": "אֶת־הָאָ֔רֶץ", "transliteral": "ʾeṯ-hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "אַצִּ֖יל", "transliteral": "ʾaṣ-ṣîl", "traducao_palavra": "livrarei" },
        { "hebraico": "מִיָּדָֽם׃", "transliteral": "mî-yā-ḏām", "traducao_palavra": "da mão deles" }
      ]
    },
    "7": {
      "traducao_completa": "Apascentei, pois, as ovelhas da matança, os mais pobres do rebanho; e tomei para mim duas varas: a uma chamei Graça, e à outra chamei União; e apascentei o rebanho.",
      "palavras": [
        { "hebraico": "וָאֶרְעֶה֙", "transliteral": "wā-ʾer-ʿeh", "traducao_palavra": "e apascentei" },
        { "hebraico": "אֶת־צֹ֣אן", "transliteral": "ʾeṯ-ṣōn", "traducao_palavra": "o rebanho de" },
        { "hebraico": "הַֽהֲרֵגָ֔ה", "transliteral": "ha-hă-rê-ḡā", "traducao_palavra": "a matança" },
        { "hebraico": "לָכֵ֖ן", "transliteral": "lā-ḵên", "traducao_palavra": "certamente / em verdade" },
        { "hebraico": "עֲנִיֵּ֣י", "transliteral": "ʿă-niy-yê", "traducao_palavra": "os mais pobres de" },
        { "hebraico": "הַצֹּ֑אן", "transliteral": "haṣ-ṣōn", "traducao_palavra": "o rebanho" },
        { "hebraico": "וָאֶקַּֽח־לִ֞י", "transliteral": "wā-ʾeq-qaḥ-lî", "traducao_palavra": "e tomei para mim" },
        { "hebraico": "שְׁנֵ֣י", "transliteral": "šə-nê", "traducao_palavra": "duas" },
        { "hebraico": "מַקְל֗וֹת", "transliteral": "maq-lôṯ", "traducao_palavra": "varas" },
        { "hebraico": "לְאַחַ֞ד", "transliteral": "lə-ʾa-ḥaḏ", "traducao_palavra": "a uma" },
        { "hebraico": "קָרָ֤אתִי", "transliteral": "qā-rā-ṯî", "traducao_palavra": "chamei" },
        { "hebraico": "נֹ֙עַם֙", "transliteral": "nō-ʿam", "traducao_palavra": "Graça / Suavidade" },
        { "hebraico": "וּלְאַחַד֙", "transliteral": "ū-lə-ʾa-ḥaḏ", "traducao_palavra": "e à outra" },
        { "hebraico": "קָרָ֣אתִי", "transliteral": "qā-rā-ṯî", "traducao_palavra": "chamei" },
        { "hebraico": "חֹבְלִ֔ים", "transliteral": "ḥō-ḇə-lîm", "traducao_palavra": "União / Vínculos" },
        { "hebraico": "וָאֶרְעֶ֖ה", "transliteral": "wā-ʾer-ʿeh", "traducao_palavra": "e apascentei" },
        { "hebraico": "אֶת־הַצֹּֽאן׃", "transliteral": "ʾeṯ-haṣ-ṣōn", "traducao_palavra": "o rebanho" }
      ]
    },
    "8": {
      "traducao_completa": "E dei cabo de três pastores num só mês; pois a minha alma se impacientou com eles, e também a alma deles teve abominação de mim.",
      "palavras": [
        { "hebraico": "וָאַכְחִ֛ד", "transliteral": "wā-ʾaḵ-ḥiḏ", "traducao_palavra": "e eliminei / destruí" },
        { "hebraico": "אֶת־שְׁלֹ֥שֶׁת", "transliteral": "ʾeṯ-šə-lō-šeṯ", "traducao_palavra": "os três" },
        { "hebraico": "הָרֹעִ֖ים", "transliteral": "hā-rō-ʿîm", "traducao_palavra": "pastores" },
        { "hebraico": "בְּיֶ֣רַח", "transliteral": "bə-ye-raḥ", "traducao_palavra": "em mês" },
        { "hebraico": "אֶחָ֑ד", "transliteral": "ʾe-ḥāḏ", "traducao_palavra": "um só" },
        { "hebraico": "וַתִּקְצַ֤ר", "transliteral": "wat-tiq-ṣar", "traducao_palavra": "e impacientou-se" },
        { "hebraico": "נַפְשִׁי֙", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "בָּהֶ֔ם", "transliteral": "bā-hem", "traducao_palavra": "com eles" },
        { "hebraico": "וְגַ֥ם", "transliteral": "wə-ḡam", "traducao_palavra": "e também" },
        { "hebraico": "נַפְשָׁ֖ם", "transliteral": "nap̄-šām", "traducao_palavra": "a alma deles" },
        { "hebraico": "בָּחֲלָ֥ה", "transliteral": "bā-ḥă-lā", "traducao_palavra": "aborreceu / teve náusea de" },
        { "hebraico": "בִֽי׃", "transliteral": "ḇî", "traducao_palavra": "mim" }
      ]
    },
    "9": {
      "traducao_completa": "Então eu disse: Não vos apascentarei mais; o que morre, morra; e o que for destruído, seja destruído; e as que restarem, comam a carne umas das outras.",
      "palavras": [
        { "hebraico": "וָאֹמַ֕ר", "transliteral": "wā-ʾō-mar", "traducao_palavra": "e eu disse" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֶרְעֶ֖ה", "transliteral": "ʾer-ʿeh", "traducao_palavra": "apascentarei" },
        { "hebraico": "אֶתְכֶ֑ם", "transliteral": "ʾeṯ-ḵem", "traducao_palavra": "a vós" },
        { "hebraico": "הַמֵּתָ֣ה", "transliteral": "ham-mê-ṯā", "traducao_palavra": "a que morre" },
        { "hebraico": "תָמ֔וּת", "transliteral": "tā-mûṯ", "traducao_palavra": "morra" },
        { "hebraico": "וְהַנִּכְחֶ֣דֶת", "transliteral": "wə-han-niḵ-ḥe-ḏeṯ", "traducao_palavra": "e a que é destruída" },
        { "hebraico": "תִּכָּחֵ֔ד", "transliteral": "tik-kā-ḥêḏ", "traducao_palavra": "seja destruída" },
        { "hebraico": "וְהַ֨נִּשְׁאָר֔וֹת", "transliteral": "wə-han-niš-ʾā-rôṯ", "traducao_palavra": "e as restantes" },
        { "hebraico": "תֹּאכַ֕לְנָה", "transliteral": "tō-ḵal-nā", "traducao_palavra": "comam" },
        { "hebraico": "אִשָּׁ֖ה", "transliteral": "ʾiš-šā", "traducao_palavra": "cada uma" },
        { "hebraico": "אֶת־בְּשַׂ֥ר", "transliteral": "ʾeṯ-bə-śar", "traducao_palavra": "a carne de" },
        { "hebraico": "רְעוּתָֽהּ׃", "transliteral": "rə-ʿû-ṯāh", "traducao_palavra": "sua companheira" }
      ]
    },
    "10": {
      "traducao_completa": "E tomei a minha vara chamada Graça, e a quebrei, para anular a minha aliança, que eu tinha feito com todos os povos.",
      "palavras": [
        { "hebraico": "וָאֶקַּ֤ח", "transliteral": "wā-ʾeq-qaḥ", "traducao_palavra": "e tomei" },
        { "hebraico": "אֶת־מַקְלִי֙", "transliteral": "ʾeṯ-maq-lî", "traducao_palavra": "a minha vara" },
        { "hebraico": "אֶת־נֹ֔עַם", "transliteral": "ʾeṯ-nō-ʿam", "traducao_palavra": "chamada Graça" },
        { "hebraico": "וָאֶגְדַּ֖ע", "transliteral": "wā-ʾeḡ-daʿ", "traducao_palavra": "e a quebrei" },
        { "hebraico": "אֹת֑וֹ", "transliteral": "ʾō-ṯô", "traducao_palavra": "a ela" },
        { "hebraico": "לְהָפֵיר֙", "transliteral": "lə-hā-p̄êr", "traducao_palavra": "para anular / romper" },
        { "hebraico": "אֶת־בְּרִיתִ֔י", "transliteral": "ʾeṯ-bə-rî-ṯî", "traducao_palavra": "a minha aliança" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "כָּרַ֖תִּי", "transliteral": "kā-rat-tî", "traducao_palavra": "tinha feito" },
        { "hebraico": "אֶת־כָּל־הָעַמִּֽים׃", "transliteral": "ʾeṯ-kāl-hā-ʿam-mîm", "traducao_palavra": "com todos os povos" }
      ]
    },
    "11": {
      "traducao_completa": "E foi anulada naquele dia; assim reconheceram os pobres do rebanho, que me respeitavam, que isto era palavra de YHWH.",
