        { "hebraico": "סוּסִ֣ים", "transliteral": "sû-sîm", "traducao_palavra": "cavalos" },
        { "hebraico": "אֲדֻמִּ֑ים", "transliteral": "ʾă-ḏum-mîm", "traducao_palavra": "vermelhos" },
        { "hebraico": "וּבַמֶּרְכָּבָ֥ה", "transliteral": "ū-ḇam-mer-kā-ḇā", "traducao_palavra": "e no carro" },
        { "hebraico": "הַשֵּׁנִ֖ית", "transliteral": "haš-šê-nîṯ", "traducao_palavra": "segundo" },
