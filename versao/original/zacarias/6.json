        { "hebraico": "וּבָאתָ֗", "transliteral": "ū-ḇā-ṯā", "traducao_palavra": "e entra" },
        { "hebraico": "בֵּ֚ית", "transliteral": "bêṯ", "traducao_palavra": "na casa de" },
        { "hebraico": "יֹאשִׁיָּ֣ה", "transliteral": "yō-šî-yā", "traducao_palavra": "Josias" },
        { "hebraico": "בֶן־צְפַנְיָ֔ה", "transliteral": "ḇen-ṣə-p̄an-yā", "traducao_palavra": "filho de Sofonias" },
        { "hebraico": "אֲשֶׁר־בָּ֖אוּ", "transliteral": "ʾă-šer-bā-ʾû", "traducao_palavra": "que vieram" },
