        { "hebraico": "לְהִתְהַלֵּ֣ךְ", "transliteral": "lə-hiṯ-hal-lêḵ", "traducao_palavra": "para percorrer" },
        { "hebraico": "בָּאָ֔רֶץ", "transliteral": "bā-ʾā-reṣ", "traducao_palavra": "a terra" },
