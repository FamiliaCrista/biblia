    "8": {
      "traducao_completa": "Então me chamou, e me falou, dizendo: Vê, aqueles que saíram para a terra do norte fizeram repousar o meu Espírito na terra do norte.",
      "palavras": [
        { "hebraico": "וַיַּזְעֵ֣ק", "transliteral": "way-yaz-ʿêq", "traducao_palavra": "e clamou" },
        { "hebraico": "אֹתִ֔י", "transliteral": "ʾō-ṯî", "traducao_palavra": "a mim" },
        { "hebraico": "וַיְדַבֵּ֥ר", "transliteral": "way-ḏab-bêr", "traducao_palavra": "e falou" },
        { "hebraico": "אֵלַ֖י", "transliteral": "ʾê-lay", "traducao_palavra": "a mim" },
        { "hebraico": "לֵאמֹ֑ר", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" },
        { "hebraico": "רְאֵ֗ה", "transliteral": "rə-ʾēh", "traducao_palavra": "vê" },
