        { "hebraico": "וְהַלְּבָנִ֔ים", "transliteral": "wə-hal-lə-ḇā-nîm", "traducao_palavra": "e os brancos" },
        { "hebraico": "יָצְא֖וּ", "transliteral": "yā-ṣə-ʾû", "traducao_palavra": "saem" },
        { "hebraico": "אֶל־אַחֲרֵיהֶ֑ם", "transliteral": "ʾel-ʾa-ḥă-rê-hem", "traducao_palavra": "após eles" },
        { "hebraico": "וְהַבְּרֻדִּ֕ים", "transliteral": "wə-hab-bə-rud-dîm", "traducao_palavra": "e os malhados" },
        { "hebraico": "יָצְא֖וּ", "transliteral": "yā-ṣə-ʾû", "traducao_palavra": "saem" },
        { "hebraico": "אֶל־אֶ֥רֶץ", "transliteral": "ʾel-ʾe-reṣ", "traducao_palavra": "para a terra do" },
        { "hebraico": "הַתֵּימָֽן׃", "transliteral": "hat-tê-mān", "traducao_palavra": "sul" }
      ]
    },
    "7": {
      "traducao_completa": "E os cavalos fortes saíam, e procuravam ir para percorrerem a terra. E ele disse: Ide, percorrei a terra. E percorreram a terra.",
      "palavras": [
        { "hebraico": "וְהָאֲמֻצִּ֣ים", "transliteral": "wə-hā-ʾă-muṣ-ṣîm", "traducao_palavra": "e os fortes" },
        { "hebraico": "יָצְא֗וּ", "transliteral": "yā-ṣə-ʾû", "traducao_palavra": "saíam" },
        { "hebraico": "וַיְבַקְשׁוּ֙", "transliteral": "way-ḇaq-šû", "traducao_palavra": "e procuravam" },
