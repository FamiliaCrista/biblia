        { "hebraico": "וְשַׂמְתָּ֗", "transliteral": "wə-śam-tā", "traducao_palavra": "e as porás" },
        { "hebraico": "בְּרֹ֛אשׁ", "transliteral": "bə-rōʾš", "traducao_palavra": "na cabeça de" },
        { "hebraico": "יְהֹושֻׁ֥עַ", "transliteral": "yə-hô-šu-aʿ", "traducao_palavra": "Josué" },
        { "hebraico": "בֶּן־יְהֹוצָדָ֖ק", "transliteral": "ben-yə-hô-ṣā-ḏāq", "traducao_palavra": "filho de Jeozadaque" },
        { "hebraico": "הַכֹּהֵ֥ן", "transliteral": "hak-kō-hên", "traducao_palavra": "o sacerdote" },
