    "4": {
      "traducao_completa": "E respondi, dizendo ao anjo que falava comigo: Que é isto, meu senhor?",
      "palavras": [
        { "hebraico": "וָאַ֙עַן֙", "transliteral": "wā-ʾa-ʿan", "traducao_palavra": "e respondi" },
        { "hebraico": "וָֽאֹמַ֔ר", "transliteral": "wā-ʾō-mar", "traducao_palavra": "e disse" },
        { "hebraico": "אֶל־הַמַּלְאָ֖ךְ", "transliteral": "ʾel-ham-mal-ʾāḵ", "traducao_palavra": "ao anjo" },
