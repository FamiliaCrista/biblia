        { "hebraico": "הֶֽהָרִ֑ים", "transliteral": "he-hā-rîm", "traducao_palavra": "os montes" },
        { "hebraico": "וְהֶהָרִ֖ים", "transliteral": "wə-he-hā-rîm", "traducao_palavra": "e os montes [eram]" },
        { "hebraico": "הָרֵ֥י", "transliteral": "hā-rê", "traducao_palavra": "montes de" },
