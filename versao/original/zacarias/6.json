    "6": {
      "traducao_completa": "O carro em que estão os cavalos pretos sai para a terra do norte, e os brancos saem após eles, e os malhados saem para a terra do sul.",
      "palavras": [
        { "hebraico": "אֲשֶׁר־בָּ֞הּ", "transliteral": "ʾă-šer-bāh", "traducao_palavra": "aquele em que [estão]" },
        { "hebraico": "הַסּוּסִ֣ים", "transliteral": "has-sû-sîm", "traducao_palavra": "os cavalos" },
        { "hebraico": "הַשְּׁחֹרִ֗ים", "transliteral": "haš-šə-ḥō-rîm", "traducao_palavra": "pretos" },
        { "hebraico": "יֹֽצְאִים֙", "transliteral": "yō-ṣə-ʾîm", "traducao_palavra": "saem" },
        { "hebraico": "אֶל־אֶ֣רֶץ", "transliteral": "ʾel-ʾe-reṣ", "traducao_palavra": "para a terra do" },
