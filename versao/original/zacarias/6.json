        { "hebraico": "וַיֹּ֣אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "אֵלָ֑י", "transliteral": "ʾê-lāy", "traducao_palavra": "a mim" },
        { "hebraico": "אֵ֗לֶּה", "transliteral": "ʾêl-leh", "traducao_palavra": "estes [são]" },
        { "hebraico": "אַרְבַּע֙", "transliteral": "ʾar-baʿ", "traducao_palavra": "os quatro" },
        { "hebraico": "רוּחֹ֣ות", "transliteral": "rû-ḥôṯ", "traducao_palavra": "espíritos / ventos de" },
        { "hebraico": "הַשָּׁמַ֔יִם", "transliteral": "haš-šā-ma-yim", "traducao_palavra": "os céus" },
        { "hebraico": "יֹֽוצְאֹ֔ות", "transliteral": "yô-ṣə-ʾôṯ", "traducao_palavra": "que saem" },
        { "hebraico": "מֵהִתְיַצֵּ֖ב", "transliteral": "mê-hiṯ-yaṣ-ṣêḇ", "traducao_palavra": "de apresentar-se" },
        { "hebraico": "עַל־אֲדֹ֥ון", "transliteral": "ʿal-ʾă-ḏôn", "traducao_palavra": "perante o Senhor de" },
        { "hebraico": "כָּל־הָאָֽרֶץ׃", "transliteral": "kāl-hā-ʾā-reṣ", "traducao_palavra": "toda a terra" }
      ]
