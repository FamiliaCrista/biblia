    },
    "3": {
      "traducao_completa": "no terceiro carro, cavalos brancos, e no quarto carro, cavalos malhados, que eram fortes.",
      "palavras": [
        { "hebraico": "וּבַמֶּרְכָּבָ֥ה", "transliteral": "ū-ḇam-mer-kā-ḇā", "traducao_palavra": "e no carro" },
