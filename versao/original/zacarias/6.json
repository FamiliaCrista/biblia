      ]
    },
    "11": {
      "traducao_completa": "Toma, digo, prata e ouro, e faze coroas, e põe-nas sobre a cabeça do sumo sacerdote Josué, filho de Jeozadaque;",
      "palavras": [
        { "hebraico": "וְלָקַחְתָּ֥", "transliteral": "wə-lā-qaḥ-tā", "traducao_palavra": "e tomarás" },
        { "hebraico": "כֶֽסֶף־וְזָהָ֖ב", "transliteral": "ḵe-sep̄-wə-zā-hāḇ", "traducao_palavra": "prata e ouro" },
        { "hebraico": "וְעָשִׂ֣יתָ", "transliteral": "wə-ʿā-śî-ṯā", "traducao_palavra": "e farás" },
