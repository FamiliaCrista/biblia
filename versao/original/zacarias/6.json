        { "hebraico": "יְדַֽעְיָ֑ה", "transliteral": "yə-ḏaʿ-yā", "traducao_palavra": "Jedaías" },
        { "hebraico": "וּבָאתָ֤", "transliteral": "ū-ḇā-ṯā", "traducao_palavra": "e vem" },
        { "hebraico": "אַתָּה֙", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "בַּיֹּ֣ום", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
