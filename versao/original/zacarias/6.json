        { "hebraico": "לֵאמֹֽר׃", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" }
      ]
    },
    "10": {
      "traducao_completa": "Recebe dos do cativeiro, de Heldai, de Tobias e de Jedaías; e vem tu no mesmo dia, e entra na casa de Josias, filho de Sofonias, os quais vieram de Babilônia.",
      "palavras": [
        { "hebraico": "לָקֹוחַ֙", "transliteral": "lā-qô-aḥ", "traducao_palavra": "toma / recebe" },
        { "hebraico": "מֵאֵ֣ת", "transliteral": "mê-ʾêṯ", "traducao_palavra": "dos de" },
        { "hebraico": "הַגֹּולָ֔ה", "transliteral": "hag-gô-lā", "traducao_palavra": "o exílio / cativeiro" },
        { "hebraico": "מֵחֶלְדַּ֕י", "transliteral": "mê-ḥel-day", "traducao_palavra": "de Heldai" },
        { "hebraico": "וּמֵאֵ֥ת", "transliteral": "ū-mê-ʾêṯ", "traducao_palavra": "e de" },
        { "hebraico": "טֹובִיָּ֖ה", "transliteral": "ṭô-ḇî-yā", "traducao_palavra": "Tobias" },
