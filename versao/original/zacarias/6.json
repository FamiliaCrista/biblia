        { "hebraico": "וַתִּתְהַלַּ֖כְנָה", "transliteral": "wat-tiṯ-hal-laḵ-nā", "traducao_palavra": "e percorreram" },
        { "hebraico": "בָּאָֽרֶץ׃", "transliteral": "bā-ʾā-reṣ", "traducao_palavra": "a terra" }
      ]
