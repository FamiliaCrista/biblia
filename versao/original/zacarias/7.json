        { "hebraico": "בֵּֽית־אֵ֔ל", "transliteral": "bêṯ-ʾêl", "traducao_palavra": "Betel" },
        { "hebraico": "שַׂר־אֶ֕צֶר", "transliteral": "śar-ʾe-ṣer", "traducao_palavra": "Sarezer" },
        { "hebraico": "וְרֶ֥גֶם", "transliteral": "wə-re-ḡem", "traducao_palavra": "e Réguem-" },
        { "hebraico": "מֶ֖לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "Meleque" },
        { "hebraico": "וַֽאֲנָשָׁ֑יו", "transliteral": "wa-ʾă-nā-šāyw", "traducao_palavra": "e os seus homens" },
        { "hebraico": "לְחַלֹּ֖ות", "transliteral": "lə-ḥal-lôṯ", "traducao_palavra": "para suplicar" },
        { "hebraico": "אֶת־פְּנֵ֥י", "transliteral": "ʾeṯ-pə-nê", "traducao_palavra": "a face de" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "3": {
