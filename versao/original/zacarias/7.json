    "12": {
      "traducao_completa": "Sim, fizeram os seus corações como diamante, para não ouvirem a lei, nem as palavras que YHWH dos Exércitos enviara pelo seu Espírito, por intermédio dos primeiros profetas; por isso veio a grande ira de YHWH dos Exércitos.",
      "palavras": [
        { "hebraico": "וְלִבָּ֞ם", "transliteral": "wə-lib-bām", "traducao_palavra": "e o seu coração" },
