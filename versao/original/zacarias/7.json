        { "hebraico": "לַחֹ֥דֶשׁ", "transliteral": "la-ḥō-ḏeš", "traducao_palavra": "do mês" },
        { "hebraico": "הַתְּשִׁיעִ֖י", "transliteral": "hat-tə-šî-ʿî", "traducao_palavra": "nono" },
        { "hebraico": "בְּכִסְלֵֽו׃", "transliteral": "bə-ḵis-lêw", "traducao_palavra": "em Quisleu" }
      ]
    },
    "2": {
      "traducao_completa": "Quando o povo de Betel enviou Sarezer e Réguem-Meleque, com os seus homens, para suplicarem o favor de YHWH,",
