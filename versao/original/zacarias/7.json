    "11": {
      "traducao_completa": "Eles, porém, recusaram dar ouvidos, e rebeldes deram as costas, e ensurdeceram os seus ouvidos para não ouvirem.",
      "palavras": [
        { "hebraico": "וַיְמָאֲנ֣וּ", "transliteral": "way-mā-ʾă-nû", "traducao_palavra": "mas recusaram" },
