        { "hebraico": "אַרְבַּ֔ע", "transliteral": "ʾar-baʿ", "traducao_palavra": "quatro" },
        { "hebraico": "לְדָרְיָ֖וֶשׁ", "transliteral": "lə-ḏā-rə-yā-weš", "traducao_palavra": "de Dario" },
