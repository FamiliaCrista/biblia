        { "hebraico": "הִנָּזֵ֔ר", "transliteral": "hin-nā-zêr", "traducao_palavra": "abstendo-me / jejuando" },
        { "hebraico": "כַּאֲשֶׁ֣ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "como" },
