      ]
    },
    "2": {
      "traducao_completa": "Porque eu ajuntarei todas as nações para a peleja contra Jerusalém; e a cidade será tomada, e as casas serão saqueadas, e as mulheres, forçadas; metade da cidade sairá para o cativeiro, mas o restante do povo não será desarraigado da cidade.",
      "palavras": [
        { "hebraico": "וְאָסַפְתִּ֨י", "transliteral": "wə-ʾā-sap̄-tî", "traducao_palavra": "e ajuntarei" },
        { "hebraico": "אֶת־כָּל־הַגּוֹיִ֥ם׀", "transliteral": "ʾeṯ-kāl-hag-gô-yim", "traducao_palavra": "todas as nações" },
        { "hebraico": "אֶֽל־יְרוּשָׁלִַם֮", "transliteral": "ʾel-yə-rû-šā-lim", "traducao_palavra": "a Jerusalém" },
        { "hebraico": "לַמִּלְחָמָה֒", "transliteral": "lam-mil-ḥā-mā", "traducao_palavra": "para a batalha" },
