        { "hebraico": "יְקָר֔וֹת", "transliteral": "yə-qā-rôṯ", "traducao_palavra": "brilhante / luminares" },
        { "hebraico": "וְקִפָּאֽוֹן׃", "transliteral": "wə-qip-pā-ʾôn", "traducao_palavra": "mas se recolherão / densa névoa" }
