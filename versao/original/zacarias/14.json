    "6": {
      "traducao_completa": "E acontecerá naquele dia que não haverá preciosa luz, mas espessa escuridão.",
      "palavras": [
        { "hebraico": "וְהָיָ֖ה", "transliteral": "wə-hā-yā", "traducao_palavra": "e acontecerá" },
