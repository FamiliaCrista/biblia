        { "hebraico": "כָּֽעֲרָבָה֙", "transliteral": "kā-ʿă-rā-ḇā", "traducao_palavra": "como a planície / Arabá" },
        { "hebraico": "מִגֶּ֣בַע", "transliteral": "miḡ-ge-ḇaʿ", "traducao_palavra": "desde Geba" },
