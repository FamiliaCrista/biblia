        { "hebraico": "תִּשָּׁכַ֥בְנָה", "transliteral": "tiš-šā-ḵaḇ-nā", "traducao_palavra": "violadas" },
        { "hebraico": "וְיָצָ֤א", "transliteral": "wə-yā-ṣā", "traducao_palavra": "e sairá" },
