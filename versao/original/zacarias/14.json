  "versiculos": {
    "1": {
      "traducao_completa": "Eis que vem o dia de YHWH, em que os teus despojos se repartirão no meio de ti.",
      "palavras": [
        { "hebraico": "הִנֵּ֥ה", "transliteral": "hin-nēh", "traducao_palavra": "eis que" },
        { "hebraico": "יוֹם־בָּ֖א", "transliteral": "yôm-bā", "traducao_palavra": "vem o dia" },
        { "hebraico": "לַֽיהוָ֑ה", "transliteral": "lay-YHWH", "traducao_palavra": "de YHWH" },
        { "hebraico": "וְחֻלַּ֥ק", "transliteral": "wə-ḥul-laq", "traducao_palavra": "e será repartido" },
        { "hebraico": "שְׁלָלֵ֖ךְ", "transliteral": "šə-lā-lêḵ", "traducao_palavra": "o teu despojo" },
