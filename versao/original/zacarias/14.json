        { "hebraico": "בַּגּוֹלָ֔ה", "transliteral": "bag-gô-lā", "traducao_palavra": "para o cativeiro" },
        { "hebraico": "וְיֶ֣תֶר", "transliteral": "wə-ye-ṯer", "traducao_palavra": "mas o resto de" },
