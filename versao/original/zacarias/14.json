        { "hebraico": "וְנָשַׁ֙סּוּ֙", "transliteral": "wə-nā-šas-sû", "traducao_palavra": "e serão saqueadas" },
        { "hebraico": "הַבָּ֣תִּ֔ים", "transliteral": "hab-bāt-tîm", "traducao_palavra": "as casas" },
