    "6": {
      "traducao_completa": "Fortalecerei a casa de Judá, e salvarei a casa de José; fá-los-ei voltar, porque me compadeci deles; e serão como se eu não os tivera rejeitado; porque eu sou YHWH seu Deus, e os ouvirei.",
      "palavras": [
        { "hebraico": "וְגִבַּרְתִּ֣י", "transliteral": "wə-ḡib-bar-tî", "traducao_palavra": "e fortalecerei" },
