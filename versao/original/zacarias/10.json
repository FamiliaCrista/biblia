        { "hebraico": "יְהוּדָ֗ה", "transliteral": "yə-hû-ḏā", "traducao_palavra": "Judá" },
        { "hebraico": "וְאֶת־בֵּ֤ית", "transliteral": "wə-ʾeṯ-bêṯ", "traducao_palavra": "e a casa de" },
        { "hebraico": "יוֹסֵף֙", "transliteral": "yô-sêp̄", "traducao_palavra": "José" },
        { "hebraico": "אוֹשִׁ֔יעַ", "transliteral": "ʾô-šî-aʿ", "traducao_palavra": "salvarei" },
        { "hebraico": "וְהֽוֹשְׁבוֹתִים֙", "transliteral": "wə-hô-šə-ḇô-ṯîm", "traducao_palavra": "e os farei habitar / regressar" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
