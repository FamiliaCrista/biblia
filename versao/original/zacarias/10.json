        { "hebraico": "הַתְּרָפִ֣ים", "transliteral": "hat-tə-rā-p̄îm", "traducao_palavra": "os terafins / ídolos" },
        { "hebraico": "דִּבְּרוּ־אָ֗וֶן", "transliteral": "dib-bə-rû-ʾā-wen", "traducao_palavra": "falam engano / vaidade" },
