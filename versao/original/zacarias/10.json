    "9": {
      "traducao_completa": "Ainda que os semeei entre os povos, eles se lembrarão de mim em terras remotas; e viverão com os seus filhos, e voltarão.",
      "palavras": [
        { "hebraico": "וְאֶזְרָעֵם֙", "transliteral": "wə-ʾez-rā-ʿêm", "traducao_palavra": "e os semearei" },
