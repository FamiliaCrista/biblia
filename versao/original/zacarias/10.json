      ]
    },
    "10": {
      "traducao_completa": "Pois fá-los-ei voltar da terra do Egito, e os congregarei da Assíria; e fá-los-ei entrar na terra de Gileade e do Líbano, e não se achará lugar suficiente para eles.",
      "palavras": [
        { "hebraico": "וַהֲשִֽׁיבוֹתִים֙", "transliteral": "wa-hă-šî-ḇô-ṯîm", "traducao_palavra": "e os farei voltar" },
        { "hebraico": "מֵאֶ֣רֶץ", "transliteral": "mê-ʾe-reṣ", "traducao_palavra": "da terra de" },
        { "hebraico": "מִצְרַ֔יִם", "transliteral": "miṣ-ra-yim", "traducao_palavra": "Egito" },
        { "hebraico": "וּמֵֽאַשּׁ֖וּר", "transliteral": "ū-mê-ʾaš-šûr", "traducao_palavra": "e da Assíria" },
