        { "hebraico": "לִבָּ֖ם", "transliteral": "lib-bām", "traducao_palavra": "o coração deles" },
        { "hebraico": "בַּיהוָֽה׃", "transliteral": "bay-hwāh", "traducao_palavra": "em YHWH" }
