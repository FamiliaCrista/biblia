        { "hebraico": "כַּאֲשֶׁ֥ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "como se" },
        { "hebraico": "לֹֽא־זְנַחְתִּ֑ים", "transliteral": "lō-zə-naḥ-tîm", "traducao_palavra": "não os tivesse rejeitado" },
