        { "hebraico": "וּבַמֶּרְחַקִּ֖ים", "transliteral": "ū-ḇam-mer-ḥaq-qîm", "traducao_palavra": "e em terras remotas" },
        { "hebraico": "יִזְכְּר֑וּנִי", "transliteral": "yiz-kə-rû-nî", "traducao_palavra": "lembrar-se-ão de mim" },
        { "hebraico": "וְחָי֥וּ", "transliteral": "wə-ḥā-yû", "traducao_palavra": "e viverão" },
        { "hebraico": "אֶת־בְּנֵיהֶ֖ם", "transliteral": "ʾeṯ-bə-nê-hem", "traducao_palavra": "com os seus filhos" },
