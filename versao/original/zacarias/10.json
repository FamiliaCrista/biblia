    "7": {
      "traducao_completa": "E os de Efraim serão como um valente, e o seu coração se alegrará como pelo vinho; e os seus filhos o verão e se alegrarão; o seu coração se regozijará em YHWH.",
      "palavras": [
        { "hebraico": "וְהָי֤וּ", "transliteral": "wə-hā-yû", "traducao_palavra": "e serão" },
        { "hebraico": "כְגִבּוֹר֙", "transliteral": "ḵə-ḡib-bôr", "traducao_palavra": "como guerreiro" },
        { "hebraico": "אֶפְרַ֔יִם", "transliteral": "ʾep̄-ra-yim", "traducao_palavra": "Efraim" },
        { "hebraico": "וְשָׂמַ֥ח", "transliteral": "wə-śā-maḥ", "traducao_palavra": "e se alegrará" },
