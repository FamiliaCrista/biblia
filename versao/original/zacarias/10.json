    "8": {
      "traducao_completa": "Eu lhes assobiarei e os ajuntarei, porque os resgatei; e multiplicar-se-ão como antes se tinham multiplicado.",
      "palavras": [
        { "hebraico": "אֶשְׁרְקָ֥ה", "transliteral": "ʾeš-rə-qā", "traducao_palavra": "assobiarei" },
        { "hebraico": "לָהֶ֛ם", "transliteral": "lā-hem", "traducao_palavra": "para eles" },
        { "hebraico": "וַאֲקַבְּצֵ֖ם", "transliteral": "wa-ʾă-qab-bə-ṣêm", "traducao_palavra": "e os ajuntarei" },
