        { "hebraico": "אֶת־בֵּ֤ית", "transliteral": "ʾeṯ-bêṯ", "traducao_palavra": "a casa de" },
        { "hebraico": "יְהוּדָה֙", "transliteral": "yə-hû-ḏā", "traducao_palavra": "Judá" },
        { "hebraico": "וְשָׂ֣ם", "transliteral": "wə-śām", "traducao_palavra": "e fará" },
