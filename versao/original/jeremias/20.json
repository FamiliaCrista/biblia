        { "hebraico": "יֻלַּ֖דְתִּי", "transliteral": "yul-laḏ-tî", "traducao_palavra": "nasci eu" },
        { "hebraico": "בֹּ֑ו", "transliteral": "bō-w", "traducao_palavra": "nele" },
