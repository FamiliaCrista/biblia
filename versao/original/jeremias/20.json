        { "hebraico": "בֹּעֶ֛רֶת", "transliteral": "bō-ʿe-reṯ", "traducao_palavra": "ardente" },
        { "hebraico": "עָצֻ֖ר", "transliteral": "ʿā-ṣūr", "traducao_palavra": "encerrado" },
        { "hebraico": "בְּעַצְמֹתָ֑י", "transliteral": "bə-ʿaṣ-mō-ṯāy", "traducao_palavra": "em meus ossos" },
        { "hebraico": "וְנִלְאֵ֥יתִי", "transliteral": "wə-nil-ʾê-ṯî", "traducao_palavra": "e cansei-me" },
