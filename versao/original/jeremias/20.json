        { "hebraico": "וְהָיָ֨ה", "transliteral": "wə-hā-yāh", "traducao_palavra": "mas foi/tornou-se" },
        { "hebraico": "בְלִבִּ֜י", "transliteral": "ḇə-lib-bî", "traducao_palavra": "no meu coração" },
