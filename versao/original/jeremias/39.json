        { "hebraico": "רָ֑ע", "transliteral": "rā", "traducao_palavra": "má" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "mas" },
        { "hebraico": "אִם־כַּאֲשֶׁ֛ר", "transliteral": "ʾim-ka-ʾă-šer", "traducao_palavra": "conforme" },
        { "hebraico": "יְדַבֵּ֥ר", "transliteral": "yə-ḏab-bêr", "traducao_palavra": "ele falar" },
        { "hebraico": "אֵלֶ֖יךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "כֵּ֥ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "עֲשֵׂ֥ה", "transliteral": "ʿă-śē", "traducao_palavra": "farás" },
        { "hebraico": "עִמֹּֽו׃", "transliteral": "ʿim-mô", "traducao_palavra": "com ele" }
