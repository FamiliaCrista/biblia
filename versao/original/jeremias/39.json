        { "hebraico": "וּמִן־הָעָ֣ם", "transliteral": "ū-min-hā-ʿām", "traducao_palavra": "e do povo" },
        { "hebraico": "הַדַּלִּ֔ים", "transliteral": "had-dal-lîm", "traducao_palavra": "os pobres/humildes" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "אֵין־לָהֶ֖ם", "transliteral": "ʾên-lā-hem", "traducao_palavra": "não tinham nada" },
        { "hebraico": "מְא֑וּם", "transliteral": "mə-ʾûm", "traducao_palavra": "coisa alguma" },
        { "hebraico": "הִשְׁאִ֞יר", "transliteral": "hiš-ʾîr", "traducao_palavra": "deixou" },
        { "hebraico": "נְבוּזַרְאֲדָ֧ן", "transliteral": "nə-ḇû-zar-ʾă-ḏān", "traducao_palavra": "Nebuzaradã" },
        { "hebraico": "רַב־טַבָּחִ֖ים", "transliteral": "raḇ-ṭab-bā-ḥîm", "traducao_palavra": "capitão da guarda" },
        { "hebraico": "בְּאֶ֣רֶץ", "transliteral": "bə-ʾe-reṣ", "traducao_palavra": "na terra de" },
        { "hebraico": "יְהוּדָ֑ה", "transliteral": "yə-hû-ḏā", "traducao_palavra": "Judá" },
        { "hebraico": "וַיִּתֵּ֨ן", "transliteral": "way-yit-tên", "traducao_palavra": "e deu" },
        { "hebraico": "לָהֶ֥ם", "transliteral": "lā-hem", "traducao_palavra": "a eles" },
        { "hebraico": "כְּרָמִ֛ים", "transliteral": "kə-rā-mîm", "traducao_palavra": "vinhas" },
        { "hebraico": "וִיוָגֵ֖ב", "transliteral": "wî-yā-ḡêḇ", "traducao_palavra": "e campos/lavouras" },
        { "hebraico": "בַּיֹּ֥ום", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "הַהֽוּא׃", "transliteral": "ha-hû", "traducao_palavra": "aquele" }
      ]
    },
    "11": {
      "traducao_completa": "E Nabucodonosor, rei da Babilônia, dera ordem acerca de Jeremias, a Nebuzaradã, capitão da guarda, dizendo:",
      "palavras": [
