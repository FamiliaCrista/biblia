        { "hebraico": "וְעֵינֶ֨יךָ֙", "transliteral": "wə-ʿê-ne-ḵā", "traducao_palavra": "e teus olhos" },
        { "hebraico": "שִׂ֣ים", "transliteral": "śîm", "traducao_palavra": "põe" },
        { "hebraico": "עָלָ֔יו", "transliteral": "ʿā-lāw", "traducao_palavra": "sobre ele" },
