        { "hebraico": "אֶת־יִרְמְיָָהוּ֮", "transliteral": "ʾeṯ-yir-mə-yā-hû", "traducao_palavra": "Jeremias" },
        { "hebraico": "מֵחֲצַ֣ר", "transliteral": "mê-ḥă-ṣar", "traducao_palavra": "do pátio de" },
