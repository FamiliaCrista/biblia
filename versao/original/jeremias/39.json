    },
    "13": {
      "traducao_completa": "Enviou, pois, Nebuzaradã, capitão da guarda, e Nebushasbã, Rab-Saris, e Nergal-Sarezer, Rab-Mag, e todos os príncipes do rei da Babilônia;",
      "palavras": [
        { "hebraico": "וַיִּשְׁלַ֡ח", "transliteral": "way-yiš-laḥ", "traducao_palavra": "e enviou" },
        { "hebraico": "נְבוּזַרְאֲדָ֣ן", "transliteral": "nə-ḇû-zar-ʾă-ḏān", "traducao_palavra": "Nebuzaradã" },
        { "hebraico": "רַב־טַבָּחִים֮", "transliteral": "raḇ-ṭab-bā-ḥîm", "traducao_palavra": "capitão da guarda" },
        { "hebraico": "וּנְבוּשַׁזְבָּ֣ן", "transliteral": "ū-nə-ḇû-šaz-bān", "traducao_palavra": "e Nebushasbã" },
        { "hebraico": "רַב־סָרִ֑יס", "transliteral": "raḇ-śā-rîs", "traducao_palavra": "Rab-Saris" },
        { "hebraico": "וְנֵרְגַ֣ל", "transliteral": "wə-nêr-ḡal", "traducao_palavra": "e Nergal-" },
        { "hebraico": "שַׁר־אֶ֕צֶר", "transliteral": "śar-ʾe-ṣer", "traducao_palavra": "Sarezer" },
        { "hebraico": "רַב־מָ֖ג", "transliteral": "raḇ-māḡ", "traducao_palavra": "Rab-Mag" },
        { "hebraico": "וְכֹ֖ל", "transliteral": "wə-ḵōl", "traducao_palavra": "e todos" },
        { "hebraico": "רַבֵּ֥י", "transliteral": "rab-bê", "traducao_palavra": "os príncipes de/grandes de" },
        { "hebraico": "מֶֽלֶךְ־בָּבֶֽל׃", "transliteral": "me-leḵ-bā-ḇel", "traducao_palavra": "rei da Babilônia" }
