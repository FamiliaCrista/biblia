        { "hebraico": "נְבוּכַדְרֶאצַּר֙", "transliteral": "nə-ḇû-ḵaḏ-reṣ-ṣar", "traducao_palavra": "Nabucodonosor" },
        { "hebraico": "מֶ֣לֶךְ־בָּבֶ֔ל", "transliteral": "me-leḵ-bā-ḇel", "traducao_palavra": "rei da Babilônia" },
        { "hebraico": "עַל־יִרְמְיָָ֖הוּ", "transliteral": "ʿal-yir-mə-yā-hû", "traducao_palavra": "acerca de Jeremias" },
        { "hebraico": "בְּיַ֥ד", "transliteral": "bə-yaḏ", "traducao_palavra": "pela mão de" },
        { "hebraico": "נְבוּזַרְאֲדָ֧ן", "transliteral": "nə-ḇû-zar-ʾă-ḏān", "traducao_palavra": "Nebuzaradã" },
        { "hebraico": "רַב־טַבָּחִ֖ים", "transliteral": "raḇ-ṭab-bā-ḥîm", "traducao_palavra": "capitão da guarda" },
        { "hebraico": "לֵאמֹֽר׃", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" }
      ]
    },
    "12": {
      "traducao_completa": "Toma-o, e põe os teus olhos sobre ele, e não lhe faças mal algum; mas como ele te disser, assim farás com ele.",
      "palavras": [
