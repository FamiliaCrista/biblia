        { "hebraico": "אֵלַ֗י", "transliteral": "ʾê-lay", "traducao_palavra": "a mim" },
        { "hebraico": "מָה־אַתָּ֥ה", "transliteral": "māh-ʾat-tāh", "traducao_palavra": "O que tu" },
