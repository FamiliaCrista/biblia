        { "hebraico": "וּנְטַעְתִּ֖ים", "transliteral": "ū-nə-ṭa-ʿtîm", "traducao_palavra": "e plantarei eles" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
