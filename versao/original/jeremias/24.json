        { "hebraico": "יִרְמְיָ֑הוּ", "transliteral": "Yir-mə-yā-hū", "traducao_palavra": "Jeremias?" },
        { "hebraico": "וָאֹמַ֗ר", "transliteral": "wā-ʾō-mar", "traducao_palavra": "E eu disse" },
