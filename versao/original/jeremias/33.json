        { "hebraico": "מִנְחָ֛ה", "transliteral": "min-ḥāh", "traducao_palavra": "oferta" },
        { "hebraico": "וְעֹ֥שֶׂה־זֶּ֖בַח", "transliteral": "wə-ʿō-śeh-ze-ḇaḥ", "traducao_palavra": "e faça sacrifício" },
        { "hebraico": "כָּל־הַיָּמִֽים׃", "transliteral": "kāl-hay-yā-mîm", "traducao_palavra": "todos os dias." }
