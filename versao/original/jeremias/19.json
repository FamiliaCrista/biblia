        { "hebraico": "וּבַקֹּתִ֞י", "transliteral": "ū-ḇaq-qō-ṯî", "traducao_palavra": "E esvaziarei/anularei" },
        { "hebraico": "אֶת־עֲצַ֨ת", "transliteral": "ʾeṯ-ʿă-ṣaṯ", "traducao_palavra": "o conselho de" },
        { "hebraico": "יְהוּדָ֤ה", "transliteral": "Yə-hū-ḏāh", "traducao_palavra": "Judá" },
        { "hebraico": "וִירֽוּשָׁלַ͏ִם֙", "transliteral": "wî-rū-šā-la-im", "traducao_palavra": "e Jerusalém" },
