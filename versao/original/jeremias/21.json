        { "hebraico": "בְּיַד־", "transliteral": "bə-yaḏ-", "traducao_palavra": "na mão de" },
        { "hebraico": "מֶֽלֶךְ־בָּבֶ֧ל", "transliteral": "me-leḵ-Bā-ḇel", "traducao_palavra": "rei de Babilônia" },
        { "hebraico": "תִּנָּתֵ֛ן", "transliteral": "tin-nā-ṯên", "traducao_palavra": "ela será entregue" },
