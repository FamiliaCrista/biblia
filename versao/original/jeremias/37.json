        { "hebraico": "וְעַל־הָאָ֥רֶץ", "transliteral": "wə-ʿal-hā-ʾā-reṣ", "traducao_palavra": "e contra a terra" },
        { "hebraico": "הַזֹּֽאת׃", "transliteral": "haz-zōṯ", "traducao_palavra": "esta" }
      ]
    },
    "20": {
      "traducao_completa": "Portanto ouve agora, eu te peço, ó senhor meu rei: Caia a minha súplica diante de ti, e não me faças tornar à casa de Jonatas, o escriba, para que eu não morra ali.",
