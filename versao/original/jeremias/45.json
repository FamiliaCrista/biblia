  "versiculos": {
    "1": {
      "traducao_completa": "A palavra que Jeremias, o profeta, falou a Baruque, filho de Nerias, quando este escrevia num livro estas palavras, da boca de Jeremias, no quarto ano de Jeoaquim, filho de Josias, rei de Judá, dizendo:",
      "palavras": [
