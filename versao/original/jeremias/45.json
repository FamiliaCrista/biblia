        { "hebraico": "גְדֹלֹ֖ות", "transliteral": "ḡə-ḏō-lôṯ", "traducao_palavra": "grandezas" },
        { "hebraico": "אַל־תְּבַקֵּ֑שׁ", "transliteral": "ʾal-tə-ḇaq-qêš", "traducao_palavra": "não procures" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "הִנְנִי֩", "transliteral": "hin-nî", "traducao_palavra": "eis que eu" },
