        { "hebraico": "בֶּן־יֹאשִׁיָָּ֛הוּ", "transliteral": "ben-yō-šî-yā-hû", "traducao_palavra": "filho de Josias" },
        { "hebraico": "מֶ֥לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "rei de" },
