    "4": {
      "traducao_completa": "Assim lhe dirás: Assim diz YHWH: Eis que o que edifiquei eu derrubo, e o que plantei eu arranco, e isso em toda esta terra.",
      "palavras": [
        { "hebraico": "כֹּ֚ה", "transliteral": "kō", "traducao_palavra": "assim" },
        { "hebraico": "תֹּאמַ֣ר", "transliteral": "tō-mar", "traducao_palavra": "dirás" },
