        { "hebraico": "אֲשֶׁר־בָּנִ֨יתִי֙", "transliteral": "ʾă-šer-bā-nî-ṯî", "traducao_palavra": "o que edifiquei" },
        { "hebraico": "אֲנִ֣י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
        { "hebraico": "הֹרֵ֔ס", "transliteral": "hō-rês", "traducao_palavra": "[estou] derrubando" },
        { "hebraico": "וְאֵ֥ת", "transliteral": "wə-ʾêṯ", "traducao_palavra": "e" },
        { "hebraico": "אֲשֶׁר־נָטַ֖עְתִּי", "transliteral": "ʾă-šer-nā-ṭaʿ-tî", "traducao_palavra": "o que plantei" },
        { "hebraico": "אֲנִ֣י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
