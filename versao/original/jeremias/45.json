        { "hebraico": "בֶּן־נֵרִיָּה֒", "transliteral": "ben-nê-ri-yā", "traducao_palavra": "filho de Nerias" },
        { "hebraico": "בְּכָתְבֹו֩", "transliteral": "bə-ḵā-ṯə-ḇô", "traducao_palavra": "ao escrever ele" },
        { "hebraico": "אֶת־הַדְּבָרִ֨ים", "transliteral": "ʾeṯ-had-də-ḇā-rîm", "traducao_palavra": "as palavras" },
        { "hebraico": "הָאֵ֜לֶּה", "transliteral": "hā-ʾēl-leh", "traducao_palavra": "estas" },
        { "hebraico": "עַל־סֵ֗פֶר", "transliteral": "ʿal-sê-p̄er", "traducao_palavra": "em um livro" },
