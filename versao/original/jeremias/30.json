        { "hebraico": "וְנִבְנְתָ֥ה", "transliteral": "wə-niḇ-nə-ṯāh", "traducao_palavra": "e será edificada" },
        { "hebraico": "עִיר֙", "transliteral": "ʿîr", "traducao_palavra": "[a] cidade" },
