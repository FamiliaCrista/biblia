        { "hebraico": "מֵהֶ֛ם", "transliteral": "mê-hem", "traducao_palavra": "deles" },
        { "hebraico": "תֹּודָ֖ה", "transliteral": "tō-w-ḏāh", "traducao_palavra": "ação de graças" },
        { "hebraico": "וְקֹ֣ול", "transliteral": "wə-qō-wl", "traducao_palavra": "e voz de" },
