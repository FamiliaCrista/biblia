        { "hebraico": "אֶת־שִׁפְחָתֹ֗ו", "transliteral": "ʾeṯ-šip̄-ḥā-ṯō-w", "traducao_palavra": "sua serva" },
        { "hebraico": "חָפְשִׁים֙", "transliteral": "ḥā-p̄ə-šîm", "traducao_palavra": "livres" },
