        { "hebraico": "אֱדֹום", "transliteral": "ʾĕ-ḏôm", "traducao_palavra": "Edom" },
        { "hebraico": "בַּיֹּ֣ום", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "הַה֔וּא", "transliteral": "ha-hû", "traducao_palavra": "aquele" },
        { "hebraico": "כְּלֵ֖ב", "transliteral": "kə-lēḇ", "traducao_palavra": "como o coração de" },
        { "hebraico": "אִשָּׁ֥ה", "transliteral": "ʾiš-šā", "traducao_palavra": "uma mulher" },
