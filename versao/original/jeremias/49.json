        { "hebraico": "הִשִּׁיא", "transliteral": "hiš-šî", "traducao_palavra": "enganou-te" },
        { "hebraico": "אֹתְךָ", "transliteral": "ʾō-ṯə-ḵā", "traducao_palavra": "te" },
