        { "hebraico": "קָטֹן", "transliteral": "qā-ṭōn", "traducao_palavra": "pequeno" },
        { "hebraico": "נְתַתִּ֖יךָ", "transliteral": "nə-ṯat-tî-ḵā", "traducao_palavra": "te fiz/pus" },
        { "hebraico": "בַּגֹּויִם", "transliteral": "baḡ-gô-yim", "traducao_palavra": "entre as nações" },
