        { "hebraico": "חֲמָ֣ת", "transliteral": "ḥă-māṯ", "traducao_palavra": "Hamate" },
        { "hebraico": "וְאַרְפָּ֑ד", "transliteral": "wə-ʾar-p̄āḏ", "traducao_palavra": "e Arpade" },
