        { "hebraico": "כִּֽי־אַרְגִּ֥יעָה", "transliteral": "kî-ʾar-gî-ʿā", "traducao_palavra": "pois farei correr" },
        { "hebraico": "אֲרִיצֶ֣נּוּ", "transliteral": "ʾă-rî-ṣen-nû", "traducao_palavra": "o farei fugir" },
        { "hebraico": "מֵעָלֶיהָ", "transliteral": "mê-ʿā-le-hā", "traducao_palavra": "dela" },
        { "hebraico": "וּמִ֥י", "transliteral": "ū-mî", "traducao_palavra": "e quem" },
        { "hebraico": "בָח֥וּר", "transliteral": "ḇā-ḥûr", "traducao_palavra": "escolhido" },
