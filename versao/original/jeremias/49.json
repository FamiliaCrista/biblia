        { "hebraico": "כְּאַרְיֵה֙", "transliteral": "kə-ʾar-yēh", "traducao_palavra": "como leão" },
        { "hebraico": "יַעֲלֶ֣ה", "transliteral": "ya-ʿă-leh", "traducao_palavra": "ele subirá" },
        { "hebraico": "מִגְּאֹון֙", "transliteral": "miḡ-gə-ʾôn", "traducao_palavra": "da enchente de" },
