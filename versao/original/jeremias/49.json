        { "hebraico": "לֹא־יֵשֵׁ֨ב", "transliteral": "lō-yê-šêḇ", "traducao_palavra": "não habitará" },
        { "hebraico": "שָׁם֙", "transliteral": "šām", "traducao_palavra": "ali" },
