        { "hebraico": "כְּמַהְפֵּכַ֣ת", "transliteral": "kə-mah-p̄ê-ḵaṯ", "traducao_palavra": "como a destruição de" },
        { "hebraico": "סְדֹ֧ם", "transliteral": "sə-ḏōm", "traducao_palavra": "Sodoma" },
        { "hebraico": "וַעֲמֹרָ֛ה", "transliteral": "wa-ʿă-mō-rā", "traducao_palavra": "e Gomorra" },
        { "hebraico": "וּשְׁכֵנֶ֖יהָ", "transliteral": "ū-šə-ḵê-ne-hā", "traducao_palavra": "e suas vizinhas" },
