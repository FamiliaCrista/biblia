    "22": {
      "traducao_completa": "Eis que subirá como águia, e voará, e estenderá as suas asas sobre Bozra; e o coração dos valentes de Edom naquele dia será como o coração da mulher que está em dores de parto.",
      "palavras": [
        { "hebraico": "הִנֵּ֧ה", "transliteral": "hin-nēh", "traducao_palavra": "eis que" },
        { "hebraico": "כַּנֶּשֶׁר", "transliteral": "kan-ne-šer", "traducao_palavra": "como a águia" },
        { "hebraico": "יַעֲלֶ֥ה", "transliteral": "ya-ʿă-leh", "traducao_palavra": "ele subirá" },
        { "hebraico": "וְיָדָ֖א", "transliteral": "wə-yā-ḏā", "traducao_palavra": "e voará" },
