    },
    "20": {
      "traducao_completa": "Portanto, ouvi o conselho de YHWH que ele formou contra Edom, e os seus desígnios que ele intentou contra os moradores de Temã: Certamente os arrastarão, ainda que sejam os pequenos do rebanho; certamente ele assolará a sua habitação sobre eles.",
      "palavras": [
        { "hebraico": "לָכֵ֗ן", "transliteral": "lā-ḵên", "traducao_palavra": "portanto" },
