        { "hebraico": "מִקֹּ֗ול", "transliteral": "miq-qôl", "traducao_palavra": "do estrondo de" },
        { "hebraico": "נִפְלָתָם", "transliteral": "nip̄-lā-ṯām", "traducao_palavra": "sua queda" },
