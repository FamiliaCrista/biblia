        { "hebraico": "תִּשְׁתֶּֽה׃", "transliteral": "tiš-teh", "traducao_palavra": "beberás" }
      ]
    },
    "13": {
      "traducao_completa": "Porque por mim mesmo jurei, diz YHWH, que Bozra se tornará em espanto, em opróbrio, em desolação e em maldição; e todas as suas cidades se tornarão em ruínas perpétuas.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "בִּ֣י", "transliteral": "bî", "traducao_palavra": "por mim" },
