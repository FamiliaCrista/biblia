        { "hebraico": "לִשְׁתֹּ֣ות", "transliteral": "liš-tôṯ", "traducao_palavra": "a beber" },
        { "hebraico": "הַכֹּ֔וס", "transliteral": "hak-kôs", "traducao_palavra": "o cálice" },
        { "hebraico": "שָׁתֹ֣ות", "transliteral": "šā-tōṯ", "traducao_palavra": "beberão" },
        { "hebraico": "יִשְׁתּ֔וּ", "transliteral": "yiš-tû", "traducao_palavra": "certamente beberão" },
        { "hebraico": "וְאַתָּה֙", "transliteral": "wə-ʾat-tā", "traducao_palavra": "e tu" },
        { "hebraico": "הוּא־נָקֹ֣ה", "transliteral": "hû-nā-qōh", "traducao_palavra": "impune?" },
        { "hebraico": "תִנָּקֶ֔ה", "transliteral": "tin-nā-qeh", "traducao_palavra": "ficarás impune" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
