        { "hebraico": "תֹּפְשֵׂי", "transliteral": "tō-p̄ə-śê", "traducao_palavra": "que ocupas" },
        { "hebraico": "מְרֹ֣ום", "transliteral": "mə-rôm", "traducao_palavra": "as alturas de" },
        { "hebraico": "גִּבְעָ֔ה", "transliteral": "ḡiḇ-ʿā", "traducao_palavra": "o outeiro" },
        { "hebraico": "כִּֽי־תַגְבִּ֤יהַ", "transliteral": "kî-ṯaḡ-bî-ah", "traducao_palavra": "ainda que eleves" },
