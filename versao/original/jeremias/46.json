        { "hebraico": "מִי־זֶה", "transliteral": "mî-zeh", "traducao_palavra": "quem [é] este" },
        { "hebraico": "כַּיְאֹר", "transliteral": "kay-ʾōr", "traducao_palavra": "como o Nilo" },
        { "hebraico": "יַעֲלֶה", "transliteral": "ya-ʿă-leh", "traducao_palavra": "sobe" },
        { "hebraico": "כַּנְּהָרֹות", "transliteral": "kan-nə-hā-rôṯ", "traducao_palavra": "como os rios" },
