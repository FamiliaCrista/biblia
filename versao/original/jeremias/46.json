        { "hebraico": "חֶרֶב", "transliteral": "ḥe-reḇ", "traducao_palavra": "a espada" },
        { "hebraico": "וְשָׂבְעָה", "transliteral": "wə-śā-ḇə-ʿā", "traducao_palavra": "e se fartará" },
