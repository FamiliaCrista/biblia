        { "hebraico": "בַּת־מִצְרָיִם", "transliteral": "baṯ-miṣ-rā-yim", "traducao_palavra": "filha do Egito" },
        { "hebraico": "לַשָּׁוְא", "transliteral": "laš-šā-wə", "traducao_palavra": "em vão/debalde" },
        { "hebraico": "הרבית", "transliteral": "hir-bêṯ", "traducao_palavra": "multiplicaste" },
        { "hebraico": "רְפֻאֹות", "transliteral": "rə-p̄u-ʾôṯ", "traducao_palavra": "remédios/curas" },
        { "hebraico": "תְּעָלָה", "transliteral": "tə-ʿā-lā", "traducao_palavra": "cicatrização/cura" },
        { "hebraico": "אֵין", "transliteral": "ʾên", "traducao_palavra": "não há" },
        { "hebraico": "לָךְ׃", "transliteral": "lāḵ", "traducao_palavra": "para ti" }
      ]
    },
    "12": {
      "traducao_completa": "As nações ouviram o teu opróbrio, e a terra está cheia do teu clamor; porque o valente tropeçou no valente, e ambos caíram juntos.",
      "palavras": [
        { "hebraico": "שָׁמְעוּ", "transliteral": "šā-mə-ʿû", "traducao_palavra": "ouviram" },
        { "hebraico": "גֹויִם", "transliteral": "gô-yim", "traducao_palavra": "nações" },
        { "hebraico": "קְלֹונֵךְ", "transliteral": "qə-lô-nêḵ", "traducao_palavra": "teu opróbrio" },
        { "hebraico": "וְצִוְחָתֵךְ", "transliteral": "wə-ṣiw-ḥā-ṯêḵ", "traducao_palavra": "e teu clamor" },
        { "hebraico": "מָלְאָה", "transliteral": "mā-lə-ʾā", "traducao_palavra": "encheu" },
        { "hebraico": "הָאָרֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "כִּי־גִבֹּור", "transliteral": "kî-ḡib-bôr", "traducao_palavra": "pois o valente" },
        { "hebraico": "בְּגִבֹּור", "transliteral": "bə-ḡib-bôr", "traducao_palavra": "no valente" },
        { "hebraico": "כָּשָׁלוּ", "transliteral": "kā-šā-lû", "traducao_palavra": "tropeçaram" },
        { "hebraico": "יַחְדָּיו", "transliteral": "yaḥ-dā-yw", "traducao_palavra": "juntos" },
        { "hebraico": "נָפְלוּ", "transliteral": "nā-p̄ə-lû", "traducao_palavra": "caíram" },
        { "hebraico": "שְׁנֵיהֶם׃", "transliteral": "šə-nê-hem", "traducao_palavra": "ambos" }
      ]
    },
    "13": {
      "traducao_completa": "A palavra que falou YHWH a Jeremias, o profeta, acerca da vinda de Nabucodonosor, rei da Babilônia, para ferir a terra do Egito.",
      "palavras": [
