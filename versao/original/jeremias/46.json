    "9": {
      "traducao_completa": "Subi, ó cavalos, e estrondai, ó carros; e saiam os valentes: os etíopes e os de Pute, que manejam o escudo, e os líbios, que manejam e entesam o arco.",
      "palavras": [
        { "hebraico": "עֲלוּ", "transliteral": "ʿă-lû", "traducao_palavra": "subi" },
        { "hebraico": "הַסּוּסִים", "transliteral": "has-sû-śîm", "traducao_palavra": "os cavalos" },
        { "hebraico": "וְהִתְהֹלְלוּ", "transliteral": "wə-hiṯ-hō-lə-lû", "traducao_palavra": "e enlouquecei/estrondai" },
