        { "hebraico": "אֲשֶׁר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "דִּבֶּר", "transliteral": "dib-ber", "traducao_palavra": "falou" },
        { "hebraico": "יְהוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֶל־יִרְמְיָהוּ", "transliteral": "ʾel-yir-mə-yā-hû", "traducao_palavra": "a Jeremias" },
        { "hebraico": "הַנָּבִיא", "transliteral": "han-nā-ḇî", "traducao_palavra": "o profeta" },
        { "hebraico": "לָבֹוא", "transliteral": "lā-ḇô", "traducao_palavra": "acerca da vinda de" },
        { "hebraico": "נְבוּכַדְרֶאצַּר", "transliteral": "nə-ḇû-ḵaḏ-reṣ-ṣar", "traducao_palavra": "Nabucodonosor" },
        { "hebraico": "מֶלֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "rei de" },
        { "hebraico": "בָּבֶל", "transliteral": "bā-ḇel", "traducao_palavra": "Babilônia" },
        { "hebraico": "לְהַכֹּות", "transliteral": "lə-hak-kôṯ", "traducao_palavra": "para ferir" },
        { "hebraico": "אֶת־אֶרֶץ", "transliteral": "ʾeṯ-ʾe-reṣ", "traducao_palavra": "a terra de" },
        { "hebraico": "מִצְרָיִם׃", "transliteral": "miṣ-rā-yim", "traducao_palavra": "Egito" }
      ]
    },
    "14": {
      "traducao_completa": "Anunciai no Egito, e fazei ouvir isso em Migdol; fazei ouvi-lo também em Nofe e em Tafnes; dizei: Apresenta-te, e prepara-te; porque a espada devorou o que está ao redor de ti.",
      "palavras": [
        { "hebraico": "הַגִּידוּ", "transliteral": "hag-gî-ḏû", "traducao_palavra": "anunciai" },
        { "hebraico": "בְמִצְרַיִם", "transliteral": "ḇə-miṣ-ra-yim", "traducao_palavra": "no Egito" },
        { "hebraico": "וְהַשְׁמִיעוּ", "transliteral": "wə-haš-mî-ʿû", "traducao_palavra": "e fazei ouvir" },
        { "hebraico": "בְמִגְדֹּול", "transliteral": "ḇə-miḡ-dōl", "traducao_palavra": "em Migdol" },
        { "hebraico": "וְהַשְׁמִיעוּ", "transliteral": "wə-haš-mî-ʿû", "traducao_palavra": "e fazei ouvir" },
        { "hebraico": "בְנֹף", "transliteral": "ḇə-nōp̄", "traducao_palavra": "em Nofe" },
        { "hebraico": "וּבְתַחְפַּנְחֵס", "transliteral": "ū-ḇə-ṯaḥ-pan-ḥēs", "traducao_palavra": "e em Tafnes" },
        { "hebraico": "אִמְרוּ", "transliteral": "ʾim-rû", "traducao_palavra": "dizei" },
        { "hebraico": "הִתְיַצֵּב", "transliteral": "hiṯ-yaṣ-ṣēḇ", "traducao_palavra": "apresenta-te" },
        { "hebraico": "וְהָכֵן", "transliteral": "wə-hā-ḵēn", "traducao_palavra": "e prepara" },
        { "hebraico": "לָךְ", "transliteral": "lāḵ", "traducao_palavra": "para ti" },
        { "hebraico": "כִּי־אָכְלָה", "transliteral": "kî-ʾā-ḵə-lā", "traducao_palavra": "porque devorou" },
        { "hebraico": "חֶרֶב", "transliteral": "ḥe-reḇ", "traducao_palavra": "a espada" },
        { "hebraico": "סְבִיבֶיךָ׃", "transliteral": "śə-ḇî-ḇe-ḵā", "traducao_palavra": "ao teu redor" }
      ]
    },
    "15": {
      "traducao_completa": "Por que foram varridos os teus valentes? Não subsistiram, porque YHWH os abateu.",
      "palavras": [
        { "hebraico": "מַדּוּעַ", "transliteral": "mad-dû-aʿ", "traducao_palavra": "por que" },
        { "hebraico": "נִסְחַף", "transliteral": "nis-ḥap̄", "traducao_palavra": "foi varrido/arrastado" },
        { "hebraico": "אַבִּירֶיךָ", "transliteral": "ʾab-bî-re-ḵā", "traducao_palavra": "teus valentes" },
        { "hebraico": "לֹא", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "עָמַד", "transliteral": "ʿā-maḏ", "traducao_palavra": "permaneceu" },
        { "hebraico": "כִּי", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "יְהוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "הֲדָפֹו׃", "transliteral": "hă-ḏā-p̄ô", "traducao_palavra": "o abateu/empurrou" }
      ]
    },
    "16": {
      "traducao_completa": "Multiplicou os que tropeçavam; também caíram uns sobre os outros e disseram: Levanta-te, e voltemos ao nosso povo, e à terra do nosso nascimento, por causa da espada que oprime.",
      "palavras": [
        { "hebraico": "הִרְבָּה", "transliteral": "hir-bā", "traducao_palavra": "ele multiplicou" },
        { "hebraico": "כֹּושֵׁל", "transliteral": "kô-šēl", "traducao_palavra": "quem tropeça" },
        { "hebraico": "גַּם־נָפַל", "transliteral": "gam-nā-p̄al", "traducao_palavra": "também caiu" },
        { "hebraico": "אִישׁ", "transliteral": "ʾîš", "traducao_palavra": "homem/um" },
        { "hebraico": "אֶל־רֵעֵהוּ", "transliteral": "ʾel-rē-ʿê-hû", "traducao_palavra": "sobre seu companheiro" },
        { "hebraico": "וַיֹּאמְרוּ", "transliteral": "way-yō-mə-rû", "traducao_palavra": "e disseram" },
        { "hebraico": "קוּמָה", "transliteral": "qû-mā", "traducao_palavra": "levanta-te" },
        { "hebraico": "וְנָשֻׁבָה", "transliteral": "wə-nā-šû-ḇā", "traducao_palavra": "e voltemos" },
        { "hebraico": "אֶל־עַמֵּנוּ", "transliteral": "ʾel-ʿam-mê-nû", "traducao_palavra": "ao nosso povo" },
        { "hebraico": "וְאֶל־אֶרֶץ", "transliteral": "wə-ʾel-ʾe-reṣ", "traducao_palavra": "e à terra de" },
        { "hebraico": "מֹולַדְתֵּנוּ", "transliteral": "mô-laḏ-tê-nû", "traducao_palavra": "nosso nascimento" },
        { "hebraico": "מִפְּנֵי", "transliteral": "mip-pə-nê", "traducao_palavra": "por causa de/da face de" },
        { "hebraico": "חֶרֶב", "transliteral": "ḥe-reḇ", "traducao_palavra": "espada" },
        { "hebraico": "הַיֹּונָה׃", "transliteral": "hay-yô-nā", "traducao_palavra": "a opressora" }
      ]
    },
    "17": {
      "traducao_completa": "Ali clamaram: Faraó, rei do Egito, é apenas um ruído; ele deixou passar o tempo determinado.",
      "palavras": [
        { "hebraico": "קָרְאוּ", "transliteral": "qā-rə-ʾû", "traducao_palavra": "chamaram/proclamaram" },
        { "hebraico": "שָׁם", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "פַּרְעֹה", "transliteral": "par-ʿōh", "traducao_palavra": "Faraó" },
        { "hebraico": "מֶלֶךְ־מִצְרַיִם", "transliteral": "me-leḵ-miṣ-ra-yim", "traducao_palavra": "rei do Egito" },
        { "hebraico": "שָׁאֹון", "transliteral": "šā-ʾôn", "traducao_palavra": "[é um] ruído/estrondo" },
        { "hebraico": "הֶעֱבִיר", "transliteral": "he-ʿĕ-ḇîr", "traducao_palavra": "deixou passar" },
        { "hebraico": "הַמֹּועֵד׃", "transliteral": "ham-mô-ʿēḏ", "traducao_palavra": "o tempo fixado" }
      ]
    },
    "18": {
      "traducao_completa": "Vivo eu, diz o Rei, cujo nome é YHWH dos Exércitos, que como o Tabor entre os montes, e como o Carmelo junto ao mar, assim ele virá.",
      "palavras": [
        { "hebraico": "חַי־אָנִי", "transliteral": "ḥay-ʾā-nî", "traducao_palavra": "vivo eu" },
        { "hebraico": "נְאֻם־הַמֶּלֶךְ", "transliteral": "nə-ʾum-ham-me-leḵ", "traducao_palavra": "diz o Rei" },
        { "hebraico": "יְהוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "dos Exércitos" },
        { "hebraico": "שְׁמֹו", "transliteral": "šə-mô", "traducao_palavra": "[é] seu nome" },
        { "hebraico": "כִּי", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "כְּתָבֹור", "transliteral": "kə-ṯā-ḇôr", "traducao_palavra": "como o Tabor" },
        { "hebraico": "בֶּהָרִים", "transliteral": "be-hā-rîm", "traducao_palavra": "entre os montes" },
        { "hebraico": "וּכְכַרְמֶל", "transliteral": "ū-ḵə-ḵar-mel", "traducao_palavra": "e como o Carmelo" },
        { "hebraico": "בַּיָּם", "transliteral": "bay-yām", "traducao_palavra": "no mar" },
        { "hebraico": "יָבֹוא׃", "transliteral": "yā-ḇô", "traducao_palavra": "virá" }
      ]
    },
    "19": {
      "traducao_completa": "Prepara o teu bagagem para o exílio, ó moradora, filha do Egito; porque Nofe será tornada em desolação e será queimada, até que ninguém nela habite.",
      "palavras": [
        { "hebraico": "כְּלֵי", "transliteral": "kəlê", "traducao_palavra": "utensílios/bagagem de" },
        { "hebraico": "גֹולָה", "transliteral": "ḡô-lā", "traducao_palavra": "exílio" },
        { "hebraico": "עֲשִׂי", "transliteral": "ʿă-śî", "traducao_palavra": "faz" },
        { "hebraico": "לָךְ", "transliteral": "lāḵ", "traducao_palavra": "para ti" },
        { "hebraico": "יֹושֶׁבֶת", "transliteral": "yô-še-ḇeṯ", "traducao_palavra": "moradora" },
        { "hebraico": "בַּת־מִצְרָיִם", "transliteral": "baṯ-miṣ-rā-yim", "traducao_palavra": "filha do Egito" },
        { "hebraico": "כִּי־נֹף", "transliteral": "kî-nōp̄", "traducao_palavra": "pois Nofe" },
        { "hebraico": "לְשַׁמָּה", "transliteral": "lə-šam-mā", "traducao_palavra": "em desolação" },
        { "hebraico": "תִהְיֶה", "transliteral": "tih-yeh", "traducao_palavra": "será" },
        { "hebraico": "וְנִצְּתָה", "transliteral": "wə-niṣ-ṣə-ṯā", "traducao_palavra": "e será incendiada" },
        { "hebraico": "מֵאֵין", "transliteral": "mê-ʾên", "traducao_palavra": "sem" },
        { "hebraico": "יֹושֵׁב׃", "transliteral": "yô-šêḇ", "traducao_palavra": "habitante" }
      ]
    },
    "20": {
      "traducao_completa": "Novilha mui formosa é o Egito; mas do norte vem o mutuca; sim, vem.",
      "palavras": [
        { "hebraico": "עֶגְלָה", "transliteral": "ʿeḡ-lā", "traducao_palavra": "novilha" },
        { "hebraico": "יְפֵֽה־פִיָּה", "transliteral": "yə-p̄ēh-p̄î-yā", "traducao_palavra": "muito bela" },
        { "hebraico": "מִצְרָיִם", "transliteral": "miṣ-ra-yim", "traducao_palavra": "Egito" },
        { "hebraico": "קֶרֶץ", "transliteral": "qe-reṣ", "traducao_palavra": "um mutuca/ferrão" },
        { "hebraico": "מִצָּפֹון", "transliteral": "miṣ-ṣā-p̄ôn", "traducao_palavra": "do norte" },
        { "hebraico": "בָּא", "transliteral": "bā", "traducao_palavra": "veio" },
        { "hebraico": "בָא׃", "transliteral": "ḇā", "traducao_palavra": "veio" }
      ]
    },
    "21": {
      "traducao_completa": "Também os seus mercenários no meio dela são como bezerros cevados; porque também eles viraram as costas, fugiram juntos, não subsistiram; porque veio sobre eles o dia da sua ruína e o tempo da sua punição.",
      "palavras": [
        { "hebraico": "גַּם־שְׂכִירֶיהָ", "transliteral": "gam-śə-ḵî-re-hā", "traducao_palavra": "também seus mercenários" },
        { "hebraico": "בְקִרְבָּהּ", "transliteral": "ḇə-qir-bāh", "traducao_palavra": "no meio dela" },
        { "hebraico": "כְּעֶגְלֵי", "transliteral": "kə-ʿeḡ-lê", "traducao_palavra": "como bezerros de" },
        { "hebraico": "מַרְבֵּק", "transliteral": "mar-bêq", "traducao_palavra": "estrebaria/cevados" },
        { "hebraico": "כִּי־גַם־הֵמָּה", "transliteral": "kî-gam-hêm-mā", "traducao_palavra": "porque também eles" },
        { "hebraico": "הִפְנּוּ", "transliteral": "hip̄-nû", "traducao_palavra": "viraram as costas" },
        { "hebraico": "נָסוּ", "transliteral": "nā-śû", "traducao_palavra": "fugiram" },
        { "hebraico": "יַחְדָּיו", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntos" },
        { "hebraico": "לֹא", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "עָמָדוּ", "transliteral": "ʿā-mā-ḏû", "traducao_palavra": "resistiram" },
        { "hebraico": "כִּי", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "יֹום", "transliteral": "yôm", "traducao_palavra": "o dia de" },
        { "hebraico": "אֵידָם", "transliteral": "ʾê-ḏām", "traducao_palavra": "ruína deles" },
        { "hebraico": "בָּא", "transliteral": "bā", "traducao_palavra": "veio" },
        { "hebraico": "עֲלֵיהֶם", "transliteral": "ʿă-lê-hem", "traducao_palavra": "sobre eles" },
        { "hebraico": "עֵת", "transliteral": "ʿêṯ", "traducao_palavra": "[o] tempo de" },
        { "hebraico": "פְּקֻדָּתָם׃", "transliteral": "pə-qud-dā-ṯām", "traducao_palavra": "punição deles" }
      ]
    },
    "22": {
      "traducao_completa": "O seu ruído será como o da serpente que foge; porque virão com exército, e virão a ela com machados, como cortadores de lenha.",
      "palavras": [
        { "hebraico": "קֹולָהּ", "transliteral": "qô-lāh", "traducao_palavra": "seu som" },
        { "hebraico": "כַּנָּחָשׁ", "transliteral": "kan-nā-ḥāš", "traducao_palavra": "como a serpente" },
        { "hebraico": "יֵלֵךְ", "transliteral": "yê-lêḵ", "traducao_palavra": "irá" },
        { "hebraico": "כִּי־בְחַיִל", "transliteral": "kî-ḇə-ḥa-yil", "traducao_palavra": "porque com exército" },
        { "hebraico": "יֵלֵכוּ", "transliteral": "yê-lê-ḵû", "traducao_palavra": "virão" },
        { "hebraico": "וּבְקַרְדֻּמֹּות", "transliteral": "ū-ḇə-qar-dum-môṯ", "traducao_palavra": "e com machados" },
        { "hebraico": "בָּאוּ", "transliteral": "bā-ʾû", "traducao_palavra": "vieram" },
