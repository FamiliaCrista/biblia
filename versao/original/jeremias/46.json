        { "hebraico": "וְהַיֹּום", "transliteral": "wə-hay-yôm", "traducao_palavra": "e este dia" },
        { "hebraico": "הַהוּא", "transliteral": "ha-hû", "traducao_palavra": "aquele" },
        { "hebraico": "לַאדֹנָי", "transliteral": "la-ʾḏō-nāy", "traducao_palavra": "ao Senhor" },
