        { "hebraico": "עֲלִי", "transliteral": "ʿă-lî", "traducao_palavra": "sobe" },
        { "hebraico": "גִלְעָד", "transliteral": "ḡil-ʿāḏ", "traducao_palavra": "[a] Gileade" },
        { "hebraico": "וּקְחִי", "transliteral": "ū-qə-ḥî", "traducao_palavra": "e toma" },
        { "hebraico": "צֳרִי", "transliteral": "ṣo-rî", "traducao_palavra": "bálsamo" },
