        { "hebraico": "הִפְנּוּ", "transliteral": "hip̄-nû", "traducao_palavra": "olharam/voltaram-se" },
        { "hebraico": "מָגֹור", "transliteral": "mā-ḡôr", "traducao_palavra": "terror" },
