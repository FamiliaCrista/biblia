      "traducao_completa": "Joanã, filho de Careá, e todos os capitães dos exércitos que estavam no campo, vieram a Gedalias, a Mispa,",
      "palavras": [
        { "hebraico": "וְיֹוחָנָן֙", "transliteral": "wə-yô-ḥā-nān", "traducao_palavra": "e Joanã" },
        { "hebraico": "בֶּן־קָרֵ֔חַ", "transliteral": "ben-qā-rê-aḥ", "traducao_palavra": "filho de Careá" },
        { "hebraico": "וְכָל־שָׂרֵ֥י", "transliteral": "wə-ḵāl-śā-rê", "traducao_palavra": "e todos os capitães de" },
        { "hebraico": "הַחֲיָלִ֖ים", "transliteral": "ha-ḥă-yā-lîm", "traducao_palavra": "exércitos" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que [estavam]" },
        { "hebraico": "בַּשָּׂדֶ֑ה", "transliteral": "baś-śā-ḏeh", "traducao_palavra": "no campo" },
        { "hebraico": "בָּ֥אוּ", "transliteral": "bā-ʾû", "traducao_palavra": "vieram" },
        { "hebraico": "אֶל־גְּדַלְיָ֖הוּ", "transliteral": "ʾel-gə-ḏal-yā-hû", "traducao_palavra": "a Gedalias" },
        { "hebraico": "הַמִּצְפָּֽתָה׃", "transliteral": "ham-miṣ-pā-ṯā", "traducao_palavra": "[a] Mispa" }
      ]
    },
    "14": {
      "traducao_completa": "E disseram-lhe: Sabes tu que Baalis, rei dos filhos de Amom, enviou a Ismael, filho de Netanias, para te tirar a vida? Mas Gedalias, filho de Aicão, não lhes deu crédito.",
      "palavras": [
        { "hebraico": "וַיֹּאמְר֣וּ", "transliteral": "way-yō-mə-rû", "traducao_palavra": "e disseram" },
        { "hebraico": "אֵלָ֗יו", "transliteral": "ʾê-lāw", "traducao_palavra": "a ele" },
        { "hebraico": "הֲיָדֹ֣עַ", "transliteral": "hă-yā-ḏō-aʿ", "traducao_palavra": "acaso sabes?" },
        { "hebraico": "תֵּדַע֮", "transliteral": "tê-ḏaʿ", "traducao_palavra": "saberias" },
        { "hebraico": "כִּ֡י", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "בַּעֲלִ֣יס", "transliteral": "ba-ʿă-lîs", "traducao_palavra": "Baalis" },
        { "hebraico": "מֶ֣לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "rei de" },
        { "hebraico": "בְּנֵי־עַמֹּון֮", "transliteral": "bə-nê-ʿam-môn", "traducao_palavra": "filhos de Amom" },
