        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "יָבֹ֖אוּ", "transliteral": "yā-ḇō-ʾû", "traducao_palavra": "vierem" },
        { "hebraico": "אֵלֵ֑ינוּ", "transliteral": "ʾē-lê-nû", "traducao_palavra": "a nós" },
        { "hebraico": "וְאַתֶּ֡ם", "transliteral": "wə-ʾat-tem", "traducao_palavra": "e vós" },
        { "hebraico": "אִסְפּ֥וּ", "transliteral": "ʾis-pû", "traducao_palavra": "colhei" },
        { "hebraico": "יַיִן֙", "transliteral": "ya-yin", "traducao_palavra": "vinho" },
