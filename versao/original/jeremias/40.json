        { "hebraico": "אֶרֶץ־יְהוּדָ֛ה", "transliteral": "ʾe-reṣ-yə-hû-ḏā", "traducao_palavra": "[à] terra de Judá" },
        { "hebraico": "אֶל־גְּדַלְיָ֖הוּ", "transliteral": "ʾel-gə-ḏal-yā-hû", "traducao_palavra": "a Gedalias" },
        { "hebraico": "הַמִּצְפָּ֑תָה", "transliteral": "ham-miṣ-pā-ṯā", "traducao_palavra": "[a] Mispa" },
        { "hebraico": "וַיַּאַסְפּ֥וּ", "transliteral": "way-ya-ʾas-pû", "traducao_palavra": "e colheram" },
        { "hebraico": "יַ֛יִן", "transliteral": "ya-yin", "traducao_palavra": "vinho" },
