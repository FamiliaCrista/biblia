        { "hebraico": "בְּעָרֵיכֶ֥ם", "transliteral": "bə-ʿā-rê-ḵem", "traducao_palavra": "em vossas cidades" },
        { "hebraico": "אֲשֶׁר־תְּפַשְׂתֶּֽם׃", "transliteral": "ʾă-šer-tə-p̄aś-tem", "traducao_palavra": "que ocupastes" }
      ]
    },
    "11": {
      "traducao_completa": "Também todos os judeus que estavam em Moabe, e entre os filhos de Amom, e em Edom, e os que havia em todas as terras, ouviram que o rei da Babilônia deixara um resto em Judá, e que pusera sobre eles a Gedalias, filho de Aicão, filho de Safã.",
      "palavras": [
