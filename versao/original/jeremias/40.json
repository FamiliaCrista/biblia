        { "hebraico": "בֶּן־הַמַּעֲכָתִ֔י", "transliteral": "ben-ham-ma-ʿă-ḵā-ṯî", "traducao_palavra": "filho do maacatita" },
        { "hebraico": "הֵ֖מָּה", "transliteral": "hêm-mā", "traducao_palavra": "eles" },
        { "hebraico": "וְאַנְשֵׁיהֶֽם׃", "transliteral": "wə-ʾan-šê-hem", "traducao_palavra": "e seus homens" }
