        { "hebraico": "כָּל־הַיְּהוּדִ֣ים", "transliteral": "kāl-hay-yə-hû-ḏîm", "traducao_palavra": "todos os judeus" },
        { "hebraico": "אֲשֶׁר־בְּמֹואָ֣ב", "transliteral": "ʾă-šer-bə-mô-ʾāḇ", "traducao_palavra": "que [estavam] em Moabe" },
        { "hebraico": "וּבִבְנֵי־עַמֹּ֨ון", "transliteral": "ū-ḇiḇ-nê-ʿam-môn", "traducao_palavra": "e entre os filhos de Amom" },
        { "hebraico": "וּבֶאֱדֹ֜ום", "transliteral": "ū-ḇe-ʾĕ-ḏôm", "traducao_palavra": "e em Edom" },
        { "hebraico": "וַאֲשֶׁ֣ר", "transliteral": "wa-ʾă-šer", "traducao_palavra": "e os que [estavam]" },
        { "hebraico": "בְּכָל־הָאֲרָצֹ֗ות", "transliteral": "bə-ḵāl-hā-ʾă-rā-ṣôṯ", "traducao_palavra": "em todas as terras" },
        { "hebraico": "שָׁמְעוּ֙", "transliteral": "šā-mə-ʿû", "traducao_palavra": "ouviram" },
        { "hebraico": "כִּֽי־נָתַ֧ן", "transliteral": "kî-nā-ṯan", "traducao_palavra": "que deu/deixou" },
        { "hebraico": "מֶֽלֶךְ־בָּבֶ֛ל", "transliteral": "me-leḵ-bā-ḇel", "traducao_palavra": "o rei da Babilônia" },
