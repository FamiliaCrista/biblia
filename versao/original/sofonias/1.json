  "versiculos": {
    "1": {
      "traducao_completa": "Palavra de YHWH que veio a Sofonias, filho de Cusi, filho de Gedalias, filho de Amarias, filho de Ezequias, nos dias de Josias, filho de Amom, rei de Judá.",
