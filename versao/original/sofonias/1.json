        { "hebraico": "וּפָקַדְתִּ֣י", "transliteral": "ū-p̄ā-qaḏ-tî", "traducao_palavra": "e castigarei" },
        { "hebraico": "עַל־הָאֲנָשִׁ֗ים", "transliteral": "ʿal-hā-ʾă-nā-šîm", "traducao_palavra": "os homens" },
        { "hebraico": "הַקֹּֽפְאִים֙", "transliteral": "haq-qō-p̄ə-ʾîm", "traducao_palavra": "que engrossam/se acomodam" },
        { "hebraico": "עַל־שִׁמְרֵיהֶ֔ם", "transliteral": "ʿal-šim-rê-hem", "traducao_palavra": "sobre as suas fezes [do vinho]" },
        { "hebraico": "הָאֹֽמְרִים֙", "transliteral": "hā-ʾō-mə-rîm", "traducao_palavra": "que dizem" },
