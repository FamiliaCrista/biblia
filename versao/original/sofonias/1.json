        { "hebraico": "הָיָה֙", "transliteral": "hā-yā", "traducao_palavra": "veio" },
        { "hebraico": "אֶל־צְפַנְיָה֙", "transliteral": "ʾel-ṣə-p̄an-yā", "traducao_palavra": "a Sofonias" },
        { "hebraico": "בֶּן־כּוּשִׁ֔י", "transliteral": "ben-kū-šî", "traducao_palavra": "filho de Cusi" },
