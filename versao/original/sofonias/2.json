        { "hebraico": "חֵֽרְפוּ֙", "transliteral": "ḥê-rə-p̄û", "traducao_palavra": "afrontaram" },
        { "hebraico": "וַיַּגְדִּ֔ילוּ", "transliteral": "way-yaḡ-dî-lû", "traducao_palavra": "e se engrandeceram" },
        { "hebraico": "עַל־עַ֖ם", "transliteral": "ʿal-ʿam", "traducao_palavra": "contra o povo de" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹֽות׃", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "dos Exércitos." }
      ]
    },
    "11": {
      "traducao_completa": "Terrível será YHWH para eles, porque fará definhar todos os deuses da terra; e todos se prostrarão diante dele, cada um desde o seu lugar, todas as ilhas das nações.",
      "palavras": [
        { "hebraico": "נֹורָ֤א", "transliteral": "nô-rā", "traducao_palavra": "terrível será" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "עֲלֵיהֶ֔ם", "transliteral": "ʿă-lê-hem", "traducao_palavra": "para com eles" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "רָזָ֔ה", "transliteral": "rā-zā", "traducao_palavra": "aniquilará/fará definhar" },
        { "hebraico": "אֵ֖ת", "transliteral": "ʾêṯ", "traducao_palavra": "[objeto]" },
        { "hebraico": "כָּל־אֱלֹהֵ֣י", "transliteral": "kāl-ʾĕ-lō-hê", "traducao_palavra": "todos os deuses de" },
        { "hebraico": "הָאָ֑רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "וְיִשְׁתַּֽחֲווּ־לֹו֙", "transliteral": "wə-yiš-ta-ḥă-wū-lô", "traducao_palavra": "e prostrar-se-ão diante dele" },
        { "hebraico": "אִ֣ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada um" },
        { "hebraico": "מִמְּקֹומֹ֔ו", "transliteral": "mim-mə-qô-mô", "traducao_palavra": "do seu lugar" },
        { "hebraico": "כֹּ֖ל", "transliteral": "kōl", "traducao_palavra": "todas" },
        { "hebraico": "אִיֵּ֥י", "transliteral": "ʾî-yê", "traducao_palavra": "as ilhas de" },
        { "hebraico": "הַגֹּויִֽם׃", "transliteral": "hag-gô-yim", "traducao_palavra": "as nações." }
      ]
    },
    "12": {
      "traducao_completa": "Também vós, ó etíopes, sereis mortos pela minha espada.",
      "palavras": [
        { "hebraico": "גַּם־אַתֶּ֥ם", "transliteral": "gam-ʾat-tem", "traducao_palavra": "também vós" },
        { "hebraico": "כּוּשִׁ֑ים", "transliteral": "kū-šîm", "traducao_palavra": "ó etíopes" },
        { "hebraico": "חַֽלְלֵ֥י", "transliteral": "ḥal-lê", "traducao_palavra": "traspassados/mortos por" },
        { "hebraico": "חַרְבִּ֖י", "transliteral": "ḥar-bî", "traducao_palavra": "minha espada" },
        { "hebraico": "הֵֽמָּה׃", "transliteral": "hêm-mā", "traducao_palavra": "sereis." }
      ]
    },
    "13": {
      "traducao_completa": "Ele estenderá também a sua mão contra o norte, e destruirá a Assíria; e fará de Nínive uma desolação, terra seca como o deserto.",
      "palavras": [
        { "hebraico": "וְיֵ֤ט", "transliteral": "wə-yêṭ", "traducao_palavra": "e estenderá" },
        { "hebraico": "יָדֹו֙", "transliteral": "yā-ḏô", "traducao_palavra": "a sua mão" },
        { "hebraico": "עַל־צָפֹ֔ון", "transliteral": "ʿal-ṣā-p̄ôn", "traducao_palavra": "contra o norte" },
        { "hebraico": "וִֽיאבַּ֖ד", "transliteral": "wî-ʾab-baḏ", "traducao_palavra": "e destruirá" },
        { "hebraico": "אֶת־אַשּׁ֑וּר", "transliteral": "ʾeṯ-ʾaš-šūr", "traducao_palavra": "a Assíria" },
        { "hebraico": "וְיָשֵׂ֤ם", "transliteral": "wə-yā-śêm", "traducao_palavra": "e fará de" },
        { "hebraico": "אֶת־נִֽינְוֵה֙", "transliteral": "ʾeṯ-nî-nə-wêh", "traducao_palavra": "Nínive" },
        { "hebraico": "לִשְׁמָמָ֔ה", "transliteral": "liš-mā-mā", "traducao_palavra": "uma desolação" },
        { "hebraico": "צִיָּ֖ה", "transliteral": "ṣî-yā", "traducao_palavra": "árida" },
        { "hebraico": "כַּמִּדְבָּֽר׃", "transliteral": "kam-miḏ-bār", "traducao_palavra": "como o deserto." }
      ]
    },
    "14": {
      "traducao_completa": "E no meio dela se deitarão rebanhos, todos os animais das nações; e alojar-se-ão nos seus capitéis tanto o pelicano como o ouriço; a voz das aves cantará nas janelas, a desolação estará nos umbrais, pois ele descobriu o forro de cedro.",
      "palavras": [
        { "hebraico": "וְרָבְצוּ֩", "transliteral": "wə-rā-ḇə-ṣû", "traducao_palavra": "e repousarão" },
        { "hebraico": "בְתֹוכָ֨הּ", "transliteral": "ḇə-ṯô-ḵāh", "traducao_palavra": "no meio dela" },
        { "hebraico": "עֲדָרִ֜ים", "transliteral": "ʿă-ḏā-rîm", "traducao_palavra": "rebanhos" },
        { "hebraico": "כָּל־חַיְתֹו־גֹ֗וי", "transliteral": "kāl-ḥay-ṯô-ḡôy", "traducao_palavra": "toda sorte de animais" },
        { "hebraico": "גַּם־קָאַת֙", "transliteral": "gam-qā-ʾaṯ", "traducao_palavra": "tanto o pelicano" },
        { "hebraico": "גַּם־קִפֹּ֔ד", "transliteral": "gam-qip-pōḏ", "traducao_palavra": "como o ouriço" },
        { "hebraico": "בְּכַפְתֹּרֶ֖יהָ", "transliteral": "bə-ḵap̄-tō-re-hā", "traducao_palavra": "nos seus capitéis" },
        { "hebraico": "יָלִ֑ינוּ", "transliteral": "yā-lî-nû", "traducao_palavra": "pernoitarão;" },
        { "hebraico": "קֹ֠ול", "transliteral": "qôl", "traducao_palavra": "uma voz" },
        { "hebraico": "יְשֹׁורֵ֤ר", "transliteral": "yə-šô-rêr", "traducao_palavra": "cantará" },
        { "hebraico": "בַּחַלֹּון֙", "transliteral": "ba-ḥal-lôn", "traducao_palavra": "na janela" },
        { "hebraico": "חֹ֣רֶב", "transliteral": "ḥō-reḇ", "traducao_palavra": "desolação haverá" },
        { "hebraico": "בַּסַּ֔ף", "transliteral": "bas-sap̄", "traducao_palavra": "nos umbrais" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אַרְזָ֖ה", "transliteral": "ʾar-zā", "traducao_palavra": "a obra de cedro" },
        { "hebraico": "עֵרָֽה׃", "transliteral": "ʿê-rā", "traducao_palavra": "está desnudada." }
      ]
    },
    "15": {
      "traducao_completa": "Esta é a cidade alegre, que habitava em segurança, que dizia no seu coração: Eu sou, e não há outra além de mim; como se tornou em desolação, em pousada de animais! Todo o que passar por ela assobiará e meneará a sua mão.",
      "palavras": [
        { "hebraico": "זֹ֞את", "transliteral": "zōṯ", "traducao_palavra": "esta é" },
        { "hebraico": "הָעִ֤יר", "transliteral": "hā-ʿîr", "traducao_palavra": "a cidade" },
        { "hebraico": "הָעַלִּיזָה֙", "transliteral": "hā-ʿal-lî-zā", "traducao_palavra": "alegre/exultante" },
        { "hebraico": "הַיֹּושֶׁ֣בֶת", "transliteral": "hay-yô-še-ḇeṯ", "traducao_palavra": "que habitava" },
        { "hebraico": "לָבֶ֔טַח", "transliteral": "lā-ḇe-ṭaḥ", "traducao_palavra": "em segurança" },
        { "hebraico": "הָאֹֽמְרָה֙", "transliteral": "hā-ʾō-mə-rā", "traducao_palavra": "que dizia" },
        { "hebraico": "בִּלְבָבָ֔הּ", "transliteral": "bil-ḇā-ḇāh", "traducao_palavra": "no seu coração:" },
        { "hebraico": "אֲנִ֖י", "transliteral": "ʾă-nî", "traducao_palavra": "eu sou" },
        { "hebraico": "וְאַפְסִ֣י", "transliteral": "wə-ʾap̄-sî", "traducao_palavra": "e não há outra" },
        { "hebraico": "עֹ֑וד", "transliteral": "ʿôḏ", "traducao_palavra": "além de mim!" },
        { "hebraico": "אֵ֣יךְ", "transliteral": "ʾêḵ", "traducao_palavra": "como" },
        { "hebraico": "הָיְתָ֣ה", "transliteral": "hā-yə-ṯā", "traducao_palavra": "tornou-se ela" },
        { "hebraico": "לְשַׁמָּ֗ה", "transliteral": "lə-šam-mā", "traducao_palavra": "em desolação" },
        { "hebraico": "מַרְבֵּץ֙", "transliteral": "mar-bêṣ", "traducao_palavra": "em guarida/pousada" },
        { "hebraico": "לַֽחַיָּ֔ה", "transliteral": "la-ḥay-yā", "traducao_palavra": "para animais!" },
        { "hebraico": "כֹּ֚ל", "transliteral": "kōl", "traducao_palavra": "todo aquele" },
        { "hebraico": "עֹובֵ֣ר", "transliteral": "ʿô-ḇêr", "traducao_palavra": "que passar" },
        { "hebraico": "עָלֶ֔יהָ", "transliteral": "ʿā-le-hā", "traducao_palavra": "por ela" },
        { "hebraico": "יִשְׁרֹ֖ק", "transliteral": "yiš-rōq", "traducao_palavra": "assobiará" },
        { "hebraico": "יָנִ֥יעַ", "transliteral": "yā-nî-aʿ", "traducao_palavra": "e sacudirá" },
        { "hebraico": "יָדֹֽו׃", "transliteral": "yā-ḏô", "traducao_palavra": "a sua mão." }
      ]
    }
  }
}