        { "hebraico": "חָצֵר֙", "transliteral": "ḥā-ṣêr", "traducao_palavra": "um átrio" },
        { "hebraico": "בְּפִנַּ֣ת", "transliteral": "bə-p̄in-naṯ", "traducao_palavra": "no canto de" },
        { "hebraico": "הֶחָצֵ֔ר", "transliteral": "he-ḥā-ṣêr", "traducao_palavra": "o átrio" },
        { "hebraico": "חָצֵ֖ר", "transliteral": "ḥā-ṣêr", "traducao_palavra": "um átrio" },
