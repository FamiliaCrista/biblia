    "19": {
      "traducao_completa": "Depois me levou pela entrada que estava ao lado da porta, às câmaras santas dos sacerdotes, que olhavam para o norte; e eis que ali havia um lugar no fundo, para o lado do ocidente.",
      "palavras": [
        { "hebraico": "וַיְבִיאֵ֣נִי", "transliteral": "way-ḇî-ʾê-nî", "traducao_palavra": "e ele me levou" },
        { "hebraico": "בַמָּבֹ֗וא", "transliteral": "ḇam-mā-ḇô", "traducao_palavra": "pela entrada" },
        { "hebraico": "אֲשֶׁר֮", "transliteral": "ʾă-šer", "traducao_palavra": "que estava" },
