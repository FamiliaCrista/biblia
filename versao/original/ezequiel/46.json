        { "hebraico": "אֵלַ֔י", "transliteral": "ʾê-lay", "traducao_palavra": "a mim" },
        { "hebraico": "זֶ֣ה", "transliteral": "zeh", "traducao_palavra": "este [é]" },
        { "hebraico": "הַמָּקֹ֗ום", "transliteral": "ham-mā-qôm", "traducao_palavra": "o lugar" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "onde" },
