        { "hebraico": "מִדָּ֣ה", "transliteral": "mid-dā", "traducao_palavra": "medida" },
        { "hebraico": "אַחַ֔ת", "transliteral": "ʾa-ḥaṯ", "traducao_palavra": "uma mesma" },
        { "hebraico": "לְאַרְבַּעְתָּ֖ם", "transliteral": "lə-ʾar-baʿ-tām", "traducao_palavra": "para os quatro" },
