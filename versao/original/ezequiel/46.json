        { "hebraico": "אֶל־הֶחָצֵ֥ר", "transliteral": "ʾel-he-ḥā-ṣêr", "traducao_palavra": "ao átrio" },
        { "hebraico": "הַחִֽיצֹונָ֖ה", "transliteral": "ha-ḥî-ṣô-nā", "traducao_palavra": "exterior" },
        { "hebraico": "לְקַדֵּ֥שׁ", "transliteral": "lə-qad-dêš", "traducao_palavra": "para santificar" },
        { "hebraico": "אֶת־הָעָֽם׃", "transliteral": "ʾeṯ-hā-ʿām", "traducao_palavra": "o povo" }
