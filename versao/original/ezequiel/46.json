        { "hebraico": "הַפֹּנֹ֖ות", "transliteral": "hap-pō-nôṯ", "traducao_palavra": "que davam para" },
        { "hebraico": "צָפֹ֑ונָה", "transliteral": "ṣā-p̄ô-nā", "traducao_palavra": "o norte" },
        { "hebraico": "וְהִנֵּה־שָׁ֣ם", "transliteral": "wə-hin-nēh-šām", "traducao_palavra": "e eis ali" },
