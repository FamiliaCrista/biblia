        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "onde" },
        { "hebraico": "יֹאפ֖וּ", "transliteral": "yō-p̄ū", "traducao_palavra": "assarão" },
        { "hebraico": "אֶת־הַמִּנְחָ֑ה", "transliteral": "ʾeṯ-ham-min-ḥā", "traducao_palavra": "a oferta de cereais" },
        { "hebraico": "לְבִלְתִּ֥י", "transliteral": "lə-ḇil-tî", "traducao_palavra": "para não" },
