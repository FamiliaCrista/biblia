        { "hebraico": "וְעֹמֵד", "transliteral": "wə-ʿō-mēḏ", "traducao_palavra": "e se pusesse" },
        { "hebraico": "בַּפֶּרֶץ", "transliteral": "bap-pe-reṣ", "traducao_palavra": "na brecha" },
