        { "hebraico": "אִישׁ", "transliteral": "ʾîš", "traducao_palavra": "um homem" },
        { "hebraico": "גֹּדֵר", "transliteral": "gō-ḏēr", "traducao_palavra": "que levantasse o muro" },
