        { "hebraico": "הָאָרֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "esta terra" },
        { "hebraico": "לְבִלְתִּי", "transliteral": "lə-ḇil-tî", "traducao_palavra": "para que não" },
        { "hebraico": "שְׁחִתָהּ", "transliteral": "šə-ḥi-ṯāh", "traducao_palavra": "a destruísse" },
        { "hebraico": "וְלֹא", "transliteral": "wə-lō", "traducao_palavra": "e não" },
