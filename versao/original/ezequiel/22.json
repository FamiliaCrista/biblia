{
  "livro": "Ezequiel - יְחֶזְקֵאל - Yechezqel",
  "capítulo": 22,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Veio a mim a palavra de YHWH, dizendo:",
      "palavras": [
        { "hebraico": "וַיְהִ֥י", "transliteral": "way-hî", "traducao_palavra": "e veio" },
        { "hebraico": "דְבַר־יְהוָ֖ה", "transliteral": "də-ḇar-YHWH", "traducao_palavra": "a palavra de YHWH" },
        { "hebraico": "אֵלַ֥י", "transliteral": "ʾē-lay", "traducao_palavra": "a mim" },
        { "hebraico": "לֵאמֹֽר׃", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" }
      ]
    },
    "2": {
      "traducao_completa": "Tu, pois, ó filho do homem, porventura julgarás, julgarás a cidade sanguinária? Faze-lhe conhecer, pois, todas as suas abominações.",
      "palavras": [
        { "hebraico": "וְאַתָּ֣ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "e tu" },
        { "hebraico": "בֶן־אָדָ֗ם", "transliteral": "ben-ʾā-ḏām", "traducao_palavra": "filho do homem" },
        { "hebraico": "הֲתִשְׁפֹּ֤ט", "transliteral": "hă-tiš-pōṭ", "traducao_palavra": "porventura julgarás" },
        { "hebraico": "הֲתִשְׁפֹּט֙", "transliteral": "hă-tiš-pōṭ", "traducao_palavra": "julgarás" },
        { "hebraico": "אֶת־עִ֣יר", "transliteral": "ʾeṯ-ʿîr", "traducao_palavra": "a cidade" },
        { "hebraico": "הַדָּמִ֔ים", "transliteral": "had-dā-mîm", "traducao_palavra": "sanguinária" },
        { "hebraico": "וְהֹודַעְתָּ֖הּ", "transliteral": "wə-hô-ḏaʿ-tāh", "traducao_palavra": "e faze-lhe conhecer" },
        { "hebraico": "אֵ֖ת", "transliteral": "ʾêṯ", "traducao_palavra": "[objeto]" },
        { "hebraico": "כָּל־תֹּועֲבֹותֶֽיהָ׃", "transliteral": "kāl-tô-ʿă-ḇō-wō-ṯe-hā", "traducao_palavra": "todas as suas abominações" }
      ]
    },
    "3": {
      "traducao_completa": "Dize, pois: Assim diz o Senhor YHWH: Cidade que derrama sangue no meio de si, para que venha o seu tempo, e que faz ídolos contra si mesma, para se contaminar!",
      "palavras": [
        { "hebraico": "וְאָמַרְתָּ֗", "transliteral": "wə-ʾā-mar-tā", "traducao_palavra": "e dize" },
        { "hebraico": "כֹּֽה־אָמַר֮", "transliteral": "kō-ʾā-mar", "traducao_palavra": "assim disse" },
        { "hebraico": "אֲדֹנָ֣י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִה֒", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "עִ֣יר", "transliteral": "ʿîr", "traducao_palavra": "cidade" },
        { "hebraico": "שֹׁפֶ֤כֶת", "transliteral": "šō-p̄e-ḵeṯ", "traducao_palavra": "que derrama" },
        { "hebraico": "דָּם֙", "transliteral": "dām", "traducao_palavra": "sangue" },
        { "hebraico": "בְּתֹוכָ֔הּ", "transliteral": "bə-ṯô-ḵāh", "traducao_palavra": "no meio de si" },
        { "hebraico": "לָבֹ֥וא", "transliteral": "lā-ḇô", "traducao_palavra": "para que venha" },
        { "hebraico": "עִתָּ֖הּ", "transliteral": "ʿit-tāh", "traducao_palavra": "o seu tempo" },
        { "hebraico": "וְעָשְׂתָ֥ה", "transliteral": "wə-ʿā-śə-ṯā", "traducao_palavra": "e que faz" },
        { "hebraico": "גִלּוּלִ֖ים", "transliteral": "gil-lû-lîm", "traducao_palavra": "ídolos" },
        { "hebraico": "עָלֶיהָ", "transliteral": "ʿā-le-hā", "traducao_palavra": "contra si mesma" },
        { "hebraico": "לְטָמְאָֽה׃", "transliteral": "lə-ṭām-ʾā", "traducao_palavra": "para se contaminar" }
      ]
    },
    "4": {
      "traducao_completa": "Pelo sangue que derramaste és culpada, e pelos ídolos que fizeste te contaminaste; fizeste aproximar os teus dias, e chegaste ao fim dos teus anos; por isso te dei por opróbrio às nações, e por escárnio a todas as terras.",
      "palavras": [
        { "hebraico": "בְּדָמֵ֤ךְ", "transliteral": "bə-ḏā-mēḵ", "traducao_palavra": "pelo sangue" },
        { "hebraico": "אֲשֶׁר־שָׁפַ֙כְתְּ֙", "transliteral": "ʾă-šer-šā-p̄aḵ-tə", "traducao_palavra": "que derramaste" },
        { "hebraico": "אָשַׁ֔מְתְּ", "transliteral": "ʾā-šam-tə", "traducao_palavra": "és culpada" },
        { "hebraico": "וּבְגִלּוּלַיִךְ", "transliteral": "ū-ḇə-gil-lû-la-yiḵ", "traducao_palavra": "e com os teus ídolos" },
        { "hebraico": "אֲשֶׁר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "עָשִׂ֖ית", "transliteral": "ʿā-śîṯ", "traducao_palavra": "fizeste" },
        { "hebraico": "טִמָּאתְךָ֑", "transliteral": "ṭim-mā-ṯə-ḵā", "traducao_palavra": "te contaminaste" },
        { "hebraico": "וַתַּקְרִבִי", "transliteral": "wat-taq-ri-ḇî", "traducao_palavra": "e fizeste aproximar" },
        { "hebraico": "יָמַיִךְ", "transliteral": "yā-mā-yiḵ", "traducao_palavra": "teus dias" },
        { "hebraico": "וַתָּבֹואִי", "transliteral": "wat-tā-ḇō-ʾî", "traducao_palavra": "e vieste/chegaste" },
        { "hebraico": "עַד־שְׁנֹותָ֑יִךְ", "transliteral": "ʿaḏ-šə-nō-ṯā-yiḵ", "traducao_palavra": "ao fim de teus anos" },
        { "hebraico": "עַל־כֵּן", "transliteral": "ʿal-kên", "traducao_palavra": "por isso" },
        { "hebraico": "נְתַתִּ֤יךְ", "transliteral": "nə-ṯat-tîḵ", "traducao_palavra": "te dei" },
        { "hebraico": "חֶרְפָּה", "transliteral": "ḥer-pā", "traducao_palavra": "por opróbrio" },
        { "hebraico": "לַגֹּויִם", "transliteral": "lag-gô-yim", "traducao_palavra": "às nações" },
        { "hebraico": "וְקֶ֥לַס", "transliteral": "wə-qe-las", "traducao_palavra": "e por escárnio" },
        { "hebraico": "לְכָל־הָאֲרָצֹֽות׃", "transliteral": "lə-ḵāl-hā-ʾă-rā-ṣôṯ", "traducao_palavra": "a todas as terras" }
      ]
    },
    "5": {
      "traducao_completa": "As que estão perto e as que estão longe de ti escarnecerão de ti, ó cidade infamada e cheia de tumulto.",
      "palavras": [
        { "hebraico": "הַקְּרֹובֹות", "transliteral": "haq-qə-rō-ḇôṯ", "traducao_palavra": "as que estão perto" },
        { "hebraico": "וְהָרְחֹקֹות", "transliteral": "wə-hā-rə-ḥō-qôṯ", "traducao_palavra": "e as que estão longe" },
        { "hebraico": "מִמֵּךְ", "transliteral": "mim-mēḵ", "traducao_palavra": "de ti" },
        { "hebraico": "יִתְעַלְּלוּ־בָךְ", "transliteral": "yiṯ-ʿal-lə-lû-ḇāḵ", "traducao_palavra": "escarnecerão de ti" },
        { "hebraico": "טְמֻאַת", "transliteral": "ṭə-mu-ʾaṯ", "traducao_palavra": "impura/infamada" },
        { "hebraico": "הַשֵּׁם", "transliteral": "haš-šēm", "traducao_palavra": "de nome" },
        { "hebraico": "רַבַּת", "transliteral": "rab-baṯ", "traducao_palavra": "cheia de" },
        { "hebraico": "הַמּוּמָה", "transliteral": "ham-mû-mā", "traducao_palavra": "tumulto/mácula" }
      ]
    },
    "6": {
      "traducao_completa": "Eis que os príncipes de Israel, cada um segundo o seu poder, houve em ti para derramar sangue.",
      "palavras": [
        { "hebraico": "הִנֵּה", "transliteral": "hin-nēh", "traducao_palavra": "eis que" },
        { "hebraico": "נְשִׂיאֵי", "transliteral": "nə-śî-ʾê", "traducao_palavra": "os príncipes de" },
        { "hebraico": "יִשְׂרָאֵל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "אִישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada um" },
        { "hebraico": "לִזְרֹועֹו", "transliteral": "liz-rō-ʿô", "traducao_palavra": "segundo o seu braço/poder" },
        { "hebraico": "הָי֥וּ", "traducao_palavra": "houve", "transliteral_alt": "hā-yû" },
        { "hebraico": "בָךְ", "transliteral": "ḇāḵ", "traducao_palavra": "em ti" },
        { "hebraico": "לְמַעַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "com o fim de" },
        { "hebraico": "שְׁפָךְ־דָּֽם׃", "transliteral": "šə-p̄āḵ-dām", "traducao_palavra": "derramar sangue" }
      ]
    },
    "7": {
      "traducao_completa": "Nela desprezaram pai e mãe; no meio dela trataram com opressão ao estrangeiro; nela não respeitaram o órfão e a viúva.",
      "palavras": [
        { "hebraico": "אָב", "transliteral": "ʾāḇ", "traducao_palavra": "pai" },
        { "hebraico": "וָאֵם", "transliteral": "wā-ʾēm", "traducao_palavra": "e mãe" },
        { "hebraico": "הֵקַלּוּ", "transliteral": "hē-qal-lû", "traducao_palavra": "desprezaram" },
        { "hebraico": "בָּךְ", "transliteral": "ḇāḵ", "traducao_palavra": "nelas/em ti" },
        { "hebraico": "לַגֵּר", "transliteral": "lag-gēr", "traducao_palavra": "ao estrangeiro" },
        { "hebraico": "עָשׂוּ", "transliteral": "ʿā-śû", "traducao_palavra": "trataram" },
        { "hebraico": "בְתֹוךְ", "transliteral": "bə-ṯôḵ", "traducao_palavra": "no meio de" },
        { "hebraico": "יָתֹום", "transliteral": "yā-ṯôm", "traducao_palavra": "órfão" },
        { "hebraico": "וְאַלְמָנָה", "transliteral": "wə-ʾal-mā-nā", "traducao_palavra": "e a viúva" },
        { "hebraico": "הֹונ֥וּ", "transliteral": "hō-nû", "traducao_palavra": "oprimiram" },
        { "hebraico": "בָךְ", "transliteral": "ḇāḵ", "traducao_palavra": "em ti" }
      ]
    },
    "8": {
      "traducao_completa": "As minhas coisas santas desprezaste, e os meus sábados profanaste.",
      "palavras": [
        { "hebraico": "קָדָשַׁי", "transliteral": "qā-ḏā-šay", "traducao_palavra": "minhas coisas santas" },
        { "hebraico": "בָּזִית", "transliteral": "bā-zîṯ", "traducao_palavra": "desprezaste" },
        { "hebraico": "וְאֶת־שַׁבְּתֹתַי", "transliteral": "wə-ʾeṯ-šab-bō-ṯay", "traducao_palavra": "e os meus sábados" },
        { "hebraico": "חִלַּלְתָּֽ׃", "transliteral": "ḥil-lal-tā", "traducao_palavra": "profanaste" }
      ]
    },
    "9": {
      "traducao_completa": "Houve nela homens caluniadores para derramar sangue; e nela comeram sobre os montes; no meio dela cometeram abominações.",
      "palavras": [
        { "hebraico": "אַנְשֵׁי", "transliteral": "ʾan-šê", "traducao_palavra": "homens" },
        { "hebraico": "רָכִיל", "transliteral": "rā-ḵîl", "traducao_palavra": "caluniadores" },
        { "hebraico": "הָיוּ", "transliteral": "hā-yû", "traducao_palavra": "houve" },
        { "hebraico": "בָּךְ", "transliteral": "ḇāḵ", "traducao_palavra": "nela" },
        { "hebraico": "לְמַעַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "com o fim de" },
        { "hebraico": "שְׁפָךְ־דָּם", "transliteral": "šə-p̄āḵ-dām", "traducao_palavra": "derramar sangue" },
        { "hebraico": "וְאֶל־הֶהָרִים", "transliteral": "wə-ʾel-he-hā-rîm", "traducao_palavra": "e sobre os montes" },
        { "hebraico": "אָכְלוּ", "transliteral": "ʾā-ḵə-lû", "traducao_palavra": "comeram" },
        { "hebraico": "בְתֹוכֵךְ", "transliteral": "bə-ṯô-ḵêḵ", "traducao_palavra": "no meio de ti" },
        { "hebraico": "עָשׂוּ", "transliteral": "ʿā-śû", "traducao_palavra": "cometeram" },
        { "hebraico": "זִמָּה", "transliteral": "zim-mā", "traducao_palavra": "abominação/lascívia" }
      ]
    },
    "10": {
      "traducao_completa": "Na tua terra descobriram a vergonha do pai, na tua terra humilharam a que estava impura na sua separação.",
      "palavras": [
        { "hebraico": "עֶרְוַת", "transliteral": "ʿer-waṯ", "traducao_palavra": "a vergonha/nudez de" },
        { "hebraico": "אָב", "transliteral": "ʾāḇ", "traducao_palavra": "pai" },
        { "hebraico": "גִּלּוּ", "transliteral": "gil-lû", "traducao_palavra": "descobriram" },
        { "hebraico": "בָּךְ", "transliteral": "ḇāḵ", "traducao_palavra": "em ti" },
        { "hebraico": "טֻמְאַת", "transliteral": "ṭum-ʾaṯ", "traducao_palavra": "a impureza da" },
        { "hebraico": "הַנִּדָּה", "transliteral": "han-nid-dā", "traducao_palavra": "mulher separada" },
        { "hebraico": "עִנּוּ", "transliteral": "ʿin-nû", "traducao_palavra": "humilharam" },
        { "hebraico": "בָךְ", "transliteral": "ḇāḵ", "traducao_palavra": "em ti" }
      ]
    },
    "11": {
      "traducao_completa": "Um cometeu abominação com a mulher do seu próximo; outro contaminou a sua nora com infâmia; outro humilhou nela sua irmã, filha de seu pai.",
      "palavras": [
        { "hebraico": "וְאִישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "e um homem" },
        { "hebraico": "אֶת־אֵשֶׁת", "transliteral": "ʾeṯ-ʾē-šeṯ", "traducao_palavra": "com a mulher de" },
        { "hebraico": "רֵעֵהוּ", "transliteral": "rē-ʿê-hû", "traducao_palavra": "seu próximo" },
        { "hebraico": "עָשָׂה", "transliteral": "ʿā-śā", "traducao_palavra": "cometeu" },
        { "hebraico": "תֹועֵבָה", "transliteral": "tô-ʿê-ḇā", "traducao_palavra": "abominação" },
        { "hebraico": "וְאִישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "e outro" },
        { "hebraico": "כַּלָּתֹו", "transliteral": "kal-lā-ṯô", "traducao_palavra": "sua nora" },
        { "hebraico": "טִמֵּא", "transliteral": "ṭim-mē", "traducao_palavra": "contaminou" },
        { "hebraico": "בְּזִמָּה", "transliteral": "bə-zim-mā", "traducao_palavra": "com infâmia" },
        { "hebraico": "וְאִישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "e outro" },
        { "hebraico": "בַּאֲחֹתֹו", "transliteral": "ba-ʾă-ḥō-ṯô", "traducao_palavra": "sua irmã" },
        { "hebraico": "בַּת־אָבִיו", "transliteral": "baṯ-ʾā-ḇîw", "traducao_palavra": "filha de seu pai" },
        { "hebraico": "עִנָּה", "transliteral": "ʿin-nā", "traducao_palavra": "humilhou" },
        { "hebraico": "בָךְ", "transliteral": "ḇāḵ", "traducao_palavra": "nelas/em ti" }
      ]
    },
    "12": {
      "traducao_completa": "Em ti tomaram subornos para derramar sangue; usura e juro tomaste, e usaste de avareza com o teu próximo, oprimindo-o, e a mim te esqueceste, diz o Senhor YHWH.",
      "palavras": [
        { "hebraico": "שֹׁחַד", "transliteral": "šō-ḥaḏ", "traducao_palavra": "suborno" },
        { "hebraico": "לָקְחוּ", "transliteral": "lā-qə-ḥû", "traducao_palavra": "tomaram" },
        { "hebraico": "בָּךְ", "transliteral": "bāḵ", "traducao_palavra": "em ti" },
        { "hebraico": "לְמַעַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "para" },
        { "hebraico": "שְׁפָךְ־דָּם", "transliteral": "šə-p̄āḵ-dām", "traducao_palavra": "derramar sangue" },
        { "hebraico": "נֶשֶׁךְ", "transliteral": "ne-šeḵ", "traducao_palavra": "usura" },
        { "hebraico": "וְTARGETTING", "transliteral": "wə-ṯar-bîṯ", "traducao_palavra": "e juros" },
        { "hebraico": "לָקַחְתְּ", "transliteral": "lā-qaḥ-tə", "traducao_palavra": "tomaste" },
        { "hebraico": "וַתְּבַצְּעִי", "transliteral": "wat-tə-ḇaṣ-ṣə-ʿî", "traducao_palavra": "e usaste de avareza/ganância" },
        { "hebraico": "רֵעַיִךְ", "transliteral": "rē-ʿa-yiḵ", "traducao_palavra": "com o teu próximo" },
        { "hebraico": "בּْعֹשֶׁק", "transliteral": "bə-ʿō-šeq", "traducao_palavra": "oprimindo-o" },
        { "hebraico": "וְאֹתִי", "transliteral": "wə-ʾō-ṯî", "traducao_palavra": "e de mim" },
        { "hebraico": "שָׁכַחַתְּ", "transliteral": "šā-ḥa-ḥat-tə", "traducao_palavra": "te esqueceste" },
        { "hebraico": "נְאֻם", "transliteral": "nə-ʾum", "traducao_palavra": "diz" },
        { "hebraico": "אֲדֹנָי", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִה", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "13": {
      "traducao_completa": "Eis, pois, que bati com as minhas mãos contra a avareza que cometeste, e contra o sangue que houve no meio de ti.",
