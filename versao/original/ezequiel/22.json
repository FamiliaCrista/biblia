    "29": {
      "traducao_completa": "O povo da terra usa de opressão, e usa de roubo, e faz violência ao pobre e ao necessitado, e ao estrangeiro oprime sem justiça.",
      "palavras": [
        { "hebraico": "עַם", "transliteral": "ʿam", "traducao_palavra": "o povo" },
        { "hebraico": "הָאָרֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "da terra" },
        { "hebraico": "עָשְׁקוּ", "transliteral": "ʿā-šə-qû", "traducao_palavra": "usam de opressão" },
        { "hebraico": "עֹשֶׁק", "transliteral": "ʿō-šeq", "traducao_palavra": "opressão" },
        { "hebraico": "וְגָזְלוּ", "transliteral": "wə-ḡā-zə-lû", "traducao_palavra": "e roubam" },
        { "hebraico": "גָּזֵל", "transliteral": "gā-zēl", "traducao_palavra": "roubo" },
        { "hebraico": "וְעָנִי", "transliteral": "wə-ʿā-nî", "traducao_palavra": "e ao pobre" },
        { "hebraico": "וֶאֶבְיֹון", "transliteral": "we-ʾeḇ-yôn", "traducao_palavra": "e ao necessitado" },
        { "hebraico": "הֹונוּ", "transliteral": "hō-nû", "traducao_palavra": "oprimem" },
        { "hebraico": "וְאֶת", "transliteral": "wə-ʾeṯ", "traducao_palavra": "e ao" },
        { "hebraico": "הַגֵּר", "transliteral": "hag-gēr", "traducao_palavra": "estrangeiro" },
        { "hebraico": "עָשְׁקוּ", "transliteral": "ʿā-šə-qû", "traducao_palavra": "oprimem" },
        { "hebraico": "בְּלֹא", "transliteral": "bə-lō", "traducao_palavra": "sem" },
        { "hebraico": "מִשְׁפָּט", "transliteral": "miš-pāṭ", "traducao_palavra": "justiça" }
