    "10": {
      "traducao_completa": "E se ele gerar um filho violento, derramador de sangue, que fizer a um irmão qualquer uma destas coisas,",
      "palavras": [
        { "hebraico": "וְהֹולִ֥יד", "transliteral": "wə-hô-lîḏ", "traducao_palavra": "e se gerar" },
