        { "hebraico": "מֹֽשְׁלִים֙", "transliteral": "mō-šə-lîm", "traducao_palavra": "proferis provérbio" },
        { "hebraico": "אֶת־הַמָּשָׁ֣ל", "transliteral": "ʾeṯ-ham-mā-šāl", "traducao_palavra": "o provérbio" },
