        { "hebraico": "יִתֵּ֔ן", "transliteral": "yit-tên", "traducao_palavra": "deu" },
        { "hebraico": "וְעֵירֹ֖ם", "transliteral": "wə-ʿê-rōm", "traducao_palavra": "e ao nu" },
