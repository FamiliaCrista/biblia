        { "hebraico": "אָכָ֔ל", "transliteral": "ʾā-ḵāl", "traducao_palavra": "comeu" },
        { "hebraico": "וְעֵינָיו֙", "transliteral": "wə-ʿê-nāyw", "traducao_palavra": "e seus olhos" },
