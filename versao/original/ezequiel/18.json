    "4": {
      "traducao_completa": "Eis que todas as almas são minhas; como a alma do pai, assim também a alma do filho é minha; a alma que pecar, essa morrerá.",
      "palavras": [
        { "hebraico": "הֵ֤ן", "transliteral": "hên", "traducao_palavra": "eis que" },
