        { "hebraico": "בֵּ֥ין", "transliteral": "bên", "traducao_palavra": "entre" },
        { "hebraico": "אִ֖ישׁ", "transliteral": "ʾîš", "traducao_palavra": "homem" },
        { "hebraico": "לְאִֽישׁ׃", "transliteral": "lə-ʾîš", "traducao_palavra": "e homem" }
      ]
    },
    "9": {
      "traducao_completa": "Andando nos meus estatutos, e guardando os meus juízos, para agir segundo a verdade; esse é justo, certamente viverá, diz o Senhor YHWH.",
