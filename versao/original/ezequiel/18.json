        { "hebraico": "וְאֶת־אֵ֤שֶׁת", "transliteral": "wə-ʾeṯ-ʾê-šeṯ", "traducao_palavra": "e a mulher de" },
        { "hebraico": "רֵעֵ֙הוּ֙", "transliteral": "rē-ʿê-hû", "traducao_palavra": "seu próximo" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "טִמֵּ֔א", "transliteral": "ṭim-mē", "traducao_palavra": "contaminou" },
