    "5": {
      "traducao_completa": "Sendo, pois, o homem justo, e praticando juízo e justiça,",
      "palavras": [
        { "hebraico": "וְאִ֖ישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "e o homem" },
        { "hebraico": "כִּֽי־יִהְיֶ֣ה", "transliteral": "kî-yih-yeh", "traducao_palavra": "se for" },
        { "hebraico": "צַדִּ֑יק", "transliteral": "ṣad-dîq", "traducao_palavra": "justo" },
        { "hebraico": "וְעָשָׂ֥ה", "transliteral": "wə-ʿā-śā", "traducao_palavra": "e praticar" },
        { "hebraico": "מִשְׁפָּ֖ט", "transliteral": "miš-pāṭ", "traducao_palavra": "juízo" },
