    "6": {
      "traducao_completa": "Não comendo sobre os montes, nem levantando os seus olhos para os ídolos da casa de Israel, nem contaminando a mulher do seu próximo, nem se chegando à mulher na sua separação,",
      "palavras": [
        { "hebraico": "אֶל־הֶֽהָרִים֙", "transliteral": "ʾel-he-hā-rîm", "traducao_palavra": "sobre os montes" },
