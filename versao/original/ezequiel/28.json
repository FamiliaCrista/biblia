        { "hebraico": "הִיא", "transliteral": "hî", "traducao_palavra": "ele" },
        { "hebraico": "אֲכָלַתְךָ", "transliteral": "ʾă-ḵā-la-ṯə-ḵā", "traducao_palavra": "te consumiu" },
        { "hebraico": "וָאֶתְּנֶךָ", "transliteral": "wā-ʾet-tə-ne-ḵā", "traducao_palavra": "e te tornei" },
