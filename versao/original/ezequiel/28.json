        { "hebraico": "כְּרוּב", "transliteral": "kə-rûḇ", "traducao_palavra": "o querubim" },
        { "hebraico": "הַמּَسֹכֵךְ", "transliteral": "ham-mă-sō-ḵêḵ", "traducao_palavra": "protetor" },
        { "hebraico": "מִתֹּוכ", "transliteral": "mit-tôḵ", "traducao_palavra": "do meio de" },
