        { "hebraico": "כָּל־יֹודְעֶיךָ", "transliteral": "kāl-yō-wə-ḏe-ʿe-ḵā", "traducao_palavra": "todos os que te conhecem" },
        { "hebraico": "בָּעַמִּים", "transliteral": "bā-ʿam-mîm", "traducao_palavra": "entre os povos" },
