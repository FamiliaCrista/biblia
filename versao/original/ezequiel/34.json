        { "hebraico": "نָפֹצוּ", "transliteral": "nā-p̄ō-ṣû", "traducao_palavra": "foram espalhadas" },
        { "hebraico": "وَإَيْن", "transliteral": "wə-ʾên", "traducao_palavra": "e sem que" },
