        { "hebraico": "وְعַל", "transliteral": "wə-ʿal", "traducao_palavra": "e sobre" },
        { "hebraico": "כָּל־פְּנֵי", "transliteral": "kāl-pə-nê", "traducao_palavra": "toda a face de" },
