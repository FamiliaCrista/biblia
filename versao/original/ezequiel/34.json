        { "hebraico": "وَإَيْن", "transliteral": "wə-ʾên", "traducao_palavra": "e sem que" },
        { "hebraico": "مְבַקֵּשׁ", "transliteral": "mə-ḇaq-qēš", "traducao_palavra": "procurasse" }
