    "5": {
      "traducao_completa": "Assim, se espalharam, por não haver pastor, e tornaram-se pastagem para todas as feras do campo, porquanto se espalharam.",
      "palavras": [
        { "hebraico": "וַתְּפُודֶינָה", "transliteral": "wat-tə-p̄û-ḏe-nā", "traducao_palavra": "e se espalharam" },
