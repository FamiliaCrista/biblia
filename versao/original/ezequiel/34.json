    "10": {
      "traducao_completa": "Assim diz o Senhor YHWH: Eis que estou contra os pastores, e das suas mãos requererei as minhas ovelhas, e os farei deixar de apascentar as ovelhas, para que os pastores não se apascentem mais a si mesmos; e livrarei as minhas ovelhas da sua boca, para que não lhes sirvam de pasto.",
      "palavras": [
        { "hebraico": "كֹה", "transliteral": "kō", "traducao_palavra": "assim" },
        { "hebraico": "אָמַר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "אֲדֹנָי", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "הִנְנִי", "transliteral": "hin-nî", "traducao_palavra": "eis que eu" },
        { "hebraico": "إَل", "transliteral": "ʾel", "traducao_palavra": "contra" },
        { "hebraico": "הָרֹעִים", "transliteral": "hār-rō-ʿîם", "traducao_palavra": "os pastores" },
        { "hebraico": "وَدָרַשְׁתִּי", "transliteral": "wə-ḏā-raš-tî", "traducao_palavra": "e requererei" },
        { "hebraico": "אֶת־צֹאנִי", "transliteral": "ʾeṯ-ṣō-nî", "traducao_palavra": "as minhas ovelhas" },
