    "4": {
      "traducao_completa": "A fraca não fortalecistes, e a doente não curastes, e a quebrada não ligastes, e a desgarrada não trouxestes de volta, e a perdida não buscastes; mas com violência e com rigor as haveis dominado.",
      "palavras": [
        { "hebraico": "אֶת־הַנַּחְלֹות", "transliteral": "ʾeṯ-han-naḥ-lôṯ", "traducao_palavra": "as fracos/enfermas" },
