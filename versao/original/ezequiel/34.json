        { "hebraico": "הַשָּׂדֶה", "transliteral": "haś-śā-ḏeh", "traducao_palavra": "o campo" },
        { "hebraico": "وַتְּפُודֶינָה", "transliteral": "wat-tə-p̄û-ḏe-nā", "traducao_palavra": "e espalharam-se" }
      ]
    },
    "6": {
      "traducao_completa": "As minhas ovelhas andam desgarradas por todos os montes, e por todo o alto outeiro; e as minhas ovelhas foram espalhadas por toda a face da terra, sem que houvesse quem as andasse a procurar, nem quem as buscasse.",
      "palavras": [
        { "hebraico": "يִשְׁگּוּ", "transliteral": "yiš-gû", "traducao_palavra": "andam desgarradas" },
        { "hebraico": "צֹאנִי", "transliteral": "ṣō-nî", "traducao_palavra": "minhas ovelhas" },
        { "hebraico": "בְּכָל־הָרִים", "transliteral": "bə-ḵāl-hā-rîm", "traducao_palavra": "por todos os montes" },
