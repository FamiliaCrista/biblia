        { "hebraico": "רֹעֶה", "transliteral": "rō-ʿeh", "traducao_palavra": "pastor" },
        { "hebraico": "وַتִּהְיֶינָה", "transliteral": "wat-tih-ye-nā", "traducao_palavra": "e tornaram-se" },
