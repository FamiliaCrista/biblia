        { "hebraico": "כִּ֛י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "כֹּ֥ה", "transliteral": "kō", "traducao_palavra": "assim" },
        { "hebraico": "אָמַ֖ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "אֲדֹנָ֣י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "הִנְנִי־אָ֕נִי", "transliteral": "hin-nî-ʾā-nî", "traducao_palavra": "eis-me aqui, eu mesmo" },
        { "hebraico": "וְדָרַשְׁתִּ֥י", "transliteral": "wə-ḏā-raš-tî", "traducao_palavra": "e buscarei" },
        { "hebraico": "אֶת־צֹאנִ֖י", "transliteral": "ʾeṯ-ṣō-nî", "traducao_palavra": "as minhas ovelhas" },
