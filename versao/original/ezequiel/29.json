{
  "livro": "Ezequiel - יְחֶזְקֵאל - Yechezqel",
  "capítulo": 29,
  "parte": "1 (Versículos 1 ao 12)",
  "versiculos": {
    "1": {
      "traducao_completa": "No décimo ano, no décimo mês, aos doze do mês, veio a mim a palavra de YHWH, dizendo:",
      "palavras": [
        { "hebraico": "בַּשָּׁנָה", "transliteral": "baš-šā-nā", "traducao_palavra": "no ano" },
        { "hebraico": "הָעֲשִׂירִית", "transliteral": "hā-ʿă-śî-rîṯ", "traducao_palavra": "décimo" },
        { "hebraico": "בָּעֲשִׂירִי", "transliteral": "bā-ʿă-śî-rî", "traducao_palavra": "no décimo [mês]" },
        { "hebraico": "בִּשְׁנֵים", "transliteral": "biš-nêm", "traducao_palavra": "aos doze" },
        { "hebraico": "עָשָׂר", "transliteral": "ʿā-śār", "traducao_palavra": "dez" },
        { "hebraico": "לַחֹדֶשׁ", "transliteral": "la-ḥō-ḏeš", "traducao_palavra": "do mês" },
        { "hebraico": "הָיָה", "transliteral": "hā-yā", "traducao_palavra": "veio" },
        { "hebraico": "דְבַר־יְהוָה", "transliteral": "də-ḇar-YHWH", "traducao_palavra": "a palavra de YHWH" },
        { "hebraico": "אֵלַי", "transliteral": "ʾē-lay", "traducao_palavra": "a mim" },
        { "hebraico": "לֵאמֹר", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" }
      ]
    },
    "2": {
      "traducao_completa": "Filho do homem, vira o teu rosto contra Faraó, rei do Egito, e profetiza contra ele e contra todo o Egito.",
      "palavras": [
        { "hebraico": "בֶּן־אָדָם", "transliteral": "ben-ʾā-ḏām", "traducao_palavra": "filho do homem" },
        { "hebraico": "שִׂים", "transliteral": "śîm", "traducao_palavra": "vira" },
        { "hebraico": "פָּנֶיךָ", "transliteral": "pā-ne-ḵā", "traducao_palavra": "teu rosto" },
        { "hebraico": "עַל־פַּרְעֹה", "transliteral": "ʿal-par-ʿōh", "traducao_palavra": "contra Faraó" },
        { "hebraico": "מֶלֶךְ־מִצְרָיִם", "transliteral": "me-leḵ-miṣ-rā-yim", "traducao_palavra": "rei do Egito" },
        { "hebraico": "וְהִנָּבֵא", "transliteral": "wə-hin-nā-ḇē", "traducao_palavra": "e profetiza" },
        { "hebraico": "עָלָיו", "transliteral": "ʿā-lāw", "traducao_palavra": "contra ele" },
        { "hebraico": "וְעַל־מִצְרַיִם", "transliteral": "wə-ʿal-miṣ-ra-yim", "traducao_palavra": "e contra todo o Egito" },
        { "hebraico": "כֻּלֹּה", "transliteral": "kul-lô", "traducao_palavra": "todo ele" }
      ]
    },
    "3": {
      "traducao_completa": "Fala, e dize: Assim diz o Senhor YHWH: Eis que eu sou contra ti, Faraó, rei do Egito, ó grande monstro que te deitas no meio dos teus rios, que dizes: O meu rio é meu, e eu o fiz para mim mesmo.",
      "palavras": [
        { "hebraico": "דַּבֵּר", "transliteral": "dab-bēr", "traducao_palavra": "fala" },
        { "hebraico": "וְאָמַרְתָּ", "transliteral": "wə-ʾā-mar-tā", "traducao_palavra": "e dize" },
        { "hebraico": "כֹּה־אָמַר", "transliteral": "kō-ʾā-mar", "traducao_palavra": "assim disse" },
        { "hebraico": "אֲדֹנָי", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "הִנְנִי", "transliteral": "hin-nî", "traducao_palavra": "eis que eu" },
        { "hebraico": "עָלֶיךָ", "transliteral": "ʿā-le-ḵā", "traducao_palavra": "contra ti" },
        { "hebraico": "פַּרְעֹה", "transliteral": "par-ʿōh", "traducao_palavra": "Faraó" },
        { "hebraico": "מֶלֶךְ־מִצְרָיִם", "transliteral": "me-leḵ-miṣ-rā-yim", "traducao_palavra": "rei do Egito" },
        { "hebraico": "הַתַּנִּים", "transliteral": "hat-tan-nîm", "traducao_palavra": "o grande monstro" },
        { "hebraico": "הַגָּדֹול", "transliteral": "hag-ḡā-ḏôl", "traducao_palavra": "grande" },
        { "hebraico": "הָרֹבֵץ", "transliteral": "hā-rō-ḇēṣ", "traducao_palavra": "que te deitas" },
        { "hebraico": "בְּתֹוךְ", "transliteral": "bə-ṯôḵ", "traducao_palavra": "no meio de" },
        { "hebraico": "יְאֹרָיו", "transliteral": "yə-ʾō-rāyw", "traducao_palavra": "teus rios" }
      ]
    },
    "4": {
      "traducao_completa": "Mas porei anzóis nos teus queixos, e farei que os peixes dos teus rios se apeguem às tuas escamas, e te farei subir do meio dos teus rios, e todos os peixes dos teus rios se apegarão às tuas escamas.",
      "palavras": [
        { "hebraico": "וְנָתַתִּי", "transliteral": "wə-nā-ṯat-tî", "traducao_palavra": "e porei" },
        { "hebraico": "חַחִים", "transliteral": "ḥa-ḥîm", "traducao_palavra": "anzóis" },
        { "hebraico": "בִּלְחָיֶיךָ", "transliteral": "bil-ḥā-ye-ḵā", "traducao_palavra": "nos teus queixos" },
        { "hebraico": "וְהִדְבַּקְתִּי", "transliteral": "wə-hiḏ-baq-tî", "traducao_palavra": "e farei que se apeguem" },
        { "hebraico": "דְּגַת", "transliteral": "də-ḡaṯ", "traducao_palavra": "peixes" },
        { "hebraico": "יְאֹרֶיךָ", "transliteral": "yə-ʾō-re-ḵā", "traducao_palavra": "dos teus rios" },
        { "hebraico": "בְּקַשְׂקְשֹׂתֶיךָ", "transliteral": "bə-qas-qə-śō-ṯe-yḵā", "traducao_palavra": "às tuas escamas" }
      ]
    },
    "5": {
      "traducao_completa": "E te deixarei no deserto, a ti e a todos os peixes dos teus rios; sobre a face do campo cairás; não serás recolhido, nem ajuntado; às feras da terra e às aves do céu te dei por mantimento.",
      "palavras": [
        { "hebraico": "וּנְטַשְׁתִּ֧יךָ", "transliteral": "ū-nə-ṭaš-tî-ḵā", "traducao_palavra": "e te deixarei" },
        { "hebraico": "הַמִּדְבָּרָה", "transliteral": "ham-miḏ-bā-rā", "traducao_palavra": "[no] deserto" },
        { "hebraico": "אֹותְךָ", "transliteral": "ʾō-ṯə-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "וְאֵת", "transliteral": "wə-ʾēṯ", "traducao_palavra": "e a" },
        { "hebraico": "כָּל־דְּגַ֣ת", "transliteral": "kāl-də-ḡaṯ", "traducao_palavra": "todos os peixes" }
      ]
    },
    "6": {
      "traducao_completa": "E saberão todos os moradores do Egito que eu sou YHWH, porque têm sido um báculo de cana para a casa de Israel.",
      "palavras": [
        { "hebraico": "וְיָדְעוּ", "transliteral": "wî-ḏaʿ-tû", "traducao_palavra": "e saberão" },
        { "hebraico": "כָּל־יֹושְׁבֵ֥י", "transliteral": "kāl-yô-šə-ḇê", "traducao_palavra": "todos os moradores de" },
        { "hebraico": "מִצְרַיִם", "transliteral": "miṣ-ra-yim", "traducao_palavra": "Egito" },
        { "hebraico": "כִּֽי־אֲנִ֥י", "transliteral": "kî-ʾă-nî", "traducao_palavra": "que eu [sou]" },
        { "hebraico": "יְהוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "יַ֣עַן", "transliteral": "ya-ʿan", "traducao_palavra": "porque" },
        { "hebraico": "הֱיֹותָם", "transliteral": "hĕ-yô-ṯām", "traducao_palavra": "eles foram" },
        { "hebraico": "מַשְׁעֵ֥נֶת", "transliteral": "maš-ʿē-neṯ", "traducao_palavra": "um báculo" },
        { "hebraico": "קָנֶ֖ה", "transliteral": "qā-neh", "traducao_palavra": "de cana" },
        { "hebraico": "לְבֵ֥ית", "transliteral": "lə-ḇêṯ", "traducao_palavra": "para a casa de" },
        { "hebraico": "יִשְׂרָאֵֽל׃", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" }
      ]
    },
    "7": {
      "traducao_completa": "Quando te pegaram pela mão, te quebraste e rasgaste todos os seus ombros; e, quando se apoiaram em ti, te quebraste e fizeste tremer todos os seus lombos.",
      "palavras": [
        { "hebraico": "בְּתָפְשָׂ֣ם", "transliteral": "bə-ṯā-p̄ə-śām", "traducao_palavra": "quando te pegaram" },
        { "hebraico": "בְּךָ֣", "transliteral": "bə-ḵā", "traducao_palavra": "em ti" },
        { "hebraico": "בַּיָּד", "transliteral": "bay-yāḏ", "traducao_palavra": "pela mão" }
      ]
    },
    "8": {
      "traducao_completa": "Portanto, assim diz o Senhor YHWH: Eis que trarei sobre ti a espada, e arrancarei de ti homens e animais.",
      "palavras": [
        { "hebraico": "לָכֵ֞ן", "transliteral": "lā-ḵên", "traducao_palavra": "portanto" },
        { "hebraico": "כֹּֽה־אָמַר", "transliteral": "kō-ʾā-mar", "traducao_palavra": "assim disse" },
        { "hebraico": "אֲדֹנָ֣י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "הִנְנִ֨י", "transliteral": "hin-nî", "traducao_palavra": "eis que eu" },
        { "hebraico": "מֵבִ֤יא", "transliteral": "mê-ḇî", "traducao_palavra": "trarei" },
        { "hebraico": "עָלַ֨יִךְ֙", "transliteral": "ʿā-la-yiḵ", "traducao_palavra": "sobre ti" },
        { "hebraico": "חֶ֔רֶב", "transliteral": "ḥe-reḇ", "traducao_palavra": "a espada" }
      ]
    },
    "9": {
      "traducao_completa": "E a terra do Egito se tornará em desolação e espanto; e saberão que eu sou YHWH; porquanto disse: O rio é meu, e eu o fiz.",
      "palavras": [
        { "hebraico": "וְהָיְתָ֤ה", "transliteral": "wə-hā-yə-ṯā", "traducao_palavra": "e será" },
        { "hebraico": "אֶרֶץ־מִצְרַיִם֙", "transliteral": "ʾe-reṣ-miṣ-ra-yim", "traducao_palavra": "a terra do Egito" },
        { "hebraico": "לְשִׁמָּמָ֣ה", "transliteral": "lə-šim-mā-mā", "traducao_palavra": "em desolação" },
        { "hebraico": "וְחָרְבָּ֔ה", "transliteral": "wə-ḥā-rə-bā", "traducao_palavra": "e ruína" }
      ]
    },
    "10": {
      "traducao_completa": "Portanto, eis que eu sou contra ti, e contra os teus rios; e farei da terra do Egito uma total desolação e espanto, desde Migdol até Sevene, e até aos limites da Etiópia.",
      "palavras": [
        { "hebraico": "לָכֵ֗ן", "transliteral": "lā-ḵên", "traducao_palavra": "portanto" },
        { "hebraico": "הִנְנִי", "transliteral": "hin-nî", "traducao_palavra": "eis que eu" },
        { "hebraico": "אֵלֶ֨יךָ֙", "transliteral": "ʾē-le-ḵā", "traducao_palavra": "contra ti" },
        { "hebraico": "וְאֶל־יְאֹרֶ֔יךָ", "transliteral": "wə-ʾel-yə-ʾō-re-ḵā", "traducao_palavra": "e contra os teus rios" }
      ]
    },
    "11": {
      "traducao_completa": "Nela não passará pé de homem, nem pé de animal passará nela, nem será habitada por quarenta anos.",
      "palavras": [
        { "hebraico": "לֹא־תַעֲבָר־בָּהּ", "transliteral": "lō-ṯa-ʿă-ḇār-bāh", "traducao_palavra": "não passará nela" },
        { "hebraico": "רֶגֶל", "transliteral": "re-ḡel", "traducao_palavra": "pé" },
        { "hebraico": "אָדָם", "transliteral": "ʾā-ḏām", "traducao_palavra": "de homem" }
      ]
    },
    "12": {
      "traducao_completa": "E farei da terra do Egito uma desolação entre as terras assoladas; e as suas cidades, entre as cidades desertas, estarão desertas por quarenta anos; e espalharei os egípcios entre as nações, e os dispersarei pelas terras.",
      "palavras": [
        { "hebraico": "וְנָתַתִּ֤י", "transliteral": "wə-nā-ṯat-tî", "traducao_palavra": "e farei" },
        { "hebraico": "אֶת־אֶרֶץ", "transliteral": "ʾeṯ-ʾe-reṣ", "traducao_palavra": "a terra de" },
        { "hebraico": "מִצְרַיִם", "transliteral": "miṣ-ra-yim", "traducao_palavra": "Egito" },
        { "hebraico": "שְׁמָמָה", "transliteral": "šə-mā-mā", "traducao_palavra": "desolação" }
      ]
    },
    "13": {
      "traducao_completa": "Porque assim diz o Senhor YHWH: Ao fim de quarenta anos ajuntarei os egípcios dentre os povos entre os quais foram espalhados.",
      "palavras": [
        { "hebraico": "כִּ֛י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "כֹּ֥ה", "transliteral": "kō", "traducao_palavra": "assim" },
        { "hebraico": "אָמַ֖ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "אֲדֹנָ֣י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מִקֵּ֞ץ", "transliteral": "miq-qēṣ", "traducao_palavra": "ao fim de" },
        { "hebraico": "אַרְבָּעִ֤ים", "transliteral": "ʾar-bā-ʿîm", "traducao_palavra": "quarenta" },
        { "hebraico": "שָׁנָה֙", "transliteral": "šā-nā", "traducao_palavra": "anos" },
        { "hebraico": "אֲקַבֵּ֣ץ", "transliteral": "ʾă-qab-bēṣ", "traducao_palavra": "ajuntarei" },
        { "hebraico": "אֶת־מִצְרַ֔יִם", "transliteral": "ʾeṯ-miṣ-ra-yim", "traducao_palavra": "os egípcios" },
        { "hebraico": "מִן־הָעַמִּ֖ים", "transliteral": "min-hā-ʿam-mîm", "traducao_palavra": "dentre os povos" },
        { "hebraico": "אֲשֶׁר־נָפֹ֥צוּ", "transliteral": "ʾă-šer-nā-p̄ō-ṣû", "traducao_palavra": "entre os quais foram espalhados" },
        { "hebraico": "שָֽׁמָּה׃", "transliteral": "šām-mā", "traducao_palavra": "para lá" }
      ]
    },
    "14": {
      "traducao_completa": "E restaurarei o cativeiro do Egito, e os farei voltar à terra de Patros, à terra do seu nascimento; e serão ali um reino humilde.",
      "palavras": [
        { "hebraico": "וְשַׁבְתִּי֙", "transliteral": "wə-šaḇ-tî", "traducao_palavra": "e restaurarei" },
        { "hebraico": "אֶת־שְׁב֣וּת", "transliteral": "ʾeṯ-šə-ḇûṯ", "traducao_palavra": "o cativeiro de" },
        { "hebraico": "מִצְרַ֔יִם", "transliteral": "miṣ-ra-yim", "traducao_palavra": "Egito" },
        { "hebraico": "וַהֲשִׁבֹתִ֤י", "transliteral": "wa-hă-ši-ḇō-ṯî", "traducao_palavra": "e os farei voltar" },
        { "hebraico": "אֹתָם֙", "transliteral": "ʾō-ṯām", "traducao_palavra": "a eles" },
        { "hebraico": "אֶ֣רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "à terra de" },
        { "hebraico": "פַּתְרֹ֔וס", "transliteral": "paṯ-rôs", "traducao_palavra": "Patros" },
        { "hebraico": "עַל־אֶ֖רֶץ", "transliteral": "ʿal-ʾe-reṣ", "traducao_palavra": "à terra de" },
        { "hebraico": "מְכוּרָתָ֑ם", "transliteral": "mə-ḵû-rā-ṯām", "traducao_palavra": "seu nascimento" },
        { "hebraico": "וְהָ֥יוּ", "transliteral": "wə-hā-yû", "traducao_palavra": "e serão" },
        { "hebraico": "שָׁ֖ם", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "מַמְלָכָ֥ה", "transliteral": "mam-lā-ḵā", "traducao_palavra": "reino" },
        { "hebraico": "שְׁפָלָֽה׃", "transliteral": "šə-p̄ā-lā", "traducao_palavra": "humilde" }
      ]
    },
    "15": {
      "traducao_completa": "Mais humilde do que os outros reinos será, e nunca mais se exaltará sobre as nações; porque os diminuirei, para que não dominem sobre as nações.",
      "palavras": [
        { "hebraico": "מִן־הַמַּמְלָכֹות֙", "transliteral": "min-ham-mam-lā-ḵôṯ", "traducao_palavra": "mais do que os [outros] reinos" },
        { "hebraico": "תִּהְיֶ֣ה", "transliteral": "tih-yeh", "traducao_palavra": "será" },
        { "hebraico": "שְׁפָלָ֔ה", "transliteral": "šə-p̄ā-lā", "traducao_palavra": "humilde" },
        { "hebraico": "וְלֹא־תִתְנַשֵּׂ֥א", "transliteral": "wə-lō-ṯiṯ-naś-śē", "traducao_palavra": "e não se exaltará" },
        { "hebraico": "עֹ֖וד", "transliteral": "ʿôḏ", "traducao_palavra": "mais" },
        { "hebraico": "עַל־הַגֹּויִ֑ם", "transliteral": "ʿal-hag-gô-yim", "traducao_palavra": "sobre as nações" },
        { "hebraico": "וְהִמְעַטְתִּ֕ים", "transliteral": "wə-him-ʿaṭ-tîm", "traducao_palavra": "e os diminuirei" },
        { "hebraico": "לְבִלְתִּ֖י", "transliteral": "lə-ḇil-tî", "traducao_palavra": "para não" },
        { "hebraico": "רְדֹ֥ות", "transliteral": "rə-ḏôṯ", "traducao_palavra": "dominarem" },
        { "hebraico": "בַּגֹּויִֽם׃", "transliteral": "baḡ-gô-yim", "traducao_palavra": "entre as nações" }
      ]
    },
    "16": {
