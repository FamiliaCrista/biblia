        { "hebraico": "גָּבְהָה", "transliteral": "ḡā-ḇə-hā", "traducao_palavra": "elevou-se" },
        { "hebraico": "קֹומָתֹו", "traducao_palavra": "sua estatura", "transliteral_alt": "qô-mā-ṯô" },
        { "hebraico": "אֶל", "transliteral": "ʾel", "traducao_palavra": "sobre" },
        { "hebraico": "כָּל־עֲצֵי", "transliteral": "kāl-ʿă-ṣê", "traducao_palavra": "todas as árvores de" },
        { "hebraico": "הַשָּׂדֶה", "transliteral": "haś-śā-ḏeh", "traducao_palavra": "o campo" },
        { "hebraico": "וַתֶּרֶבְיֶן", "transliteral": "wat-te-reḇ-yen", "traducao_palavra": "e multiplicaram-se" },
        { "hebraico": "סַרְעַפֹּתָיו", "transliteral": "śar-ʿap-pō-ṯāyw", "traducao_palavra": "os seus ramos" },
        { "hebraico": "וַתּَאֲרַכְנָה", "transliteral": "wat-tā-ʾă-raḵ-nā", "traducao_palavra": "e se alongaram" },
