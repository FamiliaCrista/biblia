        { "hebraico": "לֵאמֹר", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" }
      ]
    },
    "2": {
      "traducao_completa": "Filho do homem, dize a Faraó, rei do Egito, e à sua multidão: A quem és semelhante na tua grandeza?",
      "palavras": [
        { "hebraico": "בֶּן־אָדָם", "transliteral": "ben-ʾā-ḏām", "traducao_palavra": "filho do homem" },
        { "hebraico": "אֱמֹר", "transliteral": "ʾĕ-môr", "traducao_palavra": "dize" },
        { "hebraico": "אֶל־פַּרְעֹה", "transliteral": "ʾel-par-ʿōh", "traducao_palavra": "a Faraó" },
        { "hebraico": "מֶלֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "rei de" },
        { "hebraico": "מִצְרַיִם", "transliteral": "miṣ-rā-yim", "traducao_palavra": "Egito" },
        { "hebraico": "וְאֶל־הֲמֹונֹו", "transliteral": "wə-ʾel-hă-mô-nô", "traducao_palavra": "e à sua multidão" },
        { "hebraico": "אֶל־מִי", "transliteral": "ʾel-mî", "traducao_palavra": "a quem" },
