        { "hebraico": "מִרֹּב", "transliteral": "mir-rōḇ", "traducao_palavra": "por causa das muitas" },
        { "hebraico": "מַיִם", "transliteral": "ma-yim", "traducao_palavra": "águas" },
        { "hebraico": "בְּשַׁלְּחֹו", "transliteral": "bə-šal-lə-ḥô", "traducao_palavra": "ao enviá-las" }
