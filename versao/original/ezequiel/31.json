        { "hebraico": "בְּגָדְלֶךָ", "transliteral": "bə-ḡāḏ-le-ḵā", "traducao_palavra": "na tua grandeza" }
      ]
    },
    "3": {
      "traducao_completa": "Eis que a Assíria era um cedro no Líbano, com ramosformosos, e com sombra forestal, e de alta estatura, e o seu topo estava entre os ramos espessos.",
      "palavras": [
