        { "hebraico": "אֲשֶׁר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "בְּגַן", "transliteral": "bə-gan", "traducao_palavra": "no jardim de" },
        { "hebraico": "הָאֱלֹהִים", "transliteral": "hā-ʾĕ-lō-hîm", "traducao_palavra": "Deus" }
      ]
    },
    "10": {
      "traducao_completa": "Portanto, assim diz o Senhor YHWH: Visto que te elevaste na tua estatura, e ele deu o seu topo entre os ramos espessos, e o seu coração se elevou na sua altura,",
      "palavras": [
        { "hebraico": "לָכֵן", "transliteral": "lā-ḵên", "traducao_palavra": "portanto" },
        { "hebraico": "כֹּה", "transliteral": "kō", "traducao_palavra": "assim" },
        { "hebraico": "אָמַר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "אֲדֹנָי", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "יַעַן", "transliteral": "ya-ʿan", "traducao_palavra": "visto que" },
        { "hebraico": "אֲשֶׁר", "transliteral": "ʾă-šer", "traducao_palavra": "tu" },
        { "hebraico": "גָּבַהְתָּ", "transliteral": "ḡā-ḇah-tā", "traducao_palavra": "te elevaste" },
        { "hebraico": "בְּקֹוֱמָה", "transliteral": "bə-qô-mā", "traducao_palavra": "na estatura" },
        { "hebraico": "وַיִּתֵּן", "transliteral": "way-yit-tên", "traducao_palavra": "e ele deu" },
        { "hebraico": "צַמַּרְתֹּו", "transliteral": "ṣam-mar-tô", "traducao_palavra": "o seu topo" },
        { "hebraico": "בֵּין", "transliteral": "bên", "traducao_palavra": "entre" },
        { "hebraico": "עֲבֹתִים", "transliteral": "ʿă-ḇō-ṯîm", "traducao_palavra": "os ramos espessos" },
        { "hebraico": "وְרָם", "transliteral": "wə-rām", "traducao_palavra": "e elevou-se" },
        { "hebraico": "לְבָבֹו", "transliteral": "lə-ḇā-ḇô", "traducao_palavra": "seu coração" },
        { "hebraico": "בְּגֹבְהֹו", "transliteral": "bə-ḡō-ḇə-hô", "traducao_palavra": "na sua altura" }
