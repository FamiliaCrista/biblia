        { "hebraico": "רֹמְמָתְהוּ", "transliteral": "rō-mə-māṯ-hû", "traducao_palavra": "o exalçou" },
        { "hebraico": "אֶת־נְהָרֹתֶיהָ", "transliteral": "ʾeṯ-nə-hā-rō-ṯe-hā", "traducao_palavra": "as correntes dela" },
        { "hebraico": "הֹלֵךְ", "transliteral": "hō-lêḵ", "traducao_palavra": "corriam" },
        { "hebraico": "סְבִיב", "transliteral": "sə-vîḇ", "traducao_palavra": "em redor" },
        { "hebraico": "מִטָּעֹתָהּ", "transliteral": "mit-ṭā-ʿō-ṯāh", "traducao_palavra": "da plantação dela" },
        { "hebraico": "וְאֶת־תְּעָלֹתֶיהָ", "transliteral": "wə-ʾeṯ-tə-ʿā-lō-ṯe-hā", "traducao_palavra": "e os seus regatos" },
        { "hebraico": "שִׁלְּחָה", "transliteral": "šil-lə-ḥā", "traducao_palavra": "enviava" },
        { "hebraico": "אֶל", "transliteral": "ʾel", "traducao_palavra": "a" },
