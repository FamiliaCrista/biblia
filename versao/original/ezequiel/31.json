        { "hebraico": "אַשּׁוּר", "transliteral": "ʾaš-šûr", "traducao_palavra": "a Assíria" },
        { "hebraico": "אֶרֶז", "transliteral": "ʾe-rez", "traducao_palavra": "[era] um cedro" },
