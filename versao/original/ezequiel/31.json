    "6": {
      "traducao_completa": "Todas as aves do céu se aninhavam nos seus ramos, e todos os animais do campo geravam debaixo dos seus ramos, e todos os grandes povos se assentavam à sua sombra.",
      "palavras": [
        { "hebraico": "בִּסְעַפֹּתָיו", "transliteral": "bis-ʿap-pō-ṯāyw", "traducao_palavra": "nos ramos dele" },
