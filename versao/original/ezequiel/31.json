      ]
    },
    "9": {
      "traducao_completa": "Formoso o fiz com a multidão dos seus ramos; e todas as árvores do Éden, que estavam no jardim de Deus, tiveram inveja dele.",
      "palavras": [
        { "hebraico": "יָפֶה", "transliteral": "yā-p̄eh", "traducao_palavra": "formoso" },
        { "hebraico": "עָשִׂיתִהוּ", "transliteral": "ʿā-śî-ṯi-hû", "traducao_palavra": "o fiz" },
        { "hebraico": "בְּרֹב", "transliteral": "bə-rōḇ", "traducao_palavra": "com a multidão de" },
        { "hebraico": "דָּלִיֹּותָיו", "transliteral": "dā-lî-yō-ṯāyw", "traducao_palavra": "seus ramos" },
        { "hebraico": "وַיְקַנְאֻהוּ", "transliteral": "way-yə-qan-ʾu-hû", "traducao_palavra": "e tiveram inveja dele" },
        { "hebraico": "כָּל־עֲצֵי", "transliteral": "kāl-ʿă-ṣê", "traducao_palavra": "todas as árvores de" },
