    "7": {
      "traducao_completa": "Assim, era ele formoso na sua grandeza, na extensão dos seus ramos, porque a sua raiz estava junto às muitas águas.",
      "palavras": [
        { "hebraico": "וַיִּיפֶ", "transliteral": "way-yî-p̄e", "traducao_palavra": "e era ele formoso" },
        { "hebraico": "בְּגָדְלֹו", "transliteral": "bə-ḡāḏ-lô", "traducao_palavra": "na sua grandeza" },
        { "hebraico": "בְּאֹרֶךְ", "transliteral": "bə-ʾō-reḵ", "traducao_palavra": "na extensão de" },
        { "hebraico": "דָּלִיֹּותָיו", "transliteral": "dā-lî-yō-ṯāyw", "traducao_palavra": "seus ramos" },
        { "hebraico": "כִּי־הָיָה", "transliteral": "kî-hā-yā", "traducao_palavra": "porque estava" },
        { "hebraico": "שָׁרְשֹׁו", "transliteral": "šā-rə-šô", "traducao_palavra": "sua raiz" },
        { "hebraico": "אֶל־מַיִם", "transliteral": "ʾel-ma-yim", "traducao_palavra": "junto a águas" },
        { "hebraico": "רַבִּים", "transliteral": "rab-bîm", "traducao_palavra": "muitas" }
      ]
    },
    "8": {
      "traducao_completa": "Os cedros não o podiam escurecer no jardim de Deus; as faias não igualavam os seus ramos, e os castanheiras não eram como os seus renovos; nenhuma árvore no jardim de Deus se assemelhava a ele na sua formosura.",
      "palavras": [
        { "hebraico": "אֲרָזִים", "transliteral": "ʾă-rā-zîm", "traducao_palavra": "os cedros" },
        { "hebraico": "לֹא־עֲמָמֻהוּ", "transliteral": "lō-ʿă-mā-mu-hû", "traducao_palavra": "não o podiam escurecer" },
        { "hebraico": "בְּגַן־אֱלֹהִים", "transliteral": "bə-ḡan-ʾĕ-lō-hîm", "traducao_palavra": "no jardim de Deus" },
        { "hebraico": "בְּרֹושִׁים", "transliteral": "bə-rô-šîm", "traducao_palavra": "as faias/ciprestes" },
        { "hebraico": "לֹא", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "דָּמוּ", "transliteral": "dā-mû", "traducao_palavra": "igualavam" },
        { "hebraico": "אֶל־סְעַפֹּתָיו", "transliteral": "ʾel-śə-ʿap-pō-ṯāyw", "traducao_palavra": "os seus ramos" },
        { "hebraico": "וַעֲרֹמִים", "transliteral": "wa-ʿă-rō-mîm", "traducao_palavra": "e os castanheiras" },
        { "hebraico": "לֹא", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "הָיu", "transliteral": "hā-yû", "traducao_palavra": "eram" },
        { "hebraico": "כְּפֹאֲרֹתָיו", "transliteral": "kə-p̄ō-ʾă-rō-ṯāyw", "traducao_palavra": "como os seus renovos" },
        { "hebraico": "כָּל־עֵץ", "transliteral": "kāl-ʿēṣ", "traducao_palavra": "nenhuma árvore" },
