        { "hebraico": "יְפֵה", "transliteral": "yə-p̄ēh", "traducao_palavra": "de formosos" },
        { "hebraico": "עָנָף", "transliteral": "ʿā-nāp̄", "traducao_palavra": "ramos" },
        { "hebraico": "וְחֹרֶשׁ", "transliteral": "wə-ḥō-reš", "traducao_palavra": "e sombra de bosque" },
        { "hebraico": "מֵצַל", "transliteral": "mê-ṣal", "traducao_palavra": "projetando sombra" },
        { "hebraico": "וּגְבַהּ", "transliteral": "ū-ḡə-ḇah", "traducao_palavra": "e de alta" },
        { "hebraico": "קֹומָה", "transliteral": "qô-mā", "traducao_palavra": "estatura" },
