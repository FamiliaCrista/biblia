        { "hebraico": "כָּל־עֹוף", "transliteral": "kāl-ʿôp̄", "traducao_palavra": "todas as aves de" },
        { "hebraico": "הַשָּׁמַיִם", "transliteral": "haš-šā-ma-yim", "traducao_palavra": "o céu" },
        { "hebraico": "وَتַחַת", "transliteral": "wə-ta-ḥaṯ", "traducao_palavra": "e debaixo de" },
        { "hebraico": "פֹּארֹתָיו", "transliteral": "pō-ʾə-rō-ṯāyw", "traducao_palavra": "seus ramos/folhagens" },
        { "hebraico": "יָלְדוּ", "transliteral": "yā-lə-ḏû", "traducao_palavra": "geravam/tinham crias" },
        { "hebraico": "כֹּל", "transliteral": "kōl", "traducao_palavra": "todos" },
        { "hebraico": "חַיַּת", "transliteral": "ḥay-yaṯ", "traducao_palavra": "os animais de" },
        { "hebraico": "הַשָּׂדֶה", "transliteral": "haś-śā-ḏeh", "traducao_palavra": "o campo" },
        { "hebraico": "וּבְצִלֹּו", "transliteral": "ū-ḇə-ṣil-lô", "traducao_palavra": "e à sombra dele" },
