{
  "livro": "Ezequiel - יְחֶזְקֵאל - Yechezqel",
  "capítulo": 32,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "E sucedeu no ano doze, no décimo segundo mês, no primeiro dia do mês, que veio a mim a palavra de YHWH, dizendo:",
      "palavras": [
        { "hebraico": "وַיְהִי", "transliteral": "way-hî", "traducao_palavra": "e aconteceu" },
        { "hebraico": "בִּשְׁתֵּ֣י", "transliteral": "biš-tê", "traducao_palavra": "no ano dois [doze]" },
        { "hebraico": "עֶשְׂרֵ֣ה", "transliteral": "ʿeś-rēh", "traducao_palavra": "dez" },
        { "hebraico": "שָׁנָ֔ה", "transliteral": "šā-nā", "traducao_palavra": "ano" },
        { "hebraico": "בִּשְׁנֵי־", "transliteral": "biš-nê-", "traducao_palavra": "no segundo" },
        { "hebraico": "עָשָׂ֥ר", "transliteral": "ʿā-śār", "traducao_palavra": "dez" },
        { "hebraico": "חֹ֖דֶשׁ", "transliteral": "ḥō-ḏeš", "traducao_palavra": "mês" },
        { "hebraico": "בְּאֶחָ֣ד", "transliteral": "bə-ʾe-ḥāḏ", "traducao_palavra": "no primeiro [dia]" },
        { "hebraico": "לַחֹ֑דֶשׁ", "transliteral": "la-ḥō-ḏeš", "traducao_palavra": "do mês" },
        { "hebraico": "הָיָ֥ה", "transliteral": "hā-yā", "traducao_palavra": "veio" },
        { "hebraico": "דְבַר־יְהוָ֖ה", "transliteral": "də-ḇar-YHWH", "traducao_palavra": "a palavra de YHWH" },
        { "hebraico": "אֵלַ֥י", "transliteral": "ʾē-lay", "traducao_palavra": "a mim" },
        { "hebraico": "לֵאמֹֽר׃", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" }
      ]
    },
    "2": {
      "traducao_completa": "Filho do homem, levanta uma lamentação sobre Faraó, rei do Egito, e dize-lhe: Tu foste comparado a um leão novo entre as nações, mas és como um monstro nos mares; e irrompeste nos teus rios, e turvaste as águas com os teus pés, e pisaste os seus rios.",
      "palavras": [
        { "hebraico": "בֶּן־אָדָ֗ם", "transliteral": "ben-ʾā-ḏām", "traducao_palavra": "filho do homem" },
        { "hebraico": "שָׂ֤א", "transliteral": "śāʾ", "traducao_palavra": "levanta" },
        { "hebraico": "קִינָה֙", "transliteral": "qî-nā", "traducao_palavra": "uma lamentação" },
        { "hebraico": "עַל־פַּרְעֹ֣ה", "transliteral": "ʿal-par-ʿōh", "traducao_palavra": "sobre Faraó" },
        { "hebraico": "מֶֽלֶךְ־מִצְרַ֔יִם", "transliteral": "me-leḵ-miṣ-rā-yim", "traducao_palavra": "rei do Egito" },
        { "hebraico": "וְאָמַרְתָּ֣", "transliteral": "wə-ʾā-mar-tā", "traducao_palavra": "e dize" },
        { "hebraico": "אֵלָ֔יו", "transliteral": "ʾê-lāw", "traducao_palavra": "a ele" },
        { "hebraico": "כְּפִ֥יר", "transliteral": "kə-p̄îr", "traducao_palavra": "um leão" },
        { "hebraico": "גֹּויִ֖ם", "transliteral": "gô-yim", "traducao_palavra": "das nações" },
        { "hebraico": "נִדְמֵ֑יתָ", "transliteral": "niḏ-mê-ṯā", "traducao_palavra": "foste comparado/assemelhado" },
        { "hebraico": "וְאַתָּ֤ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "e tu" },
        { "hebraico": "כַתַּנִּים֙", "transliteral": "ḵat-tan-nîm", "traducao_palavra": "como o monstro/crocodilo" },
        { "hebraico": "בַּיַּמִּ֔ים", "transliteral": "bay-yam-mîm", "traducao_palavra": "nos mares" },
        { "hebraico": "וְתָ֣גַח", "transliteral": "wə-tā-ḡaḥ", "traducao_palavra": "e irrompiste/emergiste" },
        { "hebraico": "בְּנַהֲרֹותֶ֗יךָ", "transliteral": "bə-nă-hă-rô-ṯe-yḵā", "traducao_palavra": "nos teus rios" },
        { "hebraico": "וְתִדְלַח־מַ֨יִם֙", "transliteral": "wə-ṯiḏ-laḥ-ma-yim", "traducao_palavra": "e turvaste as águas" },
        { "hebraico": "בְּרַגְלֶ֔יךָ", "transliteral": "bə-raḡ-le-ḵā", "traducao_palavra": "com os teus pés" },
        { "hebraico": "וְתַרְפֹּ֖ס", "transliteral": "wə-ṯar-pōs", "traducao_palavra": "e pisaste/enlameaste" },
        { "hebraico": "נַהֲרֹותָֽם׃", "transliteral": "nă-hă-rô-ṯām", "traducao_palavra": "os rios deles" }
      ]
    },
    "3": {
      "traducao_completa": "Assim diz o Senhor YHWH: Estenderei sobre ti a minha rede com a congregação de muitos povos, e eles te tirarão na minha rede.",
      "palavras": [
        { "hebraico": "כֹּ֤ה", "transliteral": "kō", "traducao_palavra": "assim" },
        { "hebraico": "אָמַר֙", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "אֲדֹנָ֣י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וּפָרַשְׂתִּ֤י", "transliteral": "ū-p̄ā-raś-tî", "traducao_palavra": "e estenderei" },
        { "hebraico": "עָלֶ֙יךָ֙", "transliteral": "ʿā-le-ḵā", "traducao_palavra": "sobre ti" },
        { "hebraico": "אֶת־רִשְׁתִּ֔י", "transliteral": "ʾeṯ-riš-tî", "traducao_palavra": "a minha rede" },
        { "hebraico": "בִּקְהַ֖ל", "transliteral": "biq-hal", "traducao_palavra": "com a congregação de" },
        { "hebraico": "עַמִּ֣ים", "transliteral": "ʿam-mîm", "traducao_palavra": "muitos povos" },
        { "hebraico": "רַבִּ֑ים", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
        { "hebraico": "וְהֶעֱלוּךָ֥", "transliteral": "wə-he-ʿĕ-lû-ḵā", "traducao_palavra": "e eles te tirarão" },
        { "hebraico": "בִּמְרִשְׁתִּֽי׃", "transliteral": "bim-riš-tî", "traducao_palavra": "na minha rede" }
      ]
    },
    "4": {
      "traducao_completa": "E te deixarei em terra, lançar-te-ei sobre a face do campo, e farei habitar sobre ti todas as aves do céu, e com tigo fartarei os animais de toda a terra.",
      "palavras": [
        { "hebraico": "וּנְטַשְׁתִּ֨יךָ", "transliteral": "ū-nə-ṭaš-tî-ḵā", "traducao_palavra": "e te deixarei" },
        { "hebraico": "בָאָ֜רֶץ", "transliteral": "ḇā-ʾā-reṣ", "traducao_palavra": "na terra" },
        { "hebraico": "אֶל־פְּנֵ֤י", "transliteral": "ʾel-pə-nê", "traducao_palavra": "sobre a face de" },
        { "hebraico": "הַשָּׂדֶה", "transliteral": "haś-śā-ḏeh", "traducao_palavra": "o campo" },
        { "hebraico": "אֲטִילֶ֑ךָ", "transliteral": "ʾă-ṭî-le-ḵā", "traducao_palavra": "lançar-te-ei" },
        { "hebraico": "וְהִשְׁכַּנְתִּ֤י", "transliteral": "wə-hiš-kan-tî", "traducao_palavra": "e farei habitar" },
        { "hebraico": "עָלֶ֙יךָ֙", "transliteral": "ʿā-le-ḵā", "traducao_palavra": "sobre ti" },
        { "hebraico": "כָּל־עֹ֣וף", "transliteral": "kāl-ʿôp̄", "traducao_palavra": "todas as aves de" },
        { "hebraico": "הַשָּׁמַ֔יִם", "transliteral": "haš-šā-ma-yim", "traducao_palavra": "o céu" },
        { "hebraico": "וְהִשְׂבַּעְתִּ֤י", "transliteral": "wə-hiś-baʿ-tî", "traducao_palavra": "e fartarei" },
        { "hebraico": "מִמְּךָ֙", "transliteral": "mim-mə-ḵā", "traducao_palavra": "de ti" },
        { "hebraico": "חַיַּ֖ות", "transliteral": "ḥay-yaṯ", "traducao_palavra": "as feras de" },
        { "hebraico": "כָּל־הָאָֽרֶץ׃", "transliteral": "kāl-hā-ʾā-reṣ", "traducao_palavra": "toda a terra" }
      ]
    },
    "5": {
      "traducao_completa": "E porei a tua carne sobre os montes, e encherei os vales com a tua altura.",
      "palavras": [
        { "hebraico": "וְנָתַתִּ֤י", "transliteral": "wə-nā-ṯat-tî", "traducao_palavra": "e porei" },
        { "hebraico": "בְּשָֽׂרְךָ֙", "transliteral": "bə-śā-rə-ḵā", "traducao_palavra": "tua carne" },
        { "hebraico": "עַל־הֶהָרִ֔ים", "transliteral": "ʿal-he-hā-rîm", "traducao_palavra": "sobre os montes" },
        { "hebraico": "וּמִלֵּאתִ֖י", "transliteral": "ū-mil-lê-tî", "traducao_palavra": "e encherei" },
        { "hebraico": "הַגְּאֹיֹ֖ות", "transliteral": "hag-gə-ʾō-yôṯ", "traducao_palavra": "os vales / as alturas" },
        { "hebraico": "מִרְמָתֶֽךָ׃", "transliteral": "mir-mā-ṯe-ḵā", "traducao_palavra": "com a tua altura/cadáver" }
      ]
    },
    "6": {
      "traducao_completa": "E regarei a terra com o teu sangue, até aos montes; e os ribeirinhos se encherão de ti.",
      "palavras": [
        { "hebraico": "וְהִשְׁקִיתִ֤י", "transliteral": "wə-hiš-qî-ṯî", "traducao_palavra": "e regarei" },
        { "hebraico": "מִֽצָּפְתְךָ֙", "transliteral": "miṣ-ṣā-p̄ə-ṯə-ḵā", "traducao_palavra": "com o teu sangue / inundação" },
        { "hebraico": "אֶל־הָאָ֔רֶץ", "transliteral": "ʾel-hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "מִמְחָֽךְ", "transliteral": "mim-ḥāḵ", "traducao_palavra": "com a tua gordura/sangue" },
        { "hebraico": "אֶל־הָהָרִ֑ים", "transliteral": "ʾel-hā-hā-rîm", "traducao_palavra": "até aos montes" },
        { "hebraico": "וַאֲפָקִ֖ים", "transliteral": "wa-ʾă-p̄ā-qîm", "traducao_palavra": "e os ribeirinhos" },
        { "hebraico": "יִמְלְאu", "transliteral": "yim-lə-ʾû", "traducao_palavra": "se encherão" },
        { "hebraico": "מִמֶּֽךָּ׃", "transliteral": "mim-mek-kā", "traducao_palavra": "de ti" }
      ]
    },
    "7": {
      "traducao_completa": "E, quando eu te apagar, cobrirei os céus, e enegrecereis as suas estrelas; a lua cobrirei com nuvens, e o sol não dará a sua luz.",
      "palavras": [
        { "hebraico": "וְכִסִּיתִי", "transliteral": "wə-ḵis-sî-ṯî", "traducao_palavra": "e cobrirei" },
        { "hebraico": "בְכֹבְתְךָ", "transliteral": "bə-ḵō-ḇə-ṯə-ḵā", "traducao_palavra": "ao te apagar" },
        { "hebraico": "שָׁמַיִם", "transliteral": "šā-ma-yim", "traducao_palavra": "os céus" },
        { "hebraico": "وְהִקְדַּרְתִּי", "transliteral": "wə-hiq-dar-tî", "traducao_palavra": "e enegrecereis" },
        { "hebraico": "אֶת־כֹּוכְבֵיהֶם", "transliteral": "ʾeṯ-kōḵ-ḇê-hem", "traducao_palavra": "as estrelas deles" },
        { "hebraico": "שֶׁמֶשׁ", "transliteral": "še-meš", "traducao_palavra": "o sol" },
        { "hebraico": "בֶּעָנָן", "transliteral": "be-ʿā-nān", "traducao_palavra": "com nuvem" },
        { "hebraico": "אֲכַסֶּנּוּ", "transliteral": "ʾă-ḵas-sen-nû", "traducao_palavra": "o cobrirei" },
        { "hebraico": "وَيָרֵחַ", "transliteral": "wə-yā-rē-aḥ", "traducao_palavra": "e a lua" },
        { "hebraico": "לֹא־יָאִיר", "transliteral": "lō-yā-ʾîr", "traducao_palavra": "não dará luz" },
        { "hebraico": "אֹורֹו", "transliteral": "ʾô-rô", "traducao_palavra": "sua luz" }
      ]
    },
    "8": {
      "traducao_completa": "Todas as luzes brilhantes dos céus encubrireis sobre ti, e porei trevas sobre a tua terra, diz o Senhor YHWH.",
      "palavras": [
        { "hebraico": "כָּל־מְאֹורֵי", "transliteral": "kāl-mə-ʾō-rê", "traducao_palavra": "todas as luzes/luminares de" },
        { "hebraico": "אֹור", "transliteral": "ʾôr", "traducao_palavra": "brilho" },
        { "hebraico": "בַּשָּׁמַיִם", "transliteral": "baš-šā-ma-yim", "traducao_palavra": "os céus" },
        { "hebraico": "אֲקַדְּרֵם", "transliteral": "ʾă-qad-də-rêm", "traducao_palavra": "enevoarei/escurecerei sobre" },
        { "hebraico": "עָלֶיךָ", "transliteral": "ʿā-le-ḵā", "traducao_palavra": "ti" },
        { "hebraico": "וְנָתַתִּי", "transliteral": "wə-nā-ṯat-tî", "traducao_palavra": "e porei" },
        { "hebraico": "חֹשֶׁךְ", "transliteral": "ḥō-šeḵ", "traducao_palavra": "trevas" },
        { "hebraico": "עַל־אַרְצֶךָ", "transliteral": "ʿal-ʾar-ṣe-ḵā", "traducao_palavra": "sobre a tua terra" },
        { "hebraico": "נְאֻם", "transliteral": "nə-ʾum", "traducao_palavra": "diz" },
        { "hebraico": "אֲדֹנָי", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִה", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "9": {
      "traducao_completa": "E entristecerei o coração de muitos povos, quando eu levar a tua destruição entre as nações, às terras que não conheceste.",
      "palavras": [
        { "hebraico": "וְהִכְעַסְתִּי", "transliteral": "wə-hik-ʿas-tî", "traducao_palavra": "e entristecerei/irritarei" },
        { "hebraico": "לֵב", "transliteral": "lēḇ", "traducao_palavra": "o coração de" },
        { "hebraico": "עַמִּים", "transliteral": "ʿam-mîm", "traducao_palavra": "muitos povos" },
        { "hebraico": "רַבִּים", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
        { "hebraico": "בּْהָבִיאִי", "transliteral": "bə-hā-ḇî-ʾî", "traducao_palavra": "ao levar" },
        { "hebraico": "שִׁבְרְךָ", "transliteral": "šiḇ-rə-ḵā", "traducao_palavra": "tua destruição/quebra" },
        { "hebraico": "بַּגֹּויִם", "transliteral": "baḡ-gô-yim", "traducao_palavra": "entre as nações" },
        { "hebraico": "אֶל־אֲרָצֹות", "transliteral": "ʾel-ʾă-rā-ṣôṯ", "traducao_palavra": "às terras que" },
        { "hebraico": "לֹא", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יְדַעְתָּם", "transliteral": "yə-ḏaʿ-tām", "traducao_palavra": "conheceste" }
      ]
    },
    "10": {
      "traducao_completa": "E farei com que muitos povos passem a ter pavor de ti, e os seus reis enfurecerão sobremaneira contra ti, quando eu brandir a minha espada diante deles; e tremerão a cada momento, cada um pela sua vida, no dia da tua queda.",
      "palavras": [
        { "hebraico": "וַהֲשִׁמֹּתִי", "transliteral": "wa-hă-šim-mō-wə-ṯî", "traducao_palavra": "e farei pasmar/espantar" },
        { "hebraico": "עָלֶיךָ", "transliteral": "ʿā-le-ḵā", "traducao_palavra": "de ti" },
        { "hebraico": "עַמִּים", "transliteral": "ʿam-mîm", "traducao_palavra": "povos" },
        { "hebraico": "רַבִּים", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
        { "hebraico": "وَمِلְכֵיהֶם", "transliteral": "ū-mal-ḵê-hem", "traducao_palavra": "e os reis deles" },
        { "hebraico": "יִשְׂעֲרוּ", "transliteral": "yiś-ʿă-rû", "traducao_palavra": "enfurecerão/sobressaltarão" },
        { "hebraico": "עָלֶיךָ", "transliteral": "ʿā-le-ḵā", "traducao_palavra": "contra ti" },
        { "hebraico": "בּْعֹופָף", "transliteral": "bə-ʿō-p̄āp̄", "traducao_palavra": "ao brandir" },
        { "hebraico": "חַרְבִּי", "transliteral": "ḥar-bî", "traducao_palavra": "minha espada" },
        { "hebraico": "עַל", "transliteral": "ʿal", "traducao_palavra": "perante" },
        { "hebraico": "פְנֵיהֶם", "transliteral": "pə-nê-hem", "traducao_palavra": "eles" },
        { "hebraico": "וְחָרְדוּ", "transliteral": "wə-ḥā-rə-ḏû", "traducao_palavra": "e tremerão" },
        { "hebraico": "לִרְגַע", "transliteral": "lir-ḡaʿ", "traducao_palavra": "a cada momento" },
        { "hebraico": "אִישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada um" },
        { "hebraico": "לְנַפְשֹׁו", "transliteral": "lə-nap̄-šô", "traducao_palavra": "pela sua vida" },
        { "hebraico": "בְּיֹום", "transliteral": "bə-yôm", "traducao_palavra": "no dia da" },
        { "hebraico": "מַפָּלְתֶךָ", "transliteral": "map-pā-lə-ṯe-ḵā", "traducao_palavra": "tua queda" }
      ]
    },
    "11": {
      "traducao_completa": "Porque assim diz o Senhor YHWH: A espada do rei da Babilônia virá contra ti.",
      "palavras": [
        { "hebraico": "כִּי", "transliteral": "kî", "traducao_palavra": "porque" },
