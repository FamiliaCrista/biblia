        { "hebraico": "עֵינֵיהֶם", "transliteral": "ʿê-nê-hem", "traducao_palavra": "seus olhos" },
        { "hebraico": "וְאֶת־מִשָּׂא", "transliteral": "wə-ʾeṯ-miś-śā", "traducao_palavra": "e a ânsia/ternura de" },
        { "hebraico": "נַפְשָׁם", "transliteral": "nap̄-šām", "traducao_palavra": "sua alma" },
