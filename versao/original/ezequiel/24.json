    },
    "9": {
      "traducao_completa": "Portanto, assim diz o Senhor YHWH: Ai da cidade sanguinária! Também eu farei uma grande fogueira.",
      "palavras": [
        { "hebraico": "לָכֵ֗ן", "transliteral": "lā-ḵên", "traducao_palavra": "portanto" },
        { "hebraico": "כֹּ֤ה", "transliteral": "kō", "traducao_palavra": "assim" },
        { "hebraico": "אָמַר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "אֲדֹנָ֣י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "גַּם־אֲנִ֖י", "transliteral": "gam-ʾă-nî", "traducao_palavra": "também eu" },
        { "hebraico": "אַגְדִּ֥יל", "transliteral": "ʾag-dîl", "traducao_palavra": "farei grande / fogueira" },
        { "hebraico": "הַמָּדּוּרָֽה׃", "transliteral": "ham-mâ-ḏû-rā", "traducao_palavra": "a fogueira/pire" }
      ]
    },
    "10": {
      "traducao_completa": "Multiplica a lenha, acende o fogo, consome a carne, tempera-a com especiarias, e que os ossos sejam queimados.",
