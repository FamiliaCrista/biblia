    "5": {
      "traducao_completa": "Toma o melhor do rebanho, e faze também uma pilha de ossos debaixo dela; faze-a ferver bem, e coze nela os seus ossos.",
      "palavras": [
        { "hebraico": "מִבְחַ֤ר", "transliteral": "miḇ-ḥar", "traducao_palavra": "o melhor do" },
