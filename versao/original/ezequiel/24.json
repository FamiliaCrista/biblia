        { "hebraico": "חֵמָה֙", "transliteral": "ḥê-mā", "traducao_palavra": "a indignação" },
        { "hebraico": "לִנְקֹם", "transliteral": "lin-qōm", "traducao_palavra": "para tomar" },
        { "hebraico": "נָקָ֔ם", "transliteral": "nā-qām", "traducao_palavra": "vingança" },
        { "hebraico": "נָתַתִּי֙", "transliteral": "nā-ṯat-tî", "traducao_palavra": "pus" },
