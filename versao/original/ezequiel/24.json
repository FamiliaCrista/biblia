      ]
    },
    "11": {
      "traducao_completa": " Então a porei vazia sobre as suas brasas, para que se aqueça, e se queime o seu bronze, e se funda no meio dela a sua imundícia, e se consuma a sua ferrugem.",
      "palavras": [
        { "hebraico": "וְהַעֲמִידָ֨הּ", "transliteral": "wə-ha-ʿă-mî-ḏāh", "traducao_palavra": "e a porei" },
        { "hebraico": "עַל־גֶּחָלֶ֤יהָ", "transliteral": "ʿal-ge-ḥā-le-hā", "traducao_palavra": "sobre as brasas dela" },
        { "hebraico": "רֵקָה֙", "transliteral": "rê-qā", "traducao_palavra": "vazia" },
        { "hebraico": "לְמַ֣עַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "para que" },
        { "hebraico": "תֵּחֶַם", "transliteral": "tê-ḥam", "traducao_palavra": "se aqueça" },
        { "hebraico": "וְחָֽרְתָה", "transliteral": "wə-ḥā-rə-ṯā", "traducao_palavra": "e se queime" },
        { "hebraico": "נְחֻשְׁתָּהּ", "transliteral": "nə-ḥuš-tāh", "traducao_palavra": "o seu bronze" },
        { "hebraico": "וּנְתַכְתָּה", "transliteral": "ū-nə-ṯaḵ-tāh", "traducao_palavra": "e se funda" },
