      ]
    },
    "4": {
      "traducao_completa": "Ajunta nela os seus pedaços, todos os bons pedaços, a coxa e a espádua; enche-a dos melhores ossos.",
      "palavras": [
        { "hebraico": "אֱסֹף", "transliteral": "ʾĕ-śōp̄", "traducao_palavra": "ajunta" },
        { "hebraico": "נְתָחֶיהָ", "transliteral": "nə-ṯā-ḥe-hā", "traducao_palavra": "os pedaços dela" },
        { "hebraico": "אֵלֶיהָ", "transliteral": "ʾē-le-hā", "traducao_palavra": "nele/nela" },
        { "hebraico": "כָּל־נֵ֣תַח", "transliteral": "kāl-nē-taḥ", "traducao_palavra": "todo pedaço" },
