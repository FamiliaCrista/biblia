{
  "livro": "Ezequiel - יְחֶזְקֵאל - Yechezqel",
  "capítulo": 12,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Veio a mim a palavra de YHWH, dizendo:",
      "palavras": [
        { "hebraico": "וַיְהִ֥י", "transliteral": "way-hî", "traducao_palavra": "e aconteceu/veio" },
        { "hebraico": "דְבַר־יְהוָ֖ה", "transliteral": "də-ḇar-YHWH", "traducao_palavra": "a palavra de YHWH" },
        { "hebraico": "אֵלַ֥י", "transliteral": "ʾē-lay", "traducao_palavra": "a mim" },
        { "hebraico": "לֵאמֹֽר׃", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" }
      ]
    },
    "2": {
      "traducao_completa": "Filho do homem, tu habitas no meio da casa rebelde, que tem olhos para ver e não vê, tem ouvidos para ouvir e não ouve; porque são casa rebelde.",
      "palavras": [
        { "hebraico": "בֶּן־אָדָ֗ם", "transliteral": "ben-ʾā-ḏām", "traducao_palavra": "filho do homem" },
        { "hebraico": "בְּתֹ֨וךְ֙", "transliteral": "bə-ṯôḵ", "traducao_palavra": "no meio de" },
        { "hebraico": "בֵּית־הַמֶּ֔רִי", "transliteral": "bêṯ-ham-me-rî", "traducao_palavra": "casa rebelde" },
        { "hebraico": "אַתָּ֣ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "יֹשֵׁ֔ב", "transliteral": "yô-šēḇ", "traducao_palavra": "habitas" },
        { "hebraico": "אֲשֶׁר", "transliteral": "ʾă-šer", "traducao_palavra": "que [eles]" },
        { "hebraico": "עֵינַיִם", "transliteral": "ʿê-na-yim", "traducao_palavra": "olhos" },
        { "hebraico": "לָהֶם", "transliteral": "lā-hem", "traducao_palavra": "eles têm" },
        { "hebraico": "לִרְאֹות", "transliteral": "lir-ʾôṯ", "traducao_palavra": "para ver" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "רָא֔וּ", "transliteral": "rā-ʾû", "traducao_palavra": "vêem" }
      ]
    },
    "3": {
      "traducao_completa": "Tu, pois, ó filho do homem, prepara-te os teus trastes para o exílio, e de dia emigra à vista deles; e emigrarás do teu lugar para outro lugar à vista deles; bem pode ser que vejam que são casa rebelde.",
      "palavras": [
        { "hebraico": "וְאַתָּ֣ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "e tu" },
        { "hebraico": "בֶן־אָדָ֗ם", "transliteral": "ben-ʾā-ḏām", "traducao_palavra": "filho do homem" },
        { "hebraico": "עֲשֵׂ֤ה", "transliteral": "ʿă-śēh", "traducao_palavra": "faze" },
        { "hebraico": "לְךָ֙", "transliteral": "lə-ḵā", "traducao_palavra": "para ti" },
        { "hebraico": "כְּלֵ֣י", "transliteral": "kə-lê", "traducao_palavra": "utensílios/trastes" },
        { "hebraico": "גֹולָ֔ה", "transliteral": "ḡô-lā", "traducao_palavra": "de exílio" }
      ]
    },
    "4": {
      "traducao_completa": "E de dia, à vista deles, tirarás os teus trastes como trastes de exílio; e tu sairás à tarde à vista deles, como saem os que vão para o cativeiro.",
      "palavras": [
        { "hebraico": "וְהֹוצֵאתָ֤", "transliteral": "wə-hô-ṣê-ṯā", "traducao_palavra": "e tirarás" },
        { "hebraico": "כֵלֶיךָ֙", "transliteral": "ḵē-le-ḵā", "traducao_palavra": "teus trastes" },
        { "hebraico": "בְּיֹוםָ֔ם", "transliteral": "bə-yô-mām", "traducao_palavra": "de dia" },
        { "hebraico": "כִּכְלֵ֣י", "transliteral": "kiḵ-lê", "traducao_palavra": "como trastes de" },
        { "hebraico": "גֹּולָ֑ה", "transliteral": "ḡô-lā", "traducao_palavra": "exílio" }
      ]
    },
    "5": {
      "traducao_completa": "Fura a parede à vista deles, e sai por ela.",
      "palavras": [
        { "hebraico": "בַּקִּ֖יר", "transliteral": "baq-qîr", "traducao_palavra": "pela parede" },
        { "hebraico": "תַּחְתֹּור", "transliteral": "taḥ-tôr", "traducao_palavra": "fura" },
        { "hebraico": "לְעֵינֵיהֶ֑ם", "transliteral": "lə-ʿê-nê-hem", "traducao_palavra": "à vista deles" },
        { "hebraico": "וְהֹוצֵאתָ֥", "transliteral": "wə-hô-ṣê-ṯā", "traducao_palavra": "e sairás" },
        { "hebraico": "בֹּֽו׃", "transliteral": "bô", "traducao_palavra": "por ela" }
      ]
    },
    "6": {
      "traducao_completa": "À vista deles, aos ombros a levarás, e em trevas a tirarás; cobrirás o teu rosto, para que não vejas a terra; porque eu te pus por sinal à casa de Israel.",
      "palavras": [
        { "hebraico": "עַל־כָּתֵף", "transliteral": "ʿal-kā-ṯēp̄", "traducao_palavra": "aos ombros" },
        { "hebraico": "תִּשָּׂאֶ֕נָּה", "transliteral": "tiś-śā-ʾen-nā", "traducao_palavra": "a levarás" },
        { "hebraico": "בָּעֲרָפֶ֖ל", "transliteral": "bā-ʿă-rā-p̄el", "traducao_palavra": "em trevas" },
        { "hebraico": "תֹּוצִ֑יא", "transliteral": "ṯô-ṣî", "traducao_palavra": "a tirarás" }
      ]
    },
    "7": {
      "traducao_completa": "E fiz assim como me foi ordenado; os meus trastes tirei de dia, como trastes de exílio, e à tarde furei a parede com a mão; às escuras a tirei, e aos ombros a levei à vista deles.",
      "palavras": [
        { "hebraico": "וָאַ֣עַשׂ", "transliteral": "wā-ʾa-ʿaś", "traducao_palavra": "e fiz" },
        { "hebraico": "כֵּ֔ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "כַּאֲשֶׁ֥ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "conforme" },
        { "hebraico": "צֻוֵּ֖יתִי", "transliteral": "ṣuw-wê-ṯî", "traducao_palavra": "fui ordenado" }
      ]
    },
    "8": {
      "traducao_completa": "E pela manhã veio a mim a palavra de YHWH, dizendo:",
      "palavras": [
        { "hebraico": "וַיְהִי", "transliteral": "way-hî", "traducao_palavra": "e aconteceu" },
        { "hebraico": "דְבַר־יְהוָה", "transliteral": "də-ḇar-YHWH", "traducao_palavra": "a palavra de YHWH" },
        { "hebraico": "אֵלַי", "transliteral": "ʾē-lay", "traducao_palavra": "a mim" },
        { "hebraico": "בַּבֹּקֶר", "transliteral": "ba-bō-qer", "traducao_palavra": "pela manhã" }
      ]
    },
    "9": {
      "traducao_completa": "Filho do homem, não te perguntou a casa de Israel, aquela casa rebelde: Que fazes tu?",
      "palavras": [
        { "hebraico": "בֶּן־אָדָם", "transliteral": "ben-ʾā-ḏām", "traducao_palavra": "filho do homem" },
        { "hebraico": "הֲלֹ֨וא", "transliteral": "hă-lô", "traducao_palavra": "não?" },
        { "hebraico": "אָמְר֚וּ", "transliteral": "ʾā-mə-rû", "traducao_palavra": "disse/perguntou" },
        { "hebraico": "אֵלֶיךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "בֵּית", "transliteral": "bêṯ", "traducao_palavra": "a casa de" },
        { "hebraico": "הַמֶּרִי", "transliteral": "ham-me-rî", "traducao_palavra": "rebelde" }
      ]
    },
    "10": {
      "traducao_completa": "Dize-lhes: Assim diz o Senhor YHWH: Este peso é o príncipe em Jerusalém, e toda a casa de Israel que está nela.",
      "palavras": [
        { "hebraico": "הַנָּשִׂ֣יא", "transliteral": "han-nā-śî", "traducao_palavra": "o príncipe" },
        { "hebraico": "בִּירֽוּשָׁלִַם", "transliteral": "bî-rû-šā-la-yim", "traducao_palavra": "em Jerusalém" }
      ]
    },
    "11": {
      "traducao_completa": "Dize: Eu sou o vosso sinal; como eu fiz, assim se lhes fará a eles; irão para o cativeiro, para o exílio.",
      "palavras": [
        { "hebraico": "אֱמֹר", "transliteral": "ʾĕ-môr", "traducao_palavra": "dize" },
        { "hebraico": "אֲנִ֤י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
        { "hebraico": "מֹופֶתְכֶם", "transliteral": "mô-p̄eṯ-ḵem", "traducao_palavra": "o vosso sinal" }
      ]
    },
    "12": {
      "traducao_completa": "E o príncipe que está no meio deles levará aos ombros, na escuridão, e sairá; a parede furarão para o fazerem sair por ela; ele cobrirá o seu rosto, para que não veja a terra com os seus olhos.",
      "palavras": [
        { "hebraico": "וְהַנָּשִׂיא", "transliteral": "wə-han-nā-śî", "traducao_palavra": "e o príncipe" },
        { "hebraico": "אֲשֶׁר־בְּתֹוכָם", "transliteral": "ʾă-šer-bə-ṯô-ḵām", "traducao_palavra": "que está no meio deles" }
      ]
    },
    "13": {
      "traducao_completa": "Também estenderei a minha rede sobre ele, e ele será apanhado no meu laço; e levá-lo-ei a Babilônia, à terra dos caldeus, mas ele não a verá, e ali morrerá.",
      "palavras": [
        { "hebraico": "וּפָרַשְׂתִּ֤י", "transliteral": "ū-p̄ā-raś-tî", "traducao_palavra": "e estenderei" },
        { "hebraico": "אֶת־רִשְׁתִּי", "transliteral": "ʾeṯ-riš-tî", "traducao_palavra": "a minha rede" },
        { "hebraico": "עָלָיו", "transliteral": "ʿā-lāw", "traducao_palavra": "sobre ele" }
      ]
    },
    "14": {
      "traducao_completa": "E todos os que estiverem ao redor dele, os seus auxiliares e todas as suas tropas, espalharei a todos os ventos; e desembainharei a espada atrás deles.",
      "palavras": [
        { "hebraico": "וְכָל־אֲשֶׁר", "transliteral": "wə-ḵāl-ʾă-šer", "traducao_palavra": "e todos os que" },
        { "hebraico": "סְבִיבֹתָיו", "transliteral": "śə-ḇî-ṯāw", "traducao_palavra": "ao redor dele" }
      ]
    },
    "15": {
      "traducao_completa": "E saberão que eu sou YHWH, quando eu os dispersar entre as nações, e os espalhar pelas terras.",
      "palavras": [
        { "hebraico": "וְיָדְע֖וּ", "transliteral": "wî-ḏaʿ-tû", "traducao_palavra": "e saberão" },
        { "hebraico": "כִּֽי־אֲנִ֥י", "transliteral": "kî-ʾă-nî", "traducao_palavra": "que eu [sou]" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "16": {
      "traducao_completa": "Mas deixarei deles uns poucos homens, que escapem da espada, da fome e da peste, para que confessem todas as suas abominações entre as nações para onde forem; e saberão que eu sou YHWH.",
      "palavras": [
        { "hebraico": "וְהֹותַרְתִּ֞י", "transliteral": "wə-hô-ṯar-tî", "traducao_palavra": "e deixarei" },
        { "hebraico": "מֵהֶם", "transliteral": "mē-hem", "traducao_palavra": "deles" },
        { "hebraico": "אֲנָשִׁ֥ים", "transliteral": "ʾă-nā-šîm", "traducao_palavra": "homens" },
        { "hebraico": "מְסְפָּר", "transliteral": "mis-pār", "traducao_palavra": "poucos" }
      ]
    },
    "17": {
      "traducao_completa": "Veio ainda a mim a palavra de YHWH, dizendo:",
      "palavras": [
        { "hebraico": "וַיְהִי", "transliteral": "way-hî", "traducao_palavra": "e aconteceu" },
        { "hebraico": "דְּבַר־יְהוָ֥ה", "transliteral": "də-ḇar-YHWH", "traducao_palavra": "a palavra de YHWH" },
        { "hebraico": "אֵלַ֖י", "transliteral": "ʾē-lay", "traducao_palavra": "a mim" },
        { "hebraico": "לֵאמֹֽר׃", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" }
      ]
    },
    "18": {
      "traducao_completa": "Filho do homem, come o teu pão com tremor, e bebe a tua água com tremor e com ansiedade,",
      "palavras": [
        { "hebraico": "בֶּן־אָדָ֗ם", "transliteral": "ben-ʾā-ḏām", "traducao_palavra": "filho do homem" },
        { "hebraico": "לַחְמְךָ֤", "transliteral": "laḥ-mə-ḵā", "traducao_palavra": "teu pão" },
        { "hebraico": "בִּרְעָדָה", "transliteral": "bir-ʿā-ḏā", "traducao_palavra": "com tremor" }
      ]
    },
    "19": {
      "traducao_completa": "E dize ao povo da terra: Assim diz o Senhor YHWH aos moradores de Jerusalém, acerca da terra de Israel: Comerão o seu pão com ansiedade, e beberão a sua água com espanto, porque a sua terra será despojada de toda a sua plenitude, por causa da violência de todos os que nela habitam.",
      "palavras": [
        { "hebraico": "וְאָמַרְתָּ֞", "transliteral": "wə-ʾā-mar-tā", "traducao_palavra": "e dirás" },
        { "hebraico": "אֶל־עַם", "transliteral": "ʾel-ʿam", "traducao_palavra": "ao povo" },
        { "hebraico": "הָאָ֗רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "da terra" }
      ]
    },
    "20": {
      "traducao_completa": "E as cidades povoadas serão devastadas, e a terra se tornará em desolação; e sabereis que eu sou YHWH.",
      "palavras": [
        { "hebraico": "וְהֶעָרִים", "transliteral": "wə-he-ʿā-rîm", "traducao_palavra": "e as cidades" },
        { "hebraico": "הַנֹּשָׁבֹות", "transliteral": "han-nō-šā-ḇôṯ", "traducao_palavra": "povoadas" },
        { "hebraico": "חָרֵ֣ב", "transliteral": "ḥā-rēḇ", "traducao_palavra": "serão devastadas" },
        { "hebraico": "תִּהְיֶ֑ינָה", "transliteral": "tih-ye-nā", "traducao_palavra": "serão" }
      ]
    },
    "21": {
      "traducao_completa": "Veio a mim a palavra de YHWH, dizendo:",
      "palavras": [
        { "hebraico": "וַיְהִי", "transliteral": "way-hî", "traducao_palavra": "e aconteceu" },
        { "hebraico": "דְּבַר־יְהוָ֥ה", "transliteral": "də-ḇar-YHWH", "traducao_palavra": "a palavra de YHWH" },
        { "hebraico": "אֵלַ֖י", "transliteral": "ʾē-lay", "traducao_palavra": "a mim" },
        { "hebraico": "לֵאמֹֽר׃", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" }
      ]
    },
    "22": {
      "traducao_completa": "Filho do homem, que provérbio é este que tendes na terra de Israel, dizendo: Os dias se prolongam, e perece toda a visão?",
      "palavras": [
        { "hebraico": "בֶּן־אָדָ֗ם", "transliteral": "ben-ʾā-ḏām", "traducao_palavra": "filho do homem" },
        { "hebraico": "מָֽה־הַמָּשָׁ֤ל", "transliteral": "māh-ham-mā-šāl", "traducao_palavra": "que provérbio" },
        { "hebraico": "הַזֶּה", "transliteral": "haz-zeh", "traducao_palavra": "este" }
      ]
    },
    "23": {
      "traducao_completa": "Dize-lhes, pois: Assim diz o Senhor YHWH: Farei cessar este provérbio, e não se servirão mais dele como provérbio em Israel; mas dize-lhes: Os dias estão próximos, e o cumprimento de toda a visão.",
      "palavras": [
        { "hebraico": "לָכֵן", "transliteral": "lā-ḵên", "traducao_palavra": "portanto" },
        { "hebraico": "אֱמֹ֣ר", "transliteral": "ʾĕ-môr", "traducao_palavra": "dize" },
        { "hebraico": "אֲלֵהֶ֔ם", "transliteral": "ʾă-lê-hem", "traducao_palavra": "a eles" }
      ]
    },
    "24": {
      "traducao_completa": "Porque não haverá mais nenhuma visão vã, nem adivinhação lisonjeira no meio da casa de Israel.",
      "palavras": [
        { "hebraico": "כִּ֠י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִהְיֶה", "transliteral": "yih-yeh", "traducao_palavra": "haverá" }
      ]
    },
    "25": {
      "traducao_completa": "Porque eu, YHWH, falarei a palavra que eu disser, e ela será cumprida; não será mais adiada; porque nos vossos dias, casa rebelde, falarei a palavra, e a cumprirei, diz o Senhor YHWH.",
      "palavras": [
        { "hebraico": "כִּ֚י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אֲנִ֣י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "26": {
      "traducao_completa": "Veio a mim a palavra de YHWH, dizendo:",
      "palavras": [
        { "hebraico": "וַיְהִי", "transliteral": "way-hî", "traducao_palavra": "e aconteceu" },
        { "hebraico": "דְּבַר־יְהוָ֥ה", "transliteral": "də-ḇar-YHWH", "traducao_palavra": "a palavra de YHWH" },
        { "hebraico": "אֵלַ֖י", "transliteral": "ʾē-lay", "traducao_palavra": "a mim" },
        { "hebraico": "לֵאמֹֽר׃", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" }
      ]
    },
    "27": {
      "traducao_completa": "Filho do homem, eis que a casa de Israel diz: A visão que este vê é para muitos dias, e ele profetiza de tempos que estão longe.",
      "palavras": [
        { "hebraico": "בֶּן־אָדָ֗ם", "transliteral": "ben-ʾā-ḏām", "traducao_palavra": "filho do homem" },
        { "hebraico": "הִנֵּ֥ה", "transliteral": "hin-nēh", "traducao_palavra": "eis que" },
        { "hebraico": "בֵּית־יִשְׂרָאֵל", "transliteral": "bêṯ-yiś-rā-ʾēl", "traducao_palavra": "a casa de Israel" }
      ]
    },
    "28": {
      "traducao_completa": "Portanto dize-lhes: Assim diz o Senhor YHWH: Nenhuma das minhas palavras será mais adiada; a palavra que eu disser, será cumprida, diz o Senhor YHWH.",
