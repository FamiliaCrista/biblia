    "5": {
      "traducao_completa": "Sobre a face do campo cairás, porque eu o falei, diz o Senhor YHWH.",
      "palavras": [
        { "hebraico": "עַל־פְּנֵ֥י", "transliteral": "ʿal-pə-nê", "traducao_palavra": "sobre a face de" },
