        { "hebraico": "וְתֻבָֽל׃", "transliteral": "wə-ṯu-ḇāl", "traducao_palavra": "e Tubal" }
      ]
    },
    "2": {
      "traducao_completa": "E te farei voltar, e te conduzirei, e te farei subir dos confins do norte, e te trarei aos montes de Israel.",
      "palavras": [
        { "hebraico": "וְשֹׁבַבְתִּ֙יךָ֙", "transliteral": "wə-šō-ḇaḇ-tî-ḵā", "traducao_palavra": "e te farei voltar" },
        { "hebraico": "וְשִׁשֵּׁאתִ֔יךָ", "transliteral": "wə-šiš-šē-ṯî-ḵā", "traducao_palavra": "e te conduzirei" },
        { "hebraico": "וְהַעֲלִיתִ֖יךָ", "transliteral": "wə-ha-ʿă-lî-ṯî-ḵā", "traducao_palavra": "e te farei subir" },
        { "hebraico": "מִיַּרְכְּתֵ֣י", "transliteral": "miy-yar-kə-ṯê", "traducao_palavra": "dos confins de" },
        { "hebraico": "צָפֹ֑ון", "transliteral": "ṣā-p̄ôn", "traducao_palavra": "o norte" },
        { "hebraico": "וַהֲבִאֹותִ֖יךָ", "transliteral": "wa-hă-ḇî-ʾô-ṯî-ḵā", "traducao_palavra": "e te trarei" },
