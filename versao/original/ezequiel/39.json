{
  "livro": "Ezequiel - יְחֶזְקֵאל - Yechezqel",
  "capítulo": 39,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "E tu, ó filho do homem, profetiza contra Gogue, e dize: Assim diz o Senhor YHWH: Eis que eu sou contra ti, ó Gogue, príncipe de Rôs, Meseque e Tubal.",
      "palavras": [
        { "hebraico": "וְאַתָּ֤ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "e tu" },
