        { "hebraico": "יֹשְׁבֵ֣י", "transliteral": "yō-šə-ḇê", "traducao_palavra": "os habitantes de" },
        { "hebraico": "עָרֵ֣י", "transliteral": "ʿā-rê", "traducao_palavra": "cidades de" },
