        { "hebraico": "הִנָּבֵ֣א", "transliteral": "hin-nā-ḇê", "traducao_palavra": "profetiza" },
        { "hebraico": "עַל־גֹּ֔וג", "transliteral": "ʿal-gôḡ", "traducao_palavra": "contra Gogue" },
        { "hebraico": "וְאָמַרְתָּ֕", "transliteral": "wə-ʾā-mar-tā", "traducao_palavra": "e dirás" },
