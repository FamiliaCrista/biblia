        { "hebraico": "יְמִינְךָ֖", "transliteral": "yə-mî-nə-ḵā", "traducao_palavra": "tua direita" },
        { "hebraico": "אַפִּֽיל׃", "transliteral": "ʾap-pîl", "traducao_palavra": "farei cair" }
      ]
    },
    "4": {
      "traducao_completa": "Nos montes de Israel cairás, tu e todas as tuas tropas, e os povos que estão contigo; às aves de rapina de toda espécie e aos animais do campo te darei por pasto.",
      "palavras": [
