        { "hebraico": "אֲדֹנָ֣י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "הִנְנִ֤י", "transliteral": "hin-nî", "traducao_palavra": "eis que eu sou" },
        { "hebraico": "אֵלֶ֙יךָ֙", "transliteral": "ʾē-le-ḵā", "traducao_palavra": "contra ti" },
        { "hebraico": "גֹּ֔וג", "transliteral": "gôḡ", "traducao_palavra": "ó Gogue" },
        { "hebraico": "נְשִׂ֕יא", "transliteral": "nə-śî", "traducao_palavra": "príncipe de" },
        { "hebraico": "רֹ֖אשׁ", "transliteral": "rōʾš", "traducao_palavra": "Rôs" },
