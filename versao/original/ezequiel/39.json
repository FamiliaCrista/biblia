      ]
    },
    "3": {
      "traducao_completa": "E tirarei da tua mão esquerda o teu arco, e farei cair da tua mão direita as tuas flechas.",
      "palavras": [
        { "hebraico": "וְהִכֵּיתִ֥י", "transliteral": "wə-hik-kê-ṯî", "traducao_palavra": "e golpearei / tirarei" },
        { "hebraico": "קַשְׁתְּךָ֖", "transliteral": "qaš-tə-ḵā", "traducao_palavra": "o teu arco" },
        { "hebraico": "מִיַּ֣ד", "transliteral": "miy-yaḏ", "traducao_palavra": "da mão" },
        { "hebraico": "שְׂמֹאולֶ֑ךָ", "transliteral": "śə-mō-le-ḵā", "traducao_palavra": "tua esquerda" },
        { "hebraico": "וְחִצֶּ֕יךָ", "transliteral": "wə-ḥiṣ-ṣe-yḵā", "traducao_palavra": "e as tuas flechas" },
