        { "hebraico": "וְעַמִּ֖ים", "transliteral": "wə-ʿam-mîm", "traducao_palavra": "e povos" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que [estão]" },
