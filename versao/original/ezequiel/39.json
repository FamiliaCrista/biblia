        { "hebraico": "בְּמָגֹ֔וג", "transliteral": "bə-mā-ḡôḡ", "traducao_palavra": "em Magogue" },
        { "hebraico": "וּבְיֹשְׁבֵ֥י", "transliteral": "ū-ḇə-yō-šə-ḇê", "traducao_palavra": "e sobre os que habitam" },
