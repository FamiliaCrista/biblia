        { "hebraico": "וּבְחִצִּ֖ים", "transliteral": "ū-ḇə-ḥiṣ-ṣîm", "traducao_palavra": "e com flechas" },
        { "hebraico": "וּבְמַקֵּ֣ל", "transliteral": "ū-ḇə-maq-qêl", "traducao_palavra": "e com bastão de" },
