        { "hebraico": "יְהוִה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "הִנְנִי", "transliteral": "hin-nî", "traducao_palavra": "eis que eu" },
        { "hebraico": "נֹתְנֵךְ", "transliteral": "nō-ṯə-nêḵ", "traducao_palavra": "te entregarei" },
        { "hebraico": "בְּיַד", "transliteral": "bə-yaḏ", "traducao_palavra": "na mão de" },
