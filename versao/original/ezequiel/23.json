{
  "livro": "Ezequiel - יְחֶזְקֵאל - Yechezqel",
  "capítulo": 23,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Veio ainda a mim a palavra de YHWH, dizendo:",
      "palavras": [
        { "hebraico": "וַיְהִ֥י", "transliteral": "way-hî", "traducao_palavra": "e veio" },
        { "hebraico": "דְבַר־יְהוָ֖ה", "transliteral": "də-ḇar-YHWH", "traducao_palavra": "a palavra de YHWH" },
        { "hebraico": "אֵלַ֥י", "transliteral": "ʾē-lay", "traducao_palavra": "a mim" },
        { "hebraico": "לֵאמֹֽר׃", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" }
      ]
    },
    "2": {
      "traducao_completa": "Filho do homem, havia duas mulheres, filhas de uma mesma mãe;",
      "palavras": [
        { "hebraico": "בֶּן־אָדָ֕ם", "transliteral": "ben-ʾā-ḏām", "traducao_palavra": "filho do homem" },
        { "hebraico": "שְׁתַּ֣יִם", "transliteral": "šət-ta-yim", "traducao_palavra": "duas" },
        { "hebraico": "נָשִׁ֖ים", "transliteral": "nā-šîm", "traducao_palavra": "mulheres" },
        { "hebraico": "בְּנֹ֥ות", "transliteral": "bə-nôṯ", "traducao_palavra": "filhas de" },
        { "hebraico": "אֵם", "transliteral": "ʾēm", "traducao_palavra": "uma mãe" },
        { "hebraico": "אֶחָֽת׃", "transliteral": "ʾe-ḥāṯ", "traducao_palavra": "uma" }
      ]
    },
    "3": {
      "traducao_completa": "E prostituíram-se no Egito; prostituíram-se na sua mocidade; ali foram apertados os seus seios, e ali foram apalpados os seios da sua virgindade.",
      "palavras": [
        { "hebraico": "וַתִּזְנֶ֥ינָה", "transliteral": "wat-tiz-ne-nā", "traducao_palavra": "e prostituíram-se" },
        { "hebraico": "בְמִצְרַ֖יִם", "transliteral": "ḇə-miṣ-ra-yim", "traducao_palavra": "no Egito" },
        { "hebraico": "בִּנְעוּרֵיהֶ֣ן", "transliteral": "bin-ʿû-rê-hen", "traducao_palavra": "na sua mocidade" },
        { "hebraico": "שָׁ֣מָּה", "transliteral": "šām-mā", "traducao_palavra": "ali" },
        { "hebraico": "עֹומֹ֣כוּ", "transliteral": "ʿô-mō-ḵû", "traducao_palavra": "foram apertados" },
        { "hebraico": "שְׁדֵיהֶן", "transliteral": "šə-ḏê-hen", "traducao_palavra": "os seus seios" },
        { "hebraico": "וְשָׁ֕ם", "transliteral": "wə-šām", "traducao_palavra": "e ali" },
        { "hebraico": "עָשׂ֖וּ", "transliteral": "ʿā-śû", "traducao_palavra": "fizeram" },
        { "hebraico": "דְּדֵ֥י", "transliteral": "də-ḏê", "traducao_palavra": "os seios de" },
        { "hebraico": "בְתוּלֵיהֶֽן׃", "transliteral": "ḇə-ṯû-lê-hen", "traducao_palavra": "sua virgindade" }
      ]
    },
    "4": {
      "traducao_completa": "Os seus nomes eram: Oolá, a maior, e Oolibá, sua irmã; e foram minhas, e tiveram filhos e filhas; e quanto aos seus nomes, Samaria é Oolá, e Jerusalém é Oolibá.",
      "palavras": [
        { "hebraico": "וּשְׁמֹותָ֗ן", "transliteral": "ū-šə-mô-ṯān", "traducao_palavra": "e os nomes delas" },
        { "hebraico": "אָהֳלָה", "transliteral": "ʾā-hŏ-lā", "traducao_palavra": "Oolá" },
        { "hebraico": "הַגְּדֹולָה", "transliteral": "haḡ-ḡə-ḏô-lā", "traducao_palavra": "a maior" },
        { "hebraico": "וְאָהֳלִיבָה", "transliteral": "wə-ʾā-hŏ-lî-ḇā", "traducao_palavra": "e Oolibá" },
        { "hebraico": "אֲחֹותָהּ", "transliteral": "ʾă-ḥô-ṯāh", "traducao_palavra": "sua irmã" },
        { "hebraico": "וִֽי־הִיְיָ֣ה", "transliteral": "wî-hî-yāh", "traducao_palavra": "e foram" },
        { "hebraico": "לִי", "transliteral": "lî", "traducao_palavra": "minhas" },
        { "hebraico": "וַתֵּלַדְנָה", "transliteral": "wat-tê-laḏ-nā", "traducao_palavra": "e tiveram" },
        { "hebraico": "בָּנִ֖ים", "transliteral": "bā-nîm", "traducao_palavra": "filhos" },
        { "hebraico": "וּבָנֹ֑ות", "transliteral": "ū-ḇā-nôṯ", "traducao_palavra": "e filhas" },
        { "hebraico": "וּשְׁמֹותָן", "transliteral": "ū-šə-mô-ṯān", "traducao_palavra": "e os nomes delas" },
        { "hebraico": "שֹׁמְרֹון", "transliteral": "šō-mə-rôn", "traducao_palavra": "Samaria" },
        { "hebraico": "אָהֳלָה", "transliteral": "ʾā-hŏ-lā", "traducao_palavra": "[é] Oolá" },
        { "hebraico": "וִירוּשָׁלִַ֖ם", "transliteral": "wî-rû-šā-la-yim", "traducao_palavra": "e Jerusalém" },
        { "hebraico": "אָהֳלִיבָה׃", "transliteral": "ʾā-hŏ-lî-ḇā", "traducao_palavra": "[é] Oolibá" }
      ]
    },
    "5": {
      "traducao_completa": "Oolá prostituiu-se, estando ainda debaixo de mim, e apaixonou-se pelos seus amantes, os assírios, seus vizinhos,",
      "palavras": [
        { "hebraico": "וַתִּזְנֶ֤ה", "transliteral": "wat-tiz-neh", "traducao_palavra": "e prostituiu-se" },
        { "hebraico": "אָהֳלָה", "transliteral": "ʾā-hŏ-lā", "traducao_palavra": "Oolá" },
        { "hebraico": "תַּחְתָּ֔י", "transliteral": "taḥ-tāy", "traducao_palavra": "debaixo de mim" },
        { "hebraico": "וַתַּעֲגַ֕ב", "transliteral": "wat-ta-ʿă-ḡaḇ", "traducao_palavra": "e apaixonou-se" },
        { "hebraico": "עַל־מְאַהֲבֶ֖יהָ", "transliteral": "ʿal-mə-ʾa-hă-ḇe-hā", "traducao_palavra": "pelos seus amantes" },
        { "hebraico": "אֶל־אֻשִּׁ֥יר", "transliteral": "ʾel-aš-šûr", "traducao_palavra": "aos assírios" },
        { "hebraico": "קְרֹבִֽים׃", "transliteral": "qə-rō-ḇîm", "traducao_palavra": "seus vizinhos" }
      ]
    },
    "6": {
      "traducao_completa": "Vestidos de azul, governadores e magistrados, todos eles jovens desejáveis, cavaleiros montados a cavalo.",
      "palavras": [
        { "hebraico": "לְבוּשֵׁ֣י", "transliteral": "lə-ḇû-šê", "traducao_palavra": "vestidos de" },
        { "hebraico": "תְכֵלֶת", "transliteral": "ṯə-ḵē-leṯ", "traducao_palavra": "azul" },
        { "hebraico": "פַּחֹ֣ות", "transliteral": "pa-ḥôṯ", "traducao_palavra": "governadores" },
        { "hebraico": "וּסְגָנִ֑ים", "transliteral": "ū-śə-ḡā-nîm", "traducao_palavra": "e magistrados" },
        { "hebraico": "בְּחוּרֵ֥י", "transliteral": "bə-ḥû-rê", "traducao_palavra": "jovens de" },
        { "hebraico": "חֲמּוּדֹ֖ות", "transliteral": "ḥam-mû-ḏôṯ", "traducao_palavra": "desejos/desejáveis" },
        { "hebraico": "פָּרָשִׁ֖ים", "transliteral": "pā-rā-šîm", "traducao_palavra": "cavaleiros" },
        { "hebraico": "רֹכְבֵי", "transliteral": "rō-ḵə-ḇê", "traducao_palavra": "montados em" },
        { "hebraico": "סוּסִֽים׃", "transliteral": "sû-śîm", "traducao_palavra": "cavalos" }
      ]
    },
    "7": {
      "traducao_completa": "E consumiu as suas prostituições com eles, que eram todos eles os escolhidos dos filhos de Assur; e, com todos aqueles de quem se apaixonou, contaminou-se com todos os seus ídolos.",
      "palavras": [
        { "hebraico": "וַתִּתֵּ֧ן", "transliteral": "wat-tit-tên", "traducao_palavra": "e deu/consumiu" },
        { "hebraico": "תַּזְנוּתֶ֖יהָ", "transliteral": "taz-nû-ṯe-hā", "traducao_palavra": "as prostituições dela" },
        { "hebraico": "עֲלֵיהֶ֑ם", "transliteral": "ʿă-lê-hem", "traducao_palavra": "com eles" },
        { "hebraico": "מִבְחַ֤ר", "transliteral": "miḇ-ḥar", "traducao_palavra": "os escolhidos de" },
        { "hebraico": "בְּנֵי־אַשּׁוּר", "transliteral": "bə-nê-ʾaš-šûr", "traducao_palavra": "filhos de Assur" },
        { "hebraico": "וְכָל", "transliteral": "wə-ḵāl", "traducao_palavra": "e todos" },
        { "hebraico": "אֲשֶׁר", "transliteral": "ʾă-šer", "traducao_palavra": "aqueles que" },
        { "hebraico": "עָגְבָה", "transliteral": "ʿā-ḡə-ḇā", "traducao_palavra": "ela se apaixonou" },
        { "hebraico": "בְּכָל", "transliteral": "bə-ḵāl", "traducao_palavra": "com todos" },
        { "hebraico": "גִּלּוּלֵיהֶ֥ם", "transliteral": "gil-lû-lê-hem", "traducao_palavra": "os ídolos deles" },
        { "hebraico": "نִטְמָאָה", "transliteral": "niṭ-mā-ʾā", "traducao_palavra": "contaminou-se" }
      ]
    },
    "8": {
      "traducao_completa": "Nem tampouco deixou as suas prostituições que trouxe desde o Egito; porque, na sua mocidade, se deitaram com ela, e apalparam os seios da sua virgindade, e derramaram sobre ela a sua prostituição.",
      "palavras": [
        { "hebraico": "וְאֶת־תַּזְנוּתֶ֤יהָ", "transliteral": "wə-ʾeṯ-taz-nû-ṯe-hā", "traducao_palavra": "e as prostituições dela" },
        { "hebraico": "מִמִּצְרַ֙יִם֙", "transliteral": "mim-miṣ-ra-yim", "traducao_palavra": "desde o Egito" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "עָזָ֔בְה", "transliteral": "ʿā-zāḇ-hā", "traducao_palavra": "deixou" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "אֹתָ֨הּ֙", "transliteral": "ʾō-ṯāh", "traducao_palavra": "ela" },
        { "hebraico": "שָׁכְב֣וּ", "transliteral": "šā-ḵə-ḇû", "traducao_palavra": "deitaram-se" },
        { "hebraico": "בִנְעוּרֶ֔יהָ", "transliteral": "ḇin-ʿû-re-hā", "traducao_palavra": "na sua mocidade" },
        { "hebraico": "וְהֵ֜מָּה", "transliteral": "wə-hêm-mā", "traducao_palavra": "e eles" },
        { "hebraico": "עָשׂ֣וּ", "transliteral": "ʿā-śû", "traducao_palavra": "fizeram" },
        { "hebraico": "דְּדֵ֣י", "transliteral": "də-ḏê", "traducao_palavra": "os seios de" },
        { "hebraico": "בְתוּלָתָ֔הּ", "transliteral": "ḇə-ṯû-lā-ṯāh", "traducao_palavra": "sua virgindade" },
        { "hebraico": "וַיִּשְׁפְּכ֥וּ", "transliteral": "way-yiš-pə-ḥû", "traducao_palavra": "e derramaram" },
        { "hebraico": "תַּזְנוּתָ֖ם", "transliteral": "taz-nû-ṯām", "traducao_palavra": "a prostituição deles" },
        { "hebraico": "עָלֶֽיהָ׃", "transliteral": "ʿā-le-hā", "traducao_palavra": "sobre ela" }
      ]
    },
    "9": {
      "traducao_completa": "Por isso a entreguei na mão dos seus amantes, na mão dos filhos da Assíria, pelos quais se apaixonou.",
      "palavras": [
        { "hebraico": "לָכֵן֙", "transliteral": "lā-ḵên", "traducao_palavra": "por isso" },
        { "hebraico": "נְתַתִּ֤יהָ", "transliteral": "nə-ṯat-tî-hā", "traducao_palavra": "a entreguei" },
        { "hebraico": "בְּיַד", "transliteral": "bə-yaḏ", "traducao_palavra": "na mão de" },
        { "hebraico": "מְאַהֲבֶ֔יהָ", "transliteral": "mə-ʾa-hă-ḇe-hā", "traducao_palavra": "seus amantes" },
        { "hebraico": "בְּיַד", "transliteral": "bə-yaḏ", "traducao_palavra": "na mão de" },
        { "hebraico": "בְּנֵ֥י", "transliteral": "bə-nê", "traducao_palavra": "filhos de" },
        { "hebraico": "אַשּׁ֖וּר", "transliteral": "ʾaš-šûr", "traducao_palavra": "Assíria" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "pelas quais" },
        { "hebraico": "עָגְבָֽה׃", "transliteral": "ʿā-ḡə-ḇā", "traducao_palavra": "ela se apaixonou" }
      ]
    },
    "10": {
      "traducao_completa": "Eles descobriram a sua nudez, tomaram os seus filhos e as suas filhas, e a ela mataram à espada; e ela tornou-se célebre entre as mulheres, depois que executaram nela o juízo.",
      "palavras": [
        { "hebraico": "הֵ֚מָּה", "transliteral": "hêm-mā", "traducao_palavra": "eles" },
        { "hebraico": "גִּלּ֣וּ", "transliteral": "gil-lû", "traducao_palavra": "descobriram" },
        { "hebraico": "עֶרְוָתָ֔הּ", "transliteral": "ʿer-wā-ṯāh", "traducao_palavra": "nudez dela" },
        { "hebraico": "אֶת־בָּנֶ֥יהָ", "transliteral": "ʾeṯ-bā-ne-hā", "traducao_palavra": "seus filhos" },
        { "hebraico": "וְאֶת־בְּנֹתֶ֖יהָ", "transliteral": "wə-ʾeṯ-bə-nō-ṯe-hā", "traducao_palavra": "e suas filhas" },
        { "hebraico": "לָקָ֑חוּ", "transliteral": "lā-qā-ḥû", "traducao_palavra": "tomaram" },
        { "hebraico": "وَأِיתَ֥הּ", "transliteral": "wə-ʾō-ṯāh", "traducao_palavra": "e a ela" },
        { "hebraico": "הָרְג֖וּ", "transliteral": "hā-rə-ḡû", "traducao_palavra": "mataram" },
        { "hebraico": "בַּחֶֽרֶב", "transliteral": "ba-ḥe-reḇ", "traducao_palavra": "à espada" },
        { "hebraico": "וְהָיְתָ֥ה", "transliteral": "wə-hā-yə-ṯā", "traducao_palavra": "e ela tornou-se" },
        { "hebraico": "שֵּׁ֥ם", "transliteral": "šēm", "traducao_palavra": "célebre/fama entre" },
        { "hebraico": "לַנָּשִׁים", "transliteral": "lan-nā-šîm", "traducao_palavra": "as mulheres" },
        { "hebraico": "וּשְׁפָטִ֖ים", "transliteral": "ū-šə-p̄ā-ṭîm", "traducao_palavra": "e juízos" },
        { "hebraico": "עָשׂוּ־בָֽהּ׃", "transliteral": "ʿā-śû-ḇāh", "traducao_palavra": "executaram nela" }
      ]
    },
    "11": {
      "traducao_completa": "Vendo isto sua irmã Oolibá, corrompeu-se mais do que ela no seu amor, e as suas prostituições foram piores do que as prostituições de sua irmã.",
      "palavras": [
        { "hebraico": "וַתֵּ֣רֶא", "transliteral": "wat-tē-reʾ", "traducao_palavra": "e vendo" },
        { "hebraico": "אֲחֹותָהּ֙", "transliteral": "ʾă-ḥô-ṯāh", "traducao_palavra": "sua irmã" },
        { "hebraico": "אָהֳלִיבָ֔ה", "transliteral": "ʾā-hŏ-lî-ḇā", "traducao_palavra": "Oolibá" },
        { "hebraico": "וַתַּשְׁחֵ֣ת", "transliteral": "wat-taš-ḥēṯ", "traducao_palavra": "e corrompeu-se" },
        { "hebraico": "אַהֲבָתָ֖הּ", "transliteral": "ʾa-hă-wā-ṯāh", "traducao_palavra": "no seu amor" },
        { "hebraico": "מִמֶּ֑נָּה", "transliteral": "mim-men-nāh", "traducao_palavra": "mais do que ela" },
        { "hebraico": "וְאֶת־תַּזְנוּתֶ֛יהָ", "transliteral": "wə-ʾeṯ-taz-nû-ṯe-hā", "traducao_palavra": "e as prostituições dela" },
        { "hebraico": "מִזְּנוּת", "transliteral": "miz-zə-nûṯ", "traducao_palavra": "do que as prostituições de" },
        { "hebraico": "אֲחֹותָֽהּ׃", "transliteral": "ʾă-ḥô-ṯāh", "traducao_palavra": "sua irmã" }
      ]
    },
    "12": {
      "traducao_completa": "Apaixonou-se pelos assírios, seus vizinhos, governadores e magistrados, vestidos magnificamente, cavaleiros montados a cavalo, todos eles jovens desejáveis.",
      "palavras": [
        { "hebraico": "אֶל־בְּנֵ֨י", "transliteral": "ʾel-bə-nê", "traducao_palavra": "pelos filhos de" },
        { "hebraico": "אַשּׁ֜וּר", "transliteral": "ʾaš-šûr", "traducao_palavra": "Assíria" },
        { "hebraico": "עָגְבָ֗ה", "transliteral": "ʿā-ḡə-ḇā", "traducao_palavra": "apaixonou-se" },
        { "hebraico": "פַּחֹות", "transliteral": "pa-ḥôṯ", "traducao_palavra": "governadores" },
        { "hebraico": "וּסְגָנִים", "transliteral": "ū-śə-ḡā-nîm", "traducao_palavra": "e magistrados" },
        { "hebraico": "קְרֹבִים", "transliteral": "qə-rō-ḇîm", "traducao_palavra": "vizinhos" },
        { "hebraico": "לְבוּשֵׁ֣י", "transliteral": "lə-ḇû-šê", "traducao_palavra": "vestidos de" },
        { "hebraico": "מִכְלֹול", "transliteral": "miḵ-lôl", "traducao_palavra": "perfeição/magnificamente" },
        { "hebraico": "פָּרָשִׁ֖ים", "transliteral": "pā-rā-šîm", "traducao_palavra": "cavaleiros" },
        { "hebraico": "רֹכְבֵי", "transliteral": "rō-ḵə-ḇê", "traducao_palavra": "montados em" },
        { "hebraico": "סוּסִֽים׃", "transliteral": "sû-śîm", "traducao_palavra": "cavalos" }
      ]
    },
    "13": {
      "traducao_completa": "E vi que ela se contaminava; ambas seguiam o mesmo caminho.",
      "palavras": [
