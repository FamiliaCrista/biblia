    "23": {
      "traducao_completa": "Os babilônios e todos os caldeus, Pecode, Soa e Coa, e todos os assírios com eles, jovens desejáveis, todos eles capitães e príncipes, oficiais e governadores, todos eles montados a cavalo.",
      "palavras": [
        { "hebraico": "בְּנֵי", "transliteral": "bə-nê", "traducao_palavra": "filhos de" },
        { "hebraico": "בָּבֶל", "transliteral": "bā-ḇel", "traducao_palavra": "Babilônia" },
        { "hebraico": "וְכָל־כַּשְׂדִּים", "transliteral": "wə-ḵāl-kaś-dîm", "traducao_palavra": "e todos os caldeus" },
