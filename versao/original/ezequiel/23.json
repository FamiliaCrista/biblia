        { "hebraico": "רֶ֜כֶב", "transliteral": "re-ḵeḇ", "traducao_palavra": "com carros" },
        { "hebraico": "וּגְלַגִּ֗ל", "transliteral": "ū-ḡə-laḡ-gil", "traducao_palavra": "e rodas/carruagens" },
