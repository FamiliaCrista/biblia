        { "hebraico": "נָקְעָה", "transliteral": "nā-qə-ʿā", "traducao_palavra": "se desviou/enjeitou" },
        { "hebraico": "נַפְשֵׁךְ", "transliteral": "nap̄-šēḵ", "traducao_palavra": "tua alma" },
        { "hebraico": "וְהֲבֵאתִים", "transliteral": "wə-hă-ḇê-ṯîm", "traducao_palavra": "e os trarei" },
