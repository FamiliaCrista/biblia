        { "hebraico": "כֻּלָּם", "transliteral": "kul-lām", "traducao_palavra": "todos eles" },
        { "hebraico": "רֹכְבֵי", "transliteral": "rō-ḵə-ḇê", "traducao_palavra": "montados em" },
        { "hebraico": "סוּסִים", "transliteral": "sû-śîm", "traducao_palavra": "cavalos" }
      ]
    },
    "24": {
      "traducao_completa": "Virão contra ti com carros e carruagens, e com multidão de povos; escudo, rodela e elmo levantarão contra ti ao redor; e eu entregarei diante deles o juízo, e te julgarão conforme os seus juízos.",
