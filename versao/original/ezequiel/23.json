        { "hebraico": "בַּחוּרֵי", "transliteral": "ba-ḥû-rê", "traducao_palavra": "jovens" },
        { "hebraico": "חֶמְדָּה", "transliteral": "ḥem-dā", "traducao_palavra": "desejáveis" },
        { "hebraico": "פַּחֹות", "transliteral": "pa-ḥôṯ", "traducao_palavra": "governadores" },
        { "hebraico": "וּסְגָנִים", "transliteral": "ū-śə-ḡā-nîm", "traducao_palavra": "e magistrados" },
        { "hebraico": "שָׁלִשִׁים", "transliteral": "šā-li-šîm", "traducao_palavra": "capitães/oficiais" },
