    "27": {
      "traducao_completa": "Assim farei cessar a tua abominação e a tua prostituição, trazida desde a terra do Egito; e não levantarás os teus olhos para elas, e nunca mais te lembrarás do Egito.",
      "palavras": [
        { "hebraico": "וְהִשְׁבַּתִּ֤י", "transliteral": "wə-hiš-bat-tî", "traducao_palavra": "assim farei cessar" },
        { "hebraico": "זִמָּתְךָ", "transliteral": "zim-mā-ṯə-ḵā", "traducao_palavra": "a tua maldade/lascívia" },
        { "hebraico": "מִמֵּךְ", "transliteral": "mim-mēḵ", "traducao_palavra": "de ti" },
