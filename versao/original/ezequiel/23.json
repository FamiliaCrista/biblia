        { "hebraico": "אָהֳלִיבָה", "transliteral": "ʾā-hŏ-lî-ḇā", "traducao_palavra": "ó Oolibá" },
        { "hebraico": "כֹּה", "transliteral": "kō", "traducao_palavra": "assim" },
