        { "hebraico": "לַאֲבֹֽתֵיכֶ֑ם", "transliteral": "la-ʾă-ḇō-ṯê-ḵem", "traducao_palavra": "a vossos pais" },
        { "hebraico": "וְנָ֨פְלָ֜ה", "transliteral": "wə-nā-p̄ə-lā", "traducao_palavra": "e cairá" },
        { "hebraico": "הָאָ֧רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "הַזֹּ֛את", "transliteral": "haz-zōʾṯ", "traducao_palavra": "esta" },
