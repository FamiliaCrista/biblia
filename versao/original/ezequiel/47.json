    "12": {
      "traducao_completa": "E junto ao ribeiro, à sua margem, de um e de outro lado, nascerá toda sorte de árvore que dá fruto para se comer; não murchará a sua folha, nem faltará o seu fruto; nos seus meses produzirá novos frutos, porque as suas águas saem do santuário; e o seu fruto servirá de alimento e a sua folha de remédio.",
      "palavras": [
        { "hebraico": "וְעַל־הַנַּ֣חַל", "transliteral": "wə-ʿal-han-na-ḥal", "traducao_palavra": "e junto ao ribeiro" },
        { "hebraico": "יַעֲלֶ֣ה", "transliteral": "ya-ʿă-leh", "traducao_palavra": "crescerá" },
        { "hebraico": "עַל־שְׂפָתֹ֣ו", "transliteral": "ʿal-śə-p̄ā-ṯô", "traducao_palavra": "à sua margem" },
        { "hebraico": "מִזֶּ֣ה", "transliteral": "miz-zeh", "traducao_palavra": "de um lado" },
        { "hebraico": "וּמִזֶּ֣ה", "transliteral": "ū-miz-zeh", "traducao_palavra": "e de outro lado" },
        { "hebraico": "כָּל־עֵֽץ־מַ֠אֲכָל", "transliteral": "kāl-ʿêṣ-ma-ʾă-ḵāl", "traducao_palavra": "toda árvore de alimento" },
