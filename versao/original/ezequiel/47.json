        { "hebraico": "עָלֵ֜הוּ", "transliteral": "ʿā-lê-hū", "traducao_palavra": "a sua folha" },
        { "hebraico": "וְלֹֽא־יִתֹּ֣ם", "transliteral": "wə-lō-yit-tōm", "traducao_palavra": "e não cessará/acabará" },
        { "hebraico": "פִּרְיֹ֗ו", "transliteral": "pir-yô", "traducao_palavra": "o seu fruto" },
        { "hebraico": "לָֽחֳדָשָׁיו֙", "transliteral": "lā-ḥo-ḏā-šāyw", "traducao_palavra": "a cada mês" },
