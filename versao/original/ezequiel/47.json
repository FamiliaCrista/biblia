        { "hebraico": "הֵ֣מָּה", "transliteral": "hêm-mā", "traducao_palavra": "elas" },
        { "hebraico": "יֹוצְאִ֑ים", "transliteral": "yô-ṣə-ʾîm", "traducao_palavra": "saem" },
