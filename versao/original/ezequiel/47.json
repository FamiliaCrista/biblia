        { "hebraico": "כְּאָחִ֔יו", "transliteral": "kə-ʾā-ḥîw", "traducao_palavra": "como seu irmão" },
        { "hebraico": "אֲשֶׁ֤ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "נָשָׂ֙אתִי֙", "transliteral": "nā-śā-ṯî", "traducao_palavra": "levantei" },
