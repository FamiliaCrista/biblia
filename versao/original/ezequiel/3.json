        { "hebraico": "בִּ֣י", "transliteral": "bî", "traducao_palavra": "em mim" },
        { "hebraico": "רוּחַ", "transliteral": "rû-aḥ", "traducao_palavra": "o espírito" },
        { "hebraico": "וַתַּעֲמִידֵנִי", "transliteral": "wat-ta-ʿă-mî-ḏê-nî", "traducao_palavra": "e me pôs em pé" }
      ]
    },
    "25": {
      "traducao_completa": "E quanto a ti, ó filho do homem, eis que porão cordas sobre ti, e te ligarão com elas, e não sairás do meio deles.",
      "palavras": [
        { "hebraico": "וְאַתָּה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "e tu" },
        { "hebraico": "בֶן־אָדָם", "transliteral": "ben-ʾā-ḏām", "traducao_palavra": "filho do homem" },
        { "hebraico": "הִנֵּה", "transliteral": "hin-nēh", "traducao_palavra": "eis que" },
        { "hebraico": "נָתְנ֚וּ", "transliteral": "nā-ṯə-nû", "traducao_palavra": "porão" },
        { "hebraico": "עָלֶיךָ", "transliteral": "ʿā-le-ḵā", "traducao_palavra": "sobre ti" },
        { "hebraico": "עֲבֹתִים", "transliteral": "ʿă-ḇō-ṯîm", "traducao_palavra": "cordas" }
      ]
    },
    "26": {
      "traducao_completa": "E farei a tua língua pegar-se ao teu palato, e ficarás mudo, e não serás para eles varão que repreenda; porque são casa rebelde.",
      "palavras": [
        { "hebraico": "לְשֹׁונְךָ֞", "transliteral": "lə-šô-nə-ḵā", "traducao_palavra": "tua língua" },
        { "hebraico": "אַדְבִּ֣יק", "transliteral": "ʾaḏ-bîq", "traducao_palavra": "farei pegar" },
        { "hebraico": "אֶל־חִכֶּ֑ךָ", "transliteral": "ʾel-ḥik-ke-ḵā", "traducao_palavra": "ao teu palato" }
      ]
    },
    "27": {
      "traducao_completa": "Mas, quando eu te falar, abrirei a tua boca, e lhes dirás: Assim diz o Senhor YHWH: Quem ouvir, ouça, e quem deixar de ouvir, deixe; porque são casa rebelde.",
      "palavras": [
