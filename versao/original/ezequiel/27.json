        { "hebraico": "הַבָּשָׁן", "transliteral": "hab-bā-šān", "traducao_palavra": "Basã" },
        { "hebraico": "עָשׂוּ", "transliteral": "ʿā-śû", "traducao_palavra": "fizeram" },
        { "hebraico": "מְשֹׁוטָיִךְ", "transliteral": "mə-šô-ṯā-yiḵ", "traducao_palavra": "teus remos" },
