        { "hebraico": "עַל־צֹור", "transliteral": "ʿal-ṣôr", "traducao_palavra": "sobre Tiro" },
        { "hebraico": "קִינָה", "transliteral": "qî-nā", "traducao_palavra": "uma lamentação" }
      ]
    },
    "3": {
      "traducao_completa": "E dize a Tiro, que habita nos portões do mar, e que negocia com os povos de muitas ilhas: Assim diz o Senhor YHWH: Ó Tiro, tu dizes: Eu sou de perfeita formosura.",
      "palavras": [
