        { "hebraico": "בִּדְקֵךְ", "transliteral": "biḏ-qēḵ", "traducao_palavra": "tuas fendas" },
        { "hebraico": "כָּל־אֳנִיֹּות", "transliteral": "kāl-ʾŏ-nî-yôṯ", "traducao_palavra": "todas as naves de" },
        { "hebraico": "הַיָּם", "transliteral": "hay-yām", "traducao_palavra": "o mar" },
        { "hebraico": "וּמַלּֽَחֵיהֶם", "transliteral": "ū-mal-lā-ḥê-hem", "traducao_palavra": "e os seus marinheiros" },
        { "hebraico": "הָיu", "transliteral": "hā-yû", "traducao_palavra": "estavam" },
        { "hebraico": "בָךְ", "transliteral": "ḇāḵ", "traducao_palavra": "em ti" },
