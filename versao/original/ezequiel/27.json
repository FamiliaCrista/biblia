        { "hebraico": "מִשְּׂנִיר", "transliteral": "mis-śə-nîr", "traducao_palavra": "de Senir" },
        { "hebraico": "בָּנוּ", "transliteral": "bā-nû", "traducao_palavra": "construíram" },
        { "hebraico": "לָךְ", "transliteral": "lāḵ", "traducao_palavra": "para ti" },
