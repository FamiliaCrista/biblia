    },
    "25": {
      "traducao_completa": "As naus de Társis eram as tuas caravanas nas tuas feiras; e tu te encheste, e te glorificaste grandemente no meio dos mares.",
      "palavras": [
        { "hebraico": "אֳנִיֹּ֥ות", "transliteral": "ʾŏ-nî-yôṯ", "traducao_palavra": "as naus de" },
        { "hebraico": "תַּרְשִׁישׁ", "transliteral": "tar-šîš", "traducao_palavra": "Társis" },
        { "hebraico": "שָֽׁרְתֵךְ", "transliteral": "šā-rə-ṯēḵ", "traducao_palavra": "eram tuas caravanas/portadoras" },
        { "hebraico": "מַעֲרָבֵךְ", "transliteral": "ma-ʿă-rā-ḇēḵ", "traducao_palavra": "nas tuas feiras" },
        { "hebraico": "וְתִמָּלְאִ֖י", "transliteral": "wə-tim-mā-lə-ʾî", "traducao_palavra": "e tu te encheste" },
        { "hebraico": "וּתְכִבְּדִי", "transliteral": "ū-ṯə-ḵib-bə-ḏî", "traducao_palavra": "e te glorificaste" },
        { "hebraico": "מְאֹ֖ד", "transliteral": "mə-ʾōḏ", "traducao_palavra": "grandemente" },
        { "hebraico": "בְּלֵ֥ב", "transliteral": "bə-lēḇ", "traducao_palavra": "no coração de" },
        { "hebraico": "יַמִּֽים׃", "transliteral": "yam-mîm", "traducao_palavra": "os mares" }
      ]
    },
    "26": {
      "traducao_completa": "Os teus remadores te levaram a muitas águas; o vento oriental te quebrou no meio dos mares.",
      "palavras": [
        { "hebraico": "בְּמַיִם", "transliteral": "bə-ma-yim", "traducao_palavra": "nas águas" },
        { "hebraico": "רַבִּים֮", "transliteral": "rab-bîm", "traducao_palavra": "muitas" },
        { "hebraico": "הֱבִיאֻ֖כוּ", "transliteral": "hĕ-ḇî-ʾu-ḵû", "traducao_palavra": "te levaram" },
        { "hebraico": "הַשָּׁטִ֑ים", "transliteral": "haš-šā-ṭîm", "traducao_palavra": "os remadores" },
        { "hebraico": "רּוּחַ", "transliteral": "rû-aḥ", "traducao_palavra": "o vento" },
        { "hebraico": "הַקָּדִים", "transliteral": "haq-qā-ḏîm", "traducao_palavra": "oriental" },
        { "hebraico": "שִׁבְּרְךָ֖", "transliteral": "šib-bə-rə-ḵā", "traducao_palavra": "te quebrou" },
        { "hebraico": "בְּלֵ֥ב", "transliteral": "bə-lēḇ", "traducao_palavra": "no coração de" },
        { "hebraico": "יַמִּֽים׃", "transliteral": "yam-mîm", "traducao_palavra": "os mares" }
      ]
    },
    "27": {
      "traducao_completa": "As tuas riquezas, e as tuas mercadorias, e os teus mantimentos, os teus marinheiros e os teus pilotos, os que calafetam as tuas fendas, e os que negociam a tua mercadoria, e todos os homens de guerra que há em ti, com toda a tua multidão que está no meio de ti, cairão no meio dos mares no dia da tua ruína.",
      "palavras": [
        { "hebraico": "הֹונֵךְ", "transliteral": "hô-nēḵ", "traducao_palavra": "tua riqueza" },
        { "hebraico": "וּמַעֲרָבֵךְ", "transliteral": "ū-ma-ʿă-rā-ḇēḵ", "traducao_palavra": "e tuas mercadorias" },
        { "hebraico": "רִכְלָתֵךְ", "transliteral": "riḵ-lā-ṯēḵ", "traducao_palavra": "e teus mantimentos/comércios" },
        { "hebraico": "מַלָּחַיִךְ", "transliteral": "mal-lā-ḥa-yiḵ", "traducao_palavra": "teus marinheiros" },
        { "hebraico": "וֹחֹבְלָיִךְ", "transliteral": "wə-ḥō-bə-lā-yiḵ", "traducao_palavra": "e teus pilotos" },
        { "hebraico": "מַחֲזִיקֵי", "transliteral": "ma-ḥă-zî-qê", "traducao_palavra": "os que reparam/calafetam" },
        { "hebraico": "בִּדְקֵךְ", "transliteral": "biḏ-qēḵ", "traducao_palavra": "tuas fendas" },
        { "hebraico": "וְֹֹעֲשֵׂי", "transliteral": "wə-ʿō-śê", "traducao_palavra": "e os que negociam" },
        { "hebraico": "מַעֲרָבֵךְ", "transliteral": "ma-ʿă-rā-ḇēḵ", "traducao_palavra": "tua mercadoria" },
        { "hebraico": "וְכָל־אַנְשֵׁי", "transliteral": "wə-ḵāl-ʾan-šê", "traducao_palavra": "e todos os homens de" },
        { "hebraico": "מִלְחָמְךָ", "transliteral": "mil-ḥā-mə-ḵā", "traducao_palavra": "guerra" },
        { "hebraico": "אֲשֶׁר־בָּךְ", "transliteral": "ʾă-šer-bāḵ", "traducao_palavra": "que há em ti" },
        { "hebraico": "וּבְכָל־קְהָלֵךְ", "transliteral": "ū-ḇə-ḵāl-qə-hā-lēḵ", "traducao_palavra": "e com toda a tua multidão" },
        { "hebraico": "אֲשֶׁר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "בְּתֹוכֵךְ", "transliteral": "bə-ṯô-ḵêḵ", "traducao_palavra": "está no meio de ti" },
        { "hebraico": "יִפֹּלוּ", "transliteral": "yip-pō-lû", "traducao_palavra": "cairão" },
        { "hebraico": "בְּלֵב", "transliteral": "bə-lēḇ", "traducao_palavra": "no coração de" },
        { "hebraico": "יַמִּים", "transliteral": "yam-mîm", "traducao_palavra": "os mares" },
        { "hebraico": "בְּיֹום", "transliteral": "bə-yôm", "traducao_palavra": "no dia de" },
        { "hebraico": "מַפָּלְתֵּךְ", "transliteral": "map-pā-lə-tēḵ", "traducao_palavra": "tua ruína" }
      ]
    },
    "28": {
      "traducao_completa": "Com o ruído do grito dos teus pilotos tremerão os campos.",
      "palavras": [
        { "hebraico": "לְקֹול", "transliteral": "lə-qôl", "traducao_palavra": "ao ruído de" },
        { "hebraico": "עַבְדֵי", "transliteral": "ʿaḇ-dê", "traducao_palavra": "grito/choro de" },
        { "hebraico": "חֹבְלָיִךְ", "transliteral": "ḥō-bə-lā-yiḵ", "traducao_palavra": "teus pilotos" },
        { "hebraico": "יִרְעֲשׁוּ", "transliteral": "yir-ʿă-šû", "traducao_palavra": "tremerão" },
        { "hebraico": "מִגְרְשֹׁות", "transliteral": "miḡ-rə-šôṯ", "traducao_palavra": "os campos/subúrbios" }
      ]
    },
    "29": {
      "traducao_completa": "E descerão dos seus navios todos os que pegam o remo, os marinheiros e todos os pilotos do mar; assentar-se-ão em terra,",
      "palavras": [
        { "hebraico": "וְיָרְדוּ", "transliteral": "wə-yā-rə-ḏû", "traducao_palavra": "e descerão" },
        { "hebraico": "מֵאֳנִיֹּותָם", "transliteral": "mē-ʾŏ-nî-yô-ṯām", "traducao_palavra": "dos seus navios" },
        { "hebraico": "כֹּל", "transliteral": "kōl", "traducao_palavra": "todos" },
        { "hebraico": "תֹּפְשֵׂי", "transliteral": "tō-p̄ə-śê", "traducao_palavra": "os que pegam" },
        { "hebraico": "מָשֹׁוט", "transliteral": "mā-šôṭ", "traducao_palavra": "o remo" },
        { "hebraico": "מַלָּחִים", "transliteral": "mal-lā-ḥîm", "traducao_palavra": "os marinheiros" },
        { "hebraico": "כֹּל", "transliteral": "kōl", "traducao_palavra": "todos" },
        { "hebraico": "חֹבְלֵי", "transliteral": "ḥō-bə-lê", "traducao_palavra": "os pilotos de" },
        { "hebraico": "הַיָּם", "transliteral": "hay-yām", "traducao_palavra": "o mar" },
        { "hebraico": "אֶל", "transliteral": "ʾel", "traducao_palavra": "sobre" },
        { "hebraico": "הָאָרֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "יַעֲמֹדוּ", "transliteral": "ya-ʿă-mō-ḏû", "traducao_palavra": "ficarão/assentar-se-ão" }
      ]
    },
    "30": {
      "traducao_completa": "E farão ouvir a sua voz por ti, e clamarão amargamente, e lançarão pó sobre as suas cabeças, e na cinza se revolverão.",
      "palavras": [
        { "hebraico": "וְהִשְׁמִיעוּ", "transliteral": "wə-hiš-mî-ʿû", "traducao_palavra": "e farão ouvir" },
        { "hebraico": "עָלַיִךְ", "transliteral": "ʿā-la-yiḵ", "traducao_palavra": "por ti" },
        { "hebraico": "קֹולָם", "transliteral": "qô-lām", "traducao_palavra": "sua voz" },
        { "hebraico": "וְיִזְעֲקוּ", "transliteral": "wə-yiz-ʿă-qû", "traducao_palavra": "e clamarão" },
        { "hebraico": "מָרִיר", "transliteral": "mā-rîr", "traducao_palavra": "amargamente" },
        { "hebraico": "וְיַעֲלוּ", "transliteral": "wə-ya-ʿă-lû", "traducao_palavra": "e lançarão" },
        { "hebraico": "עָפָר", "transliteral": "ʿā-p̄ār", "traducao_palavra": "pó" },
        { "hebraico": "עַל־רֹאשָׁם", "transliteral": "ʿal-rō-šām", "traducao_palavra": "sobre as suas cabeças" },
        { "hebraico": "וּבְאֵפֶר", "transliteral": "ū-ḇə-ʾē-p̄er", "traducao_palavra": "e na cinza" },
        { "hebraico": "יִתְפַּלָּשׁוּ", "transliteral": "yiṯ-pal-lā-šû", "traducao_palavra": "se revolverão" }
      ]
    },
    "31": {
      "traducao_completa": "E por ti raparão a cabeça, e se cingirão de sacos, e chorarão por ti com amargura de alma, com amargo pranto.",
      "palavras": [
        { "hebraico": "וְקִרְחu", "transliteral": "wə-qir-ḥû", "traducao_palavra": "e raparão" },
        { "hebraico": "אֵלַיִךְ", "transliteral": "ʾē-la-yiḵ", "traducao_palavra": "por ti" },
        { "hebraico": "קָרְחָה", "transliteral": "qār-ḥā", "traducao_palavra": "calvície/cabeça rapada" },
        { "hebraico": "וְחָגְרוּ", "transliteral": "wə-ḥā-ḡə-rû", "traducao_palavra": "e se cingirão" },
        { "hebraico": "שַׂקִּים", "transliteral": "śaq-qîm", "traducao_palavra": "de sacos" },
        { "hebraico": "וּבָכוּ", "transliteral": "ū-ḇā-ḵû", "traducao_palavra": "e chorarão" },
        { "hebraico": "אֵלַיִךְ", "transliteral": "ʾē-la-yiḵ", "traducao_palavra": "por ti" },
        { "hebraico": "בְּמַר־נֶפֶשׁ", "transliteral": "bə-mar-ne-p̄eš", "traducao_palavra": "com amargura de alma" },
        { "hebraico": "מִסְפֵּד", "transliteral": "mis-pēḏ", "traducao_palavra": "com pranto" },
        { "hebraico": "מָר", "transliteral": "mār", "traducao_palavra": "amargo" }
      ]
    },
    "32": {
      "traducao_completa": "E no seu pranto levantarão por ti uma lamentação, e te lamentarão, dizendo: Quem é como Tiro, como a que foi destruída no meio do mar?",
      "palavras": [
        { "hebraico": "וְנָשְׂאוּ", "transliteral": "wə-nā-śə-ʾû", "traducao_palavra": "e levantarão" },
        { "hebraico": "אֵלַיִךְ", "transliteral": "ʾē-la-yiḵ", "traducao_palavra": "por ti" },
        { "hebraico": "בִּנְהִיהֶם", "transliteral": "bin-hî-he-hem", "traducao_palavra": "no seu pranto" },
        { "hebraico": "קִינָה", "transliteral": "qî-nā", "traducao_palavra": "uma lamentação" },
        { "hebraico": "וְקֹונְנוּ", "transliteral": "wə-qô-nə-nû", "traducao_palavra": "e te lamentarão" },
        { "hebraico": "עָלָיִךְ", "traducao_palavra": "sobre ti", "transliteral_alt": "ʿā-la-yiḵ" },
        { "hebraico": "מִי", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "כְּצֹור", "transliteral": "kə-ṣôr", "traducao_palavra": "é como Tiro" },
        { "hebraico": "כָּדֻמָּה", "transliteral": "kā-ḏum-mā", "traducao_palavra": "como a que foi silenciada/destruída" },
        { "hebraico": "בְּתֹוךְ", "transliteral": "bə-ṯôḵ", "traducao_palavra": "no meio de" },
        { "hebraico": "הַיָּם", "transliteral": "hay-yām", "traducao_palavra": "o mar" }
      ]
    },
    "33": {
      "traducao_completa": "Quando as tuas mercadorias saíam dos mares, fartavas a muitos povos; com a multidão das tuas riquezas e das tuas mercadorias enriqueceste os reis da terra.",
      "palavras": [
        { "hebraico": "בְּצֵאת", "transliteral": "bə-ṣêṯ", "traducao_palavra": "ao saírem" },
        { "hebraico": "עִזְבֹונַיִךְ", "transliteral": "ʿiz-bō-na-yiḵ", "traducao_palavra": "tuas mercadorias" },
        { "hebraico": "מִיַּמִּים", "transliteral": "miy-yam-mîm", "traducao_palavra": "dos mares" },
        { "hebraico": "הִשְׂבַּעְתְּ", "transliteral": "hiś-baṯ-tə", "traducao_palavra": "fartavas" },
        { "hebraico": "עַמִּים", "transliteral": "ʿam-mîm", "traducao_palavra": "a muitos povos" },
        { "hebraico": "רַבִּים", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
        { "hebraico": "רֹב", "transliteral": "rōḇ", "traducao_palavra": "pela multidão de" },
        { "hebraico": "חֹולֶךְ", "transliteral": "ḥô-le-ḵā", "traducao_palavra": "teus bens" },
        { "hebraico": "וּמַעֲרָבָיִךְ", "transliteral": "ū-ma-ʿă-rā-ḇā-yiḵ", "traducao_palavra": "e tuas mercadorias" },
        { "hebraico": "הֶעֱשַׁרְתְּ", "transliteral": "he-ʿĕ-šar-tə", "traducao_palavra": "enriqueceste" },
        { "hebraico": "מַלְכֵי", "transliteral": "mal-ḵê", "traducao_palavra": "os reis de" },
        { "hebraico": "אָרֶץ", "transliteral": "ʾā-reṣ", "traducao_palavra": "a terra" }
      ]
    },
    "34": {
      "traducao_completa": "Agora que estás quebrantada pelos mares, nas profundezas das águas, a tua mercadoria e toda a tua multidão caíram no meio de ti.",
      "palavras": [
        { "hebraico": "עֵת", "transliteral": "ʿêṯ", "traducao_palavra": "agora que" },
        { "hebraico": "נִשְׁבַּרְתְּ", "transliteral": "niš-bar-tə", "traducao_palavra": "estás quebrantada" },
        { "hebraico": "مִיַּמִּים", "transliteral": "miy-yam-mîm", "traducao_palavra": "pelos mares" },
        { "hebraico": "בְּמַעֲמַקֵּי", "transliteral": "bə-ma-ʿă-maq-qê", "traducao_palavra": "nas profundezas de" },
        { "hebraico": "מַיִם", "transliteral": "ma-yim", "traducao_palavra": "as águas" },
        { "hebraico": "מַעֲרָבֵךְ", "transliteral": "ma-ʿă-rā-ḇēḵ", "traducao_palavra": "tua mercadoria" },
        { "hebraico": "וְכָל־קְהָלֵךְ", "transliteral": "wə-ḵāl-qə-hā-lēḵ", "traducao_palavra": "e toda a tua multidão" },
        { "hebraico": "בְּתֹוכֵךְ", "transliteral": "bə-ṯô-ḵêḵ", "traducao_palavra": "no meio de ti" },
        { "hebraico": "נָפָלוּ", "transliteral": "nā-p̄ā-lû", "traducao_palavra": "caíram" }
      ]
    },
    "35": {
      "traducao_completa": "Todos os moradores das ilhas pasmarão por tua causa, e os seus reis tremerão de medo, o seu rosto se transtornará.",
      "palavras": [
        { "hebraico": "כֹּל", "transliteral": "kōl", "traducao_palavra": "todos" },
        { "hebraico": "יֹשְׁבֵי", "transliteral": "yô-šə-ḇê", "traducao_palavra": "os moradores de" },
        { "hebraico": "הָאִיִּים", "transliteral": "hā-ʾiy-yîm", "traducao_palavra": "as ilhas" },
        { "hebraico": "שָׁמְמוּ", "transliteral": "šā-mə-mû", "traducao_palavra": "pasmarão" },
        { "hebraico": "עָלָיִךְ", "transliteral": "ʿā-la-yiḵ", "traducao_palavra": "por tua causa" },
        { "hebraico": "וּמַלְכֵיהֶם", "transliteral": "ū-mal-ḵê-hem", "traducao_palavra": "e os reis deles" },
        { "hebraico": "שָׂעֲרוּ", "transliteral": "śā-ʿă-rû", "traducao_palavra": "tremerão / sobressaltarão" },
        { "hebraico": "פָּנִים", "transliteral": "pā-nîm", "traducao_palavra": "com rosto" },
        { "hebraico": "رַעַם", "transliteral": "ra-ʿam", "traducao_palavra": "transtornado/agitado" }
      ]
    },
    "36": {
      "traducao_completa": "Os mercadores dos povos assobiarão por tua causa; serás um espanto, e nunca mais serás.",
      "palavras": [
        { "hebraico": "סֹחֲרִים", "transliteral": "śō-ḥă-rîm", "traducao_palavra": "os mercadores de" },
        { "hebraico": "בָּעַמִּים", "transliteral": "bā-ʿam-mîm", "traducao_palavra": "povos" },
        { "hebraico": "שָׁרְקוּ", "transliteral": "šā-rə-qû", "traducao_palavra": "assobiarão" },
        { "hebraico": "עָלָיִךְ", "transliteral": "ʿā-la-yiḵ", "traducao_palavra": "por tua causa" },
        { "hebraico": "בַּלָּהֹות", "transliteral": "bal-lā-hôṯ", "traducao_palavra": "em terrores" },
        { "hebraico": "הָיִית", "transliteral": "hā-yî-ṯ", "traducao_palavra": "serás" },
        { "hebraico": "וְעַד", "transliteral": "wə-ʿad", "traducao_palavra": "e até" },
        { "hebraico": "עֹולָם", "transliteral": "ʿô-lām", "traducao_palavra": "o eterno" },
        { "hebraico": "לֹא", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תִּהְיֶי", "transliteral": "tih-ye-nā", "traducao_palavra": "serás mais" }
      ]
    }
  }
}