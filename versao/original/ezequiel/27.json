        { "hebraico": "הָיu", "transliteral": "hā-yû", "traducao_palavra": "eram" },
        { "hebraico": "שַׁטָּיִךְ", "transliteral": "šat-ṭā-yiḵ", "traducao_palavra": "teus remadores" },
        { "hebraico": "חֲכָמָיִךְ", "transliteral": "ḥă-ḵā-mā-yiḵ", "traducao_palavra": "teus sábios" },
