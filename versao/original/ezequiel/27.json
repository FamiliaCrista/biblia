        { "hebraico": "הֵ֥מָּה", "transliteral": "hêm-mā", "traducao_palavra": "eles" },
        { "hebraico": "נָתְנוּ", "transliteral": "nā-ṯə-nû", "traducao_palavra": "deram" },
        { "hebraico": "הֲדָרֵךְ", "transliteral": "hă-ḏā-rēḵ", "traducao_palavra": "o teu esplendor" }
