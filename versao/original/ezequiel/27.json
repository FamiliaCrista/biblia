        { "hebraico": "סֹחַרְתֵּךְ", "transliteral": "śō-ḥar-tēḵ", "traducao_palavra": "negociava contigo" },
        { "hebraico": "מֵרֹב", "transliteral": "mê-rōḇ", "traducao_palavra": "por causa da abundância de" },
        { "hebraico": "כָּל־הֹון", "transliteral": "kāl-hôn", "traducao_palavra": "toda riqueza" },
        { "hebraico": "בְּכֶסֶף", "transliteral": "bə-ḵe-sep̄", "traducao_palavra": "com prata" },
        { "hebraico": "בַּרְזֶל", "transliteral": "bar-zel", "traducao_palavra": "ferro" },
