        { "hebraico": "לְצֹור", "transliteral": "lə-ṣôr", "traducao_palavra": "a Tiro" },
        { "hebraico": "הַיֹּשֶׁבֶת", "transliteral": "hay-yō-še-ḇeṯ", "traducao_palavra": "que habita" },
