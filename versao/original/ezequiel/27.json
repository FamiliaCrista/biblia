        { "hebraico": "בְּמִגְדְּלֹותַיִךְ", "transliteral": "bə-miḡ-də-lō-ṯā-yiḵ", "traducao_palavra": "nas tuas torres" },
        { "hebraico": "שִׁלְטֵיהֶם", "transliteral": "šil-ṭê-hem", "traducao_palavra": "seus escudos" },
