    "11": {
      "traducao_completa": "E dirás: Subirei contra a terra das aldeias não muradas; irei aos que estão tranquilos, que habitam em segurança, habitando todos eles sem muros, e não têm ferrolhos nem portas;",
      "palavras": [
        { "hebraico": "וְאָמַרְתָּ֗", "transliteral": "wə-ʾā-mar-tā", "traducao_palavra": "e dirás" },
        { "hebraico": "אֶֽעֱלֶה֙", "transliteral": "ʾe-ʿĕ-leh", "traducao_palavra": "subirei" },
