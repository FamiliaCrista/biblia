    "8": {
      "traducao_completa": "Depois de muitos dias serás visitado; no fim dos anos virás à terra que se restaurou da espada, que foi ajuntada de muitos povos, sobre os montes de Israel, que sempre tinham estado desolados; mas ela foi tirada dos povos, e todos eles habitarão em segurança.",
      "palavras": [
        { "hebraico": "מִיָּמִ֣ים", "transliteral": "mî-yā-mîm", "traducao_palavra": "depois de dias" },
        { "hebraico": "רַבִּים֮", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
        { "hebraico": "תִּפָּקֵד֒", "transliteral": "tip-pā-qêḏ", "traducao_palavra": "serás visitado" },
