        { "hebraico": "כֶּעָנָ֛ן", "transliteral": "ke-ʿā-nān", "traducao_palavra": "como uma nuvem" },
        { "hebraico": "לְכַסֹּ֥ות", "transliteral": "lə-ḵas-sôṯ", "traducao_palavra": "para cobrir" },
