        { "hebraico": "מֵעַמִּ֣ים", "transliteral": "mê-ʿam-mîm", "traducao_palavra": "de povos" },
        { "hebraico": "רַבִּ֔ים", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
