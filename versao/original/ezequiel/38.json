        { "hebraico": "וְעַמִּ֥ים", "transliteral": "wə-ʿam-mîm", "traducao_palavra": "e povos" },
        { "hebraico": "רַבִּ֖ים", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
        { "hebraico": "אֹותָֽךְ׃", "transliteral": "ʾô-ṯāḵ", "traducao_palavra": "contigo" }
