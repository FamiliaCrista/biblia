        { "hebraico": "גֹּ֚מֶר", "transliteral": "gō-mer", "traducao_palavra": "Gomer" },
        { "hebraico": "וְכָל־אֲגַפֶּ֔יהָ", "transliteral": "wə-ḵāl-ʾă-ḡap-pe-hā", "traducao_palavra": "e todas as suas tropas" },
