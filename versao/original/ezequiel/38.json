        { "hebraico": "פָּנֶ֙יךָ֙", "transliteral": "pā-ne-ḵā", "traducao_palavra": "o teu rosto" },
        { "hebraico": "אֶל־גֹּ֔וג", "transliteral": "ʾel-gôḡ", "traducao_palavra": "contra Gogue" },
