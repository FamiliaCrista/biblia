        { "hebraico": "וְהָכֵ֖ן", "transliteral": "wə-hā-ḵên", "traducao_palavra": "e apronta" },
        { "hebraico": "לְךָ֑", "transliteral": "lə-ḵā", "traducao_palavra": "para ti" },
