        { "hebraico": "כִּֽי־הִנֵּ֤ה", "transliteral": "kî-hin-nêh", "traducao_palavra": "porque eis que" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מְצַוֶּ֔ה", "transliteral": "mə-ṣaw-weh", "traducao_palavra": "está ordenando" },
        { "hebraico": "וְהִכָּ֛ה", "transliteral": "wə-hik-kā", "traducao_palavra": "e ferirá" },
        { "hebraico": "הַבַּ֥יִת", "transliteral": "hab-ba-yiṯ", "traducao_palavra": "a casa" },
