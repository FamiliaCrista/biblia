        { "hebraico": "כַלְנֵה֙", "transliteral": "ḵal-nêh", "traducao_palavra": "Calné" },
        { "hebraico": "וּרְא֔וּ", "transliteral": "ū-rə-ʾû", "traducao_palavra": "e vede" },
        { "hebraico": "וּלְכ֥וּ", "transliteral": "ū-lə-ḵû", "traducao_palavra": "e ide" },
        { "hebraico": "מִשָּׁ֖ם", "transliteral": "miš-šām", "traducao_palavra": "dali a" },
