        { "hebraico": "הַגֹּויִ֔ם", "transliteral": "hag-gô-yim", "traducao_palavra": "as nações" },
        { "hebraico": "וּבָ֥אוּ", "transliteral": "ū-ḇā-ʾû", "traducao_palavra": "e a quem vem" },
        { "hebraico": "לָהֶ֖ם", "transliteral": "lā-hem", "traducao_palavra": "a eles" },
        { "hebraico": "בֵּ֥ית", "transliteral": "bêṯ", "traducao_palavra": "a casa de" },
