        { "hebraico": "מִגְּבֻלְכֶֽם׃", "transliteral": "mig-gə-ḇul-ḵem", "traducao_palavra": "do que o vosso território?" }
      ]
    },
    "3": {
      "traducao_completa": "Vós que afastais o dia mau e fazeis aproximar o trono da violência;",
      "palavras": [
        { "hebraico": "הַמְנַדִּ֖ים", "transliteral": "ham-nad-dîm", "traducao_palavra": "vós que repelis/afastais" },
        { "hebraico": "לְיֹ֣ום", "transliteral": "lə-yôm", "traducao_palavra": "o dia" },
        { "hebraico": "רָ֑ע", "transliteral": "rāʿ", "traducao_palavra": "mau" },
        { "hebraico": "וַתַּגִּישׁ֖וּן", "transliteral": "wat-tag-gî-šūn", "traducao_palavra": "e fazeis aproximar" },
        { "hebraico": "שֶׁ֥בֶת", "transliteral": "še-ḇeṯ", "traducao_palavra": "o assento/trono de" },
