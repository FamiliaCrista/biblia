        { "hebraico": "וּנְשָׂאֹ֣ו", "transliteral": "ū-nə-śā-ʾô", "traducao_palavra": "e levantará o cadáver" },
        { "hebraico": "דֹּודֹ֗ו", "transliteral": "dô-ḏô", "traducao_palavra": "o seu parente" },
        { "hebraico": "וּמְסָֽרְפֹו֙", "transliteral": "ū-mə-sā-rə-p̄ô", "traducao_palavra": "e o que o queima" },
        { "hebraico": "לְהֹוצִ֥יא", "transliteral": "lə-hô-ṣî", "traducao_palavra": "para retirar" },
        { "hebraico": "עֲצָמִ֖ים", "transliteral": "ʿă-ṣā-mîm", "traducao_palavra": "os ossos" },
        { "hebraico": "מִן־הַבַּ֑יִת", "transliteral": "min-hab-ba-yiṯ", "traducao_palavra": "da casa" },
        { "hebraico": "וְאָמַ֞ר", "transliteral": "wə-ʾā-mar", "traducao_palavra": "e dirá" },
        { "hebraico": "לַאֲשֶׁ֨ר", "transliteral": "la-ʾă-šer", "traducao_palavra": "ao que estiver" },
        { "hebraico": "בְּיַרְכְּתֵ֥י", "transliteral": "bə-yar-kə-ṯê", "traducao_palavra": "nos recessos de" },
        { "hebraico": "הַבַּ֛יִת", "transliteral": "hab-ba-yiṯ", "traducao_palavra": "a casa:" },
        { "hebraico": "הַעֹ֥וד", "transliteral": "ha-ʿôḏ", "traducao_palavra": "há ainda alguém" },
        { "hebraico": "עִמָּ֖ךְ", "transliteral": "ʿim-māḵ", "traducao_palavra": "contigo?" },
        { "hebraico": "וְאָמַ֣ר", "transliteral": "wə-ʾā-mar", "traducao_palavra": "e ele responderá:" },
        { "hebraico": "אָ֑פֶס", "transliteral": "ʾā-p̄es", "traducao_palavra": "nenhum!" },
        { "hebraico": "וְאָמַ֣ר", "transliteral": "wə-ʾā-mar", "traducao_palavra": "e dirá:" },
        { "hebraico": "הָ֔ס", "transliteral": "hās", "traducao_palavra": "silêncio/cala-te!" },
        { "hebraico": "כִּ֛י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não [convém]" },
        { "hebraico": "לְהַזְכִּ֖יר", "transliteral": "lə-haz-kîr", "traducao_palavra": "mencionar" },
        { "hebraico": "בְּשֵׁ֥ם", "transliteral": "bə-šêm", "traducao_palavra": "o nome de" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "11": {
