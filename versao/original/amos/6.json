        { "hebraico": "מִן־הַמַּמְלָכֹ֣ות", "transliteral": "min-ham-mam-lā-ḵôṯ", "traducao_palavra": "do que os reinos" },
        { "hebraico": "הָאֵ֔לֶּה", "transliteral": "hā-ʾêl-leh", "traducao_palavra": "estes?" },
