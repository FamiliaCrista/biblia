        { "hebraico": "אֲדֹנָ֨י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִ֜ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּנַפְשֹׁ֗ו", "transliteral": "bə-nap̄-šô", "traducao_palavra": "por si mesmo" },
        { "hebraico": "נְאֻם־יְהוָה֙", "transliteral": "nə-ʾum-YHWH", "traducao_palavra": "declaração de YHWH" },
        { "hebraico": "אֱלֹהֵ֣י", "transliteral": "ʾĕ-lō-hê", "traducao_palavra": "o Deus de" },
        { "hebraico": "צְבָאֹ֔ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "os Exércitos:" },
        { "hebraico": "מְתָאֵ֥ב", "transliteral": "mə-ṯā-ʾêḇ", "traducao_palavra": "abomino" },
        { "hebraico": "אָנֹכִ֛י", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "eu" },
        { "hebraico": "אֶת־גְּאֹ֥ון", "transliteral": "ʾeṯ-gə-ʾôn", "traducao_palavra": "a soberba de" },
        { "hebraico": "יַעֲקֹ֖ב", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" },
        { "hebraico": "וְאַרְמְנֹתָ֣יו", "transliteral": "wə-ʾar-mə-nō-ṯāyw", "traducao_palavra": "e os seus palácios" },
        { "hebraico": "שָׂנֵ֑אתִי", "transliteral": "śā-nê-ṯî", "traducao_palavra": "odeio" },
