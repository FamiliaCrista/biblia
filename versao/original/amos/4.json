        { "hebraico": "לִפְשֹׁ֑עַ", "transliteral": "lip̄-šō-aʿ", "traducao_palavra": "as transgressões" },
        { "hebraico": "וְהָבִ֤יאוּ", "transliteral": "wə-hā-ḇî-ʾû", "traducao_palavra": "e trazei" },
        { "hebraico": "לַבֹּ֙קֶר֙", "transliteral": "lab-bō-qer", "traducao_palavra": "a cada manhã" },
