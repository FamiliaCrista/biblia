        { "hebraico": "וְנִשְׁתֶּֽה׃", "transliteral": "wə-niš-teh", "traducao_palavra": "e bebamos" }
      ]
    },
    "2": {
      "traducao_completa": "Jurou o Senhor YHWH, pela sua santidade, que dias estão para vir sobre vós, em que vos levarão com ganchos, e às vossas restantes com anzóis de pesca.",
      "palavras": [
