        { "hebraico": "פָּרֹ֤ות", "transliteral": "pā-rôṯ", "traducao_palavra": "ó vacas de" },
        { "hebraico": "הַבָּשָׁן֙", "transliteral": "hab-bā-šān", "traducao_palavra": "Basã" },
