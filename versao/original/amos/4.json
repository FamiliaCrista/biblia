        { "hebraico": "אֲדֹנָ֥י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִה֮", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּקָדְשֹׁו֒", "transliteral": "bə-qāḏ-šô", "traducao_palavra": "por sua santidade" },
