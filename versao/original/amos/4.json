        { "hebraico": "הָרֹצְצֹ֖ות", "transliteral": "hā-rō-ṣə-ṣôṯ", "traducao_palavra": "que esmagais" },
        { "hebraico": "אֶבְיֹונִ֑ים", "transliteral": "ʾeḇ-yô-nîm", "traducao_palavra": "os necessitados" },
        { "hebraico": "הָאֹמְרֹ֥ת", "transliteral": "hā-ʾō-mə-rōṯ", "traducao_palavra": "que dizeis" },
        { "hebraico": "לַאֲדֹֽנֵיהֶ֖ם", "transliteral": "la-ʾă-ḏō-nê-hem", "traducao_palavra": "a vossos senhores" },
