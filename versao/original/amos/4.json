      ]
    },
    "3": {
      "traducao_completa": "E saireis pelas brechas, cada uma em frente de si, e sereis lançadas para Harmom, diz YHWH.",
      "palavras": [
        { "hebraico": "וּפְרָצִ֥ים", "transliteral": "ū-p̄ə-rā-ṣîm", "traducao_palavra": "e pelas brechas" },
        { "hebraico": "תֵּצֶ֖אנָה", "transliteral": "tê-ṣe-nā", "traducao_palavra": "saireis" },
        { "hebraico": "אִשָּׁ֣ה", "transliteral": "ʾiš-šā", "traducao_palavra": "cada mulher" },
        { "hebraico": "נֶגְדָּ֑הּ", "transliteral": "neḡ-dāh", "traducao_palavra": "em frente de si" },
