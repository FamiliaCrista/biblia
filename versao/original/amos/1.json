        { "hebraico": "יִשְׂרָאֵ֔ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "שְׁנָתַ֖יִם", "transliteral": "šə-nā-ṯa-yim", "traducao_palavra": "dois anos" },
