        { "hebraico": "עַל־שְׁלֹשָׁה֙", "transliteral": "ʿal-šə-lō-šā", "traducao_palavra": "por três" },
        { "hebraico": "פִּשְׁעֵ֣י", "transliteral": "piš-ʿê", "traducao_palavra": "transgressões de" },
