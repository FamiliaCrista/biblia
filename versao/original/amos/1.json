        { "hebraico": "עָמֹ֔וס", "transliteral": "ʿā-môs", "traducao_palavra": "Amós" },
        { "hebraico": "אֲשֶׁר־הָיָ֥ה", "transliteral": "ʾă-šer-hā-yā", "traducao_palavra": "que estava" },
