  "versiculos": {
    "1": {
      "traducao_completa": "As palavras de Amós, que estava entre os pastores de Tecoa, as quais ele viu a respeito de Israel, nos dias de Uzias, rei de Judá, e nos dias de Jeroboão, filho de Joás, rei de Israel, dois anos antes do terremoto.",
      "palavras": [
