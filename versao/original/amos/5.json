        { "hebraico": "בְּנִיתֶ֖ם", "transliteral": "bə-nî-ṯem", "traducao_palavra": "edificastes" },
        { "hebraico": "וְלֹא־תֵ֣שְׁבוּ", "transliteral": "wə-lō-ṯê-šə-ḇû", "traducao_palavra": "mas não habitareis" },
        { "hebraico": "בָ֑ם", "transliteral": "ḇām", "traducao_palavra": "nelas" },
        { "hebraico": "כַּרְמֵי־חֶ֣מֶד", "transliteral": "kar-mê-ḥe-meḏ", "traducao_palavra": "vinhas aprazíveis" },
