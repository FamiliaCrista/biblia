        { "hebraico": "וּמִסְפֵּ֖ד", "transliteral": "ū-mis-pêḏ", "traducao_palavra": "e para o pranto" },
        { "hebraico": "אֶל־יֹודְעֵ֥י", "transliteral": "ʾel-yô-ḏə-ʿê", "traducao_palavra": "os peritos em" },
        { "hebraico": "נֶֽהִי׃", "transliteral": "ne-hî", "traducao_palavra": "lamentações" }
      ]
    },
    "17": {
      "traducao_completa": "E em todas as vinhas haverá pranto; porque passarei pelo meio de ti, diz YHWH.",
      "palavras": [
        { "hebraico": "וּבְכָל־כְּרָמִ֖ים", "transliteral": "ū-ḇə-ḵāl-kə-rā-mîm", "traducao_palavra": "e em todas as vinhas" },
        { "hebraico": "מִסְפֵּ֑ד", "transliteral": "mis-pêḏ", "traducao_palavra": "haverá pranto" },
        { "hebraico": "כִּֽי־אֶעֱבֹ֥ר", "transliteral": "kî-ʾe-ʿĕ-ḇōr", "traducao_palavra": "porque passarei" },
        { "hebraico": "בְּקִרְבְּךָ֖", "transliteral": "bə-qir-bə-ḵā", "traducao_palavra": "pelo meio de ti" },
