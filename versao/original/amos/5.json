        { "hebraico": "וְדֹבֵ֥ר", "transliteral": "wə-ḏō-ḇêr", "traducao_palavra": "e ao que fala" },
        { "hebraico": "תָּמִ֖ים", "transliteral": "tā-mîm", "traducao_palavra": "com integridade/retidão" },
