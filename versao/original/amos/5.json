        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH!" },
        { "hebraico": "לָמָּה־זֶּ֥ה", "transliteral": "lām-mā-zzeh", "traducao_palavra": "para que servirá" },
        { "hebraico": "לָכֶ֛ם", "transliteral": "lā-ḵem", "traducao_palavra": "a vós" },
        { "hebraico": "יֹ֥ום", "transliteral": "yôm", "traducao_palavra": "o dia de" },
