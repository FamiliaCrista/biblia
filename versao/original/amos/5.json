    "5": {
      "traducao_completa": "Mas não busqueis a Bete-El, nem entreis em Gilgal, nem passeis a Berseba; porque Gilgal certamente irá ao cativeiro, e Bete-El será desfeita em nada.",
      "palavras": [
        { "hebraico": "וְאַֽל־תִּדְרְשׁוּ֙", "transliteral": "wə-ʾal-tid-rə-šû", "traducao_palavra": "e não busqueis" },
