{
  "livro": "Amós - עָמוֹס - ʿĀmôs",
  "capítulo": 5,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ouvi esta palavra que levanto como uma lamentação sobre vós, ó casa de Israel.",
      "palavras": [
