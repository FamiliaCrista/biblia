    "19": {
      "traducao_completa": "como se um homem fugisse de diante do leão, e se encontrasse com ele o urso; ou como se, entrando numa casa, encostasse a mão à parede, e o mordesse uma cobra.",
      "palavras": [
        { "hebraico": "כַּאֲשֶׁ֨ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "como quando" },
        { "hebraico": "יָנ֥וּס", "transliteral": "yā-nūs", "traducao_palavra": "foge" },
        { "hebraico": "אִישׁ֙", "transliteral": "ʾîš", "traducao_palavra": "um homem" },
        { "hebraico": "מִפְּנֵ֣י", "transliteral": "mip-pə-nê", "traducao_palavra": "de diante de" },
        { "hebraico": "הָאֲרִ֔י", "transliteral": "hā-ʾă-rî", "traducao_palavra": "o leão" },
