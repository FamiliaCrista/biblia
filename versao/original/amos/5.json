        { "hebraico": "וְיִגַּ֥ל", "transliteral": "wə-yig-gal", "traducao_palavra": "corra/flua porém" },
        { "hebraico": "כַּמַּ֖יִם", "transliteral": "kam-ma-yim", "traducao_palavra": "como as águas" },
        { "hebraico": "מִשְׁפָּ֑ט", "transliteral": "miš-pāṭ", "traducao_palavra": "o juízo" },
        { "hebraico": "וּצְדָקָ֖ה", "transliteral": "ū-ṣə-ḏā-qā", "traducao_palavra": "e a justiça" },
        { "hebraico": "כְּנַ֥חַל", "transliteral": "kə-na-ḥal", "traducao_palavra": "como ribeiro" },
        { "hebraico": "אֵיתָֽן׃", "transliteral": "ʾê-ṯān", "traducao_palavra": "perene/incessante" }
      ]
    },
    "25": {
      "traducao_completa": "Oferecestes-me vós sacrifícios e ofertas de manjares no deserto por quarenta anos, ó casa de Israel?",
