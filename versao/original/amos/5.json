        { "hebraico": "לְבֵֽית־אֵֽל׃", "transliteral": "lə-ḇêṯ-ʾêl", "traducao_palavra": "em Bete-El" }
      ]
    },
    "7": {
      "traducao_completa": "Vós que converteis o juízo em absinto, e deitais por terra a justiça,",
      "palavras": [
        { "hebraico": "הַהֹפְכִ֥ים", "transliteral": "ha-hō-p̄ə-ḵîm", "traducao_palavra": "vós que converteis" },
        { "hebraico": "לְלַעֲנָ֖ה", "transliteral": "lə-la-ʿă-nā", "traducao_palavra": "em absinto" },
        { "hebraico": "מִשְׁפָּ֑ט", "transliteral": "miš-pāṭ", "traducao_palavra": "o juízo" },
        { "hebraico": "וּצְדָקָ֖ה", "transliteral": "ū-ṣə-ḏā-qā", "traducao_palavra": "e a justiça" },
