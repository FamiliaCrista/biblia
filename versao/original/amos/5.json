      ]
    },
    "4": {
      "traducao_completa": "Porque assim diz YHWH à casa de Israel: Buscai-me, e vivei.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "כֹ֥ה", "transliteral": "ḵōh", "traducao_palavra": "assim" },
        { "hebraico": "אָמַ֛ר", "transliteral": "ʾā-mar", "traducao_palavra": "diz" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "לְבֵ֣ית", "transliteral": "lə-ḇêṯ", "traducao_palavra": "à casa de" },
        { "hebraico": "יִשְׂרָאֵ֑ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel:" },
        { "hebraico": "דִּרְשׁ֥וּנִי", "transliteral": "dir-šū-nî", "traducao_palavra": "buscai-me" },
        { "hebraico": "וִֽחְיֽוּ׃", "transliteral": "wi-ḥə-yû", "traducao_palavra": "e vivei" }
