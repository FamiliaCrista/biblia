        { "hebraico": "אֶת־הַדָּבָ֣ר", "transliteral": "ʾeṯ-had-dā-ḇār", "traducao_palavra": "a palavra" },
        { "hebraico": "הַזֶּ֗ה", "transliteral": "haz-zeh", "traducao_palavra": "esta" },
        { "hebraico": "אֲשֶׁ֨ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "אָנֹכִ֜י", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "eu" },
        { "hebraico": "נֹשֵׂ֧א", "transliteral": "nō-śê", "traducao_palavra": "levanto/profiro" },
        { "hebraico": "עֲלֵיכֶ֛ם", "transliteral": "ʿă-lê-ḵem", "traducao_palavra": "sobre vós" },
