        { "hebraico": "הַבַּ֔יִת", "transliteral": "hab-ba-yiṯ", "traducao_palavra": "em casa" },
        { "hebraico": "וְסָמַ֤ךְ", "transliteral": "wə-sā-maḵ", "traducao_palavra": "encosta" },
        { "hebraico": "יָדֹו֙", "transliteral": "yā-ḏô", "traducao_palavra": "a sua mão" },
        { "hebraico": "עַל־הַקִּ֔יר", "transliteral": "ʿal-haq-qîr", "traducao_palavra": "na parede" },
        { "hebraico": "וּנְשָׁכֹ֖ו", "transliteral": "ū-nə-šā-ḵô", "traducao_palavra": "e o morde" },
        { "hebraico": "הַנָּחָֽשׁ׃", "transliteral": "han-nā-ḥāš", "traducao_palavra": "uma serpente" }
