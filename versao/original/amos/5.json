        { "hebraico": "כִימָ֜ה", "transliteral": "ḵî-mā", "traducao_palavra": "as Plêiades" },
        { "hebraico": "וּכְסִ֗יל", "transliteral": "ū-ḵə-sîl", "traducao_palavra": "e o Órion" },
