    "12": {
      "traducao_completa": "Porque sei que são muitas as vossas transgressões e enormes os vossos pecados; afligis o justo, tomais suborno e rejeitais os necessitados na porta.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "יָדַ֙עְתִּי֙", "transliteral": "yā-ḏaʿ-tî", "traducao_palavra": "eu sei que" },
        { "hebraico": "רַבִּ֣ים", "transliteral": "rab-bîm", "traducao_palavra": "são muitas" },
        { "hebraico": "פִּשְׁעֵיכֶ֔ם", "transliteral": "piš-ʿê-ḵem", "traducao_palavra": "as vossas transgressões" },
