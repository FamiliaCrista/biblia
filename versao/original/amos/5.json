        { "hebraico": "בֵּ֥ית", "transliteral": "bêṯ", "traducao_palavra": "ó casa de" },
        { "hebraico": "יִשְׂרָאֵֽל׃", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" }
      ]
    },
    "2": {
      "traducao_completa": "A virgem de Israel caiu, e não mais se levantará; jaz estirada na sua terra, não há quem a levante.",
      "palavras": [
        { "hebraico": "נָפְלָה֙", "transliteral": "nā-p̄ə-lā", "traducao_palavra": "caiu" },
        { "hebraico": "לֹֽא־תֹוסִ֣יף", "transliteral": "lō-ṯô-sîp̄", "traducao_palavra": "não tornará a" },
        { "hebraico": "ק֔וּם", "transliteral": "qūm", "traducao_palavra": "levantar-se" },
        { "hebraico": "בְּתוּלַ֖ת", "transliteral": "bə-ṯū-laṯ", "traducao_palavra": "a virgem de" },
        { "hebraico": "יִשְׂרָאֵ֑ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "נִטְּשָׁ֥ה", "transliteral": "niṭ-ṭə-šā", "traducao_palavra": "jaz abandonada/prostrada" },
        { "hebraico": "עַל־אַדְמָתָ֖הּ", "transliteral": "ʿal-ʾaḏ-mā-ṯāh", "traducao_palavra": "sobre a sua terra" },
        { "hebraico": "אֵ֥ין", "transliteral": "ʾên", "traducao_palavra": "não há" },
        { "hebraico": "מְקִימָֽהּ׃", "transliteral": "mə-qî-māh", "traducao_palavra": "quem a levante" }
      ]
    },
    "3": {
      "traducao_completa": "Porque assim diz o Senhor YHWH: A cidade da qual saía um milheiro ficará com cem, e aquela da qual saíam cem ficará com dez, para a casa de Israel.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "כֹ֥ה", "transliteral": "ḵōh", "traducao_palavra": "assim" },
        { "hebraico": "אָמַ֛ר", "transliteral": "ʾā-mar", "traducao_palavra": "diz" },
        { "hebraico": "אֲדֹנָ֥י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH:" },
        { "hebraico": "הָעִ֤יר", "transliteral": "hā-ʿîr", "traducao_palavra": "a cidade" },
        { "hebraico": "הַיֹּצֵאת֙", "transliteral": "hay-yō-ṣêṯ", "traducao_palavra": "que saía com" },
        { "hebraico": "אֶ֔לֶף", "transliteral": "ʾe-lep̄", "traducao_palavra": "mil" },
        { "hebraico": "תַּשְׁאִ֖יר", "transliteral": "taš-ʾîr", "traducao_palavra": "deixará ficar" },
        { "hebraico": "מֵאָ֑ה", "transliteral": "mê-ʾā", "traducao_palavra": "cem" },
        { "hebraico": "וְהַיֹּוצֵ֥את", "transliteral": "wə-hay-yô-ṣêṯ", "traducao_palavra": "e a que saía com" },
        { "hebraico": "מֵאָ֛ה", "transliteral": "mê-ʾā", "traducao_palavra": "cem" },
        { "hebraico": "תַּשְׁאִ֥יר", "transliteral": "taš-ʾîr", "traducao_palavra": "deixará ficar" },
        { "hebraico": "עֲשָׂרָ֖ה", "transliteral": "ʿă-śā-rā", "traducao_palavra": "dez" },
        { "hebraico": "לְבֵ֥ית", "transliteral": "lə-ḇêṯ", "traducao_palavra": "para a casa de" },
