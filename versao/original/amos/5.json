    "22": {
      "traducao_completa": "E ainda que me ofereçais holocaustos e ofertas de cereais, não me agradarei deles; nem atentarei para as ofertas pacíficas dos vossos animais cevados.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "mesmo" },
        { "hebraico": "אִם־תַּעֲלוּ־לִ֥י", "transliteral": "ʾim-ta-ʿă-lū-lî", "traducao_palavra": "que me ofereçais" },
        { "hebraico": "עֹלֹ֛ות", "transliteral": "ʿō-lôṯ", "traducao_palavra": "holocaustos" },
        { "hebraico": "וּמִנְחֹתֵיכֶ֖ם", "transliteral": "ū-min-ḥō-ṯê-ḵem", "traducao_palavra": "e vossas ofertas de cereais" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֶרְצֶ֑ה", "transliteral": "ʾer-ṣeh", "traducao_palavra": "me agradarei" },
        { "hebraico": "וְשֶׁ֥לֶם", "transliteral": "wə-še-lem", "traducao_palavra": "e das ofertas pacíficas de" },
        { "hebraico": "מְרִיאֵיכֶ֖ם", "transliteral": "mə-rî-ʾê-ḵem", "traducao_palavra": "vossos animais cevados" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אַבִּֽיט׃", "transliteral": "ʾab-bîṭ", "traducao_palavra": "atentarei/olharei" }
      ]
    },
    "23": {
      "traducao_completa": "Afasta de mim o estrépito dos teus cânticos; porque não ouvirei a melodia das tuas liras.",
      "palavras": [
        { "hebraico": "הָסֵ֥ר", "transliteral": "hā-sêr", "traducao_palavra": "afasta" },
        { "hebraico": "מֵעָלַ֖י", "transliteral": "mê-ʿā-lay", "traducao_palavra": "de sobre mim" },
        { "hebraico": "הֲמֹ֣ון", "transliteral": "hă-môn", "traducao_palavra": "o ruído/estrépito de" },
        { "hebraico": "שִׁרֶ֑יךָ", "transliteral": "ši-re-ḵā", "traducao_palavra": "teus cânticos" },
        { "hebraico": "וְזִמְרַ֥ת", "transliteral": "wə-zim-raṯ", "traducao_palavra": "e a melodia de" },
        { "hebraico": "נְבָלֶ֖יךָ", "transliteral": "nə-ḇā-le-ḵā", "traducao_palavra": "tuas liras/harpas" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֶשְׁמָֽע׃", "transliteral": "ʾeš-māʿ", "traducao_palavra": "ouvirei" }
      ]
    },
    "24": {
      "traducao_completa": "Corra, porém, o juízo como as águas, e a justiça como um ribeiro perene.",
