        { "hebraico": "לָ֠כֵן", "transliteral": "lā-ḵên", "traducao_palavra": "portanto" },
        { "hebraico": "יַ֣עַן", "transliteral": "ya-ʿan", "traducao_palavra": "porquanto" },
        { "hebraico": "בֹּושַׁסְכֶ֞ם", "transliteral": "bô-šas-ḵem", "traducao_palavra": "pisais/espezinhais" },
        { "hebraico": "עַל־דָּ֗ל", "transliteral": "ʿal-dāl", "traducao_palavra": "ao pobre" },
