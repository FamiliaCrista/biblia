        { "hebraico": "מִסְפֵּ֔ד", "transliteral": "mis-pêḏ", "traducao_palavra": "haverá pranto" },
        { "hebraico": "וּבְכָל־חוּצֹ֖ות", "transliteral": "ū-ḇə-ḵāl-ḥū-ṣôṯ", "traducao_palavra": "e em todas as ruas" },
