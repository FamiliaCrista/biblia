    "20": {
      "traducao_completa": "Não será, pois, o dia de YHWH trevas e não luz? Não será completa escuridão, sem nenhum resplendor?",
      "palavras": [
        { "hebraico": "הֲלֹא־חֹ֛שֶׁךְ", "transliteral": "hă-lō-ḥō-šeḵ", "traducao_palavra": "porventura não será trevas" },
