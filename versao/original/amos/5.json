        { "hebraico": "הַקֹּורֵ֣א", "transliteral": "haq-qô-rê", "traducao_palavra": "o que chama" },
        { "hebraico": "לְמֵֽי־הַיָּ֗ם", "transliteral": "lə-mê-hay-yām", "traducao_palavra": "as águas do mar" },
        { "hebraico": "וַֽיִּשְׁפְּכֵ֛ם", "transliteral": "way-yiš-pə-ḵêm", "traducao_palavra": "e as derrama" },
