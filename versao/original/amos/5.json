        { "hebraico": "וְלֹא־נֹ֥גַֽהּ", "transliteral": "wə-lō-nō-ḡah", "traducao_palavra": "e sem resplendor" },
        { "hebraico": "לֹֽו׃", "transliteral": "lô", "traducao_palavra": "nele?" }
      ]
    },
    "21": {
      "traducao_completa": "Odeio, desprezo as vossas festas, e as vossas assembleias solenes não me dão nenhum prazer.",
      "palavras": [
        { "hebraico": "שָׂנֵ֥אתִי", "transliteral": "śā-nê-ṯî", "traducao_palavra": "odeio" },
        { "hebraico": "מָאַ֖סְתִּי", "transliteral": "mā-ʾas-tî", "traducao_palavra": "desprezo" },
        { "hebraico": "חַגֵּיכֶ֑ם", "transliteral": "ḥag-gê-ḵem", "traducao_palavra": "as vossas festas" },
