    "6": {
      "traducao_completa": "Buscai a YHWH, e vivei, para que ele não irrompa na casa de José como um fogo, e a consuma, e não haja em Bete-El quem o apague.",
      "palavras": [
        { "hebraico": "דִּרְשׁ֥וּ", "transliteral": "dir-šû", "traducao_palavra": "buscai" },
        { "hebraico": "אֶת־יְהוָ֖ה", "transliteral": "ʾeṯ-YHWH", "traducao_palavra": "a YHWH" },
        { "hebraico": "וִֽחְי֑וּ", "transliteral": "wi-ḥə-yû", "traducao_palavra": "e vivei" },
        { "hebraico": "פֶּן־יִצְלַ֤ח", "transliteral": "pen-yiṣ-laḥ", "traducao_palavra": "para que não irrompa" },
