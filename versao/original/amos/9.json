      "palavras": [
        { "hebraico": "וּנְטַעְתִּ֖ים", "transliteral": "ū-nə-ṭaʿ-tîm", "traducao_palavra": "e os plantarei" },
        { "hebraico": "עַל־אַדְמָתָ֑ם", "transliteral": "ʿal-ʾaḏ-mā-ṯām", "traducao_palavra": "na sua terra" },
