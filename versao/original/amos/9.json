        { "hebraico": "וְכָל־הַגְּבָעֹ֖ות", "transliteral": "wə-ḵāl-hag-gə-ḇā-ʿôṯ", "traducao_palavra": "e todas as colinas" },
        { "hebraico": "תִּתְמֹוגַֽגְנָה׃", "transliteral": "tiṯ-mô-ḡaḡ-nā", "traducao_palavra": "se derreterão/fluirão" }
      ]
    },
    "14": {
      "traducao_completa": "E trarei do cativeiro o meu povo Israel, e eles reedificarão as cidades assoladas, e nelas habitarão, e plantarão vinhas, e beberão o seu vinho, e farão pomares, e lhes comerão o fruto.",
      "palavras": [
        { "hebraico": "וְשַׁבְתִּי֮", "transliteral": "wə-šaḇ-tî", "traducao_palavra": "e restaurarei" },
        { "hebraico": "אֶת־שְׁבוּת֩", "transliteral": "ʾeṯ-šə-ḇūṯ", "traducao_palavra": "o cativeiro de" },
        { "hebraico": "עַמִּ֨י", "transliteral": "ʿam-mî", "traducao_palavra": "meu povo" },
        { "hebraico": "יִשְׂרָאֵ֜ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "וּבָנ֣וּ", "transliteral": "ū-ḇā-nû", "traducao_palavra": "e reedificarão" },
        { "hebraico": "עָרִ֧ים", "transliteral": "ʿā-rîm", "traducao_palavra": "cidades" },
