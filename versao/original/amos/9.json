        { "hebraico": "וְיָשָׁ֗בוּ", "transliteral": "wə-yā-šā-ḇû", "traducao_palavra": "e nelas habitarão" },
        { "hebraico": "וְנָטְע֣וּ", "transliteral": "wə-nā-ṭə-ʿû", "traducao_palavra": "e plantarão" },
        { "hebraico": "כְרָמִים֮", "transliteral": "ḵə-rā-mîm", "traducao_palavra": "vinhas" },
        { "hebraico": "וְשָׁת֣וּ", "transliteral": "wə-šā-ṯû", "traducao_palavra": "e beberão" },
        { "hebraico": "אֶת־יֵינָם֒", "transliteral": "ʾeṯ-yê-nām", "traducao_palavra": "o seu vinho" },
        { "hebraico": "וְעָשׂ֣וּ", "transliteral": "wə-ʿā-śû", "traducao_palavra": "e farão" },
