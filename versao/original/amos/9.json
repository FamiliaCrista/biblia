    "9": {
      "traducao_completa": "Porque eis que darei ordens e sacudirei a casa de Israel entre todas as nações, como se sacode o grão no crivo, sem que caia em terra um só grãozinho.",
      "palavras": [
        { "hebraico": "כִּֽי־הִנֵּ֤ה", "transliteral": "kî-hin-nêh", "traducao_palavra": "porque eis que" },
        { "hebraico": "אָנֹכִי֙", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "eu" },
        { "hebraico": "מְצַוֶּ֔ה", "transliteral": "mə-ṣaw-weh", "traducao_palavra": "estou ordenando" },
        { "hebraico": "וַהֲנִעֹותִי֙", "transliteral": "wa-hă-nî-ʿô-ṯî", "traducao_palavra": "e sacudirei" },
        { "hebraico": "בְּכָל־הַגֹּויִ֔ם", "transliteral": "bə-ḵāl-hag-gô-yim", "traducao_palavra": "entre todas as nações" },
        { "hebraico": "אֶת־בֵּ֖ית", "transliteral": "ʾeṯ-bêṯ", "traducao_palavra": "a casa de" },
        { "hebraico": "יִשְׂרָאֵ֑ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "כַּאֲשֶׁ֤ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "como" },
        { "hebraico": "יִנֹּ֙ועַ֙", "transliteral": "yin-nô-aʿ", "traducao_palavra": "se sacode o grão" },
        { "hebraico": "בַּכְּבָרָ֔ה", "transliteral": "bak-kə-ḇā-rā", "traducao_palavra": "no crivo/peneira" },
        { "hebraico": "וְלֹֽא־יִפֹּ֥ול", "transliteral": "wə-lō-yip-pôl", "traducao_palavra": "e não cairá" },
        { "hebraico": "צְרֹ֖ור", "transliteral": "ṣə-rôr", "traducao_palavra": "uma pedra/grão" },
        { "hebraico": "אָֽרֶץ׃", "transliteral": "ʾā-reṣ", "traducao_palavra": "na terra" }
      ]
    },
    "10": {
      "traducao_completa": "Todos os pecadores do meu povo morrerão à espada, os que dizem: O mal não nos alcançará, nem nos surpreenderá.",
      "palavras": [
        { "hebraico": "בַּחֶ֣רֶב", "transliteral": "ba-ḥe-reḇ", "traducao_palavra": "à espada" },
        { "hebraico": "יָמ֔וּתוּ", "transliteral": "yā-mū-ṯû", "traducao_palavra": "morrerão" },
        { "hebraico": "כֹּ֖ל", "transliteral": "kōl", "traducao_palavra": "todos" },
        { "hebraico": "חַטָּאֵ֣י", "transliteral": "ḥaṭ-ṭā-ʾê", "traducao_palavra": "os pecadores de" },
        { "hebraico": "עַמִּ֑י", "transliteral": "ʿam-mî", "traducao_palavra": "meu povo" },
        { "hebraico": "הָאֹמְרִ֗ים", "transliteral": "hā-ʾō-mə-rîm", "traducao_palavra": "os que dizem:" },
        { "hebraico": "לֹֽא־תַגִּ֧ישׁ", "transliteral": "lō-ṯag-gîš", "traducao_palavra": "não se aproximará" },
        { "hebraico": "וְתַקְדִּ֛ים", "transliteral": "wə-ṯaq-dîm", "traducao_palavra": "nem nos alcançará" },
        { "hebraico": "בַּעֲדֵ֖ינוּ", "transliteral": "ba-ʿă-ḏê-nû", "traducao_palavra": "a nós" },
        { "hebraico": "הָרָעָֽה׃", "transliteral": "hā-rā-ʿā", "traducao_palavra": "o mal" }
      ]
    },
    "11": {
      "traducao_completa": "Naquele dia tornarei a levantar a tenda caída de Davi, e taparei as suas brechas, e levantarei as suas ruínas, e a reedificarei como nos dias da antiguidade;",
      "palavras": [
        { "hebraico": "בַּיֹּ֣ום", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "הַה֔וּא", "transliteral": "ha-hû", "traducao_palavra": "aquele" },
        { "hebraico": "אָקִ֛ים", "transliteral": "ʾā-qîm", "traducao_palavra": "levantarei" },
        { "hebraico": "אֶת־סֻכַּ֥ת", "transliteral": "ʾeṯ-suk-kaṯ", "traducao_palavra": "a tenda/tabernáculo de" },
        { "hebraico": "דָּוִ֖יד", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "הַנֹּפֶ֑לֶת", "transliteral": "han-nō-p̄e-leṯ", "traducao_palavra": "que está caída" },
        { "hebraico": "וְגָדַרְתִּ֣י", "transliteral": "wə-ḡā-ḏar-tî", "traducao_palavra": "e taparei" },
        { "hebraico": "אֶת־פִּרְצֵיהֶ֗ן", "transliteral": "ʾeṯ-pir-ṣê-hen", "traducao_palavra": "as suas brechas" },
        { "hebraico": "וַהֲרִֽסֹתָיו֙", "transliteral": "wa-hă-ri-sō-ṯāyw", "traducao_palavra": "e as suas ruínas" },
        { "hebraico": "אָקִ֔ים", "transliteral": "ʾā-qîm", "traducao_palavra": "levantarei" },
        { "hebraico": "וּבְנִיתִ֖יהָ", "transliteral": "ū-ḇə-nî-ṯî-hā", "traducao_palavra": "e a edificarei" },
        { "hebraico": "כִּימֵ֥י", "transliteral": "kî-mê", "traducao_palavra": "como nos dias de" },
        { "hebraico": "עֹולָֽם׃", "transliteral": "ʿô-lām", "traducao_palavra": "antiguidade" }
      ]
    },
    "12": {
      "traducao_completa": "para que possuam o restante de Edom e todas as nações que são chamadas pelo meu nome, diz YHWH, que faz isto.",
      "palavras": [
        { "hebraico": "לְמַ֨עַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "para que" },
        { "hebraico": "יִֽירְשׁ֜וּ", "transliteral": "yî-rə-šû", "traducao_palavra": "herdem/possuam" },
        { "hebraico": "אֶת־שְׁאֵרִ֤ית", "transliteral": "ʾeṯ-šə-ʾê-rîṯ", "traducao_palavra": "o remanescente de" },
        { "hebraico": "אֱדֹום֙", "transliteral": "ʾĕ-ḏôm", "traducao_palavra": "Edom" },
        { "hebraico": "וְכָל־הַגֹּויִ֔ם", "transliteral": "wə-ḵāl-hag-gô-yim", "traducao_palavra": "e todas as nações" },
        { "hebraico": "אֲשֶׁר־נִקְרָ֥א", "transliteral": "ʾă-šer-niq-rā", "traducao_palavra": "sobre as quais é chamado" },
        { "hebraico": "שְׁמִ֖י", "transliteral": "šə-mî", "traducao_palavra": "o meu nome" },
        { "hebraico": "עֲלֵיהֶ֑ם", "transliteral": "ʿă-lê-hem", "traducao_palavra": "sobre elas" },
        { "hebraico": "נְאֻם־יְהוָ֖ה", "transliteral": "nə-ʾum-YHWH", "traducao_palavra": "declaração de YHWH" },
        { "hebraico": "עֹ֥שֶׂה", "transliteral": "ʿō-śeh", "traducao_palavra": "que faz" },
        { "hebraico": "זֹּֽאת׃", "transliteral": "zōṯ", "traducao_palavra": "isto" }
      ]
    },
    "13": {
      "traducao_completa": "Eis que vêm dias, diz YHWH, em que o que lavra alcançará ao que sega, e o que pisa as uvas ao que lança a semente; e os montes destilarão mosto, e todos os outeiros se derreterão.",
      "palavras": [
        { "hebraico": "הִנֵּ֨ה", "transliteral": "hin-nêh", "traducao_palavra": "eis que" },
        { "hebraico": "יָמִ֤ים", "transliteral": "yā-mîm", "traducao_palavra": "dias" },
        { "hebraico": "בָּאִים֙", "transliteral": "bā-ʾîm", "traducao_palavra": "estão vindo" },
        { "hebraico": "נְאֻם־יְהוָ֔ה", "transliteral": "nə-ʾum-YHWH", "traducao_palavra": "declaração de YHWH" },
        { "hebraico": "וְנִגַּ֤שׁ", "transliteral": "wə-niḡ-gaš", "traducao_palavra": "em que se achegará/alcançará" },
        { "hebraico": "חֹורֵשׁ֙", "transliteral": "ḥô-rêš", "traducao_palavra": "o que ara/lavra" },
        { "hebraico": "בַּקֹּצֵ֔ר", "transliteral": "baq-qō-ṣêr", "traducao_palavra": "ao que ceifa" },
        { "hebraico": "וְדֹרֵ֥ךְ", "transliteral": "wə-ḏō-rêḵ", "traducao_palavra": "e o que pisa" },
        { "hebraico": "עֲנָבִ֖ים", "transliteral": "ʿă-nā-ḇîm", "traducao_palavra": "uvas" },
        { "hebraico": "בְּמֹשֵׁ֣ךְ", "transliteral": "bə-mō-šêḵ", "traducao_palavra": "ao que puxa/espalha" },
        { "hebraico": "הַזָּ֑רַע", "transliteral": "haz-zā-raʿ", "traducao_palavra": "a semente" },
        { "hebraico": "וְהִטִּ֤יפוּ", "transliteral": "wə-hiṭ-ṭî-p̄û", "traducao_palavra": "e destilarão" },
        { "hebraico": "הֶהָרִים֙", "transliteral": "he-hā-rîm", "traducao_palavra": "os montes" },
