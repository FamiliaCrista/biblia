        { "hebraico": "וְאָכְל֖וּ", "transliteral": "wə-ʾā-ḵə-lû", "traducao_palavra": "e comerão" },
        { "hebraico": "אֶת־פְּרִיהֶֽם׃", "transliteral": "ʾeṯ-pə-rî-hem", "traducao_palavra": "o seu fruto" }
      ]
    },
    "15": {
