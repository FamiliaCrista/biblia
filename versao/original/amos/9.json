    "2": {
      "traducao_completa": "Ainda que cavem até ao Seol, dali a minha mão os tirará; e se subirem ao céu, dali os farei descer.",
      "palavras": [
        { "hebraico": "אִם־יַחְתְּר֣וּ", "transliteral": "ʾim-yaḥ-tə-rû", "traducao_palavra": "se cavarem" },
