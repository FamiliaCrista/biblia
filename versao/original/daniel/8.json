        { "hebraico": "וַיְהִי֙", "transliteral": "way-hî", "traducao_palavra": "e aconteceu" },
        { "hebraico": "בִּרְאֹתִ֔י", "transliteral": "bir-ʾō-ṯî", "traducao_palavra": "quando vi" },
