        { "hebraico": "דָנִיֵּ֜אל", "transliteral": "dā-nî-yêl", "traducao_palavra": "Daniel" },
        { "hebraico": "נִהְיֵ֤יתִי", "transliteral": "nih-yê-ṯî", "traducao_palavra": "desfaleci/enfraqueci" },
        { "hebraico": "וְנֶחֱלֵ֙יתִי֙", "transliteral": "wə-ne-ḥĕ-lê-ṯî", "traducao_palavra": "e estive doente por" },
        { "hebraico": "יָמִ֔ים", "transliteral": "yā-mîm", "traducao_palavra": "dias" },
        { "hebraico": "וָאָק֕וּם", "transliteral": "wā-ʾā-qūm", "traducao_palavra": "e levantei-me" },
        { "hebraico": "וָאֶעֱשֶׂ֖ה", "transliteral": "wā-ʾe-ʿĕ-śeh", "traducao_palavra": "e fiz/tratei de" },
        { "hebraico": "אֶת־מְלֶ֣אכֶת", "transliteral": "ʾeṯ-mə-le-ḵeṯ", "traducao_palavra": "o serviço/negócios de" },
        { "hebraico": "הַמֶּ֑לֶךְ", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
        { "hebraico": "וָאֶשְׁתֹּומֵ֥ם", "transliteral": "wā-ʾeš-tô-mêm", "traducao_palavra": "e estava estarrecido/atônito" },
        { "hebraico": "עַל־הַמַּרְאֶ֖ה", "transliteral": "ʿal-ham-mar-ʾeh", "traducao_palavra": "com a visão" },
