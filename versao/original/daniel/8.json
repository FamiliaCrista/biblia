        { "hebraico": "עֹלָ֥ה", "transliteral": "ʿō-lā", "traducao_palavra": "subiu" },
        { "hebraico": "בָאַחֲרֹנָֽה׃", "transliteral": "bā-ʾa-ḥă-rō-nā", "traducao_palavra": "por último" }
      ]
    },
    "4": {
      "traducao_completa": "Vi que o carneiro dava marradas para o ocidente, para o norte e para o sul; e nenhum animal podia resistir-lhe, nem havia quem pudesse livrar da sua mão; e ele fazia conforme a sua vontade e se engrandecia.",
      "palavras": [
