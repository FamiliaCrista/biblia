        { "hebraico": "מִן־הַֽמַּעֲרָב֙", "transliteral": "min-ham-ma-ʿă-rāḇ", "traducao_palavra": "do ocidente" },
        { "hebraico": "עַל־פְּנֵ֣י", "transliteral": "ʿal-pə-nê", "traducao_palavra": "sobre a face de" },
