        { "hebraico": "וְאֵ֥ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não estava" },
        { "hebraico": "נֹוגֵ֖עַ", "transliteral": "nô-ḡê-aʿ", "traducao_palavra": "tocando" },
        { "hebraico": "בָּאָ֑רֶץ", "transliteral": "bā-ʾā-reṣ", "traducao_palavra": "na terra" },
        { "hebraico": "וְהַצָּפִ֕יר", "transliteral": "wə-haṣ-ṣā-p̄îr", "traducao_palavra": "e o bode [tinha]" },
        { "hebraico": "קֶ֥רֶן", "transliteral": "qe-ren", "traducao_palavra": "um chifre de" },
