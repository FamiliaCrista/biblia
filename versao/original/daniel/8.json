        { "hebraico": "מֵבִ֗ין", "transliteral": "mê-ḇîn", "traducao_palavra": "considerando/compreendendo" },
        { "hebraico": "וְהִנֵּ֤ה", "transliteral": "wə-hin-nêh", "traducao_palavra": "e eis que" },
