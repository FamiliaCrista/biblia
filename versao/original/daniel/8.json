        { "hebraico": "אוּלָֽי׃", "transliteral": "ʾū-lāy", "traducao_palavra": "Ulai" }
      ]
    },
    "3": {
      "traducao_completa": "E levantei os meus olhos e vi, e eis que um carneiro estava em pé diante do rio, o qual tinha dois chifres; e os dois chifres eram altos, mas um era mais alto do que o outro, e o mais alto subiu por último.",
      "palavras": [
        { "hebraico": "וָאֶשָּׂ֨א", "transliteral": "wā-ʾeś-śā", "traducao_palavra": "e levantei" },
        { "hebraico": "עֵינַ֜י", "transliteral": "ʿê-nay", "traducao_palavra": "os meus olhos" },
        { "hebraico": "וָאֶרְאֶ֗ה", "transliteral": "wā-ʾer-ʾeh", "traducao_palavra": "e vi" },
        { "hebraico": "וְהִנֵּ֨ה", "transliteral": "wə-hin-nêh", "traducao_palavra": "e eis que" },
        { "hebraico": "אַ֥יִל", "transliteral": "ʾa-yil", "traducao_palavra": "um carneiro" },
