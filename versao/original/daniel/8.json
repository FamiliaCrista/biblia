        { "hebraico": "וְהַקְּרָנַ֣יִם", "transliteral": "wə-haq-qə-rā-na-yim", "traducao_palavra": "e os chifres [eram]" },
        { "hebraico": "גְּבֹהֹ֗ות", "transliteral": "gə-ḇō-hôṯ", "traducao_palavra": "altos" },
