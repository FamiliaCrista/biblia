        { "hebraico": "שְׁלֹ֥שׁ", "transliteral": "šə-lōš", "traducao_palavra": "três" },
        { "hebraico": "מֵאֹ֖ות", "transliteral": "mê-ʾôṯ", "traducao_palavra": "centenas [trezentos]" },
        { "hebraico": "שְׁלֹשִׁ֥ים", "transliteral": "šə-lō-šîm", "traducao_palavra": "e trinta" },
        { "hebraico": "וַחֲמִשָּֽׁה׃", "transliteral": "wa-ḥă-miš-šā", "traducao_palavra": "e cinco" }
      ]
    },
    "13": {
      "traducao_completa": "Tu, porém, vai até ao fim; porque repousarás, e estarás na tua herança, no fim dos dias.",
      "palavras": [
        { "hebraico": "וְאַתָּ֖ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "tu porém" },
