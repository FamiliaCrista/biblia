        { "hebraico": "הוּסַ֣ר", "transliteral": "hū-sar", "traducao_palavra": "for tirado" },
        { "hebraico": "הַתָּמִ֔יד", "transliteral": "hat-tā-mîḏ", "traducao_palavra": "o [sacrifício] contínuo" },
        { "hebraico": "וְלָתֵ֖ת", "transliteral": "wə-lā-ṯêṯ", "traducao_palavra": "e para estabelecer" },
        { "hebraico": "שִׁקּ֣וּץ", "transliteral": "šiq-qūṣ", "traducao_palavra": "a abominação" },
        { "hebraico": "שֹׁמֵ֑ם", "transliteral": "šō-mêm", "traducao_palavra": "desoladora" },
        { "hebraico": "יָמִ֕ים", "transliteral": "yā-mîm", "traducao_palavra": "[haverá] dias" },
        { "hebraico": "אֶ֖לֶף", "transliteral": "ʾe-lep̄", "traducao_palavra": "mil" },
        { "hebraico": "מָאתַ֥יִם", "transliteral": "mā-ṯa-yim", "traducao_palavra": "duzentos" },
        { "hebraico": "וְתִשְׁעִֽים׃", "transliteral": "wə-ṯiš-ʿîm", "traducao_palavra": "e noventa" }
      ]
    },
    "12": {
      "traducao_completa": "Bem-aventurado aquele que espera e chega aos mil trezentos e trinta e cinco dias.",
      "palavras": [
        { "hebraico": "אַשְׁרֵ֥י", "transliteral": "ʾaš-rê", "traducao_palavra": "bem-aventurado" },
        { "hebraico": "הַֽמְחַכֶּ֖ה", "transliteral": "ham-ḥak-keh", "traducao_palavra": "aquele que espera" },
        { "hebraico": "וְיַגִּ֑יעַ", "transliteral": "wə-yag-gî-aʿ", "traducao_palavra": "e alcança/chega" },
        { "hebraico": "לְיָמִ֕ים", "transliteral": "lə-yā-mîm", "traducao_palavra": "a dias" },
