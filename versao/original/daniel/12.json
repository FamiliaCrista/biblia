        { "hebraico": "וְיִֽתְלַבְּנ֤וּ", "transliteral": "wə-yiṯ-lab-bə-nû", "traducao_palavra": "e embranquecer-se-ão" },
        { "hebraico": "וְיִצָּֽרְפוּ֙", "transliteral": "wə-yiṣ-ṣā-rə-p̄û", "traducao_palavra": "e serão refinados" },
        { "hebraico": "רַבִּ֔ים", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
        { "hebraico": "וְהִרְשִׁ֣יעוּ", "transliteral": "wə-hir-šî-ʿû", "traducao_palavra": "mas agirão impiamente" },
        { "hebraico": "רְשָׁעִ֔ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "os ímpios" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יָבִ֖ינוּ", "transliteral": "yā-ḇî-nû", "traducao_palavra": "entenderão" },
        { "hebraico": "כָּל־רְשָׁעִ֑ים", "transliteral": "kāl-rə-šā-ʿîm", "traducao_palavra": "nenhum dos ímpios" },
        { "hebraico": "וְהַמַּשְׂכִּלִ֖ים", "transliteral": "wə-ham-maś-ki-lîm", "traducao_palavra": "mas os sábios" },
        { "hebraico": "יָבִֽינוּ׃", "transliteral": "yā-ḇî-nû", "traducao_palavra": "entenderão" }
      ]
    },
    "11": {
      "traducao_completa": "E desde o tempo em que o sacrifício contínuo for tirado, e posta a abominação desoladora, haverá mil duzentos e noventa dias.",
      "palavras": [
