        { "hebraico": "וְלֹֽא־חִלִּ֜ינוּ", "transliteral": "wə-lō-ḥil-lî-nû", "traducao_palavra": "e não imploramos o favor de" },
        { "hebraico": "אֶת־פְּנֵ֣י", "transliteral": "ʾeṯ-pə-nê", "traducao_palavra": "a face de" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהֵ֗ינוּ", "transliteral": "ʾĕ-lō-hê-nû", "traducao_palavra": "nosso Deus" },
