    "15": {
      "traducao_completa": "E agora, ó Senhor, nosso Deus, que tiraste o teu povo da terra do Egito com mão poderosa e para ti adquiriste renome, como hoje se vê: pecamos, procedemos impiamente.",
      "palavras": [
        { "hebraico": "וְעַתָּ֣ה", "transliteral": "wə-ʿat-tā", "traducao_palavra": "e agora" },
        { "hebraico": "אֲדֹנָ֣י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "ó Senhor" },
        { "hebraico": "אֱלֹהֵ֗ינוּ", "transliteral": "ʾĕ-lō-hê-nû", "traducao_palavra": "nosso Deus" },
        { "hebraico": "אֲשֶׁר֩", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "הֹוצֵ֨אתָ", "transliteral": "hô-ṣê-ṯā", "traducao_palavra": "tiraste" },
        { "hebraico": "אֶֽת־עַמְּךָ֜", "transliteral": "ʾeṯ-ʿam-mə-ḵā", "traducao_palavra": "o teu povo" },
        { "hebraico": "מֵאֶ֤רֶץ", "transliteral": "mê-ʾe-reṣ", "traducao_palavra": "da terra de" },
        { "hebraico": "מִצְרַ֙יִם֙", "transliteral": "miṣ-ra-yim", "traducao_palavra": "Egito" },
        { "hebraico": "בְּיָ֣ד", "transliteral": "bə-yāḏ", "traducao_palavra": "com mão" },
        { "hebraico": "חֲזָקָ֔ה", "transliteral": "ḥă-zā-qā", "traducao_palavra": "forte/poderosa" },
        { "hebraico": "וַתַּֽעַשׂ־לְךָ֥", "transliteral": "wat-ta-ʿaś-lə-ḵā", "traducao_palavra": "e fizeste para ti" },
        { "hebraico": "שֵׁ֖ם", "transliteral": "šêm", "traducao_palavra": "um nome/renome" },
        { "hebraico": "כַּיֹּ֣ום", "transliteral": "kay-yôm", "traducao_palavra": "como no dia" },
        { "hebraico": "הַזֶּ֑ה", "transliteral": "haz-zeh", "traducao_palavra": "de hoje" },
        { "hebraico": "חָטָ֖אנוּ", "transliteral": "ḥā-ṭā-nû", "traducao_palavra": "pecamos" },
        { "hebraico": "רָשָֽׁעְנוּ׃", "transliteral": "rā-šāʿ-nû", "traducao_palavra": "procedemos impiamente" }
      ]
    },
    "16": {
      "traducao_completa": "Ó Senhor, segundo todas as tuas justiças, aparte-se a tua ira e o teu furor da tua cidade de Jerusalém, do teu santo monte; porquanto, por nossos pecados e pelas iniquidades de nossos pais, Jerusalém e o teu povo se tornaram opróbrio para todos os que estão ao redor de nós.",
      "palavras": [
        { "hebraico": "אֲדֹנָ֗י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "ó Senhor" },
        { "hebraico": "כְּכָל־צִדְקֹתֶ֙ךָ֙", "transliteral": "kə-ḵāl-ṣiḏ-qō-ṯe-ḵā", "traducao_palavra": "conforme todas as tuas justiças" },
        { "hebraico": "יָֽשָׁב־נָ֤א", "transliteral": "yā-šoḇ-nā", "traducao_palavra": "aparte-se, peço-te" },
        { "hebraico": "אַפְּךָ֙", "transliteral": "ʾap-pə-ḵā", "traducao_palavra": "a tua ira" },
        { "hebraico": "וַחֲמָ֣תְךָ֔", "transliteral": "wa-ḥă-mā-ṯə-ḵā", "traducao_palavra": "e o teu furor" },
        { "hebraico": "מֵעִֽירְךָ֥", "transliteral": "mê-ʿî-rə-ḵā", "traducao_palavra": "da tua cidade" },
        { "hebraico": "יְרוּשָׁלִַ֖ם", "transliteral": "yə-rū-šā-la-yim", "traducao_palavra": "Jerusalém" },
        { "hebraico": "הַר־קָדְשֶׁ֑ךָ", "transliteral": "har-qāḏ-še-ḵā", "traducao_palavra": "o teu santo monte" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "בַחֲטָאֵ֙ינוּ֙", "transliteral": "ḇa-ḥă-ṭā-ʾê-nû", "traducao_palavra": "por causa dos nossos pecados" },
        { "hebraico": "וּבַעֲוֹנֹ֣ות", "transliteral": "ū-ḇa-ʿă-wō-nôṯ", "traducao_palavra": "e pelas iniquidades de" },
        { "hebraico": "אֲבֹתֵ֔ינוּ", "transliteral": "ʾă-ḇō-ṯê-nû", "traducao_palavra": "nossos pais" },
        { "hebraico": "יְרוּשָׁלִַ֧ם", "transliteral": "yə-rū-šā-la-yim", "traducao_palavra": "Jerusalém" },
        { "hebraico": "וְעַמְּךָ֛", "transliteral": "wə-ʿam-mə-ḵā", "traducao_palavra": "e o teu povo" },
        { "hebraico": "לְחֶרְפָּ֖ה", "transliteral": "lə-ḥer-pā", "traducao_palavra": "[são] por opróbrio/vergonha" },
        { "hebraico": "לְכָל־סְבִיבֹתֵֽינוּ׃", "transliteral": "lə-ḵāl-sə-ḇî-ḇō-ṯê-nû", "traducao_palavra": "para todos ao redor de nós" }
      ]
    },
    "17": {
      "traducao_completa": "Agora, pois, ó Deus nosso, ouve a oração do teu servo e as suas súplicas, e faze resplandecer o teu rosto sobre o teu santuário assolado, por amor do Senhor.",
      "palavras": [
        { "hebraico": "וְעַתָּ֣ה", "transliteral": "wə-ʿat-tā", "traducao_palavra": "e agora" },
        { "hebraico": "שְׁמַ֣ע", "transliteral": "šə-maʿ", "traducao_palavra": "ouve" },
        { "hebraico": "אֱלֹהֵ֗ינוּ", "transliteral": "ʾĕ-lō-hê-nû", "traducao_palavra": "ó Deus nosso" },
        { "hebraico": "אֶל־תְּפִלַּ֤ת", "transliteral": "ʾel-tə-p̄il-laṯ", "traducao_palavra": "a oração de" },
        { "hebraico": "עַבְדְּךָ֙", "transliteral": "ʿaḇ-də-ḵā", "traducao_palavra": "teu servo" },
        { "hebraico": "וְאֶל־תַּ֣חֲנוּנָ֔יו", "transliteral": "wə-ʾel-ta-ḥă-nū-nāyw", "traducao_palavra": "e as suas súplicas" },
        { "hebraico": "וְהָאֵ֣ר", "transliteral": "wə-hā-ʾêr", "traducao_palavra": "e faze resplandecer" },
        { "hebraico": "פָּנֶ֔יךָ", "transliteral": "pā-ne-ḵā", "traducao_palavra": "o teu rosto" },
        { "hebraico": "עַל־מִקְדָּשְׁךָ֖", "transliteral": "ʿal-miq-dā-šə-ḵā", "traducao_palavra": "sobre o teu santuário" },
        { "hebraico": "הַשָּׁמֵ֑ם", "transliteral": "haš-šā-mêm", "traducao_palavra": "assolado" },
        { "hebraico": "לְמַ֖עַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "por amor de" },
        { "hebraico": "אֲדֹנָֽי׃", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" }
      ]
