        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "o qual" },
        { "hebraico": "הָמְלַ֔ךְ", "transliteral": "hām-laḵ", "traducao_palavra": "foi feito rei" },
        { "hebraico": "עַ֖ל", "transliteral": "ʿal", "traducao_palavra": "sobre" },
        { "hebraico": "מַלְכ֥וּת", "transliteral": "mal-ḵûṯ", "traducao_palavra": "o reino de" },
        { "hebraico": "כַּשְׂדִּֽים׃", "transliteral": "kaś-dîm", "traducao_palavra": "os caldeus" }
      ]
    },
    "2": {
      "traducao_completa": "no primeiro ano do seu reinado, eu, Daniel, entendi pelos livros que o número de anos, de que falara YHWH ao profeta Jeremias, que haviam de durar as desolações de Jerusalém, era de setenta anos.",
