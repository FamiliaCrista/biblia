        { "hebraico": "מֵֽעֲוֹנֵ֔נוּ", "transliteral": "mê-ʿă-wō-nê-nû", "traducao_palavra": "das nossas iniquidades" },
        { "hebraico": "וּלְהַשְׂכִּ֖יל", "transliteral": "ū-lə-haś-kîl", "traducao_palavra": "e para atentarmos" },
        { "hebraico": "בַּאֲמִתֶּֽךָ׃", "transliteral": "ba-ʾă-mit-te-ḵā", "traducao_palavra": "à tua verdade" }
      ]
    },
    "14": {
      "traducao_completa": "Por isso YHWH vigiou sobre o mal e o trouxe sobre nós; porque justo é YHWH, nosso Deus, em todas as suas obras que faz, e não demos ouvidos à sua voz.",
      "palavras": [
        { "hebraico": "וַיִּשְׁקֹ֤ד", "transliteral": "way-yiš-qōḏ", "traducao_palavra": "e vigiou/cuidou" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "עַל־הָ֣רָעָ֔ה", "transliteral": "ʿal-hā-rā-ʿā", "traducao_palavra": "sobre o mal" },
        { "hebraico": "וַיְבִיאֶ֖הָ", "transliteral": "way-ḇî-ʾe-hā", "traducao_palavra": "e o trouxe" },
        { "hebraico": "עָלֵ֑ינוּ", "transliteral": "ʿā-lê-nû", "traducao_palavra": "sobre nós" },
        { "hebraico": "כִּֽי־צַדִּ֞יק", "transliteral": "kî-ṣad-dîq", "traducao_palavra": "pois justo é" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהֵ֗ינוּ", "transliteral": "ʾĕ-lō-hê-nû", "traducao_palavra": "nosso Deus" },
        { "hebraico": "עַל־כָּל־מַֽעֲשָׂיו֙", "transliteral": "ʿal-kāl-ma-ʿă-śāyw", "traducao_palavra": "em todas as suas obras" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "עָשָׂ֔ה", "transliteral": "ʿā-śā", "traducao_palavra": "ele faz" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "שָׁמַ֖עְנוּ", "transliteral": "šā-maʿ-nû", "traducao_palavra": "demos ouvidos" },
        { "hebraico": "בְּקֹלֹֽו׃", "transliteral": "bə-qō-lô", "traducao_palavra": "à sua voz" }
      ]
