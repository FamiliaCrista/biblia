        { "hebraico": "כַּאֲשֶׁ֥ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "como o que" },
        { "hebraico": "נֶעֶשְׂתָ֖ה", "transliteral": "ne-ʿeś-ṯā", "traducao_palavra": "se fez" },
        { "hebraico": "בִּירוּשָׁלִָֽם׃", "transliteral": "bî-rū-šā-lā-yim", "traducao_palavra": "em Jerusalém" }
      ]
    },
    "13": {
      "traducao_completa": "Como está escrito na lei de Moisés, todo este mal nos sobreveio; contudo, não suplicamos à face de YHWH, nosso Deus, para nos convertermos das nossas iniquidades e para atendermos à tua verdade.",
      "palavras": [
        { "hebraico": "כַּאֲשֶׁ֤ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "como" },
        { "hebraico": "כָּתוּב֙", "transliteral": "kā-ṯūḇ", "traducao_palavra": "está escrito" },
        { "hebraico": "בְּתֹורַ֣ת", "transliteral": "bə-ṯô-raṯ", "traducao_palavra": "na lei de" },
        { "hebraico": "מֹשֶׁ֔ה", "transliteral": "mō-šeh", "traducao_palavra": "Moisés" },
