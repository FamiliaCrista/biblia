        { "hebraico": "וּלְיֹושְׁבֵ֣י", "transliteral": "ū-lə-yô-šə-ḇê", "traducao_palavra": "e aos habitantes de" },
        { "hebraico": "יְרוּשָׁלִַ֔ם", "transliteral": "yə-rū-šā-la-yim", "traducao_palavra": "Jerusalém" },
