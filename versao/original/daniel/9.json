        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "חָטָ֖אנוּ", "transliteral": "ḥā-ṭā-nû", "traducao_palavra": "pecamos" },
        { "hebraico": "לֹֽו׃", "transliteral": "lô", "traducao_palavra": "contra ele" }
      ]
    },
    "12": {
      "traducao_completa": "E ele confirmou as suas palavras, que falou contra nós e contra os nossos juízes que nos julgavam, trazendo sobre nós um grande mal; porquanto debaixo de todo o céu nunca se fez como se tem feito em Jerusalém.",
      "palavras": [
        { "hebraico": "וַיָּ֣קֶם", "transliteral": "way-yā-qem", "traducao_palavra": "e confirmou" },
        { "hebraico": "אֶת־דְּבָרָ֗יו", "transliteral": "ʾeṯ-də-ḇā-rāyw", "traducao_palavra": "as suas palavras" },
        { "hebraico": "אֲשֶׁר־דִּבֶּר֮", "transliteral": "ʾă-šer-dib-ber", "traducao_palavra": "que falou" },
        { "hebraico": "עָלֵינוּ֒", "transliteral": "ʿā-lê-nû", "traducao_palavra": "contra nós" },
        { "hebraico": "וְעַ֣ל", "transliteral": "wə-ʿal", "traducao_palavra": "e contra" },
        { "hebraico": "שֹׁפְטֵ֗ינוּ", "transliteral": "šō-p̄ə-ṭê-nû", "traducao_palavra": "nossos juízes" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
