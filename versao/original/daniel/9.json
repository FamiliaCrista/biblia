        { "hebraico": "אֱלֹהַ֖י", "transliteral": "ʾĕ-lō-hay", "traducao_palavra": "meu Deus" },
        { "hebraico": "וָאֶתְוַדָּ֑אָה", "transliteral": "wā-ʾeṯ-wad-dā-ʾā", "traducao_palavra": "e confessei" },
        { "hebraico": "וָאֹמְרָ֗ה", "transliteral": "wā-ʾōm-rā", "traducao_palavra": "e disse" },
        { "hebraico": "אָנָּ֤א", "transliteral": "ʾān-nā", "traducao_palavra": "ah! rogamos" },
