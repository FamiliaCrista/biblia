    "11": {
      "traducao_completa": "Sim, todo o Israel transgrediu a tua lei, desviando-se para não obedecer à tua voz; por isso a maldição e o juramento que estão escritos na lei de Moisés, servo de Deus, se derramaram sobre nós; porque pecamos contra ele.",
      "palavras": [
        { "hebraico": "וְכָל־יִשְׂרָאֵ֗ל", "transliteral": "wə-ḵāl-yiś-rā-ʾêl", "traducao_palavra": "e todo o Israel" },
        { "hebraico": "עָֽבְרוּ֙", "transliteral": "ʿā-ḇə-rû", "traducao_palavra": "transgrediu" },
        { "hebraico": "אֶת־תֹּ֣ורָתֶ֔ךָ", "transliteral": "ʾeṯ-tô-rā-ṯe-ḵā", "traducao_palavra": "a tua lei" },
        { "hebraico": "וְסֹ֖ור", "transliteral": "wə-sôr", "traducao_palavra": "e desviou-se" },
