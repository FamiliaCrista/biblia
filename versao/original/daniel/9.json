    },
    "9": {
      "traducao_completa": "Ao Senhor, nosso Deus, pertencem as misericórdias e os perdões, porque nos rebelamos contra ele,",
      "palavras": [
        { "hebraico": "לַֽאדֹנָ֣י", "transliteral": "la-ʾḏō-nāy", "traducao_palavra": "ao Senhor" },
