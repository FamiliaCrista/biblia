        { "hebraico": "רָעָ֣ה", "transliteral": "rā-ʿā", "traducao_palavra": "um mal" },
        { "hebraico": "גְדֹלָ֑ה", "transliteral": "gə-ḏō-lā", "traducao_palavra": "grande" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "qual" },
