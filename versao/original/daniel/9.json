        { "hebraico": "שֹׁמֵ֤ר", "transliteral": "šō-mêr", "traducao_palavra": "que guarda" },
        { "hebraico": "הַבְּרִית֙", "transliteral": "hab-bə-rîṯ", "traducao_palavra": "a aliança" },
        { "hebraico": "וְֽהַחֶ֔סֶד", "transliteral": "wə-ha-ḥe-seḏ", "traducao_palavra": "e a misericórdia/fidelidade" },
