        { "hebraico": "לְךָ֔", "transliteral": "lə-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "אֶת־הָרָשׁ֥וּם", "transliteral": "ʾeṯ-hā-rā-šūm", "traducao_palavra": "o que está registrado" },
        { "hebraico": "בִּכְתָ֥ב", "transliteral": "biḵ-ṯāḇ", "traducao_palavra": "na escritura de" },
        { "hebraico": "אֱמֶ֑ת", "transliteral": "ʾĕ-meṯ", "traducao_palavra": "verdade" },
        { "hebraico": "וְאֵ֨ין", "transliteral": "wə-ʾên", "traducao_palavra": "e ninguém" },
