        { "hebraico": "אֵלֶ֛יךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "וַעֲמֹ֥ד", "transliteral": "wa-ʿă-mōḏ", "traducao_palavra": "e põe-te em pé" },
        { "hebraico": "עַל־עָמְדֶ֖ךָ", "transliteral": "ʿal-ʿām-de-ḵā", "traducao_palavra": "no teu lugar" },
