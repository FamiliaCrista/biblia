        { "hebraico": "מַלְכֵ֥י", "transliteral": "mal-ḵê", "traducao_palavra": "os reis de" },
        { "hebraico": "פָרָֽס׃", "transliteral": "pā-rās", "traducao_palavra": "Pérsia" }
      ]
    },
    "14": {
      "traducao_completa": "Agora vim para fazer-te entender o que há de acontecer ao teu povo nos últimos dias; porque a visão é ainda para muitos dias.",
      "palavras": [
        { "hebraico": "וּבָ֨אתִי֙", "transliteral": "ū-ḇā-ṯî", "traducao_palavra": "e vim" },
        { "hebraico": "לַהֲבִֽינְךָ֔", "transliteral": "la-hă-ḇî-nə-ḵā", "traducao_palavra": "para fazer-te entender" },
        { "hebraico": "אֵ֛ת", "transliteral": "ʾêṯ", "traducao_palavra": "[objeto]" },
        { "hebraico": "אֲשֶׁר־יִקְרָ֥ה", "transliteral": "ʾă-šer-yiq-rā", "traducao_palavra": "o que há de acontecer" },
        { "hebraico": "לְעַמְּךָ֖", "transliteral": "lə-ʿam-mə-ḵā", "traducao_palavra": "ao teu povo" },
        { "hebraico": "בְּאַחֲרִ֣ית", "transliteral": "bə-ʾa-ḥă-rîṯ", "traducao_palavra": "no fim de/nos últimos" },
        { "hebraico": "הַיָּמִ֑ים", "transliteral": "hay-yā-mîm", "traducao_palavra": "os dias" },
        { "hebraico": "כִּי־עֹ֥וד", "transliteral": "kî-ʿôḏ", "traducao_palavra": "porque ainda" },
        { "hebraico": "חָזֹ֖ון", "transliteral": "ḥā-zôn", "traducao_palavra": "[é] a visão" },
        { "hebraico": "לַיָּמִֽים׃", "transliteral": "lay-yā-mîm", "traducao_palavra": "para os dias" }
      ]
    },
    "15": {
      "traducao_completa": "E, falando ele comigo estas palavras, dirigi o meu rosto para a terra e emudeci.",
      "palavras": [
        { "hebraico": "וּבְדַבְּרֹ֣ו", "transliteral": "ū-ḇə-ḏab-bə-rô", "traducao_palavra": "e enquanto ele falava" },
