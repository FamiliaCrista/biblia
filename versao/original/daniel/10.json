        { "hebraico": "וַיִּגַּע־בִּ֛י", "transliteral": "way-yiḡ-gaʿ-bî", "traducao_palavra": "e tocou-me" },
        { "hebraico": "כְּמַרְאֵ֥ה", "transliteral": "kə-mar-ʾēh", "traducao_palavra": "como aparência de" },
        { "hebraico": "אָדָ֖ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "homem" },
        { "hebraico": "וַֽיְחַזְּקֵֽנִי׃", "transliteral": "way-ḥaz-zə-qê-nî", "traducao_palavra": "e fortaleceu-me" }
