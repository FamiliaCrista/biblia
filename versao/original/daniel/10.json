        { "hebraico": "הֲיָדַ֙עְתָּ֙", "transliteral": "hă-yā-ḏaʿ-tā", "traducao_palavra": "sabes" },
        { "hebraico": "לָמָּה־בָּ֣אתִי", "transliteral": "lām-mā-ḇā-ṯî", "traducao_palavra": "por que vim" },
        { "hebraico": "אֵלֶ֔יךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a ti?" },
        { "hebraico": "וְעַתָּ֣ה", "transliteral": "wə-ʿat-tā", "traducao_palavra": "e agora" },
        { "hebraico": "אָשׁ֔וּב", "transliteral": "ʾā-šūḇ", "traducao_palavra": "tornarei" },
        { "hebraico": "לְהִלָּחֵ֖ם", "transliteral": "lə-hil-lā-ḥêm", "traducao_palavra": "a pelejar" },
        { "hebraico": "עִם־שַׂ֣ר", "transliteral": "ʿim-śar", "traducao_palavra": "contra o príncipe de" },
