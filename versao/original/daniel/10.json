        { "hebraico": "הִתְחַזַּ֔קְתִּי", "transliteral": "hiṯ-ḥaz-zaq-tî", "traducao_palavra": "fiquei fortalecido" },
        { "hebraico": "וָאֹֽמְרָ֗ה", "transliteral": "wā-ʾōm-rā", "traducao_palavra": "e disse" },
        { "hebraico": "יְדַבֵּ֥ר", "transliteral": "yə-ḏab-bêr", "traducao_palavra": "fale" },
