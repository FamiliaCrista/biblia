        { "hebraico": "חֲזַ֣ק", "transliteral": "ḥă-zaq", "traducao_palavra": "sê forte" },
        { "hebraico": "וַחֲזָ֑ק", "transliteral": "wa-ḥă-zāq", "traducao_palavra": "e sê forte!" },
        { "hebraico": "וּֽבְדַבְּרֹ֤ו", "transliteral": "ū-ḇə-ḏab-bə-rô", "traducao_palavra": "e quando ele falou" },
