        { "hebraico": "אֵלַ֡י", "transliteral": "ʾê-lay", "traducao_palavra": "a mim" },
        { "hebraico": "דָּנִיֵּ֣אל", "transliteral": "dā-nî-yêl", "traducao_palavra": "Daniel" },
        { "hebraico": "אִישׁ־חֲ֠מֻדֹות", "transliteral": "ʾîš-ḥă-mu-ḏôṯ", "traducao_palavra": "homem mui amado" },
