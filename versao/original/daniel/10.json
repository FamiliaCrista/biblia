        { "hebraico": "מִֽיכָאֵ֗ל", "transliteral": "mî-ḵā-ʾêl", "traducao_palavra": "Miguel" },
        { "hebraico": "אַחַ֛ד", "transliteral": "ʾa-ḥaḏ", "traducao_palavra": "um de" },
        { "hebraico": "הַשָּׂרִ֥ים", "transliteral": "haś-śā-rîm", "traducao_palavra": "os príncipes" },
