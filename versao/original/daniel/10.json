        { "hebraico": "עַל־שְׂפָתָ֑י", "transliteral": "ʿal-śə-p̄ā-ṯāy", "traducao_palavra": "os meus lábios" },
        { "hebraico": "וָאֶפְתַּח־פִּ֗י", "transliteral": "wā-ʾep̄-taḥ-pî", "traducao_palavra": "e abri a minha boca" },
        { "hebraico": "וָאֲדַבְּרָה֙", "transliteral": "wā-ʾă-ḏab-bə-rā", "traducao_palavra": "e falei" },
        { "hebraico": "וָאֹֽמְרָה֙", "transliteral": "wā-ʾōm-rā", "traducao_palavra": "e disse" },
        { "hebraico": "אֶל־הָעֹמֵ֣ד", "transliteral": "ʾel-hā-ʿō-mêḏ", "traducao_palavra": "àquele que estava em pé" },
        { "hebraico": "לְנֶגְדִּ֔י", "transliteral": "lə-neḡ-dî", "traducao_palavra": "diante de mim" },
        { "hebraico": "אֲדֹנִ֗י", "transliteral": "ʾă-ḏō-nî", "traducao_palavra": "meu senhor" },
        { "hebraico": "בַּמַּרְאָה֙", "transliteral": "bam-mar-ʾā", "traducao_palavra": "por causa da visão" },
        { "hebraico": "נֶהֶפְכ֤וּ", "transliteral": "ne-hep̄-ḵû", "traducao_palavra": "sobrevieram/volvera-se" },
        { "hebraico": "צִירַי֙", "transliteral": "ṣî-ray", "traducao_palavra": "as minhas dores/angústias" },
        { "hebraico": "עָלַ֔י", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "עָצַ֖רְתִּי", "transliteral": "ʿā-ṣar-tî", "traducao_palavra": "retive" },
        { "hebraico": "כֹּֽחַ׃", "transliteral": "kō-aḥ", "traducao_palavra": "força" }
      ]
    },
    "17": {
      "traducao_completa": "Como, pois, pode o servo deste meu senhor falar com este meu senhor? Porque, quanto a mim, desde agora não resta força em mim, e nem fôlego ficou em mim.",
      "palavras": [
        { "hebraico": "וְהֵ֣יךְ", "transliteral": "wə-hêḵ", "traducao_palavra": "e como" },
        { "hebraico": "יוּכַ֗ל", "transliteral": "yū-ḵal", "traducao_palavra": "pode" },
        { "hebraico": "עֶ֥בֶד", "transliteral": "ʿe-ḇeḏ", "traducao_palavra": "o servo de" },
        { "hebraico": "אֲדֹנִ֛י", "transliteral": "ʾă-ḏō-nî", "traducao_palavra": "meu senhor" },
        { "hebraico": "זֶ֖ה", "transliteral": "zeh", "traducao_palavra": "este" },
        { "hebraico": "לְדַבֵּ֣ר", "transliteral": "lə-ḏab-bêr", "traducao_palavra": "falar" },
        { "hebraico": "עִם־אֲדֹנִ֣י", "transliteral": "ʿim-ʾă-ḏō-nî", "traducao_palavra": "com meu senhor" },
        { "hebraico": "זֶ֑ה", "transliteral": "zeh", "traducao_palavra": "este?" },
        { "hebraico": "וַאֲנִ֤י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "pois quanto a mim" },
        { "hebraico": "מֵעַ֙תָּה֙", "transliteral": "mê-ʿat-tā", "traducao_palavra": "desde agora" },
        { "hebraico": "לֹֽא־יַעֲמָד־בִּ֣י", "transliteral": "lō-ya-ʿă-māḏ-bî", "traducao_palavra": "não subsiste em mim" },
        { "hebraico": "כֹ֔חַ", "transliteral": "ḵō-aḥ", "traducao_palavra": "força" },
        { "hebraico": "וּנְשָׁמָ֖ה", "transliteral": "ū-nə-šā-mā", "traducao_palavra": "e fôlego" },
