        { "hebraico": "וַאֲנִ֣י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "e saindo" },
        { "hebraico": "יֹוצֵ֔א", "transliteral": "yô-ṣê", "traducao_palavra": "eu" },
        { "hebraico": "וְהִנֵּ֥ה", "transliteral": "wə-hin-nêh", "traducao_palavra": "eis que" },
        { "hebraico": "שַׂר־יָוָ֖ן", "transliteral": "śar-yā-wān", "traducao_palavra": "o príncipe da Grécia" },
