        { "hebraico": "בַּדְּבָרִ֜ים", "transliteral": "bad-də-ḇā-rîm", "traducao_palavra": "as palavras" },
        { "hebraico": "אֲשֶׁר֩", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
