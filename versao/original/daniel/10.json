        { "hebraico": "אֲשֶׁ֨ר", "transliteral": "ʾă-šer", "traducao_palavra": "em que" },
        { "hebraico": "נָתַ֧תָּ", "transliteral": "nā-ṯat-tā", "traducao_palavra": "aplicaste/puseste" },
        { "hebraico": "אֶֽת־לִבְּךָ֛", "transliteral": "ʾeṯ-lib-bə-ḵā", "traducao_palavra": "o teu coração" },
        { "hebraico": "לְהָבִ֧ין", "transliteral": "lə-hā-ḇîn", "traducao_palavra": "para compreender" },
        { "hebraico": "וּלְהִתְעַנֹּ֛ות", "transliteral": "ū-lə-hiṯ-ʿan-nôṯ", "traducao_palavra": "e para humilhar-te" },
