    "5": {
      "traducao_completa": "E consumirão a terra da Assíria à espada, e a terra de Ninrode nas suas entradas; e ele nos livrará da Assíria, quando vier à nossa terra e quando pisar nos nossos termos.",
      "palavras": [
        { "hebraico": "וְרָע֞וּ", "transliteral": "wə-rā-ʿû", "traducao_palavra": "e destruirão/apascentarão" },
