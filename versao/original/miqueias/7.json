        { "hebraico": "יִפְחָ֔דוּ", "transliteral": "yip̄-ḥā-ḏû", "traducao_palavra": "virão com temor" },
        { "hebraico": "וְיִֽרְא֥וּ", "transliteral": "wə-yir-ʾû", "traducao_palavra": "e temerão" },
