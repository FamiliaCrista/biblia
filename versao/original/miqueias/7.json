        { "hebraico": "מָצֹור֙", "transliteral": "mā-ṣôr", "traducao_palavra": "o Egito" },
        { "hebraico": "וְעַד־נָהָ֔ר", "transliteral": "wə-ʿaḏ-nā-hār", "traducao_palavra": "até ao Rio [Eufrates]" },
        { "hebraico": "וְיָ֥ם", "transliteral": "wə-yām", "traducao_palavra": "e de mar" },
        { "hebraico": "מִיָּ֖ם", "transliteral": "mî-yām", "traducao_palavra": "a mar" },
        { "hebraico": "וְהַ֥ר", "transliteral": "wə-har", "traducao_palavra": "e de monte" },
