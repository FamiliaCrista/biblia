        { "hebraico": "גֹויִם֙", "transliteral": "gô-yim", "traducao_palavra": "as nações" },
        { "hebraico": "וְיֵבֹ֔שׁוּ", "transliteral": "wə-yê-ḇō-šû", "traducao_palavra": "e envergonhar-se-ão" },
        { "hebraico": "מִכֹּ֖ל", "transliteral": "mik-kōl", "traducao_palavra": "de todo" },
        { "hebraico": "גְּבוּרָתָ֑ם", "transliteral": "gə-ḇū-rā-ṯām", "traducao_palavra": "o seu poder" },
