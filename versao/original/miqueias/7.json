        { "hebraico": "יִרְגְּז֖וּ", "transliteral": "yir-gə-zû", "traducao_palavra": "tremendo sairão" },
        { "hebraico": "מִמִּסְגְּרֹֽתֵיהֶ֑ם", "transliteral": "mim-mis-gə-rō-ṯê-hem", "traducao_palavra": "das suas fortalezas/esconderijos" },
        { "hebraico": "אֶל־יְהוָ֤ה", "transliteral": "ʾel-YHWH", "traducao_palavra": "a YHWH" },
