        { "hebraico": "עָפָר֙", "transliteral": "ʿā-p̄ār", "traducao_palavra": "o pó" },
        { "hebraico": "כַּנָּחָ֔שׁ", "transliteral": "kan-nā-ḥāš", "traducao_palavra": "como a serpente" },
        { "hebraico": "כְּזֹחֲלֵ֣י", "transliteral": "kə-zō-ḥă-lê", "traducao_palavra": "como os que rastejam/répteis de" },
