        { "hebraico": "לָעַד֙", "transliteral": "lā-ʿaḏ", "traducao_palavra": "para sempre" },
        { "hebraico": "אַפֹּ֔ו", "transliteral": "ʾap-pô", "traducao_palavra": "a sua ira" },
        { "hebraico": "כִּֽי־חָפֵ֥ץ", "transliteral": "kî-ḥā-p̄êṣ", "traducao_palavra": "porque tem prazer em" },
