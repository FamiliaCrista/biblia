        { "hebraico": "יַ֖עַר", "transliteral": "ya-ʿar", "traducao_palavra": "no bosque" },
        { "hebraico": "בְּתֹ֣וךְ", "transliteral": "bə-ṯôḵ", "traducao_palavra": "no meio do" },
        { "hebraico": "כַּרְמֶ֑ל", "transliteral": "kar-mel", "traducao_palavra": "Carmelo" },
        { "hebraico": "יִרְע֥וּ", "transliteral": "yir-ʿû", "traducao_palavra": "pastem em" },
        { "hebraico": "בָשָׁ֛ן", "transliteral": "ḇā-šān", "traducao_palavra": "Basã" },
        { "hebraico": "וְגִלְעָ֖ד", "transliteral": "wə-ḡil-ʿāḏ", "traducao_palavra": "e Gileade" },
        { "hebraico": "כִּימֵ֥י", "transliteral": "kî-mê", "traducao_palavra": "como nos dias de" },
        { "hebraico": "עֹולָֽם׃", "transliteral": "ʿô-lām", "traducao_palavra": "antiguidade" }
      ]
