      ]
    },
    "17": {
      "traducao_completa": "Lamberão o pó como a serpente; como os répteis da terra, tremendo, sairão dos seus esconderijos; com pavor virão a YHWH, nosso Deus, e de ti terão medo.",
      "palavras": [
