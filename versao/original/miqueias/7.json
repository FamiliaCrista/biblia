        { "hebraico": "יְרַֽחֲמֵ֔נוּ", "transliteral": "yə-ra-ḥă-mê-nû", "traducao_palavra": "ter compaixão de nós" },
        { "hebraico": "יִכְבֹּ֖שׁ", "transliteral": "yiḵ-bōš", "traducao_palavra": "subjugará" },
        { "hebraico": "עֲוֹנֹתֵ֑ינוּ", "transliteral": "ʿă-wō-nō-ṯê-nû", "traducao_palavra": "as nossas iniquidades" },
        { "hebraico": "וְתַשְׁלִ֛יךְ", "transliteral": "wə-ṯaš-lîḵ", "traducao_palavra": "e lançarás" },
