        { "hebraico": "אֲשֶׁר־נִשְׁבַּ֥עְתָּ", "transliteral": "ʾă-šer-niš-baʿ-tā", "traducao_palavra": "as quais juraste" },
        { "hebraico": "לַאֲבֹתֵ֖ינוּ", "transliteral": "la-ʾă-ḇō-ṯê-nû", "traducao_palavra": "a nossos pais" },
