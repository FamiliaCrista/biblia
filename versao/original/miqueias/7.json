        { "hebraico": "עַמְּךָ֣", "transliteral": "ʿam-mə-ḵā", "traducao_palavra": "o teu povo" },
        { "hebraico": "בְשִׁבְטֶ֗ךָ", "transliteral": "ḇə-šiḇ-ṭe-ḵā", "traducao_palavra": "com a tua vara" },
        { "hebraico": "צֹ֚אן", "transliteral": "ṣōn", "traducao_palavra": "o rebanho de" },
        { "hebraico": "נַחֲלָתֶ֔ךָ", "transliteral": "na-ḥă-lā-ṯe-ḵā", "traducao_palavra": "tua herança" },
        { "hebraico": "שֹׁכְנִ֣י", "transliteral": "šō-ḵə-nî", "traducao_palavra": "que habita" },
