        { "hebraico": "וְעָדֶ֣יךָ", "transliteral": "wə-ʿā-ḏe-ḵā", "traducao_palavra": "até ti" },
        { "hebraico": "יָבֹ֔וא", "transliteral": "yā-ḇô", "traducao_palavra": "se virá" },
        { "hebraico": "לְמִנִּ֥י", "transliteral": "lə-min-nî", "traducao_palavra": "desde" },
        { "hebraico": "אַשּׁ֖וּר", "transliteral": "ʾaš-šūr", "traducao_palavra": "a Assíria" },
