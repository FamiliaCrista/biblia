        { "hebraico": "הָאָ֛רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "לִשְׁמָמָ֖ה", "transliteral": "liš-mā-mā", "traducao_palavra": "para desolação" },
        { "hebraico": "עַל־יֹשְׁבֶ֑יהָ", "transliteral": "ʿal-yō-šə-ḇe-hā", "traducao_palavra": "por causa dos seus moradores" },
        { "hebraico": "מִפְּרִ֖י", "transliteral": "mip-pə-rî", "traducao_palavra": "pelo fruto de" },
        { "hebraico": "מַֽעַלְלֵיהֶֽם׃", "transliteral": "ma-ʿal-lê-hem", "traducao_palavra": "suas ações" }
      ]
    },
    "14": {
      "traducao_completa": "Apascenta o teu povo com a tua vara, o rebanho da tua herança, que habita a sós no bosque, no meio do Carmelo; pastem em Basã e Gileade, como nos dias da antiguidade.",
      "palavras": [
