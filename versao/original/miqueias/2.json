{
  "livro": "Miqueias - מִיכָה - Mîḵā",
  "capítulo": 2,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ai daqueles que maquinam a iniquidade e tramam o mal nos seus leitos! Pela manhã, raiando a luz, o praticam, porque está no poder da sua mão.",
      "palavras": [
        { "hebraico": "הֹ֣וי", "transliteral": "hôy", "traducao_palavra": "ai de" },
        { "hebraico": "חֹֽשְׁבֵי־אָ֧וֶן", "transliteral": "ḥō-šə-ḇê-ʾā-wen", "traducao_palavra": "os que maquinam iniquidade" },
        { "hebraico": "וּפֹעֲלֵי־רָ֖ע", "transliteral": "ū-p̄ō-ʿă-lê-rāʿ", "traducao_palavra": "e os que praticam o mal" },
        { "hebraico": "עַל־מִשְׁכְּבֹותָ֑ם", "transliteral": "ʿal-miš-kə-ḇô-ṯām", "traducao_palavra": "nos seus leitos!" },
        { "hebraico": "בְּאֹ֤ור", "transliteral": "bə-ʾôr", "traducao_palavra": "ao romper da luz de" },
        { "hebraico": "הַבֹּ֙קֶר֙", "transliteral": "hab-bō-qer", "traducao_palavra": "a manhã" },
        { "hebraico": "יַעֲשׂ֔וּהָ", "transliteral": "ya-ʿă-śū-hā", "traducao_palavra": "o executam" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "יֶשׁ־לְאֵ֥ל", "transliteral": "yeš-lə-ʾêl", "traducao_palavra": "está no poder de" },
        { "hebraico": "יָדָֽם׃", "transliteral": "yā-ḏām", "traducao_palavra": "sua mão" }
      ]
    },
    "2": {
      "traducao_completa": "E cobiçam campos e os arrebatam; e casas, e as tomam; assim oprimem o homem e a sua casa, o indivíduo e a sua herança.",
      "palavras": [
        { "hebraico": "וְחָמְד֤וּ", "transliteral": "wə-ḥā-mə-ḏû", "traducao_palavra": "e cobiçam" },
        { "hebraico": "שָׂדֹות֙", "transliteral": "śā-ḏôṯ", "traducao_palavra": "campos" },
        { "hebraico": "וְגָזָ֔לוּ", "transliteral": "wə-ḡā-zā-lû", "traducao_palavra": "e os arrebatam/roubam" },
        { "hebraico": "וּבָתִּ֖ים", "transliteral": "ū-ḇāt-tîm", "traducao_palavra": "e casas" },
        { "hebraico": "וְנָשָׂ֑אוּ", "transliteral": "wə-nā-śā-ʾû", "traducao_palavra": "e as tomam" },
        { "hebraico": "וְעָֽשְׁקוּ֙", "transliteral": "wə-ʿāš-qû", "traducao_palavra": "e oprimem" },
        { "hebraico": "גֶּ֣בֶר", "transliteral": "ge-ḇer", "traducao_palavra": "ao homem" },
        { "hebraico": "וּבֵיתֹ֔ו", "transliteral": "ū-ḇê-ṯô", "traducao_palavra": "e à sua casa" },
        { "hebraico": "וְאִ֖ישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "ao indivíduo" },
        { "hebraico": "וְנַחֲלָתֹֽו׃", "transliteral": "wə-na-ḥă-lā-ṯô", "traducao_palavra": "e à sua herança" }
      ]
    },
    "3": {
      "traducao_completa": "Portanto, assim diz YHWH: Eis que projeto um mal contra esta família, do qual não tirareis os vossos pescoços; e não andareis altivamente, porque o tempo será mau.",
      "palavras": [
        { "hebraico": "לָכֵ֗ן", "transliteral": "lā-ḵên", "traducao_palavra": "portanto" },
        { "hebraico": "כֹּ֚ה", "transliteral": "kōh", "traducao_palavra": "assim" },
        { "hebraico": "אָמַ֣ר", "transliteral": "ʾā-mar", "traducao_palavra": "diz" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH:" },
        { "hebraico": "הִנְנִ֥י", "transliteral": "hin-nə-nî", "traducao_palavra": "eis que eu" },
        { "hebraico": "חֹשֵׁ֛ב", "transliteral": "ḥō-šêḇ", "traducao_palavra": "estou maquinando/planejando" },
        { "hebraico": "עַל־הַמִּשְׁפָּחָ֥ה", "transliteral": "ʿal-ham-miš-pā-ḥā", "traducao_palavra": "contra a família" },
        { "hebraico": "הַזֹּ֖את", "transliteral": "haz-zōṯ", "traducao_palavra": "esta" },
        { "hebraico": "רָעָ֑ה", "transliteral": "rā-ʿā", "traducao_palavra": "um mal" },
        { "hebraico": "אֲ֠שֶׁר", "transliteral": "ʾă-šer", "traducao_palavra": "do qual" },
        { "hebraico": "לֹא־תָמִ֨ישׁוּ", "transliteral": "lō-ṯā-mî-šū", "traducao_palavra": "não retirareis" },
        { "hebraico": "מִשָּׁ֝ם", "transliteral": "miš-šām", "traducao_palavra": "dali" },
        { "hebraico": "צַוְּארֹֽתֵיכֶ֗ם", "transliteral": "ṣaw-wə-rō-ṯê-ḵem", "traducao_palavra": "os vossos pescoços" },
        { "hebraico": "וְלֹ֤א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "תֵֽלְכוּ֙", "transliteral": "ṯê-lə-ḵû", "traducao_palavra": "andareis" },
        { "hebraico": "רֹומָ֔ה", "transliteral": "rô-mā", "traducao_palavra": "altivamente" },
        { "hebraico": "כִּ֛י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "עֵ֥ת", "transliteral": "ʿêṯ", "traducao_palavra": "um tempo" },
        { "hebraico": "רָעָ֖ה", "transliteral": "rā-ʿā", "traducao_palavra": "mau" },
        { "hebraico": "הִֽיא׃", "transliteral": "hî", "traducao_palavra": "é este" }
      ]
    },
    "4": {
      "traducao_completa": "Naquele dia se levantará contra vós um provérbio, e se pranteará um pranto amargo, dizendo: Fomos de todo destruídos! A porção do meu povo ele a muda! Como ele a tira de mim! Reparte os nossos campos aos rebeldes!",
      "palavras": [
        { "hebraico": "בַּיֹּ֨ום", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "הַה֜וּא", "transliteral": "ha-hû", "traducao_palavra": "aquele" },
        { "hebraico": "יִשְׂרָאֵ֔ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "[contra vós]" },
        { "hebraico": "יִשָּׂ֧א", "transliteral": "yiś-śā", "traducao_palavra": "se levantará" },
        { "hebraico": "עֲלֵיכֶ֣ם", "transliteral": "ʿă-lê-ḵem", "traducao_palavra": "sobre vós" },
        { "hebraico": "מָשָׁ֗ל", "transliteral": "mā-šāl", "traducao_palavra": "um provérbio/sátira" },
        { "hebraico": "וְנָהָ֨ה", "transliteral": "wə-nā-hā", "traducao_palavra": "e se lamentará" },
        { "hebraico": "נְהִ֤י", "transliteral": "nə-hî", "traducao_palavra": "um lamento" },
        { "hebraico": "נִהְיָה֙", "transliteral": "nih-yā", "traducao_palavra": "doloroso" },
        { "hebraico": "אָמַר֙", "transliteral": "ʾā-mar", "traducao_palavra": "dizendo:" },
        { "hebraico": "שָׁדֹ֣וד", "transliteral": "šā-ḏôḏ", "traducao_palavra": "totalmente" },
        { "hebraico": "נְשַׁדֻּ֔נוּ", "transliteral": "nə-šad-du-nû", "traducao_palavra": "fomos destruídos/despojados" },
        { "hebraico": "חֵ֥לֶק", "transliteral": "ḥê-leq", "traducao_palavra": "a porção de" },
        { "hebraico": "עַמִּ֖י", "transliteral": "ʿam-mî", "traducao_palavra": "meu povo" },
        { "hebraico": "יָמִ֑יר", "transliteral": "yā-mîr", "traducao_palavra": "ele transfere/muda" },
        { "hebraico": "אֵ֚יךְ", "transliteral": "ʾêḵ", "traducao_palavra": "como" },
        { "hebraico": "יָמִ֣ישׁ", "transliteral": "yā-mîš", "traducao_palavra": "ele a retira" },
        { "hebraico": "לִ֔י", "transliteral": "lî", "traducao_palavra": "de mim!" },
        { "hebraico": "לְשֹׁובֵ֥ב", "transliteral": "lə-šô-ḇêḇ", "traducao_palavra": "ao apóstata/rebelde" },
        { "hebraico": "שָׂדֵ֖ינוּ", "transliteral": "śā-ḏê-nû", "traducao_palavra": "os nossos campos" },
        { "hebraico": "יְחַלֵּֽק׃", "transliteral": "yə-ḥal-lêq", "traducao_palavra": "ele reparte" }
      ]
    },
    "5": {
      "traducao_completa": "Portanto, não terás quem lance o cordel por sorte na congregação de YHWH.",
      "palavras": [
        { "hebraico": "לָכֵן֙", "transliteral": "lā-ḵên", "traducao_palavra": "portanto" },
        { "hebraico": "לֹא־יִהְיֶ֣ה", "transliteral": "lō-yih-yeh", "traducao_palavra": "não terás" },
        { "hebraico": "לְךָ֔", "transliteral": "lə-ḵā", "traducao_palavra": "para ti" },
        { "hebraico": "מַשְׁלִ֥יךְ", "transliteral": "maš-lîḵ", "traducao_palavra": "quem lance" },
        { "hebraico": "חֶ֖בֶל", "transliteral": "ḥe-ḇel", "traducao_palavra": "o cordel de medir" },
        { "hebraico": "בְּגֹורָ֑ל", "transliteral": "bə-ḡô-rāl", "traducao_palavra": "por sorte" },
        { "hebraico": "בִּקְהַ֖ל", "transliteral": "biq-hal", "traducao_palavra": "na congregação de" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "6": {
      "traducao_completa": "Não profetizeis, dizem eles aos que profetizam; não devem profetizar acerca destas coisas; a vergonha não nos alcançará.",
      "palavras": [
        { "hebraico": "אַל־תַּטִּ֖יפוּ", "transliteral": "ʾal-taṭ-ṭî-p̄ū", "traducao_palavra": "não profetizeis/gotejeis" },
        { "hebraico": "יַטִּיפ֑וּן", "transliteral": "yaṭ-ṭî-p̄ūn", "traducao_palavra": "profetizam eles" },
        { "hebraico": "לֹא־יַטִּ֣יפוּ", "transliteral": "lō-yaṭ-ṭî-p̄ū", "traducao_palavra": "não profetizarão" },
        { "hebraico": "לָאֵ֔לֶּה", "transliteral": "lā-ʾêl-leh", "traducao_palavra": "acerca destas coisas" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
