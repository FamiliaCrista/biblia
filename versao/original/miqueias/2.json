        { "hebraico": "כְּלִמֹּֽות׃", "transliteral": "kə-lim-môṯ", "traducao_palavra": "o opróbrio/humilhação" }
      ]
    },
    "7": {
      "traducao_completa": "Ó vós que sois chamados casa de Jacó, encurtou-se o Espírito de YHWH? São estas as suas obras? Porventura as minhas palavras não fazem bem ao que anda retamente?",
      "palavras": [
        { "hebraico": "הֶאָמ֣וּר", "transliteral": "he-ʾā-mūr", "traducao_palavra": "ó vós que sois chamados" },
        { "hebraico": "בֵּֽית־יַעֲקֹ֗ב", "transliteral": "bêṯ-ya-ʿă-qōḇ", "traducao_palavra": "casa de Jacó" },
        { "hebraico": "הֲקָצַר֙", "transliteral": "hă-qā-ṣar", "traducao_palavra": "acaso encurtou-se" },
        { "hebraico": "ר֣וּחַ", "transliteral": "rū-aḥ", "traducao_palavra": "o Espírito de" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH?" },
        { "hebraico": "אִם־אֵ֖לֶּה", "transliteral": "ʾim-ʾêl-leh", "traducao_palavra": "são estas" },
        { "hebraico": "מַעֲלָלָ֑יו", "transliteral": "ma-ʿă-lā-lāyw", "traducao_palavra": "as suas obras?" },
        { "hebraico": "הֲלֹ֤וא", "transliteral": "hă-lô", "traducao_palavra": "porventura não" },
        { "hebraico": "דְבָרַי֙", "transliteral": "də-ḇā-ray", "traducao_palavra": "as minhas palavras" },
        { "hebraico": "יֵיטִ֔יבוּ", "transliteral": "yê-ṭî-ḇû", "traducao_palavra": "fazem o bem" },
        { "hebraico": "עִ֖ם", "transliteral": "ʿim", "traducao_palavra": "àquele que" },
        { "hebraico": "הַיָּשָׁ֥ר", "transliteral": "hay-yā-šār", "traducao_palavra": "retamente" },
        { "hebraico": "הֹולֵֽךְ׃", "transliteral": "hō-lêḵ", "traducao_palavra": "anda?" }
      ]
    },
    "8": {
      "traducao_completa": "Mas de há pouco o meu povo se levantou como um inimigo; de sobre a vestidura tirais a capa aos que passam seguros, como homens que voltam da guerra.",
      "palavras": [
        { "hebraico": "וְאֶתְמ֗וּל", "transliteral": "wə-ʾeṯ-mūl", "traducao_palavra": "mas recentemente/há pouco" },
        { "hebraico": "עַמִּי֙", "transliteral": "ʿam-mî", "traducao_palavra": "o meu povo" },
        { "hebraico": "לְאֹויֵ֣ב", "transliteral": "lə-ʾô-yêḇ", "traducao_palavra": "como inimigo" },
        { "hebraico": "יְקֹומֵ֔ם", "transliteral": "yə-qô-mêm", "traducao_palavra": "se levanta" },
        { "hebraico": "מִמּ֥וּל", "transliteral": "mim-mūl", "traducao_palavra": "de defronte da" },
        { "hebraico": "שַׂלְמָ֖ה", "transliteral": "śal-mā", "traducao_palavra": "túnica/veste" },
        { "hebraico": "אֶ֣דֶר", "transliteral": "ʾe-ḏer", "traducao_palavra": "o manto de valor" },
        { "hebraico": "תַּפְשִׁט֑וּן", "transliteral": "tap̄-ši-ṭūn", "traducao_palavra": "arrancais/despojais" },
        { "hebraico": "מֵעֹבְרִ֣ים", "transliteral": "mê-ʿō-ḇə-rîm", "traducao_palavra": "dos que passam" },
        { "hebraico": "בֶּ֔טַח", "transliteral": "be-ṭaḥ", "traducao_palavra": "despreocupados/em confiança" },
        { "hebraico": "שׁוּבֵ֖י", "transliteral": "šū-ḇê", "traducao_palavra": "que voltam da" },
        { "hebraico": "מִלְחָמָֽה׃", "transliteral": "mil-ḥā-mā", "traducao_palavra": "batalha" }
      ]
    },
    "9": {
      "traducao_completa": "As mulheres do meu povo vós as expulsais das suas casas agradáveis; dos seus filhinhos tirais para sempre a minha glória.",
      "palavras": [
        { "hebraico": "נְשֵׁ֤י", "transliteral": "nə-šê", "traducao_palavra": "as mulheres de" },
        { "hebraico": "עַמִּי֙", "transliteral": "ʿam-mî", "traducao_palavra": "meu povo" },
        { "hebraico": "תְּגָ֣רְשׁ֔וּן", "transliteral": "tə-ḡā-rə-šūn", "traducao_palavra": "vós expulsais" },
        { "hebraico": "מִבֵּ֖ית", "transliteral": "mib-bêṯ", "traducao_palavra": "da casa de" },
        { "hebraico": "תַּעֲנֻגֶ֑יהָ", "transliteral": "ta-ʿă-nu-ḡe-hā", "traducao_palavra": "suas delícias" },
        { "hebraico": "מֵעַל֙", "transliteral": "mê-ʿal", "traducao_palavra": "de sobre" },
        { "hebraico": "עֹֽלָלֶ֔יהָ", "transliteral": "ʿō-lā-le-hā", "traducao_palavra": "os seus filhinhos" },
        { "hebraico": "תִּקְח֥וּ", "transliteral": "tiq-ḥû", "traducao_palavra": "tirais" },
        { "hebraico": "הֲדָרִ֖י", "transliteral": "hă-ḏā-rî", "traducao_palavra": "o meu resplendor/glória" },
        { "hebraico": "לְעֹולָֽם׃", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre" }
      ]
    },
    "10": {
      "traducao_completa": "Levantai-vos e andai, porque este não é o vosso descanso; por causa da imundícia que traz destruição, sim, destruição irreparável.",
      "palavras": [
        { "hebraico": "ק֣וּמוּ", "transliteral": "qū-mû", "traducao_palavra": "levantai-vos" },
        { "hebraico": "וּלְכ֔וּ", "transliteral": "ū-lə-ḵû", "traducao_palavra": "e ide-vos" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לֹא־זֹ֖את", "transliteral": "lō-zōṯ", "traducao_palavra": "não é este" },
        { "hebraico": "הַמְּנוּחָ֑ה", "transliteral": "ham-mə-nū-ḥā", "traducao_palavra": "o descanso" },
        { "hebraico": "בַּעֲב֥וּר", "transliteral": "ba-ʿă-ḇūr", "traducao_palavra": "por causa de" },
        { "hebraico": "טָמְאָ֛ה", "transliteral": "ṭā-mə-ʾā", "traducao_palavra": "estar contaminada" },
        { "hebraico": "תַּחְבֹּ֖ל", "transliteral": "taḥ-bōl", "traducao_palavra": "ela vos destruirá" },
        { "hebraico": "וְחֶ֥בֶל", "transliteral": "wə-ḥe-ḇel", "traducao_palavra": "e com destruição" },
        { "hebraico": "נִמְרָֽץ׃", "transliteral": "nim-rāṣ", "traducao_palavra": "dolorosa/atroz" }
      ]
    },
    "11": {
      "traducao_completa": "Se um homem que anda no espírito de falsidade mentir, dizendo: Eu te profetizarei de vinho e de bebida forte; este tal será o profeta deste povo.",
      "palavras": [
        { "hebraico": "לוּ־אִ֞ישׁ", "transliteral": "lū-ʾîš", "traducao_palavra": "se um homem" },
        { "hebraico": "הֹלֵ֥ךְ", "transliteral": "hō-lêḵ", "traducao_palavra": "andando no" },
        { "hebraico": "ר֙וּחַ֙", "transliteral": "rū-aḥ", "traducao_palavra": "vento" },
        { "hebraico": "וָשֶׁ֣קֶר", "transliteral": "wā-še-qer", "traducao_palavra": "e na falsidade" },
        { "hebraico": "כִּזֵּ֔ב", "transliteral": "kiz-zêḇ", "traducao_palavra": "mentisse dizendo:" },
