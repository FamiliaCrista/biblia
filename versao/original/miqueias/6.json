        { "hebraico": "חָמָ֔ס", "transliteral": "ḥā-mās", "traducao_palavra": "violência" },
        { "hebraico": "וְיֹשְׁבֶ֖יהָ", "transliteral": "wə-yō-šə-ḇe-hā", "traducao_palavra": "e os seus moradores" },
        { "hebraico": "דִּבְּרוּ־שָׁ֑קֶר", "transliteral": "dib-bə-rū-šā-qer", "traducao_palavra": "falam mentiras" },
        { "hebraico": "וּלְשֹׁונָ֖ם", "transliteral": "ū-lə-šô-nām", "traducao_palavra": "e a sua língua" },
        { "hebraico": "רְמִיָּ֥ה", "transliteral": "rə-mî-yā", "traducao_palavra": "é enganosa" },
        { "hebraico": "בְּפִיהֶֽם׃", "transliteral": "bə-p̄î-hem", "traducao_palavra": "na sua boca." }
      ]
    },
    "13": {
      "traducao_completa": "Por isso também te enfraquecerei com feridas, assolando-te por causa dos teus pecados.",
      "palavras": [
        { "hebraico": "וְגַם־אֲנִ֖י", "transliteral": "wə-ḡam-ʾă-nî", "traducao_palavra": "por isso também eu" },
        { "hebraico": "הֶחֱלֵ֣יתִי", "transliteral": "he-ḥĕ-lê-ṯî", "traducao_palavra": "te farei adoecer" },
        { "hebraico": "הַכֹּותֶ֑ךָ", "transliteral": "hak-kô-ṯe-ḵā", "traducao_palavra": "ao ferir-te" },
        { "hebraico": "הַשְׁמֵ֖ם", "transliteral": "haš-mêm", "traducao_palavra": "assolando-te" },
        { "hebraico": "עַל־חַטֹּאתֶֽךָ׃", "transliteral": "ʿal-ḥaṭ-ṭō-ṯe-ḵā", "traducao_palavra": "por causa dos teus pecados." }
      ]
    },
    "14": {
      "traducao_completa": "Tu comerás, mas não te fartarás, e a tua fome estará no meio de ti; e removerás os teus bens, mas não os salvarás; e aquilo que salvares, eu o entregarei à espada.",
      "palavras": [
        { "hebraico": "אַתָּ֤ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "תֹאכַל֙", "transliteral": "ṯō-ḵal", "traducao_palavra": "comerás" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "mas não" },
        { "hebraico": "תִשְׂבָּ֔ע", "transliteral": "tiś-bāʿ", "traducao_palavra": "te fartarás" },
        { "hebraico": "וְיֶשְׁחֲךָ֖", "transliteral": "wə-yeš-ḥă-ḵā", "traducao_palavra": "e o teu vazio/fome estará" },
        { "hebraico": "בְּקִרְבֶּ֑ךָ", "transliteral": "bə-qir-be-ḵā", "traducao_palavra": "nas tuas entranhas" },
        { "hebraico": "וְתַסֵּג֙", "transliteral": "wə-ṯas-sêḡ", "traducao_palavra": "e removerás" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "mas não" },
        { "hebraico": "תַפְלִ֔יט", "transliteral": "tap̄-lîṭ", "traducao_palavra": "salvarás" },
        { "hebraico": "וַאֲשֶׁ֥ר", "transliteral": "wa-ʾă-šer", "traducao_palavra": "e o que" },
        { "hebraico": "תְּפַלֵּ֖ט", "transliteral": "tə-p̄al-lêṭ", "traducao_palavra": "salvares" },
        { "hebraico": "לַחֶ֥רֶב", "transliteral": "la-ḥe-reḇ", "traducao_palavra": "à espada" },
        { "hebraico": "אֶתֵּֽן׃", "transliteral": "ʾet-tên", "traducao_palavra": "eu o entregarei." }
      ]
    },
    "15": {
      "traducao_completa": "Tu semearás, mas não ceifarás; pisarás a azeitona, mas não te ungirás com azeite; e pisarás o mosto, mas não beberás o vinho.",
      "palavras": [
        { "hebraico": "אַתָּ֥ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "תִזְרַ֖ע", "transliteral": "tiz-raʿ", "traducao_palavra": "semearás" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "mas não" },
        { "hebraico": "תִקְצֹ֑ור", "transliteral": "tiq-ṣôr", "traducao_palavra": "ceifarás" },
        { "hebraico": "אַתָּ֤ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "תִדְרֹךְ־זַ֙יִת֙", "transliteral": "tiḏ-rōḵ-za-yiṯ", "traducao_palavra": "pisarás a azeitona" },
        { "hebraico": "וְלֹא־תָס֣וּךְ", "transliteral": "wə-lō-ṯā-sūḵ", "traducao_palavra": "mas não te ungirás com" },
        { "hebraico": "שֶׁ֔מֶן", "transliteral": "še-men", "traducao_palavra": "azeite" },
        { "hebraico": "וְתִירֹ֖ושׁ", "transliteral": "wə-ṯî-rôš", "traducao_palavra": "e [pisarás] o mosto" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "mas não" },
        { "hebraico": "תִשְׁתֶּה־יָּֽיִן׃", "transliteral": "tiš-teh-yā-yin", "traducao_palavra": "beberás vinho." }
      ]
    },
    "16": {
      "traducao_completa": "Porque se guardam os estatutos de Onri e todas as obras da casa de Acabe, e vós andais nos conselhos deles; para que eu te entregue à desolação, e os seus habitantes ao assobio; assim levareis o opróbrio do meu povo.",
      "palavras": [
        { "hebraico": "וְיִשְׁתַּמֵּ֞ר", "transliteral": "wə-yiš-tam-mêr", "traducao_palavra": "porque se observam" },
        { "hebraico": "חֻקֹּ֣ות", "transliteral": "ḥuq-qôṯ", "traducao_palavra": "os estatutos de" },
        { "hebraico": "עָמְרִ֗י", "transliteral": "ʿām-rî", "traducao_palavra": "Onri" },
        { "hebraico": "וְכֹל֙", "transliteral": "wə-ḵōl", "traducao_palavra": "e toda" },
        { "hebraico": "מַעֲשֵׂ֣ה", "transliteral": "ma-ʿă-śêh", "traducao_palavra": "a obra de" },
        { "hebraico": "בֵית־אַחְאָ֔ב", "transliteral": "bêṯ-ʾaḥ-ʾāḇ", "traducao_palavra": "a casa de Acabe" },
        { "hebraico": "וַתֵּלְכ֖וּ", "transliteral": "wat-tê-lə-ḵû", "traducao_palavra": "e andais" },
        { "hebraico": "בְּמֹֽעֲצֹותָ֑ם", "transliteral": "bə-mō-ʿă-ṣô-ṯām", "traducao_palavra": "nos seus conselhos" },
        { "hebraico": "לְמַעַן֩", "transliteral": "lə-ma-ʿan", "traducao_palavra": "para que" },
        { "hebraico": "תִּתִּ֨י", "transliteral": "tit-tî", "traducao_palavra": "eu te entregue" },
        { "hebraico": "אֹתְךָ֜", "transliteral": "ʾō-ṯə-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "לְשַׁמָּ֗ה", "transliteral": "lə-šam-mā", "traducao_palavra": "à desolação" },
        { "hebraico": "וְיֹשְׁבֶ֙יהָ֙", "transliteral": "wə-yō-šə-ḇe-hā", "traducao_palavra": "e os seus moradores" },
        { "hebraico": "לִשְׁרֵקָ֔ה", "transliteral": "liš-rê-qā", "traducao_palavra": "ao escárnio/assobio" },
        { "hebraico": "וְחֶרְפַּ֥ת", "transliteral": "wə-ḥer-paṯ", "traducao_palavra": "e o opróbrio de" },
        { "hebraico": "עַמִּ֖י", "transliteral": "ʿam-mî", "traducao_palavra": "meu povo" },
        { "hebraico": "תִּשָּֽׂאוּ׃", "transliteral": "tiś-śā-ʾû", "traducao_palavra": "levareis." }
      ]
    }
