        { "hebraico": "שְׁאֵ֣ר", "transliteral": "šə-ʾêr", "traducao_palavra": "a carne de" },
        { "hebraico": "עַמִּי֒", "transliteral": "ʿam-mî", "traducao_palavra": "meu povo" },
        { "hebraico": "וְעֹורָם֙", "transliteral": "wə-ʿô-rām", "traducao_palavra": "e a sua pele" },
