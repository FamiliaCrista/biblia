      ]
    },
    "2": {
      "traducao_completa": "Vós que odiais o bem e amais o mal, que arrancais a sua pele de cima deles e a sua carne de cima dos seus ossos;",
      "palavras": [
        { "hebraico": "שֹׂנְאֵ֥י", "transliteral": "śō-nə-ʾê", "traducao_palavra": "vós que odiais" },
        { "hebraico": "טֹוב֙", "transliteral": "ṭôḇ", "traducao_palavra": "o bem" },
        { "hebraico": "וְאֹ֣הֲבֵי", "transliteral": "wə-ʾō-hă-ḇê", "traducao_palavra": "e amais" },
        { "hebraico": "רָ֔ע", "transliteral": "rāʿ", "traducao_palavra": "o mal" },
        { "hebraico": "גֹּזְלֵ֤י", "transliteral": "gō-zə-lê", "traducao_palavra": "que arrancais" },
        { "hebraico": "עֹורָם֙", "transliteral": "ʿô-rām", "traducao_palavra": "a pele deles" },
        { "hebraico": "מֵֽעֲלֵיהֶ֔ם", "transliteral": "mê-ʿă-lê-hem", "traducao_palavra": "de sobre eles" },
        { "hebraico": "וּשְׁאֵרָ֖ם", "transliteral": "ū-šə-ʾê-rām", "traducao_palavra": "e a carne deles" },
        { "hebraico": "מֵעַ֥ל", "transliteral": "mê-ʿal", "traducao_palavra": "de sobre" },
        { "hebraico": "עַצְמֹותָֽם׃", "transliteral": "ʿaṣ-mô-ṯām", "traducao_palavra": "os seus ossos;" }
      ]
    },
    "3": {
      "traducao_completa": "e que comeis a carne do meu povo, e lhes esfolais a pele, e lhes esmiuçais os ossos, e os repartis como para a panela e como carne dentro do caldeirão.",
      "palavras": [
        { "hebraico": "וַאֲשֶׁ֣ר", "transliteral": "wa-ʾă-šer", "traducao_palavra": "e que" },
