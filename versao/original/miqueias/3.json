        { "hebraico": "פִּשְׁעֹ֔ו", "transliteral": "piš-ʿô", "traducao_palavra": "a sua transgressão" },
        { "hebraico": "וּלְיִשְׂרָאֵ֖ל", "transliteral": "ū-lə-yiś-rā-ʾēl", "traducao_palavra": "e a Israel" },
        { "hebraico": "חַטָּאתֹֽו׃", "transliteral": "ḥaṭ-ṭā-ṯô", "traducao_palavra": "o seu pecado." }
      ]
    },
    "9": {
      "traducao_completa": "Ouvi agora isto, vós, chefes da casa de Jacó, e vós, governantes da casa de Israel, que abominais o juízo e perverteis tudo o que é reto,",
      "palavras": [
        { "hebraico": "שִׁמְעוּ־נָ֣א", "transliteral": "šim-ʿū-nā", "traducao_palavra": "ouvi, peço-vos" },
        { "hebraico": "זֹ֗את", "transliteral": "zōṯ", "traducao_palavra": "isto" },
        { "hebraico": "רָאשֵׁי֙", "transliteral": "rā-šê", "traducao_palavra": "ó chefes de" },
        { "hebraico": "בֵּ֣ית", "transliteral": "bêṯ", "traducao_palavra": "a casa de" },
        { "hebraico": "יַעֲקֹ֔ב", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" },
        { "hebraico": "וּקְצִינֵ֖י", "transliteral": "ū-qə-ṣî-nê", "traducao_palavra": "e governantes de" },
