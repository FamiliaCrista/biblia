    "5": {
      "traducao_completa": "Assim diz YHWH acerca dos profetas que fazem errar o meu povo, que mordem com os seus dentes e clamam: Paz! Mas contra aquele que nada lhes dá na boca preparam guerra:",
      "palavras": [
        { "hebraico": "כֹּ֚ה", "transliteral": "kōh", "traducao_palavra": "assim" },
        { "hebraico": "אָמַ֣ר", "transliteral": "ʾā-mar", "traducao_palavra": "diz" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "עַל־הַנְּבִיאִ֖ים", "transliteral": "ʿal-han-nə-ḇî-ʾîm", "traducao_palavra": "acerca dos profetas" },
        { "hebraico": "הַמַּתְעִ֣ים", "transliteral": "ham-maṯ-ʿîm", "traducao_palavra": "que desencaminham" },
