    "11": {
      "traducao_completa": "Os seus chefes dão as sentenças por suborno, os seus sacerdotes ensinam por interesse, e os seus profetas adivinham por dinheiro; e ainda se encostam a YHWH, dizendo: Não está YHWH no meio de nós? Nenhum mal nos sobrevirá.",
      "palavras": [
        { "hebraico": "רָאשֶׁ֣יהָ", "transliteral": "rā-še-hā", "traducao_palavra": "os seus chefes" },
        { "hebraico": "בְּשֹׁ֣חַד", "transliteral": "bə-šō-ḥaḏ", "traducao_palavra": "por suborno" },
