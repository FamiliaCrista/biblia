        { "hebraico": "הִפְשִׁ֔יטוּ", "transliteral": "hip̄-šî-ṭû", "traducao_palavra": "esfolais" },
        { "hebraico": "וְאֶת־עַצְמֹֽתֵיהֶ֖ם", "transliteral": "wə-ʾeṯ-ʿaṣ-mō-ṯê-hem", "traducao_palavra": "e os seus ossos" },
