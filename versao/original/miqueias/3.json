        { "hebraico": "וְקָדַ֥ר", "transliteral": "wə-qā-ḏar", "traducao_palavra": "e escurecerá" },
        { "hebraico": "עֲלֵיהֶ֖ם", "transliteral": "ʿă-lê-hem", "traducao_palavra": "sobre eles" },
        { "hebraico": "הַיֹּֽום׃", "transliteral": "hay-yôm", "traducao_palavra": "o dia." }
