        { "hebraico": "הַחֹזִ֗ים", "transliteral": "ha-ḥō-zîm", "traducao_palavra": "os videntes" },
        { "hebraico": "וְחָֽפְרוּ֙", "transliteral": "wə-ḥā-p̄ə-rû", "traducao_palavra": "e se confundirão" },
        { "hebraico": "הַקֹּ֣סְמִ֔ים", "transliteral": "haq-qō-sə-mîm", "traducao_palavra": "os adivinhos" },
