        { "hebraico": "הַנֹּשְׁכִ֤ים", "transliteral": "han-nō-šə-ḵîm", "traducao_palavra": "que mastigam/mordem" },
        { "hebraico": "בְּשִׁנֵּיהֶם֙", "transliteral": "bə-šin-nê-hem", "traducao_palavra": "com os seus dentes" },
        { "hebraico": "וְקָרְא֣וּ", "transliteral": "wə-qā-rə-ʾû", "traducao_palavra": "e proclamam:" },
        { "hebraico": "שָׁלֹ֔ום", "transliteral": "šā-lôm", "traducao_palavra": "Paz!" },
        { "hebraico": "וַאֲשֶׁ֨ר", "transliteral": "wa-ʾă-šer", "traducao_palavra": "mas para quem" },
        { "hebraico": "לֹא־יִתֵּ֜ן", "transliteral": "lō-yit-tên", "traducao_palavra": "não lhes põe nada" },
