        { "hebraico": "מִשְׁפָּ֔ט", "transliteral": "miš-pāṭ", "traducao_palavra": "o juízo" },
        { "hebraico": "וְאֵ֥ת", "transliteral": "wə-ʾêṯ", "traducao_palavra": "e" },
        { "hebraico": "כָּל־הַיְשָׁרָ֖ה", "transliteral": "kāl-hay-šā-rā", "traducao_palavra": "tudo o que é reto" },
        { "hebraico": "יְעַקֵּֽשׁוּ׃", "transliteral": "yə-ʿaq-qê-šû", "traducao_palavra": "perverteis;" }
