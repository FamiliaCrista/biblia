        { "hebraico": "שִׁמְעוּ־נָא֙", "transliteral": "šim-ʿū-nā", "traducao_palavra": "ouvi, peço-vos" },
        { "hebraico": "רָאשֵׁ֣י", "transliteral": "rā-šê", "traducao_palavra": "ó chefes de" },
        { "hebraico": "יַעֲקֹ֔ב", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" },
        { "hebraico": "וּקְצִינֵ֖י", "transliteral": "ū-qə-ṣî-nê", "traducao_palavra": "e governantes de" },
        { "hebraico": "בֵּ֣ית", "transliteral": "bêṯ", "traducao_palavra": "a casa de" },
        { "hebraico": "יִשְׂרָאֵ֑ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel:" },
