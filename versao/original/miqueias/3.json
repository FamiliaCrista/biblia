        { "hebraico": "וּפָרְשׂוּ֙", "transliteral": "ū-p̄ā-rə-śû", "traducao_palavra": "e os cortais em pedaços" },
        { "hebraico": "כַּאֲשֶׁ֣ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "como" },
        { "hebraico": "בַּסִּ֔יר", "transliteral": "bas-sîr", "traducao_palavra": "para a panela" },
        { "hebraico": "וּכְבָשָׂ֖ר", "transliteral": "ū-ḵə-ḇā-śār", "traducao_palavra": "e como carne" },
