        { "hebraico": "עָלָ֛יו", "transliteral": "ʿā-lāyw", "traducao_palavra": "contra ele" },
        { "hebraico": "מִלְחָמָֽה׃", "transliteral": "mil-ḥā-mā", "traducao_palavra": "a guerra." }
      ]
    },
    "6": {
      "traducao_completa": "Portanto, se vos fará noite sem visão, e tereis trevas sem adivinhação; e pôr-se-á o sol sobre esses profetas, e sobre eles o dia se escurecerá.",
      "palavras": [
        { "hebraico": "לָכֵ֞ן", "transliteral": "lā-ḵên", "traducao_palavra": "portanto" },
        { "hebraico": "לַ֤יְלָה", "transliteral": "lay-lā", "traducao_palavra": "noite haverá" },
        { "hebraico": "לָכֶם֙", "transliteral": "lā-ḵem", "traducao_palavra": "para vós" },
        { "hebraico": "מֵֽחָזֹ֔ון", "transliteral": "mê-ḥā-zôn", "traducao_palavra": "sem visão" },
        { "hebraico": "וְחָשְׁכָ֥ה", "transliteral": "wə-ḥāš-ḵā", "traducao_palavra": "e escuridão" },
        { "hebraico": "לָכֶ֖ם", "transliteral": "lā-ḵem", "traducao_palavra": "para vós" },
