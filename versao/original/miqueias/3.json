        { "hebraico": "אֱלֹהִֽים׃", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus." }
      ]
    },
    "8": {
      "traducao_completa": "Mas eu estou cheio da força do Espírito de YHWH, e de juízo e de coragem, para declarar a Jacó a sua transgressão e a Israel o seu pecado.",
      "palavras": [
        { "hebraico": "וְאוּלָ֗ם", "transliteral": "wə-ʾū-lām", "traducao_palavra": "mas verdadeiramente" },
        { "hebraico": "אָנֹכִ֞י", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "eu" },
        { "hebraico": "מָלֵ֤אתִי", "transliteral": "mā-lê-ṯî", "traducao_palavra": "estou cheio de" },
        { "hebraico": "כֹ֙חַ֙", "transliteral": "ḵō-aḥ", "traducao_palavra": "força" },
        { "hebraico": "אֶת־ר֣וּחַ", "transliteral": "ʾeṯ-rū-aḥ", "traducao_palavra": "com o Espírito de" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וּמִשְׁפָּ֖ט", "transliteral": "ū-miš-pāṭ", "traducao_palavra": "e de juízo" },
