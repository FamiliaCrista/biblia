        { "hebraico": "וּבָ֤את", "transliteral": "ū-ḇāṯ", "traducao_palavra": "e chegarás" },
        { "hebraico": "עַד־בָּבֶל֙", "transliteral": "ʿaḏ-bā-ḇel", "traducao_palavra": "até à Babilônia" },
