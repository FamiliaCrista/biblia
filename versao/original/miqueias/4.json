{
  "livro": "Miqueias - מִיכָה - Mîḵā",
  "capítulo": 4,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Mas nos últimos dias acontecerá que o monte da casa de YHWH será estabelecido no cume dos montes, e se elevará sobre os outeiros, e a ele afluirão os povos.",
      "palavras": [
        { "hebraico": "וְהָיָ֣ה", "transliteral": "wə-hā-yā", "traducao_palavra": "e acontecerá que" },
        { "hebraico": "בְּאַחֲרִ֣ית", "transliteral": "bə-ʾa-ḥă-rîṯ", "traducao_palavra": "no fim de/nos últimos" },
        { "hebraico": "הַיָּמִ֗ים", "transliteral": "hay-yā-mîm", "traducao_palavra": "dias" },
        { "hebraico": "יִ֠הְיֶה", "transliteral": "yih-yeh", "traducao_palavra": "será" },
        { "hebraico": "הַ֣ר", "transliteral": "har", "traducao_palavra": "o monte de" },
        { "hebraico": "בֵּית־יְהוָ֞ה", "transliteral": "bêṯ-YHWH", "traducao_palavra": "a casa de YHWH" },
        { "hebraico": "נָכֹ֤ון", "transliteral": "nā-ḵôn", "traducao_palavra": "estabelecido" },
        { "hebraico": "בְּרֹאשׁ֙", "transliteral": "bə-rōš", "traducao_palavra": "no cume de" },
        { "hebraico": "הֶהָרִ֔ים", "transliteral": "he-hā-rîm", "traducao_palavra": "os montes" },
        { "hebraico": "וְנִשָּׂ֥א", "transliteral": "wə-niś-śā", "traducao_palavra": "e se elevará" },
        { "hebraico": "ה֖וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "מִגְּבָעֹ֑ות", "transliteral": "miḡ-gə-ḇā-ʿôṯ", "traducao_palavra": "acima das colinas" },
        { "hebraico": "וְנָהֲר֥וּ", "transliteral": "wə-nā-hă-rû", "traducao_palavra": "e afluirão" },
        { "hebraico": "עָלָ֖יו", "transliteral": "ʿā-lāyw", "traducao_palavra": "a ele" },
        { "hebraico": "עַמִּֽים׃", "transliteral": "ʿam-mîm", "traducao_palavra": "povos" }
      ]
    },
    "2": {
      "traducao_completa": "E irão muitas nações, e dirão: Vinde, e subamos ao monte de YHWH, e à casa do Deus de Jacó, para que nos ensine os seus caminhos, e andemos pelas suas veredas; porque de Sião sairá a lei, e de Jerusalém a palavra de YHWH.",
      "palavras": [
        { "hebraico": "וְֽהָלְכ֞וּ", "transliteral": "wə-hāl-ḵû", "traducao_palavra": "e irão" },
        { "hebraico": "גֹּויִ֣ם", "transliteral": "gô-yim", "traducao_palavra": "nações" },
        { "hebraico": "רַבִּ֗ים", "transliteral": "rab-bîm", "traducao_palavra": "muitas" },
        { "hebraico": "וְאָמְרוּ֙", "transliteral": "wə-ʾā-mə-rû", "traducao_palavra": "e dirão:" },
        { "hebraico": "לְכ֣וּ", "transliteral": "lə-ḵû", "traducao_palavra": "vinde" },
        { "hebraico": "וְנַעֲלֶ֣ה", "transliteral": "wə-na-ʿă-leh", "traducao_palavra": "e subamos" },
        { "hebraico": "אֶל־הַר־יְהוָ֗ה", "transliteral": "ʾel-har-YHWH", "traducao_palavra": "ao monte de YHWH" },
        { "hebraico": "וְאֶל־בֵּית֙", "transliteral": "wə-ʾel-bêṯ", "traducao_palavra": "e à casa de" },
        { "hebraico": "אֱלֹהֵ֣י", "transliteral": "ʾĕ-lō-hê", "traducao_palavra": "o Deus de" },
        { "hebraico": "יַעֲקֹ֔ב", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" },
        { "hebraico": "וְיֹורֵ֙נוּ֙", "transliteral": "wə-yô-rê-nû", "traducao_palavra": "para que nos ensine" },
        { "hebraico": "מִדְּרָכָ֔יו", "transliteral": "mid-də-rā-ḵāyw", "traducao_palavra": "os seus caminhos" },
        { "hebraico": "וְנֵלְכָ֖ה", "transliteral": "wə-nê-lə-ḵā", "traducao_palavra": "e andemos" },
        { "hebraico": "בְּאֹֽרְחֹתָ֑יו", "transliteral": "bə-ʾōr-ḥō-ṯāyw", "traducao_palavra": "nas suas veredas" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "מִצִּיֹּון֙", "transliteral": "miṣ-ṣî-yôn", "traducao_palavra": "de Sião" },
        { "hebraico": "תֵּצֵ֣א", "transliteral": "tê-ṣê", "traducao_palavra": "sairá" },
        { "hebraico": "תֹורָ֔ה", "transliteral": "tô-rā", "traducao_palavra": "a lei/instrução" },
        { "hebraico": "וּדְבַר־יְהוָ֖ה", "transliteral": "ū-ḏə-ḇar-YHWH", "traducao_palavra": "e a palavra de YHWH" },
        { "hebraico": "מִירוּשָׁלִָֽם׃", "transliteral": "mî-rū-šā-lā-yim", "traducao_palavra": "de Jerusalém" }
      ]
    },
    "3": {
      "traducao_completa": "E ele julgará entre muitos povos, e arbitrará sobre nações poderosas e longínquas; e converterão as suas espadas em relhas de arado e as suas lanças em foices; uma nação não levantará espada contra outra nação, nem aprenderão mais a guerra.",
      "palavras": [
        { "hebraico": "וְשָׁפַ֗ט", "transliteral": "wə-šā-p̄aṭ", "traducao_palavra": "e julgará" },
        { "hebraico": "בֵּ֚ין", "transliteral": "bên", "traducao_palavra": "entre" },
        { "hebraico": "עַמִּ֣ים", "transliteral": "ʿam-mîm", "traducao_palavra": "povos" },
        { "hebraico": "רַבִּ֔ים", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
        { "hebraico": "וְהֹוכִ֞יחַ", "transliteral": "wə-hô-ḵî-aḥ", "traducao_palavra": "e arbitrará/repreenderá" },
        { "hebraico": "לְגֹויִ֧ם", "transliteral": "lə-ḡô-yim", "traducao_palavra": "a nações" },
        { "hebraico": "עֲצֻמִ֛ים", "transliteral": "ʿă-ṣu-mîm", "traducao_palavra": "poderosas" },
        { "hebraico": "עַד־רָחֹ֑וק", "transliteral": "ʿaḏ-rā-ḥôq", "traducao_palavra": "até longe" },
        { "hebraico": "וְכִתְּת֨וּ", "transliteral": "wə-ḵit-tə-ṯû", "traducao_palavra": "e forjarão/converterão" },
        { "hebraico": "חַרְבֹתֵיהֶ֜ם", "transliteral": "ḥar-ḇō-ṯê-hem", "traducao_palavra": "as suas espadas" },
        { "hebraico": "לְאִתִּ֗ים", "transliteral": "lə-ʾit-tîm", "traducao_palavra": "em relhas de arado" },
        { "hebraico": "וַחֲנִיתֹֽתֵיהֶם֙", "transliteral": "wa-ḥă-nî-ṯō-ṯê-hem", "traducao_palavra": "e as suas lanças" },
        { "hebraico": "לְמַזְמֵרֹ֔ות", "transliteral": "lə-maz-mê-rôṯ", "traducao_palavra": "em foices de podar" },
        { "hebraico": "לֹֽא־יִשְׂא֞וּ", "transliteral": "lō-yiś-ʾû", "traducao_palavra": "não levantará" },
        { "hebraico": "גֹּ֤וי", "transliteral": "gôy", "traducao_palavra": "nação" },
        { "hebraico": "אֶל־גֹּוי֙", "transliteral": "ʾel-gôy", "traducao_palavra": "contra nação" },
        { "hebraico": "חֶ֔רֶב", "transliteral": "ḥe-reḇ", "traducao_palavra": "espada" },
        { "hebraico": "וְלֹֽא־יִלְמְד֥וּן", "transliteral": "wə-lō-yil-mə-ḏūn", "traducao_palavra": "nem aprenderão" },
        { "hebraico": "עֹ֖וד", "transliteral": "ʿôḏ", "traducao_palavra": "mais" },
        { "hebraico": "מִלְחָמָֽה׃", "transliteral": "mil-ḥā-mā", "traducao_palavra": "a guerra" }
      ]
    },
    "4": {
      "traducao_completa": "Mas assentar-se-á cada um debaixo da sua videira e debaixo da sua figueira, e não haverá quem os espante, porque a boca de YHWH dos Exércitos o disse.",
      "palavras": [
        { "hebraico": "וְיָשְׁב֗וּ", "transliteral": "wə-yā-šə-ḇû", "traducao_palavra": "e assentar-se-ão" },
        { "hebraico": "אִ֣ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada um" },
        { "hebraico": "תַּ֧חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "debaixo de" },
        { "hebraico": "גַּפְנֹ֛ו", "transliteral": "gap̄-nô", "traducao_palavra": "sua videira" },
        { "hebraico": "וְתַ֥חַת", "transliteral": "wə-ṯa-ḥaṯ", "traducao_palavra": "e debaixo de" },
        { "hebraico": "תְּאֵנָתֹ֖ו", "transliteral": "tə-ʾê-nā-ṯô", "traducao_palavra": "sua figueira" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não haverá" },
        { "hebraico": "מַחֲרִ֑יד", "transliteral": "ma-ḥă-rîḏ", "traducao_palavra": "quem os atemorize" },
        { "hebraico": "כִּי־פִ֛י", "transliteral": "kî-p̄î", "traducao_palavra": "porque a boca de" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹ֖ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "dos Exércitos" },
        { "hebraico": "דִּבֵּֽר׃", "transliteral": "dib-bêr", "traducao_palavra": "o disse" }
      ]
    },
    "5": {
      "traducao_completa": "Porque todos os povos andam, cada um em nome do seu deus; mas nós andaremos no nome de YHWH, nosso Deus, para todo o sempre.",
      "palavras": [
        { "hebraico": "כִּ֚י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "כָּל־הָ֣עַמִּ֔ים", "transliteral": "kāl-hā-ʿam-mîm", "traducao_palavra": "todos os povos" },
        { "hebraico": "יֵלְכ֕וּ", "transliteral": "yê-lə-ḵû", "traducao_palavra": "andam" },
        { "hebraico": "אִ֖ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada um" },
        { "hebraico": "בְּשֵׁ֣ם", "transliteral": "bə-šêm", "traducao_palavra": "em nome de" },
        { "hebraico": "אֱלֹהָ֑יו", "transliteral": "ʾĕ-lō-hāyw", "traducao_palavra": "seu deus" },
        { "hebraico": "וַאֲנַ֗חְנוּ", "transliteral": "wa-ʾă-naḥ-nû", "traducao_palavra": "mas nós" },
        { "hebraico": "נֵלֵ֛ךְ", "transliteral": "nê-lêḵ", "traducao_palavra": "andaremos" },
        { "hebraico": "בְּשֵׁם־יְהוָ֥ה", "transliteral": "bə-šêm-YHWH", "traducao_palavra": "no nome de YHWH" },
        { "hebraico": "אֱלֹהֵ֖ינוּ", "transliteral": "ʾĕ-lō-hê-nû", "traducao_palavra": "nosso Deus" },
        { "hebraico": "לְעֹולָ֥ם", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre" },
        { "hebraico": "וָעֶֽד׃", "transliteral": "wā-ʿeḏ", "traducao_palavra": "e eternamente" }
      ]
    },
    "6": {
      "traducao_completa": "Naquele dia, diz YHWH, congregarei a que coxeia, e recolherei a que foi expulsa, e a que eu tinha afligido;",
      "palavras": [
        { "hebraico": "בַּיֹּ֨ום", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "הַה֜וּא", "transliteral": "ha-hû", "traducao_palavra": "aquele" },
        { "hebraico": "נְאֻם־יְהוָ֗ה", "transliteral": "nə-ʾum-YHWH", "traducao_palavra": "declaração de YHWH" },
        { "hebraico": "אֹֽסְפָה֙", "transliteral": "ʾōs-p̄ā", "traducao_palavra": "recolherei" },
        { "hebraico": "הַצֹּ֣לֵעָ֔ה", "transliteral": "haṣ-ṣō-lê-ʿā", "traducao_palavra": "a que coxeia" },
        { "hebraico": "וְהַנִּדָּחָ֖ה", "transliteral": "wə-han-nid-dā-ḥā", "traducao_palavra": "e a que foi expulsa" },
        { "hebraico": "אֲקַבֵּ֑צָה", "transliteral": "ʾă-qab-bê-ṣā", "traducao_palavra": "congregarei" },
        { "hebraico": "וַאֲשֶׁ֥ר", "transliteral": "wa-ʾă-šer", "traducao_palavra": "e a quem" },
        { "hebraico": "הֲרֵעֹֽותִי׃", "transliteral": "hă-rê-ʿô-ṯî", "traducao_palavra": "eu afligi" }
      ]
    },
    "7": {
      "traducao_completa": "e farei da que coxeava um remanescente, e da que tinha sido arrojada para longe, uma nação poderosa; e YHWH reinará sobre eles no monte Sião, desde agora e para sempre.",
      "palavras": [
        { "hebraico": "וְשַׂמְתִּ֤י", "transliteral": "wə-śam-tî", "traducao_palavra": "e farei" },
        { "hebraico": "אֶת־הַצֹּֽלֵעָה֙", "transliteral": "ʾeṯ-haṣ-ṣō-lê-ʿā", "traducao_palavra": "da que coxeia" },
        { "hebraico": "לִשְׁאֵרִ֔ית", "transliteral": "liš-ʾê-rîṯ", "traducao_palavra": "um remanescente" },
        { "hebraico": "וְהַנַּהֲלָאָ֖ה", "transliteral": "wə-han-na-hă-lā-ʾā", "traducao_palavra": "e da que foi arrojada para longe" },
        { "hebraico": "לְגֹ֣וי", "transliteral": "lə-ḡôy", "traducao_palavra": "em uma nação" },
        { "hebraico": "עָצ֑וּם", "transliteral": "ʿā-ṣūm", "traducao_palavra": "poderosa" },
        { "hebraico": "וּמָלַ֨ךְ", "transliteral": "ū-mā-laḵ", "traducao_palavra": "e reinará" },
        { "hebraico": "יְהוָ֤ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "עֲלֵיהֶם֙", "transliteral": "ʿă-lê-hem", "traducao_palavra": "sobre eles" },
        { "hebraico": "בְּהַ֣ר", "transliteral": "bə-har", "traducao_palavra": "no monte" },
        { "hebraico": "צִיֹּ֔ון", "transliteral": "ṣî-yôn", "traducao_palavra": "Sião" },
        { "hebraico": "מֵעַתָּ֖ה", "transliteral": "mê-ʿat-tā", "traducao_palavra": "desde agora" },
        { "hebraico": "וְעַד־עֹולָֽם׃", "transliteral": "wə-ʿaḏ-ʿô-lām", "traducao_palavra": "e para sempre" }
      ]
    },
    "8": {
      "traducao_completa": "E a ti, ó torre do rebanho, fortaleza da filha de Sião, a ti virá; sim, virá o primeiro domínio, o reino da filha de Jerusalém.",
      "palavras": [
        { "hebraico": "וְאַתָּ֣ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "e tu" },
        { "hebraico": "מִגְדַּל־עֵ֗דֶר", "transliteral": "miḡ-dal-ʿê-ḏer", "traducao_palavra": "ó torre do rebanho [Migdal-Éder]" },
        { "hebraico": "עֹ֛פֶל", "transliteral": "ʿō-p̄el", "traducao_palavra": "fortaleza de" },
        { "hebraico": "בַּת־צִיֹּ֖ון", "transliteral": "baṯ-ṣî-yôn", "traducao_palavra": "a filha de Sião" },
        { "hebraico": "עָדֶ֣יךָ", "transliteral": "ʿā-ḏe-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "תֵּאתֶ֑ה", "transliteral": "tê-ṯeh", "traducao_palavra": "virá" },
        { "hebraico": "וּבָאָ֗ה", "transliteral": "ū-ḇā-ʾā", "traducao_palavra": "sim virá" },
        { "hebraico": "הַמֶּמְשָׁלָה֙", "transliteral": "ham-mem-šā-lā", "traducao_palavra": "o domínio" },
        { "hebraico": "הָרִ֣אשֹׁנָ֔ה", "transliteral": "hā-ri-šō-nā", "traducao_palavra": "primeiro" },
        { "hebraico": "מַמְלֶ֥כֶת", "transliteral": "mam-le-ḵeṯ", "traducao_palavra": "o reino" },
        { "hebraico": "לְבַת־יְרוּשָׁלִָֽם׃", "transliteral": "lə-ḇaṯ-yə-rū-šā-lā-yim", "traducao_palavra": "da filha de Jerusalém" }
      ]
    },
    "9": {
      "traducao_completa": "Agora, por que gritas tão fortemente? Não há rei em ti? Pereceu o teu conselheiro, de sorte que de ti se apoderaram dores como da que está de parto?",
      "palavras": [
        { "hebraico": "עַתָּ֕ה", "transliteral": "ʿat-tā", "traducao_palavra": "agora" },
        { "hebraico": "לָ֥מָּה", "transliteral": "lām-mā", "traducao_palavra": "por que" },
        { "hebraico": "תָרִ֖יעִי", "transliteral": "ṯā-rî-ʿî", "traducao_palavra": "gritas com alarido" },
        { "hebraico": "רֵ֑עַ", "transliteral": "rē-aʿ", "traducao_palavra": "ruidosamente?" },
        { "hebraico": "הֲמֶ֣לֶךְ", "transliteral": "hă-me-leḵ", "traducao_palavra": "acaso rei" },
        { "hebraico": "אֵֽין־בָּ֗ךְ", "transliteral": "ʾên-bāḵ", "traducao_palavra": "não há em ti?" },
        { "hebraico": "אִם־יֹועֲצֵךְ֙", "transliteral": "ʾim-yô-ʿă-ṣêḵ", "traducao_palavra": "ou o teu conselheiro" },
        { "hebraico": "אָבָ֔ד", "transliteral": "ʾā-ḇāḏ", "traducao_palavra": "pereceu" },
        { "hebraico": "כִּֽי־הֶחֱזִיקֵ֥ךְ", "transliteral": "kî-he-ḥĕ-zî-qêḵ", "traducao_palavra": "que te tomaram" },
        { "hebraico": "חִ֖יל", "transliteral": "ḥîl", "traducao_palavra": "dores" },
        { "hebraico": "כַּיֹּולֵדָֽה׃", "transliteral": "kay-yô-lê-ḏā", "traducao_palavra": "como de mulher de parto?" }
      ]
    },
    "10": {
