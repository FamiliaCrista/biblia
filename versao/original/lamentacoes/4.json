        { "hebraico": "מְשִׁ֣יחַ", "transliteral": "mə-šî-aḥ", "traducao_palavra": "o ungido de" },
        { "hebraico": "יְהוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
