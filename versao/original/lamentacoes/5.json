      ]
    },
    "17": {
      "traducao_completa": "Por isso está desfalecido o nosso coração; por estas coisas se escureceram os nossos olhos.",
      "palavras": [
        { "hebraico": "עַל־זֶה", "transliteral": "ʿal-zeh", "traducao_palavra": "por isso" },
