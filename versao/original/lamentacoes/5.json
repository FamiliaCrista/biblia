        { "hebraico": "כָּשָֽׁלוּ׃", "transliteral": "kā-šā-lû", "traducao_palavra": "tropeçaram" }
      ]
    },
    "14": {
      "traducao_completa": "Os anciãos cessaram das portas, os jovens do seu canto.",
