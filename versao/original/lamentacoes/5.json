    },
    "16": {
      "traducao_completa": "Caiu a coroa da nossa cabeça; ai de nós, porque pecamos!",
      "palavras": [
        { "hebraico": "נָפְלָ֖ה", "transliteral": "nā-p̄ə-lā", "traducao_palavra": "caiu" },
