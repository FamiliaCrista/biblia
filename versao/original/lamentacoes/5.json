        { "hebraico": "פֹּרֵ֖ק", "transliteral": "pō-rēq", "traducao_palavra": "livrador/quem resgate" },
        { "hebraico": "אֵ֥ין", "transliteral": "ʾên", "traducao_palavra": "não há" },
        { "hebraico": "מִיָּדָֽם׃", "transliteral": "miy-yā-ḏām", "traducao_palavra": "da mão deles" }
      ]
    },
    "9": {
      "traducao_completa": "Com perigo das nossas vidas trazemos o nosso pão, por causa da espada do deserto.",
