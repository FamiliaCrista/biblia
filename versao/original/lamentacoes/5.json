{
  "livro": "Lamentações - אֵיכָה - Eikhah",
  "capítulo": 5,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Lembra-te, ó YHWH, do que nos tem sucedido; considera e olha para o nosso opróbrio.",
      "palavras": [
        { "hebraico": "זְכֹ֥ר", "transliteral": "zə-ḵōr", "traducao_palavra": "lembra-te" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מֶֽה־הָיָ֣ה", "transliteral": "meh-hā-yā", "traducao_palavra": "o que aconteceu" },
        { "hebraico": "לָ֑נוּ", "transliteral": "lā-nû", "traducao_palavra": "a nós" },
        { "hebraico": "הַבִּ֖יטָה", "transliteral": "hab-bî-ṭā", "traducao_palavra": "considera" },
        { "hebraico": "וּרְאֵ֥ה", "transliteral": "ū-rə-ʾēh", "traducao_palavra": "e olha" },
        { "hebraico": "אֶת־חֶרְפָּתֵֽנוּ׃", "transliteral": "ʾeṯ-ḥer-pā-ṯê-nû", "traducao_palavra": "o nosso opróbrio" }
      ]
    },
    "2": {
      "traducao_completa": "A nossa herança passou a estranhos, as nossas casas a estrangeiros.",
      "palavras": [
        { "hebraico": "נַחֲלָתֵנוּ", "transliteral": "na-ḥă-lā-ṯê-nû", "traducao_palavra": "nossa herança" },
        { "hebraico": "נֶהֶפְכָה", "transliteral": "ne-hep̄-ḵā", "traducao_palavra": "passou/mudou" },
        { "hebraico": "לְזָרִים", "transliteral": "lə-zā-rîm", "traducao_palavra": "a estranhos" },
        { "hebraico": "בָּתֵּ֖ינוּ", "transliteral": "ḇāt-tê-nû", "traducao_palavra": "nossas casas" },
        { "hebraico": "לְנָכְרִֽים׃", "transliteral": "lə-nā-ḵə-rîm", "traducao_palavra": "a estrangeiros" }
      ]
    },
    "3": {
      "traducao_completa": "Órfãos somos, sem pai; as nossas mães são como viúvas.",
      "palavras": [
        { "hebraico": "יְתֹומִים", "transliteral": "yə-ṯô-mîm", "traducao_palavra": "órfãos" },
        { "hebraico": "הָיִ֖ינוּ", "transliteral": "hā-yî-nû", "traducao_palavra": "somos" },
        { "hebraico": "אֵ֣ין", "transliteral": "ʾên", "traducao_palavra": "sem" },
        { "hebraico": "אָ֑ב", "transliteral": "ʾāḇ", "traducao_palavra": "pai" },
        { "hebraico": "אִמֹּתֵ֖ינוּ", "transliteral": "ʾim-mō-ṯê-nû", "traducao_palavra": "nossas mães" },
        { "hebraico": "כְּאַלְמָנֹֽות׃", "transliteral": "kə-ʾal-mā-nôṯ", "traducao_palavra": "como viúvas" }
      ]
    },
    "4": {
      "traducao_completa": "A nossa água bebemos por dinheiro; a nossa lenha por preço a compramos.",
      "palavras": [
        { "hebraico": "מֵימֵ֖ינוּ", "transliteral": "mê-mê-nû", "traducao_palavra": "nossa água" },
        { "hebraico": "בְּכֶ֣סֶף", "transliteral": "bə-ḵe-sep̄", "traducao_palavra": "por dinheiro" },
        { "hebraico": "שָׁתִ֑ינוּ", "transliteral": "šā-ṯî-nû", "traducao_palavra": "bebemos" },
        { "hebraico": "עֵצֵ֖ינוּ", "transliteral": "ʿē-ṣê-nû", "traducao_palavra": "nossa lenha" },
        { "hebraico": "בִּמְחִ֥יר", "transliteral": "bim-ḥîr", "traducao_palavra": "por preço" },
        { "hebraico": "יָבֹֽאוּ׃", "transliteral": "yā-ḇō-ʾû", "traducao_palavra": "a compramos [literal: entram]" }
      ]
    },
    "5": {
      "traducao_completa": "Os nossos perseguidores estão sobre os nossos pescoços; estamos cansados e não temos descanso.",
      "palavras": [
        { "hebraico": "עַל־צַוָּארֵ֖נוּ", "transliteral": "ʿal-ṣaw-wā-rê-nû", "traducao_palavra": "sobre nossos pescoços" },
        { "hebraico": "נִרְדָּ֑פְנוּ", "transliteral": "nir-dā-p̄ə-nû", "traducao_palavra": "somos perseguidos" },
        { "hebraico": "יָגַ֖עְנוּ", "transliteral": "yā-ḡaʿ-nû", "traducao_palavra": "estamos cansados" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "הוּנַֽח־לָֽנוּ׃", "transliteral": "hû-naḥ-lā-nû", "traducao_palavra": "não temos descanso" }
      ]
    },
    "6": {
      "traducao_completa": "Ao Egito demos a mão, e à Assíria, para nos fartarmos de pão.",
      "palavras": [
        { "hebraico": "מִצְרַיִם", "transliteral": "miṣ-ra-yim", "traducao_palavra": "Egito" },
