        { "hebraico": "אֲבֹתֵ֥ינוּ", "transliteral": "ʾă-ḇô-ṯê-nû", "traducao_palavra": "nossos pais" },
        { "hebraico": "חָטְא֖וּ", "transliteral": "ḥā-ṭə-ʾû", "traducao_palavra": "pecaram" },
        { "hebraico": "אֵינָ֑ם", "transliteral": "ʾê-nām", "traducao_palavra": "já não existem" },
        { "hebraico": "וַאֲנַ֖חְנוּ", "transliteral": "wa-ʾă-naḥ-nû", "traducao_palavra": "e nós" },
        { "hebraico": "עֲוֹנֹתָ֥ם", "transliteral": "ʿă-wō-nō-ṯām", "traducao_palavra": "as iniquidades deles" },
