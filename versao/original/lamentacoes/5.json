        { "hebraico": "יָ֑ד", "transliteral": "yāḏ", "traducao_palavra": "a mão" },
        { "hebraico": "אַשּׁוּר", "transliteral": "ʾaš-šûr", "traducao_palavra": "Assíria" },
        { "hebraico": "לִשְׂבֹּ֥עַ", "transliteral": "liš-bō-aʿ", "traducao_palavra": "para nos fartarmos" },
        { "hebraico": "לָֽחֶם׃", "transliteral": "lā-ḥem", "traducao_palavra": "de pão" }
      ]
    },
    "7": {
      "traducao_completa": "Nossos pais pecaram, e já não existem; e nós levamos as suas iniquidades.",
