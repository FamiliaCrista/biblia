        { "hebraico": "בְּנַפְשֵׁ֖נוּ", "transliteral": "bə-nap̄-šê-nû", "traducao_palavra": "com nossas vidas" },
        { "hebraico": "נָבִ֣יא", "transliteral": "nā-ḇî", "traducao_palavra": "trazemos" },
        { "hebraico": "לַחְמֵ֑נוּ", "transliteral": "laḥ-mē-nû", "traducao_palavra": "nosso pão" },
        { "hebraico": "מִפְּנֵ֖י", "transliteral": "mip-pə-nê", "traducao_palavra": "por causa de" },
        { "hebraico": "חֶ֥רֶב", "transliteral": "ḥe-reḇ", "traducao_palavra": "espada" },
