        { "hebraico": "תֵצֵ֖א", "transliteral": "ṯê-ṣê", "traducao_palavra": "sai" },
        { "hebraico": "הָרָעֹ֥ות", "transliteral": "hā-rā-ʿôṯ", "traducao_palavra": "os males" },
