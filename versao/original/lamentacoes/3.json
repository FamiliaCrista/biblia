        { "hebraico": "אָדָ֖ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "o homem" },
        { "hebraico": "בְּרִיבֹ֑ו", "transliteral": "bə-rî-ḇô", "traducao_palavra": "em sua causa" },
        { "hebraico": "אֲדֹנָ֥י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
