        { "hebraico": "אֲנִ֥י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
        { "hebraico": "מַנְגִּינָתָֽם׃", "transliteral": "man-gî-nā-ṯām", "traducao_palavra": "a canção deles" }
      ]
