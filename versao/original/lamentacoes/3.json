        { "hebraico": "תַּ֣חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "debaixo de" },
        { "hebraico": "רַגְלָ֔יו", "transliteral": "raḡ-lāyw", "traducao_palavra": "seus pés" },
        { "hebraico": "כֹּ֖ל", "transliteral": "kōl", "traducao_palavra": "todos" },
        { "hebraico": "אֲסִירֵ֥י", "transliteral": "ʾă-sî-rê", "traducao_palavra": "os presos de" },
