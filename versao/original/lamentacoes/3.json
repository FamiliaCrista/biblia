        { "hebraico": "חַיָּתִ֑י", "transliteral": "ḥay-yā-ṯî", "traducao_palavra": "minha vida" },
        { "hebraico": "וַיַּדּוּ", "transliteral": "way-yaḏ-dû", "traducao_palavra": "e lançaram" },
