        { "hebraico": "תַּאֲלָתְךָ֖", "transliteral": "ta-ʾă-lā-ṯə-ḵā", "traducao_palavra": "tua maldição" },
        { "hebraico": "לָהֶֽם׃", "transliteral": "lā-hem", "traducao_palavra": "a eles" }
