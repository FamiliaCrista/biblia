{
  "livro": "Lamentações - אֵיכָה - Eikhah",
  "capítulo": 3,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Eu sou o homem que viu a aflição pela vara do seu furor.",
      "palavras": [
        { "hebraico": "אֲנִ֤י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
        { "hebraico": "הַגֶּ֨בֶר֙", "transliteral": "hag-ge-ḇer", "traducao_palavra": "o homem" },
        { "hebraico": "רָאָ֣ה", "transliteral": "rā-ʾāh", "traducao_palavra": "[que] viu" },
        { "hebraico": "עֳנִ֔י", "transliteral": "ʿŏ-nî", "traducao_palavra": "aflição" },
        { "hebraico": "בְּשֵׁ֖בֶט", "transliteral": "bə-šê-ḇeṭ", "traducao_palavra": "pela vara de" },
        { "hebraico": "עֶבְרָתֹֽו׃", "transliteral": "ʿeḇ-rā-ṯô", "traducao_palavra": "seu furor" }
      ]
    },
    "2": {
      "traducao_completa": "Guiou-me, e fez-me andar em trevas, e não em luz.",
      "palavras": [
        { "hebraico": "אֹתִ֥י", "transliteral": "ʾō-ṯî", "traducao_palavra": "me" },
        { "hebraico": "נָהַ֖ג", "transliteral": "nā-haḡ", "traducao_palavra": "guiou" },
        { "hebraico": "וַיֹּלַ֑ךְ", "transliteral": "way-yō-laḵ", "traducao_palavra": "e fez andar" },
        { "hebraico": "חֹ֥שֶׁךְ", "transliteral": "ḥō-šeḵ", "traducao_palavra": "trevas" },
        { "hebraico": "וְלֹא־אֹֽור׃", "transliteral": "wə-lō-ʾôr", "traducao_palavra": "e não luz" }
      ]
    },
    "3": {
      "traducao_completa": "Certamente contra mim torna a virar a sua mão todo o dia.",
      "palavras": [
        { "hebraico": "אַ֣ךְ", "transliteral": "ʾaḵ", "traducao_palavra": "certamente" },
        { "hebraico": "יָשֻׁ֗ב", "transliteral": "yā-šûḇ", "traducao_palavra": "torna a virar" },
        { "hebraico": "יַהֲפֹךְ", "transliteral": "ya-hă-p̄ōḵ", "traducao_palavra": "vira" },
        { "hebraico": "יָדֹ֧ו", "transliteral": "yā-ḏô", "traducao_palavra": "sua mão" },
        { "hebraico": "כָּל־הַיֹּֽום׃", "transliteral": "kāl-hay-yôm", "traducao_palavra": "todo o dia" }
      ]
    },
    "4": {
      "traducao_completa": "Fez envelhecer a minha carne e a minha pele, quebrou os meus ossos.",
      "palavras": [
        { "hebraico": "בִּלָּ֤ה", "transliteral": "bil-lāh", "traducao_palavra": "fez envelhecer" },
        { "hebraico": "בְּשָׂרִ֥י", "transliteral": "bə-śā-rî", "traducao_palavra": "minha carne" },
        { "hebraico": "וְעֹורִ֖י", "transliteral": "wə-ʿô-rî", "traducao_palavra": "e minha pele" },
        { "hebraico": "שִׁבַּ֥ר", "transliteral": "šib-bar", "traducao_palavra": "quebrou" },
        { "hebraico": "עַצְמֹותָֽי׃", "transliteral": "ʿaṣ-mō-ṯāy", "traducao_palavra": "meus ossos" }
      ]
    },
    "5": {
      "traducao_completa": "Edificou contra mim, e cercou-me de veneno e de trabalho.",
      "palavras": [
        { "hebraico": "בָּנָ֤ה", "transliteral": "bā-nā", "traducao_palavra": "edificou" },
        { "hebraico": "עָלַי", "transliteral": "ʿā-lay", "traducao_palavra": "contra mim" },
        { "hebraico": "וַיַּקַּף", "transliteral": "way-yaq-qap̄", "traducao_palavra": "e cercou-me" },
        { "hebraico": "רֹ֖אשׁ", "transliteral": "rōʾš", "traducao_palavra": "veneno/fel" },
        { "hebraico": "וּתְלָאָֽה׃", "transliteral": "ū-ṯə-lā-ʾā", "traducao_palavra": "e trabalho/fadiga" }
      ]
    },
    "6": {
      "traducao_completa": "Assentou-me em lugares tenebrosos, como os que morreram há muito.",
      "palavras": [
        { "hebraico": "בְּמַחֲשַׁכִּ֖ים", "transliteral": "bə-ma-ḥă-šak-kîm", "traducao_palavra": "em lugares tenebrosos" },
        { "hebraico": "הֹושִׁיבַ֥נִי", "transliteral": "hō-šî-ḇa-nî", "traducao_palavra": "assentou-me" },
        { "hebraico": "כְּמֵתֵ֥י", "transliteral": "kə-mē-ṯê", "traducao_palavra": "como [os] mortos" },
        { "hebraico": "עֹולָֽם׃", "transliteral": "ʿô-lām", "traducao_palavra": "há muito [eternos]" }
      ]
    },
    "7": {
      "traducao_completa": "Cercou-me de muro, que não posso sair; fez pesadas as minhas cadeias.",
      "palavras": [
        { "hebraico": "גָּדֵ֥ר", "transliteral": "ḡā-ḏēr", "traducao_palavra": "cercou-me de muro" },
        { "hebraico": "בַּעֲדִי", "transliteral": "ba-ʿă-ḏî", "traducao_palavra": "ao meu redor" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "אֵצֵ֑א", "transliteral": "ʾē-ṣē", "traducao_palavra": "posso sair" },
        { "hebraico": "הִכְבִּ֖יד", "transliteral": "hiḵ-bîḏ", "traducao_palavra": "fez pesadas" },
        { "hebraico": "נְחֻשְׁתִּֽי׃", "transliteral": "nə-ḥuš-tî", "traducao_palavra": "minhas cadeias" }
      ]
    },
    "8": {
      "traducao_completa": "Mesmo quando clamo e grito, ele fecha os ouvidos à minha oração.",
      "palavras": [
        { "hebraico": "גַּ֚ם", "transliteral": "gam", "traducao_palavra": "mesmo" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "quando" },
        { "hebraico": "אֶזְעַ֣ק", "transliteral": "ʾez-ʿaq", "traducao_palavra": "clamo" },
        { "hebraico": "וַאֲשַׁוֵּ֑עַ", "transliteral": "wa-ʾă-šaw-wē-aʿ", "traducao_palavra": "e grito" },
        { "hebraico": "סָתַ֖ם", "transliteral": "śā-ṯam", "traducao_palavra": "fecha" },
        { "hebraico": "תְּפִלָּתִֽי׃", "transliteral": "tə-p̄il-lā-ṯî", "traducao_palavra": "minha oração" }
      ]
    },
    "9": {
      "traducao_completa": "Fechou os meus caminhos com pedras lavradas, transtornou as minhas veredas.",
      "palavras": [
        { "hebraico": "גָּדַ֤ר", "transliteral": "ḡā-ḏar", "traducao_palavra": "fechou" },
        { "hebraico": "דְּרָכַי", "transliteral": "də-rā-ḥay", "traducao_palavra": "meus caminhos" },
        { "hebraico": "בְּגָזִ֔ית", "transliteral": "bə-ḡā-zîṯ", "traducao_palavra": "com pedras lavradas" },
        { "hebraico": "נְתִיבֹתַ֖י", "transliteral": "nə-ṯî-ḇō-ṯay", "traducao_palavra": "minhas veredas" },
        { "hebraico": "עִוָּֽה׃", "transliteral": "ʿiw-wā", "traducao_palavra": "transtornou" }
      ]
    },
    "10": {
      "traducao_completa": "Fez-se para mim como um urso à espreita, como um leão em lugares ocultos.",
      "palavras": [
        { "hebraico": "דֹּ֤ב", "transliteral": "dōḇ", "traducao_palavra": "um urso" },
        { "hebraico": "אֹרֵב֙", "transliteral": "ʾō-rēḇ", "traducao_palavra": "à espreita" },
        { "hebraico": "ה֣וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "לִ֔י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "אֲרִ֖י", "transliteral": "ʾă-rî", "traducao_palavra": "um leão" },
        { "hebraico": "בְּמִסְתָּרִֽים׃", "transliteral": "bə-mis-tā-rîm", "traducao_palavra": "em lugares ocultos" }
      ]
    },
    "11": {
      "traducao_completa": "Desviou os meus caminhos, e fez-me em pedaços; deixou-me assolado.",
      "palavras": [
        { "hebraico": "דְּרָכַי", "transliteral": "də-rā-ḥay", "traducao_palavra": "meus caminhos" },
        { "hebraico": "סוּר", "transliteral": "śûr", "traducao_palavra": "desviou" },
        { "hebraico": "וַיְפַשְּׁחֵ֑נִי", "transliteral": "way-p̄aš-šə-ḥê-nî", "traducao_palavra": "e fez-me em pedaços" },
        { "hebraico": "שָׁמֵֽנִי", "transliteral": "šā-mê-nî", "traducao_palavra": "deixou-me" }
      ]
    },
    "12": {
      "traducao_completa": "Armou o seu arco, e pôs-me como alvo à flecha.",
      "palavras": [
        { "hebraico": "דָּרַ֥ךְ", "transliteral": "dā-raḵ", "traducao_palavra": "armou" },
        { "hebraico": "קַשְׁתֹּ֖ו", "transliteral": "qaš-tô", "traducao_palavra": "seu arco" },
        { "hebraico": "וַיַּצִּיבֵ֥נִי", "transliteral": "way-yaṣ-ṣî-ḇê-nî", "traducao_palavra": "e pôs-me" },
        { "hebraico": "כַּמַּטָּרָ֖ה", "transliteral": "kam-maṭ-ṭā-rā", "traducao_palavra": "como alvo" },
        { "hebraico": "לַחֵֽץ׃", "transliteral": "la-ḥēṣ", "traducao_palavra": "para a flecha" }
      ]
    },
    "13": {
      "traducao_completa": "Fez entrar nos meus rins as flechas da sua aljava.",
      "palavras": [
        { "hebraico": "הֵבִיא", "transliteral": "hê-ḇî", "traducao_palavra": "fez entrar" },
        { "hebraico": "בִּכְלָיֹתָ֖י", "transliteral": "biḵ-lā-yō-ṯāy", "traducao_palavra": "nos meus rins" },
        { "hebraico": "בְּנֵ֥י", "transliteral": "bə-nê", "traducao_palavra": "os filhos de" },
        { "hebraico": "אַשְׁפָּתֹֽו׃", "transliteral": "ʾaš-pā-ṯô", "traducao_palavra": "sua aljava" }
      ]
    },
    "14": {
      "traducao_completa": "Fui feito um objeto de riso para todo o meu povo, e a sua canção todo o dia.",
      "palavras": [
        { "hebraico": "הָיִיתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "fui feito" },
        { "hebraico": "שְׂחֹק", "transliteral": "śə-ḥōq", "traducao_palavra": "objeto de riso" },
        { "hebraico": "לְכָל־עַמִּ֖י", "transliteral": "lə-ḵāl-ʿam-mî", "traducao_palavra": "para todo o meu povo" },
        { "hebraico": "נְגִינָתָֽם׃", "transliteral": "nə-ḡî-nā-ṯām", "traducao_palavra": "a sua canção" }
      ]
    },
    "15": {
      "traducao_completa": "Fartou-me de amarguras, inebriou-me de absinto.",
      "palavras": [
        { "hebraico": "הִשְׂבִּיעַֽנִי", "transliteral": "hiś-bî-ʿa-nî", "traducao_palavra": "fartou-me" },
        { "hebraico": "בַמְּרֹורִ֑ים", "transliteral": "ḇam-mə-rō-rîm", "traducao_palavra": "de amarguras" },
        { "hebraico": "הִרְוַ֖נִי", "transliteral": "hir-wa-nî", "traducao_palavra": "inebriou-me" },
        { "hebraico": "לַעֲנָֽה׃", "transliteral": "la-ʿă-nā", "traducao_palavra": "de absinto" }
      ]
    },
    "16": {
      "traducao_completa": "Quebrou os meus dentes com pedras, cobriu-me de cinza.",
      "palavras": [
        { "hebraico": "וַיַּגְרֵ֣ס", "transliteral": "way-yaḡ-rēs", "traducao_palavra": "triturou/quebrou" },
        { "hebraico": "בֶּחָצָץ", "transliteral": "be-ḥā-ṣāṣ", "traducao_palavra": "com pedras" },
        { "hebraico": "שִׁנָּ֑י", "transliteral": "šin-nāy", "traducao_palavra": "meus dentes" },
        { "hebraico": "הִכְפִּישַׁ֖נִי", "transliteral": "hiḵ-p̄î-ša-nî", "traducao_palavra": "cobriu-me" },
        { "hebraico": "בָּאֵֽפֶר׃", "transliteral": "bā-ʾē-p̄er", "traducao_palavra": "de cinza" }
      ]
    },
    "17": {
      "traducao_completa": "E tu afastaste a minha paz, esqueci-me da prosperidade.",
      "palavras": [
        { "hebraico": "וַתִּזְנַח", "transliteral": "wat-tiz-naḥ", "traducao_palavra": "e tu afastaste/rejeitaste" },
        { "hebraico": "מִשָּׁלֹ֣ום", "transliteral": "miš-šā-lôm", "traducao_palavra": "a paz" },
        { "hebraico": "נַפְשִׁ֑י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "נָשִׁ֖יתִי", "transliteral": "nā-šî-ṯî", "traducao_palavra": "esqueci-me" },
        { "hebraico": "הַטֹּובָֽה׃", "transliteral": "haṭ-ṭô-ḇā", "traducao_palavra": "da prosperidade" }
      ]
    },
    "18": {
      "traducao_completa": "Por isso eu disse: Já pereceu a minha força, e a minha esperança em YHWH.",
      "palavras": [
        { "hebraico": "וָאֹמַ֕ר", "transliteral": "wā-ʾō-mar", "traducao_palavra": "e eu disse" },
        { "hebraico": "אָבַ֥ד", "transliteral": "ʾā-ḇaḏ", "traducao_palavra": "pereceu" },
        { "hebraico": "נִצְחִ֖י", "transliteral": "niṣ-ḥî", "traducao_palavra": "minha força" },
        { "hebraico": "וְתֹוחַלְתִּ֥י", "transliteral": "wə-ṯô-ḥal-tî", "traducao_palavra": "e minha esperança" },
        { "hebraico": "מֵיְהוָֽה׃", "transliteral": "mê-YHWH", "traducao_palavra": "em YHWH" }
      ]
    },
    "19": {
      "traducao_completa": "Lembra-te da minha aflição e da minha miséria, do absinto e da amargura.",
      "palavras": [
        { "hebraico": "זְכָר־עָנְיִ֥י", "transliteral": "zə-ḵar-ʿā-nə-yî", "traducao_palavra": "lembra-te da aflição" },
        { "hebraico": "וּמְרוּדִ֖י", "transliteral": "ū-mə-rû-ḏî", "traducao_palavra": "e da minha miséria" },
        { "hebraico": "לַעֲנָ֥ה", "transliteral": "la-ʿă-nā", "traducao_palavra": "absinto" },
        { "hebraico": "וָרֹֽאשׁ׃", "transliteral": "wā-rōʾš", "traducao_palavra": "e amargura" }
      ]
    },
    "20": {
      "traducao_completa": "A minha alma certamente se lembra de mim, e se abate dentro de mim.",
      "palavras": [
        { "hebraico": "זָכֹ֧ור", "transliteral": "zā-ḵôr", "traducao_palavra": "certamente lembra-se" },
        { "hebraico": "תִּזְכֹּ֛ור", "transliteral": "tiz-kôr", "traducao_palavra": "lembra-se" },
        { "hebraico": "וְתָשִׁ֥יחַ", "transliteral": "wə-ṯā-šî-aḥ", "traducao_palavra": "e abate-se" },
        { "hebraico": "עָלַ֖י", "transliteral": "ʿā-lay", "traducao_palavra": "dentro de mim" },
        { "hebraico": "נַפְשִֽׁי׃", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" }
      ]
    },
    "21": {
      "traducao_completa": "Isto trarei ao meu coração, por isso esperarei.",
      "palavras": [
        { "hebraico": "זֹאת", "transliteral": "zōṯ", "traducao_palavra": "isto" },
        { "hebraico": "אָשִׁ֖יב", "transliteral": "ʾā-šîḇ", "traducao_palavra": "trarei/farei voltar" },
        { "hebraico": "אֶל־לִבִּ֑י", "transliteral": "ʾel-lib-bî", "traducao_palavra": "ao meu coração" },
        { "hebraico": "עַל־כֵּ֖ן", "transliteral": "ʿal-kên", "traducao_palavra": "por isso" },
        { "hebraico": "אֹוחִֽיל׃", "transliteral": "ʾô-ḥîl", "traducao_palavra": "esperarei" }
      ]
    },
    "22": {
      "traducao_completa": "As misericórdias de YHWH são a causa de não sermos consumidos, porque as suas misericórdias não têm fim;",
      "palavras": [
        { "hebraico": "חַסְדֵ֥י", "transliteral": "ḥas-ḏê", "traducao_palavra": "misericórdias de" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לֹא־תָֽמְנוּ", "transliteral": "lō-ṯā-mə-nû", "traducao_palavra": "não fomos consumidos" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לֹא־כָל֖וּ", "transliteral": "lō-ḵā-lû", "traducao_palavra": "não têm fim" },
        { "hebraico": "רַחֲמָֽיו׃", "transliteral": "ra-ḥă-māyw", "traducao_palavra": "as misericórdias dele" }
      ]
    },
    "23": {
      "traducao_completa": "Novas são cada manhã; grande é a tua fidelidade.",
      "palavras": [
        { "hebraico": "חֲדָשִׁ֖ים", "transliteral": "ḥă-ḏā-šîm", "traducao_palavra": "novas" },
        { "hebraico": "לַבְּקָרִ֑ים", "transliteral": "lab-bə-qā-rîm", "traducao_palavra": "cada manhã" },
        { "hebraico": "רַבָּ֖ה", "transliteral": "rab-bā", "traducao_palavra": "grande" },
        { "hebraico": "אֱמוּנָתֶֽךָ׃", "transliteral": "ʾĕ-mû-nā-ṯe-ḵā", "traducao_palavra": "é a tua fidelidade" }
      ]
    },
    "24": {
      "traducao_completa": "A minha porção é YHWH, diz a minha alma; portanto esperarei nele.",
      "palavras": [
        { "hebraico": "חֶלְקִ֤י", "transliteral": "ḥel-qî", "traducao_palavra": "minha porção" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אָמְרָ֣ה", "transliteral": "ʾā-mə-rā", "traducao_palavra": "disse" },
        { "hebraico": "נַפְשִׁ֔י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
