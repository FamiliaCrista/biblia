        { "hebraico": "רִיבֵ֥י", "transliteral": "rî-ḇê", "traducao_palavra": "a causa de" },
        { "hebraico": "נַפְשִׁ֖י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "גָּאַ֥לְתָּ", "transliteral": "gā-ʾal-tā", "traducao_palavra": "remiste" },
