        { "hebraico": "עִנָּה֙", "transliteral": "ʿin-nā", "traducao_palavra": "aflige" },
        { "hebraico": "מִלִּבֹּ֔ו", "transliteral": "mil-lib-bô", "traducao_palavra": "de [seu] coração" },
        { "hebraico": "וַיַּגֶּ֖ה", "transliteral": "way-yaḡ-geh", "traducao_palavra": "nem entristece" },
