        { "hebraico": "עַד־יְהוָֽה׃", "transliteral": "ʿaḏ-YHWH", "traducao_palavra": "para YHWH" }
      ]
    },
    "41": {
      "traducao_completa": "Levantemos os nossos corações com as mãos para Deus nos céus, dizendo:",
