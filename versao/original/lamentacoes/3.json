        { "hebraico": "וּמָרִ֑ינוּ", "transliteral": "ū-mā-rî-nû", "traducao_palavra": "e fomos rebeldes" },
        { "hebraico": "אַתָּ֖ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "סָלָֽחְתָּ׃", "transliteral": "śā-lāḥ-tā", "traducao_palavra": "perdoaste" }
      ]
    },
    "43": {
      "traducao_completa": "Cobriste-te de ira, e nos perseguiste; mataste, não perdoaste.",
      "palavras": [
        { "hebraico": "סַכֹּתָה", "transliteral": "śak-kō-ṯā", "traducao_palavra": "cobriste-te" },
        { "hebraico": "בָאַף", "transliteral": "ḇā-ʾap̄", "traducao_palavra": "de ira" },
        { "hebraico": "וַתִּרְדְּפֵ֑נוּ", "transliteral": "wat-tir-də-p̄ê-nû", "traducao_palavra": "e nos perseguiste" },
        { "hebraico": "הָרַ֖גְתָּ", "transliteral": "hā-raḡ-tā", "traducao_palavra": "mataste" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "חָמָֽלְתָּ׃", "transliteral": "ḥā-mā-lə-ṯā", "traducao_palavra": "perdoaste" }
      ]
    },
    "44": {
      "traducao_completa": "Cobriste-te de nuvem, para que a nossa oração não passe.",
      "palavras": [
        { "hebraico": "סַכֹּתָה", "transliteral": "śak-kō-ṯā", "traducao_palavra": "cobriste-te" },
        { "hebraico": "בֶעָנָן", "transliteral": "ḇe-ʿā-nān", "traducao_palavra": "de nuvem" },
        { "hebraico": "מֵעֲבֹ֣ור", "transliteral": "mē-ʿă-ḇôr", "traducao_palavra": "para que não passe" },
        { "hebraico": "תְּפִלָּֽה׃", "transliteral": "tə-p̄il-lā", "traducao_palavra": "oração" }
      ]
    },
    "45": {
      "traducao_completa": "Como escória e refugo nos puseste no meio dos povos.",
      "palavras": [
        { "hebraico": "סְחִ֧י", "transliteral": "śə-ḥî", "traducao_palavra": "como escória" },
        { "hebraico": "וּמָאֹ֛וס", "transliteral": "ū-mā-ʾôs", "traducao_palavra": "e refugo" },
        { "hebraico": "שַׂמְתָּ֥נוּ", "transliteral": "śam-tā-nû", "traducao_palavra": "nos puseste" },
        { "hebraico": "בְּקֶ֥רֶב", "transliteral": "bə-qe-reḇ", "traducao_palavra": "no meio de" },
        { "hebraico": "הָעַמִּֽים׃", "transliteral": "hā-ʿam-mîm", "traducao_palavra": "os povos" }
      ]
    },
    "46": {
      "traducao_completa": "Todos os nossos inimigos abriram a sua boca contra nós.",
      "palavras": [
        { "hebraico": "פָּצ֣וּ", "transliteral": "pā-ṣû", "traducao_palavra": "abriram" },
        { "hebraico": "עָלֵ֨ינוּ֙", "transliteral": "ʿā-lê-nû", "traducao_palavra": "contra nós" },
        { "hebraico": "פִּיהֶ֔ם", "transliteral": "pî-hem", "traducao_palavra": "a boca deles" },
        { "hebraico": "כָּל־אֹיְבֵֽינוּ׃", "transliteral": "kāl-ʾō-yə-ḇê-nû", "traducao_palavra": "todos os nossos inimigos" }
      ]
    },
    "47": {
      "traducao_completa": "Terror e cova nos vieram, assolação e destruição.",
      "palavras": [
        { "hebraico": "פַּ֧חַד", "transliteral": "pa-ḥaḏ", "traducao_palavra": "terror" },
        { "hebraico": "וָפַ֛חַת", "transliteral": "wā-p̄a-ḥaṯ", "traducao_palavra": "e cova" },
        { "hebraico": "הָיָ֥ה", "transliteral": "hā-yā", "traducao_palavra": "nos vieram/foi" },
