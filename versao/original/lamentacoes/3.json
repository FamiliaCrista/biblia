      ]
    },
    "39": {
      "traducao_completa": "De que se queixa, pois, o homem vivente? Queixe-se cada um dos seus próprios pecados.",
      "palavras": [
        { "hebraico": "מַה־יִּתְאֹונֵן֙", "transliteral": "mah-yit-ʾô-nēn", "traducao_palavra": "por que se queixa?" },
