        { "hebraico": "אֶל־כַּפַּ֑יִם", "transliteral": "ʾel-kap-pa-yim", "traducao_palavra": "com as mãos" },
        { "hebraico": "אֶל־אֵ֖ל", "transliteral": "ʾel-ʾēl", "traducao_palavra": "a Deus" },
        { "hebraico": "בַּשָּׁמָֽיִם׃", "transliteral": "baš-šā-ma-yim", "traducao_palavra": "nos céus" }
      ]
    },
    "42": {
      "traducao_completa": "Nós transgredimos, e fomos rebeldes; tu não perdoaste.",
      "palavras": [
        { "hebraico": "אֲנַ֣חְנוּ", "transliteral": "ʾă-naḥ-nû", "traducao_palavra": "nós" },
