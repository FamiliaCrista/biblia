        { "hebraico": "לַגֶּ֖בֶר", "transliteral": "laḡ-ge-ḇer", "traducao_palavra": "para o homem" },
        { "hebraico": "כִּֽי־יִשָּׂ֣א", "transliteral": "kî-yiś-śā", "traducao_palavra": "que suporte" },
        { "hebraico": "עֹ֖ול", "transliteral": "ʿôl", "traducao_palavra": "o jugo" },
        { "hebraico": "בִּנְעוּרָֽיו׃", "transliteral": "bin-ʿû-rāyw", "traducao_palavra": "na sua mocidade" }
      ]
    },
    "28": {
      "traducao_completa": "Assente-se solitário e fique em silêncio, quando ele o puser sobre si.",
      "palavras": [
        { "hebraico": "יֵשֵׁ֤ב", "transliteral": "yê-šēḇ", "traducao_palavra": "assente-se" },
        { "hebraico": "בָדָד֙", "transliteral": "ḇā-ḏāḏ", "traducao_palavra": "solitário" },
        { "hebraico": "וְיִדֹּ֔ם", "transliteral": "wə-yid-dōm", "traducao_palavra": "e fique em silêncio" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "quando" },
        { "hebraico": "נָטַ֖ל", "transliteral": "nā-ṭal", "traducao_palavra": "ele o puser sobre si" }
      ]
    },
    "29": {
      "traducao_completa": "Ponha a sua boca no pó; talvez ainda haja esperança.",
      "palavras": [
        { "hebraico": "יִתֵּ֤ן", "transliteral": "yit-tên", "traducao_palavra": "ponha" },
        { "hebraico": "בֶּֽעָפָר֙", "transliteral": "be-ʿā-p̄ār", "traducao_palavra": "no pó" },
        { "hebraico": "פִּ֔יהוּ", "transliteral": "pî-hû", "traducao_palavra": "a boca dele" },
        { "hebraico": "אוּלַ֖י", "transliteral": "ʾû-lay", "traducao_palavra": "talvez" },
        { "hebraico": "יֵ֥שׁ", "transliteral": "yêš", "traducao_palavra": "haja" },
        { "hebraico": "תִּקְוָֽה׃", "transliteral": "tiq-wā", "traducao_palavra": "esperança" }
      ]
    },
    "30": {
      "traducao_completa": "Dê a face a quem o fere; farte-se de afronta.",
      "palavras": [
        { "hebraico": "יִתֵּ֧ן", "transliteral": "yit-tên", "traducao_palavra": "dê" },
