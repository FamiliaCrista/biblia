    "32": {
      "traducao_completa": "Pois ainda que ele entristeça, compadecer-se-á segundo a grandeza das suas misericórdias.",
      "palavras": [
        { "hebraico": "כִּ֧י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "אִם־הֹוגָ֖ה", "transliteral": "ʾim-hô-ḡāh", "traducao_palavra": "ainda que entristeça" },
        { "hebraico": "וְרִחַ֣ם", "transliteral": "wə-ri-ḥam", "traducao_palavra": "compadecer-se-á" },
