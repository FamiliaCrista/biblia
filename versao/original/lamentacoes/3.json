        { "hebraico": "חָ֔י", "transliteral": "ḥāy", "traducao_palavra": "vivente" },
        { "hebraico": "גֶּ֖בֶר", "transliteral": "ḡe-ḇer", "traducao_palavra": "cada um [homem]" },
        { "hebraico": "עַל־חֲטָאָֽו׃", "transliteral": "ʿal-ḥă-ṭā-w", "traducao_palavra": "dos seus pecados" }
      ]
    },
    "40": {
      "traducao_completa": "Esquadrinhemos os nossos caminhos, e provemo-los, e voltemos para YHWH.",
