        { "hebraico": "יִשְׂבַּ֖ע", "transliteral": "yiś-baʿ", "traducao_palavra": "farte-se" },
        { "hebraico": "בְּחֶרְפָּֽה׃", "transliteral": "bə-ḥer-pā", "traducao_palavra": "de afronta" }
      ]
    },
    "31": {
      "traducao_completa": "Pois o Senhor não rejeitará para sempre.",
      "palavras": [
        { "hebraico": "כִּ֧י", "transliteral": "kî", "traducao_palavra": "pois" },
