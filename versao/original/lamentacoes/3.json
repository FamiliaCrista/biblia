        { "hebraico": "וְדוּמָ֖ם", "transliteral": "wə-ḏû-mām", "traducao_palavra": "e em silêncio" },
        { "hebraico": "לִתְשׁוּעַ֥ת", "transliteral": "liṯ-šû-ʿaṯ", "traducao_palavra": "a salvação de" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "27": {
      "traducao_completa": "Bom é para o homem suportar o jugo na sua mocidade.",
      "palavras": [
