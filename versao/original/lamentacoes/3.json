        { "hebraico": "וַתֶּ֑הִי", "transliteral": "wat-te-hî", "traducao_palavra": "e aconteceu" },
        { "hebraico": "אֲדֹנָ֖י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
