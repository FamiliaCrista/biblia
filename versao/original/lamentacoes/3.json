    "48": {
      "traducao_completa": "Rios de águas derramam os meus olhos, por causa da destruição da filha do meu povo.",
      "palavras": [
        { "hebraico": "פַּלְגֵי־מַ֨יִם֙", "transliteral": "pal-ḡê-ma-yim", "traducao_palavra": "rios de águas" },
        { "hebraico": "תֵּרֵ֣ד", "transliteral": "tê-rēḏ", "traducao_palavra": "derramam/descem" },
        { "hebraico": "עֵינִ֔י", "transliteral": "ʿê-nî", "traducao_palavra": "meus olhos" },
        { "hebraico": "עַל־שֶׁ֖בֶר", "transliteral": "ʿal-še-ḇer", "traducao_palavra": "por causa da destruição de" },
        { "hebraico": "בַּת־עַמִּֽי׃", "transliteral": "baṯ-ʿam-mî", "traducao_palavra": "filha do meu povo" }
      ]
    },
    "49": {
      "traducao_completa": "Os meus olhos choram sem cessar, e não têm descanso,",
      "palavras": [
        { "hebraico": "עֵינִ֥י", "transliteral": "ʿê-nî", "traducao_palavra": "meu olho" },
        { "hebraico": "נִגְּרָ֖ה", "transliteral": "niḡ-rā", "traducao_palavra": "chora/derrama-se" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "תִדְמֶ֑ה", "transliteral": "ṯiḏ-meh", "traducao_palavra": "tem descanso/cessa" },
        { "hebraico": "מֵאֵ֖ין", "transliteral": "mē-ʾên", "traducao_palavra": "sem" },
        { "hebraico": "הֲפֻגֹֽות׃", "transliteral": "hă-p̄u-ḡôṯ", "traducao_palavra": "interrupção" }
      ]
    },
    "50": {
      "traducao_completa": "Até que YHWH olhe e veja desde os céus.",
      "palavras": [
        { "hebraico": "עַד־יַשְׁקִ֥יף", "transliteral": "ʿaḏ-yaš-qîp̄", "traducao_palavra": "até que olhe" },
        { "hebraico": "וְיֵ֖רֶא", "transliteral": "wə-yê-reʾ", "traducao_palavra": "e veja" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מִשָּׁמָֽיִם׃", "transliteral": "miš-šā-ma-yim", "traducao_palavra": "desde os céus" }
      ]
    },
    "51": {
      "traducao_completa": "O meu olho me causa dor por causa de todas as filhas da minha cidade.",
      "palavras": [
        { "hebraico": "עֵינִִי", "transliteral": "ʿê-nî", "traducao_palavra": "meu olho" },
        { "hebraico": "עֹולְלָ֣ה", "transliteral": "ʿô-lə-lāh", "traducao_palavra": "causa dor/aflição" },
        { "hebraico": "לְנַפְשִׁ֔י", "transliteral": "lə-nap̄-šî", "traducao_palavra": "à minha alma" },
        { "hebraico": "מִכֹּ֖ל", "transliteral": "mik-kōl", "traducao_palavra": "de todas" },
        { "hebraico": "בְּנֹ֥ות", "transliteral": "bə-nôṯ", "traducao_palavra": "as filhas de" },
        { "hebraico": "עִירִֽי׃", "transliteral": "ʿî-rî", "traducao_palavra": "minha cidade" }
      ]
    },
    "52": {
      "traducao_completa": "Caçaram-me como a uma ave, meus inimigos, sem causa.",
      "palavras": [
        { "hebraico": "צֹ֥וד", "transliteral": "ṣôḏ", "traducao_palavra": "caçaram-me" },
        { "hebraico": "צָד֖וּנִי", "transliteral": "ṣā-ḏû-nî", "traducao_palavra": "caçaram-me" },
        { "hebraico": "כַּצִּפֹּ֑ור", "transliteral": "kaṣ-ṣip-pôr", "traducao_palavra": "como a uma ave" },
        { "hebraico": "אֹיְבַ֖י", "transliteral": "ʾō-yə-ḇay", "traducao_palavra": "meus inimigos" },
        { "hebraico": "חִנָּֽם׃", "transliteral": "ḥin-nām", "traducao_palavra": "sem causa" }
      ]
