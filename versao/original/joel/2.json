        { "hebraico": "הַקַּדְמֹנִ֔י", "transliteral": "haq-qaḏ-mō-nî", "traducao_palavra": "oriental [Mar Morto]" },
        { "hebraico": "וְסֹפֹ֖ו", "transliteral": "wə-sō-p̄ô", "traducao_palavra": "e a sua retaguarda" },
