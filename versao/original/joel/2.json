        { "hebraico": "שָׂדַ֔י", "transliteral": "śā-ḏay", "traducao_palavra": "o campo" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "דָשְׁא֖וּ", "transliteral": "ḏā-šə-ʾû", "traducao_palavra": "reverdeceram" },
        { "hebraico": "נְאֹ֣ות", "transliteral": "nə-ʾôṯ", "traducao_palavra": "as pastagens de" },
