        { "hebraico": "חִלֵּֽקוּ׃", "transliteral": "ḥil-lê-qû", "traducao_palavra": "repartiram" }
      ]
    },
    "3": {
      "traducao_completa": "E lançaram sortes sobre o meu povo, e deram um menino por uma meretriz, e venderam uma menina por vinho, para beberem.",
      "palavras": [
