{
  "livro": "Joel - יוֹאֵל - Yôʾēl",
  "capítulo": 4,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Porque eis que naqueles dias, e naquele tempo, em que restaurarei o cativeiro de Judá e de Jerusalém,",
