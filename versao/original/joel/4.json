        { "hebraico": "יַדּ֣וּ", "transliteral": "yad-dû", "traducao_palavra": "lançaram" },
        { "hebraico": "גֹורָ֑ל", "transliteral": "ḡô-rāl", "traducao_palavra": "sortes" },
        { "hebraico": "וַיִּתְּנ֤וּ", "transliteral": "way-yit-tə-nû", "traducao_palavra": "e deram" },
