        { "hebraico": "בַּיָּמִ֤ים", "transliteral": "bay-yā-mîm", "traducao_palavra": "nos dias" },
        { "hebraico": "הָהֵ֙מָּה֙", "transliteral": "hā-hêm-mā", "traducao_palavra": "aqueles" },
