        { "hebraico": "עָלָ֔י", "transliteral": "ʿā-lāy", "traducao_palavra": "contra mim?" },
        { "hebraico": "וְאִם־גֹּמְלִ֤ים", "transliteral": "wə-ʾim-gō-mə-lîm", "traducao_palavra": "e se retribuís" },
