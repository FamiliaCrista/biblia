        { "hebraico": "יְהֹֽושָׁפָ֑ט", "transliteral": "yə-hô-šā-p̄āṭ", "traducao_palavra": "Josafá" },
        { "hebraico": "וְנִשְׁפַּטְתִּ֨י", "transliteral": "wə-niš-paṭ-tî", "traducao_palavra": "e entrarei em juízo" },
        { "hebraico": "עִמָּ֜ם", "transliteral": "ʿim-mām", "traducao_palavra": "com elas" },
        { "hebraico": "שָׁ֗ם", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "עַל־עַמִּ֨י", "transliteral": "ʿal-ʿam-mî", "traducao_palavra": "por causa do meu povo" },
        { "hebraico": "וְנַחֲלָתִ֤י", "transliteral": "wə-na-ḥă-lā-ṯî", "traducao_palavra": "e da minha herança" },
        { "hebraico": "יִשְׂרָאֵל֙", "transliteral": "yiś-rā-ʾêl", "traducao_palavra": "Israel" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "a quem" },
