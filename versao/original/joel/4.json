        { "hebraico": "הַהִ֔יא", "transliteral": "ha-hî", "traducao_palavra": "aquele" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "em que" },
        { "hebraico": "אָשִׁ֛יב", "transliteral": "ʾā-šîḇ", "traducao_palavra": "restaurarei/mudarei" },
        { "hebraico": "אֶת־שְׁב֥וּת", "transliteral": "ʾeṯ-šə-ḇūṯ", "traducao_palavra": "a sorte/cativeiro de" },
        { "hebraico": "יְהוּדָ֖ה", "transliteral": "yə-hū-ḏā", "traducao_palavra": "Judá" },
        { "hebraico": "וִירוּשָׁלִָֽם׃", "transliteral": "wî-rū-šā-lā-yim", "traducao_palavra": "e Jerusalém" }
      ]
    },
    "2": {
      "traducao_completa": "congregarei todas as nações e as farei descer ao vale de Josafá; e ali entrarei em juízo com elas por causa do meu povo e da minha herança, Israel, a quem dispersaram entre as nações, repartindo a minha terra.",
      "palavras": [
