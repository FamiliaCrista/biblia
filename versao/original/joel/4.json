    "5": {
      "traducao_completa": "Visto como levastes a minha prata e o meu ouro, e as minhas joias preciosas metestes nos vossos templos;",
      "palavras": [
        { "hebraico": "אֲשֶׁר־כַּסְפִּ֥י", "transliteral": "ʾă-šer-kas-pî", "traducao_palavra": "porque a minha prata" },
        { "hebraico": "וּזְהָבִ֖י", "transliteral": "ū-zə-hā-ḇî", "traducao_palavra": "e o meu ouro" },
