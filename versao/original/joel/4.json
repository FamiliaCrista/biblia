        { "hebraico": "מָה־אַתֶּ֥ם", "transliteral": "māh-ʾat-tem", "traducao_palavra": "que sois vós" },
        { "hebraico": "לִי֙", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "צֹ֣ר", "transliteral": "ṣōr", "traducao_palavra": "ó Tiro" },
        { "hebraico": "וְצִידֹ֔ון", "transliteral": "wə-ṣî-ḏôn", "traducao_palavra": "e Sidom" },
        { "hebraico": "וְכֹ֖ל", "transliteral": "wə-ḵōl", "traducao_palavra": "e todas" },
        { "hebraico": "גְּלִילֹ֣ות", "transliteral": "gə-lî-lôṯ", "traducao_palavra": "as regiões de" },
