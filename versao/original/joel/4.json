        { "hebraico": "אֶת־כָּל־הַגֹּויִ֔ם", "transliteral": "ʾeṯ-kāl-hag-gô-yim", "traducao_palavra": "todas as nações" },
        { "hebraico": "וְהֹֽורַדְתִּ֔ים", "transliteral": "wə-hô-raḏ-tîm", "traducao_palavra": "e as farei descer" },
