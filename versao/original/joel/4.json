    "8": {
      "traducao_completa": "E venderei os vossos filhos e as vossas filhas na mão dos filhos de Judá, e eles os venderão aos sabeus, a uma nação remota, porque YHWH o disse.",
      "palavras": [
        { "hebraico": "וּמָכַרְתִּ֞י", "transliteral": "ū-mā-ḵar-tî", "traducao_palavra": "e venderei" },
