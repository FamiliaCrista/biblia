        { "hebraico": "עָלַ֔י", "transliteral": "ʿā-lay", "traducao_palavra": "contra mim" },
        { "hebraico": "קַ֣ל", "transliteral": "qal", "traducao_palavra": "com presteza" },
        { "hebraico": "מְהֵרָ֔ה", "transliteral": "mə-hê-rā", "traducao_palavra": "rapidamente" },
        { "hebraico": "אָשִׁ֥יב", "transliteral": "ʾā-šîḇ", "traducao_palavra": "farei recair" },
        { "hebraico": "גְּמֻלְכֶ֖ם", "transliteral": "gə-mul-ḵem", "traducao_palavra": "a vossa recompensa/paga" },
        { "hebraico": "בְּרֹאשְׁכֶֽם׃", "transliteral": "bə-rōš-ḵem", "traducao_palavra": "sobre a vossa cabeça" }
      ]
