        { "hebraico": "יֶ֤תֶר", "transliteral": "ye-ṯer", "traducao_palavra": "o que sobrou de" },
        { "hebraico": "הַגָּזָם֙", "transliteral": "hag-gā-zām", "traducao_palavra": "a lagarta/cortador" },
        { "hebraico": "אָכַ֣ל", "transliteral": "ʾā-ḵal", "traducao_palavra": "comeu" },
        { "hebraico": "הָֽאַרְבֶּ֔ה", "transliteral": "hā-ʾar-beh", "traducao_palavra": "o gafanhoto" },
        { "hebraico": "וְיֶ֥תֶר", "transliteral": "wə-ye-ṯer", "traducao_palavra": "e o que sobrou de" },
        { "hebraico": "הָאַרְבֶּ֖ה", "transliteral": "hā-ʾar-beh", "traducao_palavra": "o gafanhoto" },
        { "hebraico": "אָכַ֣ל", "transliteral": "ʾā-ḵal", "traducao_palavra": "comeu" },
        { "hebraico": "הַיָּ֑לֶק", "transliteral": "hay-yā-leq", "traducao_palavra": "o gafanhoto saltador/locusta" },
        { "hebraico": "וְיֶ֣תֶר", "transliteral": "wə-ye-ṯer", "traducao_palavra": "e o que sobrou de" },
        { "hebraico": "הַיֶּ֔לֶק", "transliteral": "hay-ye-leq", "traducao_palavra": "o gafanhoto saltador" },
        { "hebraico": "אָכַ֖ל", "transliteral": "ʾā-ḵal", "traducao_palavra": "comeu" },
        { "hebraico": "הֶחָסִֽיל׃", "transliteral": "he-ḥā-sîl", "traducao_palavra": "o gafanhoto destruidor/pulgão" }
      ]
    },
    "5": {
      "traducao_completa": "Despertai, ébrios, e chorai; gemei, todos os que bebeis vinho, por causa do mosto, porque tirado é da vossa boca.",
      "palavras": [
        { "hebraico": "הָקִ֤יצוּ", "transliteral": "hā-qî-ṣû", "traducao_palavra": "despertai" },
        { "hebraico": "שִׁכֹּורִים֙", "transliteral": "šik-kô-rîm", "traducao_palavra": "óbrios" },
        { "hebraico": "וּבְכ֔וּ", "transliteral": "ū-ḇə-ḵû", "traducao_palavra": "e chorai" },
        { "hebraico": "וְהֵילִ֖ילוּ", "transliteral": "wə-hê-lî-lû", "traducao_palavra": "e uivai/gemei" },
        { "hebraico": "כָּל־שֹׁ֣תֵי", "transliteral": "kāl-šō-ṯê", "traducao_palavra": "todos os bebedores de" },
        { "hebraico": "יָ֑יִן", "transliteral": "yā-yin", "traducao_palavra": "vinho" },
        { "hebraico": "עַל־עָסִ֕יס", "transliteral": "ʿal-ʿā-sîs", "traducao_palavra": "por causa do vinho novo/mosto" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "נִכְרַ֖ת", "transliteral": "niḵ-raṯ", "traducao_palavra": "foi cortado/tirado" },
        { "hebraico": "מִפִּיכֶֽם׃", "transliteral": "mip-pî-ḵem", "traducao_palavra": "da vossa boca" }
      ]
    },
    "6": {
      "traducao_completa": "Porque uma nação subiu sobre a minha terra, poderosa e inumerável; os seus dentes são dentes de leão, e tem queixadas de leoa.",
      "palavras": [
        { "hebraico": "כִּֽי־גֹוי֙", "transliteral": "kî-ḡôy", "traducao_palavra": "porque uma nação" },
        { "hebraico": "עָלָ֣ה", "transliteral": "ʿā-lā", "traducao_palavra": "subiu" },
        { "hebraico": "עַל־אַרְצִ֔י", "transliteral": "ʿal-ʾar-ṣî", "traducao_palavra": "sobre a minha terra" },
        { "hebraico": "עָצ֥וּם", "transliteral": "ʿā-ṣūm", "traducao_palavra": "poderosa" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e sem" },
        { "hebraico": "מִסְפָּ֑ר", "transliteral": "mis-pār", "traducao_palavra": "número/inumerável" },
        { "hebraico": "שִׁנָּיו֙", "transliteral": "šin-nāyw", "traducao_palavra": "os seus dentes [são]" },
        { "hebraico": "שִׁנֵּ֣י", "transliteral": "šin-nê", "traducao_palavra": "dentes de" },
        { "hebraico": "אַרְיֵ֔ה", "transliteral": "ʾar-yêh", "traducao_palavra": "leão" },
        { "hebraico": "וּֽמְתַלְּעֹ֥ות", "transliteral": "ū-mə-ṯal-lə-ʿôṯ", "traducao_palavra": "e queixadas de" },
        { "hebraico": "לָבִ֖יא", "transliteral": "lā-ḇî", "traducao_palavra": "leoa" },
        { "hebraico": "לֹֽו׃", "transliteral": "lô", "traducao_palavra": "tem ele" }
      ]
    },
    "7": {
      "traducao_completa": "Fez da minha vide uma assolação, e descascou a minha figueira; despiu-a totalmente e a lançou por terra; os seus sarmentos se embranqueceram.",
      "palavras": [
        { "hebraico": "שָׂ֤ם", "transliteral": "śām", "traducao_palavra": "pôs/fez" },
        { "hebraico": "גַּפְנִי֙", "transliteral": "gap̄-nî", "traducao_palavra": "a minha vide" },
        { "hebraico": "לְשַׁמָּ֔ה", "transliteral": "lə-šam-mā", "traducao_palavra": "em desolação" },
        { "hebraico": "וּתְאֵנָתִ֖י", "transliteral": "ū-ṯə-ʾê-nā-ṯî", "traducao_palavra": "e a minha figueira" },
        { "hebraico": "לִקְצָפָ֑ה", "transliteral": "liq-ṣā-p̄ā", "traducao_palavra": "em toco descascado/lascas" },
        { "hebraico": "חָשֹׂ֤ף", "transliteral": "ḥā-śōp̄", "traducao_palavra": "descascando" },
        { "hebraico": "חֲשָׂפָהּ֙", "transliteral": "ḥă-śā-p̄āh", "traducao_palavra": "descascou-a" },
        { "hebraico": "וְהִשְׁלִ֔יךְ", "transliteral": "wə-hiš-lîḵ", "traducao_palavra": "e a lançou fora" },
        { "hebraico": "הִלְבִּ֖ינוּ", "transliteral": "hil-bî-nû", "traducao_palavra": "ficaram brancos" },
        { "hebraico": "שָׂרִיגֶֽיהָ׃", "transliteral": "śā-rî-ḡe-hā", "traducao_palavra": "os seus ramos/sarmentos" }
      ]
    },
    "8": {
      "traducao_completa": "Lamenta como a virgem cingida de saco pelo marido da sua mocidade.",
      "palavras": [
        { "hebraico": "אֱלִ֕י", "transliteral": "ʾĕ-lî", "traducao_palavra": "lamenta/chora" },
        { "hebraico": "כִּבְתוּלָ֥ה", "transliteral": "kiḇ-ṯū-lā", "traducao_palavra": "como a virgem/jovem" },
        { "hebraico": "חֲגֻֽרַת־שַׂ֖ק", "transliteral": "ḥă-ḡu-raṯ-śaq", "traducao_palavra": "cingida de pano de saco" },
        { "hebraico": "עַל־בַּ֥עַל", "transliteral": "ʿal-ba-ʿal", "traducao_palavra": "pelo esposo de" },
        { "hebraico": "נְעוּרֶֽיהָ׃", "transliteral": "nə-ʿū-re-hā", "traducao_palavra": "sua mocidade" }
      ]
    },
    "9": {
      "traducao_completa": "Cortada está a oferta de manjares e a libação da casa de YHWH; os sacerdotes, ministros de YHWH, estão de luto.",
