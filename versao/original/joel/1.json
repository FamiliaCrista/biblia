        { "hebraico": "הָכְרַ֥ת", "transliteral": "hāḵ-raṯ", "traducao_palavra": "cortada foi" },
        { "hebraico": "מִנְחָ֛ה", "transliteral": "min-ḥā", "traducao_palavra": "a oferta de cereais" },
        { "hebraico": "וָנֶ֖סֶךְ", "transliteral": "wā-ne-seḵ", "traducao_palavra": "e a libação" },
        { "hebraico": "מִבֵּ֣ית", "transliteral": "mib-bêṯ", "traducao_palavra": "da casa de" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אָֽבְלוּ֙", "transliteral": "ʾā-ḇə-lû", "traducao_palavra": "estão de luto" },
        { "hebraico": "הַכֹּ֣הֲנִ֔ים", "transliteral": "hak-kō-hă-nîm", "traducao_palavra": "os sacerdotes" },
        { "hebraico": "מְשָׁרְתֵ֖י", "transliteral": "mə-šā-rə-ṯê", "traducao_palavra": "ministros de" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "10": {
      "traducao_completa": "O campo está assolado, a terra chora; porque o trigo está destruído, o mosto se secou, o azeite acabou.",
      "palavras": [
        { "hebraico": "שֻׁדַּ֣ד", "transliteral": "šud-daḏ", "traducao_palavra": "assolado está" },
        { "hebraico": "שָׂדֶ֔ה", "transliteral": "śā-ḏeh", "traducao_palavra": "o campo" },
        { "hebraico": "אָבְלָ֖ה", "transliteral": "ʾā-ḇə-lā", "traducao_palavra": "está de luto/chora" },
        { "hebraico": "אֲדָמָ֑ה", "transliteral": "ʾă-ḏā-mā", "traducao_palavra": "a terra/solo" },
        { "hebraico": "כִּ֚י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "שֻׁדַּ֣ד", "transliteral": "šud-daḏ", "traducao_palavra": "está destruído" },
        { "hebraico": "דָּגָ֔ן", "transliteral": "dā-ḡān", "traducao_palavra": "o cereal/trigo" },
        { "hebraico": "הֹובִ֥ישׁ", "transliteral": "hô-ḇîš", "traducao_palavra": "secou-se" },
        { "hebraico": "תִּירֹ֖ושׁ", "transliteral": "tî-rôš", "traducao_palavra": "o vinho novo" },
        { "hebraico": "אֻמְלַ֥ל", "transliteral": "ʾum-lal", "traducao_palavra": "desfaleceu/acabou" },
        { "hebraico": "יִצְהָֽר׃", "transliteral": "yiṣ-hār", "traducao_palavra": "o azeite fresco" }
      ]
    },
    "11": {
      "traducao_completa": "Envergonhai-vos, lavradores, uivai, vinhateiros, por causa do trigo e da cevada; porque a colheita do campo pereceu.",
      "palavras": [
        { "hebraico": "הֹבִ֣ישׁוּ", "transliteral": "hō-ḇî-šû", "traducao_palavra": "envergonhai-vos" },
        { "hebraico": "אִכָּרִ֗ים", "transliteral": "ʾik-kā-rîm", "traducao_palavra": "ó lavradores" },
        { "hebraico": "הֵילִ֙ילוּ֙", "transliteral": "hê-lî-lû", "traducao_palavra": "uivai" },
        { "hebraico": "כֹּֽרְמִ֔ים", "transliteral": "kō-rə-mîm", "traducao_palavra": "ó vinhateiros" },
        { "hebraico": "עַל־חִטָּ֖ה", "transliteral": "ʿal-ḥiṭ-ṭā", "traducao_palavra": "pelo trigo" },
        { "hebraico": "וְעַל־שְׂעֹרָ֑ה", "transliteral": "wə-ʿal-śə-ʿō-rā", "traducao_palavra": "e pela cevada" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אָבַ֖ד", "transliteral": "ʾā-ḇaḏ", "traducao_palavra": "pereceu" },
        { "hebraico": "קְצִ֥יר", "transliteral": "qə-ṣîr", "traducao_palavra": "a colheita de" },
        { "hebraico": "שָׂדֶֽה׃", "transliteral": "śā-ḏeh", "traducao_palavra": "o campo" }
      ]
    },
    "12": {
      "traducao_completa": "A vide se secou, a figueira se murchou; a romeira também, a palmeira e a macieira; todas as árvores do campo se secaram, e a alegria se secou entre os filhos dos homens.",
      "palavras": [
        { "hebraico": "הַגֶּ֥פֶן", "transliteral": "hag-ge-p̄en", "traducao_palavra": "a vide" },
        { "hebraico": "הֹובִ֛ישָׁה", "transliteral": "hô-ḇî-šā", "traducao_palavra": "secou-se" },
        { "hebraico": "וְהַתְּאֵנָ֖ה", "transliteral": "wə-hat-tə-ʾê-nā", "traducao_palavra": "e a figueira" },
        { "hebraico": "אֻמְלָ֑לָה", "transliteral": "ʾum-lā-lā", "traducao_palavra": "murchou" },
        { "hebraico": "רִמֹּ֞ון", "transliteral": "rim-môn", "traducao_palavra": "a romeira" },
        { "hebraico": "גַּם־תָּמָ֣ר", "transliteral": "gam-tā-mār", "traducao_palavra": "também a palmeira" },
        { "hebraico": "וְתַפּ֗וּחַ", "transliteral": "wə-ṯap-pū-aḥ", "traducao_palavra": "e a macieira" },
        { "hebraico": "כָּל־עֲצֵ֤י", "transliteral": "kāl-ʿă-ṣê", "traducao_palavra": "todas as árvores de" },
        { "hebraico": "הַשָּׂדֶה֙", "transliteral": "haś-śā-ḏeh", "traducao_palavra": "o campo" },
        { "hebraico": "יָבֵ֔שׁוּ", "transliteral": "yā-ḇê-šû", "traducao_palavra": "secaram-se" },
        { "hebraico": "כִּֽי־הֹבִ֥ישׁ", "transliteral": "kî-hō-ḇîš", "traducao_palavra": "porque secou/cessou" },
        { "hebraico": "שָׂשֹׂ֖ון", "transliteral": "śā-śôn", "traducao_palavra": "a alegria" },
        { "hebraico": "מִן־בְּנֵ֥י", "transliteral": "min-bə-nê", "traducao_palavra": "de entre os filhos de" },
        { "hebraico": "אָדָֽם׃", "transliteral": "ʾā-ḏām", "traducao_palavra": "homens" }
      ]
    },
    "13": {
      "traducao_completa": "Cingi-vos e lamentai, sacerdotes; uivai, ministros do altar; vinde e passai a noite vestidos de panos de saco, ministros do meu Deus; porque a oferta de cereais e a libação foram cortadas da casa de vosso Deus.",
      "palavras": [
        { "hebraico": "חִגְר֨וּ", "transliteral": "ḥiḡ-rû", "traducao_palavra": "cingi-vos" },
        { "hebraico": "וְסִפְד֜וּ", "transliteral": "wə-sip̄-dû", "traducao_palavra": "e lamentai" },
