    "1": {
      "traducao_completa": "Palavra de YHWH que veio a Joel, filho de Petuel.",
      "palavras": [
        { "hebraico": "דְּבַר־יְהוָה֙", "transliteral": "də-ḇar-YHWH", "traducao_palavra": "a palavra de YHWH" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "הָיָ֔ה", "transliteral": "hā-yā", "traducao_palavra": "veio/aconteceu" },
        { "hebraico": "אֶל־יֹואֵ֖ל", "transliteral": "ʾel-yô-ʾêl", "traducao_palavra": "a Joel" },
        { "hebraico": "בֶּן־פְּתוּאֵֽל׃", "transliteral": "ben-pə-ṯū-ʾêl", "traducao_palavra": "filho de Petuel" }
      ]
    },
    "2": {
      "traducao_completa": "Ouvi isto, ó anciãos, e escutai, todos os moradores da terra: Aconteceu isto em vossos dias, ou nos dias de vossos pais?",
      "palavras": [
        { "hebraico": "שִׁמְעוּ־זֹ֣את", "transliteral": "šim-ʿū-zōṯ", "traducao_palavra": "ouvi isto" },
        { "hebraico": "הַזְּקֵנִ֔ים", "transliteral": "haz-zə-qê-nîm", "traducao_palavra": "ó anciãos" },
        { "hebraico": "וְהַֽאֲזִ֔ינוּ", "transliteral": "wə-ha-ʾă-zî-nû", "traducao_palavra": "e dai ouvidos/escutai" },
        { "hebraico": "כֹּ֖ל", "transliteral": "kōl", "traducao_palavra": "todos" },
        { "hebraico": "יֹושְׁבֵ֣י", "transliteral": "yô-šə-ḇê", "traducao_palavra": "os moradores de" },
        { "hebraico": "הָאָ֑רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "הֶהָ֤יְתָה", "transliteral": "he-hā-yə-ṯā", "traducao_palavra": "aconteceu" },
        { "hebraico": "זֹּאת֙", "transliteral": "zōṯ", "traducao_palavra": "isto" },
        { "hebraico": "בִּֽימֵיכֶ֔ם", "transliteral": "bî-mê-ḵem", "traducao_palavra": "nos vossos dias" },
        { "hebraico": "וְאִ֖ם", "transliteral": "wə-ʾim", "traducao_palavra": "ou" },
        { "hebraico": "בִּימֵ֥י", "transliteral": "bî-mê", "traducao_palavra": "nos dias de" },
        { "hebraico": "אֲבֹֽתֵיכֶֽם׃", "transliteral": "ʾă-ḇō-ṯê-ḵem", "traducao_palavra": "vossos pais?" }
      ]
    },
    "3": {
      "traducao_completa": "Contai isto a vossos filhos, e vossos filhos a seus filhos, e os filhos destes à outra geração.",
      "palavras": [
        { "hebraico": "עָלֶ֖יהָ", "transliteral": "ʿā-le-hā", "traducao_palavra": "acerca disto" },
        { "hebraico": "לִבְנֵיכֶ֣ם", "transliteral": "liḇ-nê-ḵem", "traducao_palavra": "a vossos filhos" },
        { "hebraico": "סַפֵּ֑רוּ", "transliteral": "sap-pê-rû", "traducao_palavra": "contai/relatai" },
        { "hebraico": "וּבְנֵיכֶם֙", "transliteral": "ū-ḇə-nê-ḵem", "traducao_palavra": "e vossos filhos" },
        { "hebraico": "לִבְנֵיהֶ֔ם", "transliteral": "liḇ-nê-hem", "traducao_palavra": "a seus filhos" },
        { "hebraico": "וּבְנֵיהֶ֖ם", "transliteral": "ū-ḇə-nê-hem", "traducao_palavra": "e os filhos destes" },
        { "hebraico": "לְדֹ֥ור", "transliteral": "lə-ḏôr", "traducao_palavra": "à geração" },
