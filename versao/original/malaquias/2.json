        { "hebraico": "שִׁלַּ֣חְתִּי", "transliteral": "šil-laḥ-tî", "traducao_palavra": "enviei" },
        { "hebraico": "אֲלֵיכֶ֔ם", "transliteral": "ʾă-lê-ḵem", "traducao_palavra": "a vós" },
        { "hebraico": "אֵ֖ת", "transliteral": "ʾêṯ", "traducao_palavra": "[objeto]" },
        { "hebraico": "הַמִּצְוָ֣ה", "transliteral": "ham-miṣ-wā", "traducao_palavra": "o mandamento" },
