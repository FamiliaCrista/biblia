        { "hebraico": "יִשְׁמְרוּ־דַ֔עַת", "transliteral": "yiš-mə-rû-ḏa-ʿaṯ", "traducao_palavra": "devem guardar o conhecimento" },
        { "hebraico": "וְתוֹרָ֖ה", "transliteral": "wə-ṯô-rā", "traducao_palavra": "e a lei" },
        { "hebraico": "יְבַקְשׁ֣וּ", "transliteral": "yə-ḇaq-šû", "traducao_palavra": "devem buscar" },
        { "hebraico": "מִפִּ֑יהוּ", "transliteral": "mip-pî-hû", "traducao_palavra": "da sua boca" },
        { "hebraico": "כִּ֛י", "transliteral": "kî", "traducao_palavra": "porque" },
