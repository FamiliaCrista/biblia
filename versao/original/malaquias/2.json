        { "hebraico": "אֱמֶת֙", "transliteral": "ʾĕ-meṯ", "traducao_palavra": "verdade" },
        { "hebraico": "הָיְתָ֣ה", "transliteral": "hā-yə-ṯā", "traducao_palavra": "esteve" },
        { "hebraico": "בְּפִ֔יהוּ", "transliteral": "bə-p̄î-hû", "traducao_palavra": "na sua boca" },
        { "hebraico": "וְעַוְלָ֖ה", "transliteral": "wə-ʿaw-lā", "traducao_palavra": "e iniquidade" },
        { "hebraico": "לֹא־נִמְצָ֣א", "transliteral": "lō-nim-ṣā", "traducao_palavra": "não se achou" },
        { "hebraico": "בִשְׂפָתָ֑יו", "transliteral": "ḇiś-p̄ā-ṯāyw", "traducao_palavra": "nos seus lábios" },
        { "hebraico": "בְּשָׁל֤וֹם", "transliteral": "bə-šā-lôm", "traducao_palavra": "em paz" },
