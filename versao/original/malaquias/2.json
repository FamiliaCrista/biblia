        { "hebraico": "הֲל֨וֹא", "transliteral": "hă-lô", "traducao_palavra": "porventura não [temos]" },
        { "hebraico": "אָ֤ב", "transliteral": "ʾāḇ", "traducao_palavra": "pai" },
        { "hebraico": "אֶחָד֙", "transliteral": "ʾe-ḥāḏ", "traducao_palavra": "um só" },
        { "hebraico": "לְכֻלָּ֔נוּ", "transliteral": "lə-ḵul-lā-nû", "traducao_palavra": "todos nós" },
        { "hebraico": "הֲל֛וֹא", "transliteral": "hă-lô", "traducao_palavra": "não [é]" },
        { "hebraico": "אֵ֥ל", "transliteral": "ʾêl", "traducao_palavra": "Deus" },
        { "hebraico": "אֶחָ֖ד", "transliteral": "ʾe-ḥāḏ", "traducao_palavra": "um só" },
        { "hebraico": "בְּרָאָ֑נוּ", "transliteral": "bə-rā-ʾā-nû", "traducao_palavra": "que nos criou" },
        { "hebraico": "מַדּ֗וּעַ", "transliteral": "mad-dû-aʿ", "traducao_palavra": "por que" },
        { "hebraico": "נִבְגַּד֙", "transliteral": "niḇ-gaḏ", "traducao_palavra": "agimos traiçoeiramente" },
        { "hebraico": "אִ֣ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada um" },
