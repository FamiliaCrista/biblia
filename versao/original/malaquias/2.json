    },
    "5": {
      "traducao_completa": "Minha aliança com ele foi de vida e de paz, e eu lhas dei para que me temesse; e ele me temeu e tremeu diante do meu nome.",
      "palavras": [
        { "hebraico": "בְּרִיתִ֣י", "transliteral": "bə-rî-ṯî", "traducao_palavra": "minha aliança" },
