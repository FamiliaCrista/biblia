        { "hebraico": "נִבְזִ֥ים", "transliteral": "niḇ-zîm", "traducao_palavra": "desprezíveis" },
        { "hebraico": "וּשְׁפָלִ֖ים", "transliteral": "ū-šə-p̄ā-lîm", "traducao_palavra": "e humilhados / indignos" },
        { "hebraico": "לְכָל־הָעָ֑ם", "transliteral": "lə-ḵāl-hā-ʿām", "traducao_palavra": "diante de todo o povo" },
        { "hebraico": "כְּפִ֗י", "transliteral": "kə-p̄î", "traducao_palavra": "conforme" },
        { "hebraico": "אֲשֶׁ֤ר", "transliteral": "ʾă-šer", "traducao_palavra": "o que" },
        { "hebraico": "אֵֽינְכֶם֙", "transliteral": "ʾên-ḵem", "traducao_palavra": "não estais" },
        { "hebraico": "שֹׁמְרִ֣ים", "transliteral": "šō-mə-rîm", "traducao_palavra": "guardando" },
        { "hebraico": "אֶת־דְּרָכַ֔י", "transliteral": "ʾeṯ-də-rā-ḵay", "traducao_palavra": "os meus caminhos" },
        { "hebraico": "וְנֹשְׂאִ֥ים", "transliteral": "wə-nō-śə-ʾîm", "traducao_palavra": "e fazeis acepção de" },
