  "versiculos": {
    "1": {
      "traducao_completa": "E agora, ó sacerdotes, a vós vos toca este mandamento.",
      "palavras": [
        { "hebraico": "וְעַתָּ֗ה", "transliteral": "wə-ʿat-tā", "traducao_palavra": "e agora" },
        { "hebraico": "אֲלֵיכֶ֛ם", "transliteral": "ʾă-lê-ḵem", "traducao_palavra": "a vós" },
        { "hebraico": "הַמִּצְוָ֥ה", "transliteral": "ham-miṣ-wā", "traducao_palavra": "o mandamento" },
        { "hebraico": "הַזֹּ֖את", "transliteral": "haz-zōʾṯ", "traducao_palavra": "este" },
