      ]
    },
    "2": {
      "traducao_completa": "Se não ouvirdes e se não propuserdes no vosso coração dar honra ao meu nome, diz YHWH dos Exércitos, enviarei a maldição sobre vós e amaldiçoarei as vossas bênçãos; e já as tenho amaldiçoado, porque não pondes isso no coração.",
      "palavras": [
        { "hebraico": "אִם־לֹ֣א", "transliteral": "ʾim-lō", "traducao_palavra": "se não" },
        { "hebraico": "תִשְׁמְע֡וּ", "transliteral": "ṯiš-mə-ʿû", "traducao_palavra": "ouvirdes" },
        { "hebraico": "וְאִם־לֹא֩", "transliteral": "wə-ʾim-lō", "traducao_palavra": "e se não" },
        { "hebraico": "תָשִׂ֨ימוּ", "transliteral": "ṯā-śî-mû", "traducao_palavra": "puserdes" },
        { "hebraico": "עַל־לֵ֜ב", "transliteral": "ʿal-lêḇ", "traducao_palavra": "no coração" },
        { "hebraico": "לָתֵ֧ת", "transliteral": "lā-ṯêṯ", "traducao_palavra": "para dar" },
        { "hebraico": "כָּב֣וֹד", "transliteral": "kā-ḇôḏ", "traducao_palavra": "glória" },
        { "hebraico": "לִשְׁמִ֗י", "transliteral": "liš-mî", "traducao_palavra": "ao meu nome" },
        { "hebraico": "אָמַר֙", "transliteral": "ʾā-mar", "traducao_palavra": "diz" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָא֔וֹת", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "dos Exércitos" },
        { "hebraico": "וְשִׁלַּחְתִּ֤י", "transliteral": "wə-šil-laḥ-tî", "traducao_palavra": "enviarei" },
        { "hebraico": "בָכֶם֙", "transliteral": "ḇā-ḵem", "traducao_palavra": "sobre vós" },
        { "hebraico": "אֶת־הַמְּאֵרָ֔ה", "transliteral": "ʾeṯ-ham-mə-ʾê-rā", "traducao_palavra": "a maldição" },
        { "hebraico": "וְאָרוֹתִ֖י", "transliteral": "wə-ʾā-rô-ṯî", "traducao_palavra": "e amaldiçoarei" },
        { "hebraico": "אֶת־בִּרְכוֹתֵיכֶ֑ם", "transliteral": "ʾeṯ-bir-ḵô-ṯê-ḵem", "traducao_palavra": "as vossas bênçãos" },
        { "hebraico": "וְגַם֙", "transliteral": "wə-ḡam", "traducao_palavra": "e até" },
        { "hebraico": "אָרוֹתִ֔יהָ", "transliteral": "ʾā-rô-ṯî-hā", "traducao_palavra": "já as amaldiçoei" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אֵינְכֶ֖ם", "transliteral": "ʾên-ḵem", "traducao_palavra": "não estais" },
        { "hebraico": "שָׂמִ֥ים", "transliteral": "śā-mîm", "traducao_palavra": "pondo [isso]" },
        { "hebraico": "עַל־לֵֽב׃", "transliteral": "ʿal-lêḇ", "traducao_palavra": "no coração" }
      ]
    },
    "3": {
      "traducao_completa": "Eis que vos reprovarei a semente, e espalharei esterco sobre os vossos rostos, o esterco das vossas festas; e sereis levados juntamente com ele.",
      "palavras": [
        { "hebraico": "הִנְנִ֨י", "transliteral": "hin-nə-nî", "traducao_palavra": "eis que eu" },
        { "hebraico": "גֹעֵ֤ר", "transliteral": "ḡō-ʿêr", "traducao_palavra": "repreenderei" },
        { "hebraico": "לָכֶם֙", "transliteral": "lā-ḵem", "traducao_palavra": "por vossa causa" },
        { "hebraico": "אֶת־הַזֶּ֔רַע", "transliteral": "ʾeṯ-haz-ze-raʿ", "traducao_palavra": "a semente" },
        { "hebraico": "וְזֵרִ֤יתִי", "transliteral": "wə-zê-rî-ṯî", "traducao_palavra": "e espalharei" },
        { "hebraico": "פֶ֙רֶשׁ֙", "transliteral": "p̄e-reš", "traducao_palavra": "esterco" },
        { "hebraico": "עַל־פְּנֵיכֶ֔ם", "transliteral": "ʿal-pə-nê-ḵem", "traducao_palavra": "sobre os vossos rostos" },
        { "hebraico": "פֶּ֖רֶשׁ", "transliteral": "pe-reš", "traducao_palavra": "o esterco de" },
        { "hebraico": "חַגֵּיכֶ֑ם", "transliteral": "ḥag-gê-ḵem", "traducao_palavra": "vossas festas" },
        { "hebraico": "וְנָשָׂ֥א", "transliteral": "wə-nā-śā", "traducao_palavra": "e vos levará" },
        { "hebraico": "אֶתְכֶ֖ם", "transliteral": "ʾeṯ-ḵem", "traducao_palavra": "a vós" },
        { "hebraico": "אֵלָֽיו׃", "transliteral": "ʾê-lāyw", "traducao_palavra": "com ele" }
      ]
    },
    "4": {
      "traducao_completa": "E sabereis que eu vos enviei este mandamento, para que a minha aliança permaneça com Levi, diz YHWH dos Exércitos.",
      "palavras": [
