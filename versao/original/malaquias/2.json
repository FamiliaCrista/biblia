        { "hebraico": "אִתּ֗וֹ", "transliteral": "ʾit-tô", "traducao_palavra": "com ele" },
        { "hebraico": "הַֽחַיִּים֙", "transliteral": "ha-ḥay-yîm", "traducao_palavra": "[de] vida" },
        { "hebraico": "וְהַשָּׁל֔וֹם", "transliteral": "wə-haš-šā-lôm", "traducao_palavra": "e [de] paz" },
        { "hebraico": "וָאֶתְּנֵֽם־ל֥וֹ", "transliteral": "wā-ʾet-tə-nêm-lô", "traducao_palavra": "e dei-lhas" },
        { "hebraico": "מוֹרָ֖א", "transliteral": "mô-rā", "traducao_palavra": "para temor" },
        { "hebraico": "וַיִּֽירָאֵ֑נִי", "transliteral": "way-yî-rā-ʾê-nî", "traducao_palavra": "e ele me temeu" },
        { "hebraico": "וּמִפְּנֵ֥י", "transliteral": "ū-mip-pə-nê", "traducao_palavra": "e diante de" },
        { "hebraico": "שְׁמִ֖י", "transliteral": "šə-mî", "traducao_palavra": "meu nome" },
