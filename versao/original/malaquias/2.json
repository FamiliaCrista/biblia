        { "hebraico": "הֽוּא׃", "transliteral": "hû", "traducao_palavra": "[é] ele" }
      ]
    },
    "8": {
      "traducao_completa": "Mas vós vos desviastes do caminho; a muitos fizestes tropeçar na lei; corrompestes a aliança de Levi, diz YHWH dos Exércitos.",
