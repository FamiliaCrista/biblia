    },
    "9": {
      "traducao_completa": "Por isso também eu vos fiz desprezíveis e indignos diante de todo o povo, visto que não guardastes os meus caminhos, mas fizestes acepção de pessoas na lei.",
      "palavras": [
        { "hebraico": "וְגַם־אֲנִ֞י", "transliteral": "wə-ḡam-ʾă-nî", "traducao_palavra": "por isso também eu" },
