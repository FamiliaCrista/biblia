        { "hebraico": "רַבִּ֖ים", "transliteral": "rab-bîm", "traducao_palavra": "a muitos" },
        { "hebraico": "בַּתּוֹרָ֑ה", "transliteral": "bat-tô-rā", "traducao_palavra": "na lei" },
        { "hebraico": "שִֽׁחַתֶּם֙", "transliteral": "ši-ḥat-tem", "traducao_palavra": "corrompestes" },
        { "hebraico": "בְּרִ֣ית", "transliteral": "bə-rîṯ", "traducao_palavra": "a aliança de" },
        { "hebraico": "הַלֵּוִ֔י", "transliteral": "hal-lê-wî", "traducao_palavra": "Levi" },
        { "hebraico": "אָמַ֖ר", "transliteral": "ʾā-mar", "traducao_palavra": "diz" },
