        { "hebraico": "הָאָד֣וֹן׀", "transliteral": "hā-ʾā-ḏôn", "traducao_palavra": "o Senhor" },
        { "hebraico": "אֲשֶׁר־אַתֶּ֣ם", "transliteral": "ʾă-šer-ʾat-tem", "traducao_palavra": "a quem vós" },
        { "hebraico": "מְבַקְשִׁ֗ים", "transliteral": "mə-ḇaq-šîm", "traducao_palavra": "buscais" },
        { "hebraico": "וּמַלְאַ֨ךְ", "transliteral": "ū-mal-ʾaḵ", "traducao_palavra": "e o anjo / mensageiro de" },
        { "hebraico": "הַבְּרִ֜ית", "transliteral": "hab-bə-rîṯ", "traducao_palavra": "a aliança" },
        { "hebraico": "אֲשֶׁר־אַתֶּ֤ם", "transliteral": "ʾă-šer-ʾat-tem", "traducao_palavra": "em quem vós" },
        { "hebraico": "חֲפֵצִים֙", "transliteral": "ḥă-p̄ê-ṣîm", "traducao_palavra": "vos comprazeis" },
        { "hebraico": "הִנֵּה־בָ֔א", "transliteral": "hin-nēh-ḇā", "traducao_palavra": "eis que vem" },
        { "hebraico": "אָמַ֖ר", "transliteral": "ʾā-mar", "traducao_palavra": "diz" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֽוֹת׃", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "dos Exércitos" }
      ]
    },
    "2": {
      "traducao_completa": "Mas quem suportará o dia da sua vinda? E quem subsistirá, quando ele aparecer? Porque ele é como o fogo do refinador e como o sabão dos lavandeiros.",
      "palavras": [
        { "hebraico": "וּמִ֤י", "transliteral": "ū-mî", "traducao_palavra": "mas quem" },
        { "hebraico": "מְכַלְכֵּל֙", "transliteral": "mə-ḵal-kêl", "traducao_palavra": "suportará" },
        { "hebraico": "אֶת־י֣וֹם", "transliteral": "ʾeṯ-yôm", "traducao_palavra": "o dia de" },
        { "hebraico": "בּוֹא֔וֹ", "transliteral": "bô-ʾô", "traducao_palavra": "sua vinda" },
        { "hebraico": "וּמִ֥י", "transliteral": "ū-mî", "traducao_palavra": "e quem" },
        { "hebraico": "הָעֹמֵ֖ד", "transliteral": "hā-ʿō-mêḏ", "traducao_palavra": "ficará em pé / subsistirá" },
        { "hebraico": "בְּהֵרָאוֹת֑וֹ", "transliteral": "bə-hê-rā-ʾô-ṯô", "traducao_palavra": "quando ele aparecer" },
        { "hebraico": "כִּֽי־הוּא֙", "transliteral": "kî-hû", "traducao_palavra": "porque ele [é]" },
        { "hebraico": "כְּאֵ֣שׁ", "transliteral": "kə-ʾēš", "traducao_palavra": "como o fogo de" },
        { "hebraico": "מְצָרֵ֔ף", "transliteral": "mə-ṣā-rêp̄", "traducao_palavra": "refinador / fundidor" },
