        { "hebraico": "מִנְחַ֥ת", "transliteral": "min-ḥaṯ", "traducao_palavra": "a oferta de" },
        { "hebraico": "יְהוּדָ֖ה", "transliteral": "yə-hû-ḏā", "traducao_palavra": "Judá" },
        { "hebraico": "וִירוּשָׁלִָ֑ם", "transliteral": "wî-rû-šā-lim", "traducao_palavra": "e de Jerusalém" },
        { "hebraico": "כִּימֵ֣י", "transliteral": "kî-mê", "traducao_palavra": "como nos dias de" },
        { "hebraico": "עוֹלָ֔ם", "transliteral": "ʿô-lām", "traducao_palavra": "antiguidade" },
        { "hebraico": "וּכְשָׁנִ֖ים", "transliteral": "ū-ḵə-šā-nîm", "traducao_palavra": "e como nos anos" },
        { "hebraico": "קַדְמֹנִיֹּֽת׃", "transliteral": "qaḏ-mō-niy-yōṯ", "traducao_palavra": "passados / remotos" }
      ]
    },
    "5": {
      "traducao_completa": "E chegar-me-ei a vós para juízo, e serei uma testemunha veloz contra os feiticeiros, contra os adúlteros, contra os que juram falsamente e contra os que defraudam o salário do diarista, a viúva e o órfão, e que torcem o direito do estrangeiro, e não me temem, diz YHWH dos Exércitos.",
      "palavras": [
        { "hebraico": "וְקָרַבְתִּ֣י", "transliteral": "wə-qā-raḇ-tî", "traducao_palavra": "e chegar-me-ei" },
        { "hebraico": "אֲלֵיכֶם֮", "transliteral": "ʾă-lê-ḵem", "traducao_palavra": "a vós" },
        { "hebraico": "לַמִּשְׁפָּט֒", "transliteral": "lam-miš-pāṭ", "traducao_palavra": "para juízo" },
        { "hebraico": "וְהָיִ֣יתִי׀", "transliteral": "wə-hā-yî-ṯî", "traducao_palavra": "e serei" },
        { "hebraico": "עֵ֣ד", "transliteral": "ʿêḏ", "traducao_palavra": "testemunha" },
        { "hebraico": "מְמַהֵ֗ר", "transliteral": "mə-ma-hêr", "traducao_palavra": "veloz" },
        { "hebraico": "בַּֽמְכַשְּׁפִים֙", "transliteral": "bam-ḵaš-šə-p̄îm", "traducao_palavra": "contra os feiticeiros" },
        { "hebraico": "וּבַמְנָ֣אָפִ֔ים", "transliteral": "ū-ḇam-nā-ʾă-p̄îm", "traducao_palavra": "e contra os adúlteros" },
        { "hebraico": "וּבַנִּשְׁבָּעִ֖ים", "transliteral": "ū-ḇan-niš-bā-ʿîm", "traducao_palavra": "e contra os que juram" },
        { "hebraico": "לַשָּׁ֑קֶר", "transliteral": "laš-šā-qer", "traducao_palavra": "falsamente" },
        { "hebraico": "וּבְעֹשְׁקֵ֣י", "transliteral": "ū-ḇə-ʿō-šə-qê", "traducao_palavra": "e contra os que defraudam" },
        { "hebraico": "שְׂכַר־שָׂ֠כִיר", "transliteral": "śə-ḵar-śā-ḵîr", "traducao_palavra": "o salário do diarista" },
        { "hebraico": "אַלְמָנָ֨ה", "transliteral": "ʾal-mā-nā", "traducao_palavra": "a viúva" },
        { "hebraico": "וְיָת֤וֹם", "transliteral": "wə-yā-ṯôm", "traducao_palavra": "e o órfão" },
        { "hebraico": "וּמַטֵּי־גֵר֙", "transliteral": "ū-maṭ-ṭê-ḡêr", "traducao_palavra": "e que torcem o direito do estrangeiro" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יְרֵא֔וּנִי", "transliteral": "yə-rê-ʾû-nî", "traducao_palavra": "me temem" },
        { "hebraico": "אָמַ֖ר", "transliteral": "ʾā-mar", "traducao_palavra": "diz" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֽוֹת׃", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "dos Exércitos" }
      ]
    },
    "6": {
      "traducao_completa": "Porque eu, YHWH, não mudo; por isso vós, ó filhos de Jacó, não sois consumidos.",
      "palavras": [
        { "hebraico": "כִּ֛י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אֲנִ֥י", "transliteral": "ʾă-nî", "traducao_palavra": "eu [sou]" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "שָׁנִ֑יתִי", "transliteral": "šā-nî-ṯî", "traducao_palavra": "mudo" },
        { "hebraico": "וְאַתֶּ֥ם", "transliteral": "wə-ʾat-tem", "traducao_palavra": "e vós" },
        { "hebraico": "בְּנֵֽי־יַעֲקֹ֖ב", "transliteral": "bə-nê-ya-ʿă-qōḇ", "traducao_palavra": "ó filhos de Jacó" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "כְלִיתֶֽם׃", "transliteral": "ḵə-lî-ṯem", "traducao_palavra": "fostes consumidos" }
      ]
    },
    "7": {
      "traducao_completa": "Desde os dias de vossos pais vos desviastes dos meus estatutos e não os guardastes; tornai para mim, e eu me tornarei para vós, diz YHWH dos Exércitos; mas dizeis: Em que havemos de tornar?",
      "palavras": [
        { "hebraico": "לְמִימֵ֨י", "transliteral": "lə-mî-mê", "traducao_palavra": "desde os dias de" },
        { "hebraico": "אֲבֹתֵיכֶ֜ם", "transliteral": "ʾă-ḇō-ṯê-ḵem", "traducao_palavra": "vossos pais" },
        { "hebraico": "סַרְתֶּ֤ם", "transliteral": "sar-tem", "traducao_palavra": "vos desviastes" },
        { "hebraico": "מֵֽחֻקַּי֙", "transliteral": "mê-ḥuq-qay", "traducao_palavra": "dos meus estatutos" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não [os]" },
        { "hebraico": "שְׁמַרְתֶּ֔ם", "transliteral": "šə-mar-tem", "traducao_palavra": "guardastes" },
        { "hebraico": "שׁ֤וּבוּ", "transliteral": "šû-ḇû", "traducao_palavra": "tornai / voltai" },
        { "hebraico": "אֵלַי֙", "transliteral": "ʾê-lay", "traducao_palavra": "a mim" },
        { "hebraico": "וְאָשׁ֣וּבָה", "transliteral": "wə-ʾā-šû-ḇā", "traducao_palavra": "e me tornarei" },
        { "hebraico": "אֲלֵיכֶ֔ם", "transliteral": "ʾă-lê-ḵem", "traducao_palavra": "a vós" },
        { "hebraico": "אָמַ֖ר", "transliteral": "ʾā-mar", "traducao_palavra": "diz" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָא֑וֹת", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "dos Exércitos" },
        { "hebraico": "וַאֲמַרְתֶּ֖ם", "transliteral": "wa-ʾă-mar-tem", "traducao_palavra": "mas dizeis" },
        { "hebraico": "בַּמֶּ֥ה", "transliteral": "bam-meh", "traducao_palavra": "em que" },
        { "hebraico": "נָשֽׁוּב׃", "transliteral": "nā-šûḇ", "traducao_palavra": "havemos de tornar" }
      ]
    },
    "8": {
      "traducao_completa": "Roubará o homem a Deus? Todavia vós me roubais, e dizeis: Em que te roubamos? Nos dízimos e nas ofertas alçadas.",
      "palavras": [
        { "hebraico": "הֲיִקְבַּ֨ע", "transliteral": "hă-yiq-baʿ", "traducao_palavra": "roubará / defraudarà" },
        { "hebraico": "אָדָ֜ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "o homem" },
        { "hebraico": "אֱלֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "a Deus" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "contudo" },
        { "hebraico": "אַתֶּם֙", "transliteral": "ʾat-tem", "traducao_palavra": "vós" },
        { "hebraico": "קֹבְעִ֣ים", "transliteral": "qō-ḇə-ʿîm", "traducao_palavra": "roubais" },
        { "hebraico": "אֹתִ֔י", "transliteral": "ʾō-ṯî", "traducao_palavra": "a mim" },
        { "hebraico": "וַאֲמַרְתֶּ֖ם", "transliteral": "wa-ʾă-mar-tem", "traducao_palavra": "e dizeis" },
        { "hebraico": "בַּמֶּ֣ה", "transliteral": "bam-meh", "traducao_palavra": "em que" },
        { "hebraico": "קְבַעֲנ֑וּךָ", "transliteral": "qə-ḇa-ʿă-nû-ḵā", "traducao_palavra": "te roubamos" },
        { "hebraico": "הַֽמַּעֲשֵׂ֖ר", "transliteral": "ham-ma-ʿă-śêr", "traducao_palavra": "nos dízimos" },
        { "hebraico": "וְהַתְּרוּמָֽה׃", "transliteral": "wə-hat-tə-rû-mā", "traducao_palavra": "e nas ofertas alçadas" }
      ]
    },
    "9": {
      "traducao_completa": "Com maldição sois amaldiçoados, porque a mim me roubais, sim, toda esta nação.",
      "palavras": [
        { "hebraico": "בַּמְּאֵרָה֙", "transliteral": "bam-mə-ʾê-rā", "traducao_palavra": "com maldição" },
        { "hebraico": "אַתֶּ֣ם", "transliteral": "ʾat-tem", "traducao_palavra": "vós" },
        { "hebraico": "נֵֽאָרִ֔ים", "transliteral": "nê-ʾā-rîm", "traducao_palavra": "sois amaldiçoados" },
        { "hebraico": "וְאֹתִ֖י", "transliteral": "wə-ʾō-ṯî", "traducao_palavra": "e a mim" },
        { "hebraico": "אַתֶּ֣ם", "transliteral": "ʾat-tem", "traducao_palavra": "vós" },
        { "hebraico": "קֹבְעִ֑ים", "transliteral": "qō-ḇə-ʿîm", "traducao_palavra": "roubais" },
        { "hebraico": "הַגּ֖וֹי", "transliteral": "hag-gôy", "traducao_palavra": "a nação" },
        { "hebraico": "כֻּלּֽוֹ׃", "transliteral": "kul-lô", "traducao_palavra": "toda ela" }
      ]
    },
    "10": {
      "traducao_completa": "Trazei todos os dízimos à casa do tesouro, para que haja mantimento na minha casa, e depois fazei prova de mim nisto, diz YHWH dos Exércitos, se eu não vos abrir as janelas do céu e não derramar sobre vós uma bênção tal até que não haja mais lugar para a recolherdes.",
      "palavras": [
        { "hebraico": "הָבִ֨יאוּ", "transliteral": "hā-ḇî-ʾû", "traducao_palavra": "trazei" },
        { "hebraico": "אֶת־כָּל־הַֽמַּעֲשֵׂ֜ר", "transliteral": "ʾeṯ-kāl-ham-ma-ʿă-śêr", "traducao_palavra": "todos os dízimos" },
