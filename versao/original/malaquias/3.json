        { "hebraico": "מְכַבְּסִֽים׃", "transliteral": "mə-ḵab-bə-sîm", "traducao_palavra": "lavandeiros" }
      ]
    },
    "3": {
      "traducao_completa": "E assentar-se-á como fundidor e purificador de prata; e purificará os filhos de Levi, e os refinará como ouro e como prata; e trarão a YHWH ofertas em justiça.",
      "palavras": [
        { "hebraico": "וְיָשַׁ֨ב", "transliteral": "wə-yā-šaḇ", "traducao_palavra": "e assentar-se-á" },
        { "hebraico": "מְצָרֵ֤ף", "transliteral": "mə-ṣā-rêp̄", "traducao_palavra": "como refinador" },
        { "hebraico": "וּמְטַהֵר֙", "transliteral": "ū-mə-ṭa-hêr", "traducao_palavra": "e purificador de" },
        { "hebraico": "כֶּ֔סֶף", "transliteral": "ke-sep̄", "traducao_palavra": "prata" },
        { "hebraico": "וְטִהַ֤ר", "transliteral": "wə-ṭi-har", "traducao_palavra": "e purificará" },
        { "hebraico": "אֶת־בְּנֵֽי־לֵוִי֙", "transliteral": "ʾeṯ-bə-nê-lê-wî", "traducao_palavra": "os filhos de Levi" },
        { "hebraico": "וְזִקַּ֣ק", "transliteral": "wə-ziq-qaq", "traducao_palavra": "e refinará" },
        { "hebraico": "אֹתָ֔ם", "transliteral": "ʾō-ṯām", "traducao_palavra": "a eles" },
        { "hebraico": "כַּזָּהָ֖ב", "transliteral": "kaz-zā-hāḇ", "traducao_palavra": "como o ouro" },
        { "hebraico": "וְכַכָּ֑סֶף", "transliteral": "wə-ḵak-kā-sep̄", "traducao_palavra": "e como a prata" },
        { "hebraico": "וְהָיוּ֙", "transliteral": "wə-hā-yû", "traducao_palavra": "e serão" },
        { "hebraico": "לַֽיהוָ֔ה", "transliteral": "lay-YHWH", "traducao_palavra": "para YHWH" },
        { "hebraico": "מַגִּישֵׁ֥י", "transliteral": "mag-gî-šê", "traducao_palavra": "os que apresentam" },
        { "hebraico": "מִנְחָ֖ה", "transliteral": "min-ḥā", "traducao_palavra": "oferta" },
        { "hebraico": "בִּצְדָקָֽה׃", "transliteral": "biṣ-dā-qā", "traducao_palavra": "em justiça" }
      ]
    },
    "4": {
      "traducao_completa": "Então a oferta de Judá e de Jerusalém será agradável a YHWH, como nos dias antigos e como nos primeiros anos.",
      "palavras": [
        { "hebraico": "וְעָֽרְבָה֙", "transliteral": "wə-ʿā-rə-ḇā", "traducao_palavra": "e será agradável" },
