{
  "livro": "Malaquias - מַלְאָכִי - Malʾāḵî",
  "capítulo": 3,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Eis que eu envio o meu mensageiro, que preparará o caminho diante de mim; e de repente virá ao seu templo o Senhor, a quem vós buscais, o anjo da aliança, a quem vós desejais; eis que ele vem, diz YHWH dos Exércitos.",
      "palavras": [
        { "hebraico": "הִנְנִ֤י", "transliteral": "hin-nə-nî", "traducao_palavra": "eis que eu" },
        { "hebraico": "שֹׁלֵחַ֙", "transliteral": "šō-lê-aḥ", "traducao_palavra": "envio" },
        { "hebraico": "מַלְאָכִ֔י", "transliteral": "mal-ʾā-ḵî", "traducao_palavra": "o meu mensageiro" },
        { "hebraico": "וּפִנָּה־דֶ֖רֶךְ", "transliteral": "ū-p̄in-nāh-de-reḵ", "traducao_palavra": "e preparará o caminho" },
        { "hebraico": "לְפָנָ֑י", "transliteral": "lə-p̄ā-nāy", "traducao_palavra": "diante de mim" },
        { "hebraico": "וּפִתְאֹם֩", "transliteral": "ū-p̄iṯ-ʾōm", "traducao_palavra": "e de repente" },
        { "hebraico": "יָב֨וֹא", "transliteral": "yā-ḇô", "traducao_palavra": "virá" },
