    "2": {
      "traducao_completa": "Eu vos amei, diz YHWH; mas vós dizeis: Em que nos amaste? Não era Esaú irmão de Jacó? — diz YHWH; todavia amei a Jacó,",
      "palavras": [
        { "hebraico": "אָהַ֤בְתִּי", "transliteral": "ʾā-haḇ-tî", "traducao_palavra": "amei" },
        { "hebraico": "אֶתְכֶם֙", "transliteral": "ʾeṯ-ḵem", "traducao_palavra": "a vós" },
        { "hebraico": "אָמַ֣ר", "transliteral": "ʾā-mar", "traducao_palavra": "diz" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וַאֲמַרְתֶּ֖ם", "transliteral": "wa-ʾă-mar-tem", "traducao_palavra": "mas dizeis" },
        { "hebraico": "בַּמָּ֣ה", "transliteral": "bam-māh", "traducao_palavra": "em que" },
        { "hebraico": "אֲהַבְתָּ֑נוּ", "transliteral": "ʾă-haḇ-tā-nû", "traducao_palavra": "nos amaste" },
        { "hebraico": "הֲלוֹא־אָ֨ח", "transliteral": "hă-lô-ʾāḥ", "traducao_palavra": "não era irmão" },
        { "hebraico": "עֵשָׂ֤ו", "transliteral": "ʿê-śāw", "traducao_palavra": "Esaú" },
        { "hebraico": "לְיַֽעֲקֹב֙", "transliteral": "lə-ya-ʿă-qōḇ", "traducao_palavra": "de Jacó" },
        { "hebraico": "נְאֻם־יְהוָ֔ה", "transliteral": "nə-ʾum-YHWH", "traducao_palavra": "declaração de YHWH" },
        { "hebraico": "וָאֹהַ֖ב", "transliteral": "wā-ʾō-haḇ", "traducao_palavra": "todavia amei" },
        { "hebraico": "אֶֽת־יַעֲקֹֽב׃", "transliteral": "ʾeṯ-ya-ʿă-qōḇ", "traducao_palavra": "a Jacó" }
      ]
    },
    "3": {
      "traducao_completa": "e aborreci a Esaú; e fiz dos seus montes uma desolação, e dei a sua herança aos chacais do deserto.",
      "palavras": [
        { "hebraico": "וְאֶת־עֵשָׂ֖ו", "transliteral": "wə-ʾeṯ-ʿê-śāw", "traducao_palavra": "e a Esaú" },
        { "hebraico": "שָׂנֵ֑אתִי", "transliteral": "śā-nê-ṯî", "traducao_palavra": "odiei / aborreci" },
        { "hebraico": "וָאָשִׂ֤ים", "transliteral": "wā-ʾā-śîm", "traducao_palavra": "e fiz de" },
        { "hebraico": "אֶת־הָרָיו֙", "transliteral": "ʾeṯ-hā-rāyw", "traducao_palavra": "os seus montes" },
        { "hebraico": "שְׁמָמָ֔ה", "transliteral": "šə-mā-mā", "traducao_palavra": "uma desolação" },
        { "hebraico": "וְאֶת־נַחֲלָת֖וֹ", "transliteral": "wə-ʾeṯ-na-ḥă-lā-ṯô", "traducao_palavra": "e a sua herança" },
        { "hebraico": "לְתַנּ֥וֹת", "transliteral": "lə-ṯan-nôṯ", "traducao_palavra": "aos chacais de" },
        { "hebraico": "מִדְבָּֽר׃", "transliteral": "miḏ-bār", "traducao_palavra": "deserto" }
      ]
    },
    "4": {
      "traducao_completa": "Se Edom disser: Fomos destruídos, mas tornaremos a edificar as ruínas; assim diz YHWH dos Exércitos: Eles edificarão, e eu destruirei; e lhes chamarão: Terra de Impiedade, e povo contra quem YHWH está irado para sempre.",
