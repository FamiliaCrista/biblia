    },
    "7": {
      "traducao_completa": "Ofereceis sobre o meu altar pão imundo, e dizeis: Em que te profanamos? Nisto, que dizeis: A mesa de YHWH é desprezível.",
      "palavras": [
        { "hebraico": "מַגִּישִׁ֤ים", "transliteral": "mag-gî-šîm", "traducao_palavra": "ofereceis" },
        { "hebraico": "עַֽל־מִזְבְּחִי֙", "transliteral": "ʿal-miz-bə-ḥî", "traducao_palavra": "sobre o meu altar" },
