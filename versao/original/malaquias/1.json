        { "hebraico": "וּמִנְחָ֖ה", "transliteral": "ū-min-ḥā", "traducao_palavra": "e oferta de manjares" },
        { "hebraico": "לֹֽא־אֶרְצֶ֥ה", "transliteral": "lō-ʾer-ṣeh", "traducao_palavra": "não aceitarei" },
