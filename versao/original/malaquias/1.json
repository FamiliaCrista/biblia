        { "hebraico": "אֱד֜וֹם", "transliteral": "ʾĕ-ḏôm", "traducao_palavra": "Edom" },
        { "hebraico": "רֻשַּׁ֗שְׁנוּ", "transliteral": "ruš-šaš-nû", "traducao_palavra": "fomos destruídos" },
