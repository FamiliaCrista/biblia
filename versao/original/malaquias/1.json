        { "hebraico": "וַאֲנִ֣י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "e eu" },
        { "hebraico": "אֶהֱר֔וֹס", "transliteral": "ʾe-hĕ-rôs", "traducao_palavra": "derrubarei" },
        { "hebraico": "וְקָרְא֤וּ", "transliteral": "wə-qā-rə-ʾû", "traducao_palavra": "e chamarão" },
