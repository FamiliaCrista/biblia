    },
    "5": {
      "traducao_completa": "E os vossos olhos o verão, e vós direis: Engrandecido seja YHWH além dos limites de Israel.",
      "palavras": [
        { "hebraico": "וְעֵינֵיכֶ֖ם", "transliteral": "wə-ʿê-nê-ḵem", "traducao_palavra": "e os vossos olhos" },
