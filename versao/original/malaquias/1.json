    "6": {
      "traducao_completa": "O filho honra o pai, e o servo, o seu senhor; se eu sou pai, onde está a minha honra? E, se eu sou senhor, onde está o meu temor? — diz YHWH dos Exércitos a vós, ó sacerdotes, que desprezais o meu nome. E vós dizeis: Em que desprezamos o teu nome?",
      "palavras": [
        { "hebraico": "בֵּ֛ן", "transliteral": "bên", "traducao_palavra": "o filho" },
        { "hebraico": "יְכַבֵּ֥ד", "transliteral": "yə-ḵab-bêḏ", "traducao_palavra": "honra" },
        { "hebraico": "אָ֖ב", "transliteral": "ʾāḇ", "traducao_palavra": "o pai" },
