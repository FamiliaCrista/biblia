        { "hebraico": "הַקְרִיבֵ֨הוּ", "transliteral": "haq-rî-ḇê-hû", "traducao_palavra": "apresenta-o" },
        { "hebraico": "נָ֜א", "transliteral": "nā", "traducao_palavra": "agora / peço-te" },
