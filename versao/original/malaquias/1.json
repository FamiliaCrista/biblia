  "versiculos": {
    "1": {
      "traducao_completa": "Sentença da palavra de YHWH contra Israel, por intermédio de Malaquias.",
      "palavras": [
        { "hebraico": "מַשָּׂ֥א", "transliteral": "maś-śā", "traducao_palavra": "sentença / peso de" },
        { "hebraico": "דְבַר־יְהוָ֖ה", "transliteral": "də-ḇar-YHWH", "traducao_palavra": "a palavra de YHWH" },
