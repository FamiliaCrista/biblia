        { "hebraico": "גַם־בָּכֶם֙", "transliteral": "gam-bā-ḵem", "traducao_palavra": "também entre vós" },
        { "hebraico": "וְיִסְגֹּ֣ר", "transliteral": "wə-yis-gōr", "traducao_palavra": "fechasse" },
