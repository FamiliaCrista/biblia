        { "hebraico": "אָנִי֩", "transliteral": "ʾā-nî", "traducao_palavra": "eu" },
        { "hebraico": "אַיֵּ֨ה", "transliteral": "ʾay-yêh", "traducao_palavra": "onde [está]" },
        { "hebraico": "מוֹרָאִ֜י", "transliteral": "mô-rā-ʾî", "traducao_palavra": "o meu temor" },
