        { "hebraico": "לֹא־יַעֲזֹ֥ב", "transliteral": "lō-ya-ʿă-zōḇ", "traducao_palavra": "não deixará" },
        { "hebraico": "לָהֶ֖ם", "transliteral": "lā-hem", "traducao_palavra": "a eles" },
