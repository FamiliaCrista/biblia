        { "hebraico": "הַיּוֹם֙", "transliteral": "hay-yôm", "traducao_palavra": "o dia" },
        { "hebraico": "בָּ֔א", "transliteral": "bā", "traducao_palavra": "vem" },
        { "hebraico": "בֹּעֵ֖ר", "transliteral": "bō-ʿêr", "traducao_palavra": "ardendo" },
