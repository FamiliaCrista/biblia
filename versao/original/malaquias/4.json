        { "hebraico": "בַּיּוֹם֙", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "em que" },
        { "hebraico": "אֲנִ֣י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
