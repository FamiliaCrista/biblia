        { "hebraico": "רִשְׁעָה֙", "transliteral": "riš-ʿā", "traducao_palavra": "impiedade" },
        { "hebraico": "קַ֔שׁ", "transliteral": "qaš", "traducao_palavra": "palha / restolho" },
        { "hebraico": "וְלִהַ֨ט", "transliteral": "wə-li-haṭ", "traducao_palavra": "e abrasará" },
        { "hebraico": "אֹתָ֜ם", "transliteral": "ʾō-ṯām", "traducao_palavra": "a eles" },
        { "hebraico": "הַיּ֣וֹם", "transliteral": "hay-yôm", "traducao_palavra": "o dia" },
        { "hebraico": "הַבָּ֗א", "transliteral": "hab-bā", "traducao_palavra": "que vem" },
        { "hebraico": "אָמַר֙", "transliteral": "ʾā-mar", "traducao_palavra": "diz" },
