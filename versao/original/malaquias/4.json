        { "hebraico": "אֵ֔פֶר", "transliteral": "ʾê-p̄er", "traducao_palavra": "cinza" },
        { "hebraico": "תַּ֖חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "debaixo de" },
