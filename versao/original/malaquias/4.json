        { "hebraico": "לָכֶ֜ם", "transliteral": "lā-ḵem", "traducao_palavra": "para vós" },
        { "hebraico": "יִרְאֵ֤י", "transliteral": "yir-ʾê", "traducao_palavra": "os que temeis" },
        { "hebraico": "שְׁמִי֙", "transliteral": "šə-mî", "traducao_palavra": "o meu nome" },
