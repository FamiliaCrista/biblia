        { "hebraico": "בּ֚וֹא", "transliteral": "bô", "traducao_palavra": "vir" },
        { "hebraico": "י֣וֹם", "transliteral": "yôm", "traducao_palavra": "o dia de" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "הַגָּדוֹל", "transliteral": "hag-gā-ḏôl", "traducao_palavra": "o grande" },
